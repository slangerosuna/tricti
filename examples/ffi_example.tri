# FFI (Foreign Function Interface) Example
# Demonstrates calling C functions and loading dynamic libraries

use ffi
use ffi::marshal

# Example 1: Static extern declarations for common C functions
extern sqrt :: (x: f64) -> f64
extern strlen :: (s: *u8) -> u64
extern pow :: (base: f64, exp: f64) -> f64

# Example 2: Memory management with FFI
test_memory_allocation :: () => {
    println("Testing FFI memory allocation...")
    
    # Allocate C memory
    size := 100u64
    ptr := ffi_malloc(size)
    
    if ptr == (0 as *u8) {
        println("Failed to allocate memory")
        ret
    }
    
    # Initialize memory to zero
    ffi_memset(ptr, 0, size)
    
    # Write some data
    test_data := "Hello, FFI!"
    data_len := String::len(&test_data)
    ffi_memcpy(ptr, String::as_ptr(&test_data), data_len)
    
    # Read back and verify
    result := cstr_to_string(ptr)
    println("Read from C memory: ")
    println(result)
    
    # Free memory
    ffi_free(ptr)
    println("Memory freed successfully")
}

# Example 3: String marshalling
test_string_marshalling :: () => {
    println("\nTesting string marshalling...")
    
    # Convert TriCTI string to C string
    tri_str := "TriCTI String"
    c_str := string_to_cstr(tri_str)
    
    # Use C string with strlen
    length := strlen(c_str)
    println("String length from C strlen: ")
    println(length as i64)
    
    # Convert back to TriCTI string
    back_to_tri := cstr_to_string(c_str)
    println("Converted back: ")
    println(back_to_tri)
    
    # Free C string
    free_cstr(c_str)
}

# Example 4: Calling C math functions
test_math_functions :: () => {
    println("\nTesting C math functions...")
    
    # Test sqrt
    value := 25.0
    result := sqrt(value)
    println("sqrt(25.0) = ")
    println(result)
    
    # Test pow
    base := 2.0
    exponent := 10.0
    power_result := pow(base, exponent)
    println("pow(2.0, 10.0) = ")
    println(power_result)
}

# Example 5: Dynamic library loading
test_dynamic_loading :: () => {
    println("\nTesting dynamic library loading...")
    
    # Try to load math library
    # On Linux: libm.so.6, on macOS: libm.dylib, on Windows: msvcrt.dll
    lib_path := "libm.so.6"
    
    lib_opt := DynLib::open(lib_path)
    
    lib := lib_opt? else {
        println("Failed to load library: ")
        println(lib_path)
        println("Error: ")
        println(DynLib::error())
        ret
    }
    
    println("Successfully loaded: ")
    println(lib.path)
    
    # Try to get a symbol
    symbol_name := "sin"
    symbol_opt := DynLib::get_symbol(&lib, symbol_name)
    
    if symbol_opt {
        println("Found symbol: ")
        println(symbol_name)
    } else {
        println("Symbol not found: ")
        println(symbol_name)
    }
    
    # Close library
    closed := DynLib::close(&mut lib)
    if closed {
        println("Library closed successfully")
    } else {
        println("Failed to close library")
    }
}

# Example 6: C array marshalling
test_array_marshalling :: () => {
    println("\nTesting array marshalling...")
    
    # Create TriCTI array
    tri_array := [1i32, 2, 3, 4, 5]
    
    # Convert to C array
    c_array := array_to_c(&tri_array)
    
    # Verify data
    println("First element from C array: ")
    println(*c_array as i64)
    
    # Convert back
    back_to_tri := c_array_to_vec(c_array, 5u64)
    println("Array length after conversion: ")
    println(back_to_tri.len as i64)
    
    # Free C array
    c_free(c_array)
}

main :: () => {
    println("=== TriCTI FFI Examples ===\n")
    
    test_memory_allocation()
    test_string_marshalling()
    test_math_functions()
    test_dynamic_loading()
    test_array_marshalling()
    
    println("\n=== All FFI examples completed ===")
}
