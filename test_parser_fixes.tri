// Test 1: Generic impl with trait bounds
impl<T, U: From<T>> Into<U> for T {
    into :: (self: T) -> U => { ret From::from(self) }
}

// Test 2: Simple type parameters with bounds
Container :: <T: Eq> { value: T }

// Test 3: Multiple bounds
Hashable :: <T: Eq + Hash> { value: T }

// Test 4: Generic impl block
impl<T> Container<T> {
    new :: (value: T) -> Container<T> => {
        ret Container { value: value }
    }
}

// Test 5: Trait impl with generics
impl<T: Display> ToString for Container<T> {
    to_string :: (self: Container<T>) -> string => {
        ret "Container"
    }
}
