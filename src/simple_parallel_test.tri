use std::prelude
use std::collections::vec::ParVec

main :: () -> none => {
    println("Testing parallel map operations...")
    
    mut vec := ParVec<i64>::new()
    vec.push(1)
    vec.push(2)
    vec.push(3)
    vec.push(4)
    vec.push(5)
    
    result := vec.parallel_map_add(10, 2)
    
    println("Original: [1,2,3,4,5]")
    println("After add 10:")
    
    for i in 0..result.len() {
        val := result.get(i)
        match val {
            some v => println(v)
            none => println("Error")
        }
    }
    
    sum := vec.parallel_sum(2)
    println("Parallel sum: ")
    println(sum)
}
