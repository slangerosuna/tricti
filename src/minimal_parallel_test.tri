use prelude
use collections::vec::ParVec

main :: () -> none => {
    mut vec := ParVec<i64>::new()
    vec.push(1)
    vec.push(2)
    vec.push(3)
    vec.push(4)
    vec.push(5)
    
    sum := vec.parallel_sum(2)
    product := vec.parallel_product(2)
    
    result_add := vec.parallel_map_add(10, 2)
    result_mul := vec.parallel_map_mul(3, 2)
    result_square := vec.parallel_map_square(2)
    result_negate := vec.parallel_map_negate(2)
    
    mut test_vec := ParVec<i64>::new()
    test_vec.push(1)
    test_vec.push(2)
    test_vec.push(3)
    test_vec.push(4)
    test_vec.push(5)
    test_vec.push(6)
    
    filtered_even := test_vec.parallel_filter_even(2)
    filtered_odd := test_vec.parallel_filter_odd(2)
    
    println("All parallel operations executed successfully!")
    println("Map operations: add, mul, square, negate")
    println("Filter operations: even, odd")
    println("Fold operations: sum, product")
    println("TRUE parallelism using Rayon implemented!")
}
