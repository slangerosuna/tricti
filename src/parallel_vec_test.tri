use std::prelude
use std::collections::vec::ParVec

main :: () -> none => {
    test_i64_parallel()
}

test_i64_parallel :: () -> none => {
    mut vec := ParVec<i64>::new()
    
    vec.push(1)
    vec.push(2)
    vec.push(3)
    vec.push(4)
    vec.push(5)
    vec.push(6)
    vec.push(7)
    vec.push(8)
    vec.push(9)
    vec.push(10)
    
    serial_sum := vec.sum()
    parallel_sum := vec.parallel_sum(4)
    
    serial_product := vec.product()
    parallel_product := vec.parallel_product(4)
    
    mut vec2 := ParVec<u64>::new()
    vec2.push(1)
    vec2.push(2)
    vec2.push(3)
    vec2.push(4)
    vec2.push(5)
    
    parallel_sum_u64 := vec2.parallel_sum(2)
    parallel_product_u64 := vec2.parallel_product(2)
    
    mut vec3 := ParVec<f64>::new()
    vec3.push(1.5)
    vec3.push(2.5)
    vec3.push(3.5)
    
    parallel_sum_f64 := vec3.parallel_sum(2)
    parallel_product_f64 := vec3.parallel_product(2)
}
