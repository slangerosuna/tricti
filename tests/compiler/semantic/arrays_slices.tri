# Vector Typing Tests - migrating from array/slice coverage to Vec-based helpers
# These helpers emulate a small fixed-capacity Vec implementation without relying on arrays.

VecI64 :: struct {
    len: i64,
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,

vec_new_i64 :: () -> VecI64 => do
        len: 0,
        a: 0,
        b: 0,
        c: 0,
        d: 0,
        e: 0,

vec_push_i64 :: (vec: VecI64, value: i64) -> VecI64 => do
    if vec.len == 0:
        ret {
            len: 1,
            a: value,
            b: vec.b,
            c: vec.c,
            d: vec.d,
            e: vec.e,
    if vec.len == 1:
        ret {
            len: 2,
            a: vec.a,
            b: value,
            c: vec.c,
            d: vec.d,
            e: vec.e,
    if vec.len == 2:
        ret {
            len: 3,
            a: vec.a,
            b: vec.b,
            c: value,
            d: vec.d,
            e: vec.e,
    if vec.len == 3:
        ret {
            len: 4,
            a: vec.a,
            b: vec.b,
            c: vec.c,
            d: value,
            e: vec.e,
        len: if vec.len >= 4 { 5 } else { vec.len + 1 },
        a: vec.a,
        b: vec.b,
        c: vec.c,
        d: vec.d,
        e: value,

vec_len_i64 :: (vec: VecI64) -> i64 => vec.len

vec_is_empty_i64 :: (vec: VecI64) -> bool => vec.len == 0

vec_get_i64 :: (vec: VecI64, idx: i64) -> i64 => do
    if idx == 0 { ret vec.a }
    if idx == 1 { ret vec.b }
    if idx == 2 { ret vec.c }
    if idx == 3 { ret vec.d }
    vec.e

vec_sum_i64 :: (vec: VecI64) -> i64 => do
    acc := 0
    if vec.len >= 1 { acc = acc + vec.a }
    if vec.len >= 2 { acc = acc + vec.b }
    if vec.len >= 3 { acc = acc + vec.c }
    if vec.len >= 4 { acc = acc + vec.d }
    if vec.len >= 5 { acc = acc + vec.e }
    acc

VecBool :: struct {
    len: i64,
    a: bool,
    b: bool,
    c: bool,
    d: bool,

vec_new_bool :: () -> VecBool => do
        len: 0,
        a: false,
        b: false,
        c: false,
        d: false,

vec_push_bool :: (vec: VecBool, value: bool) -> VecBool => do
    if vec.len == 0:
        ret {
            len: 1,
            a: value,
            b: vec.b,
            c: vec.c,
            d: vec.d,
    if vec.len == 1:
        ret {
            len: 2,
            a: vec.a,
            b: value,
            c: vec.c,
            d: vec.d,
    if vec.len == 2:
        ret {
            len: 3,
            a: vec.a,
            b: vec.b,
            c: value,
            d: vec.d,
        len: 4,
        a: vec.a,
        b: vec.b,
        c: vec.c,
        d: value,

vec_len_bool :: (vec: VecBool) -> i64 => vec.len

vec_get_bool :: (vec: VecBool, idx: i64) -> bool => do
    if idx == 0 { ret vec.a }
    if idx == 1 { ret vec.b }
    if idx == 2 { ret vec.c }
    vec.d

vec_any_true :: (vec: VecBool) -> bool => do
    if vec.len >= 1 and vec.a { ret true }
    if vec.len >= 2 and vec.b { ret true }
    if vec.len >= 3 and vec.c { ret true }
    if vec.len >= 4 and vec.d { ret true }
    false

# ============ VEC CONSTRUCTION TESTS ============

test_vec_new_is_empty :: () -> bool => do
    v := vec_new_i64()
    vec_is_empty_i64(v)

test_vec_push_increases_len :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 10)
    v = vec_push_i64(v, 20)
    vec_len_i64(v) == 2

test_vec_sum_tracks_values :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 5)
    v = vec_push_i64(v, 7)
    v = vec_push_i64(v, 9)
    vec_sum_i64(v) == 21

test_vec_get_first :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 3)
    v = vec_push_i64(v, 4)
    vec_get_i64(v, 0) == 3

test_vec_get_middle :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 3)
    v = vec_push_i64(v, 8)
    v = vec_push_i64(v, 13)
    vec_get_i64(v, 1) == 8

test_vec_get_last :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 1)
    v = vec_push_i64(v, 2)
    v = vec_push_i64(v, 3)
    v = vec_push_i64(v, 4)
    vec_get_i64(v, 3) == 4

# ============ VEC STATE CHECKS ============

test_vec_is_empty_false_after_push :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 42)
    !vec_is_empty_i64(v)

test_vec_chain_push_caps_to_five :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 1)
    v = vec_push_i64(v, 2)
    v = vec_push_i64(v, 3)
    v = vec_push_i64(v, 4)
    v = vec_push_i64(v, 5)
    v = vec_push_i64(v, 6)
    vec_len_i64(v) == 5

test_vec_sum_caps_after_overflow :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 1)
    v = vec_push_i64(v, 2)
    v = vec_push_i64(v, 3)
    v = vec_push_i64(v, 4)
    v = vec_push_i64(v, 5)
    v = vec_push_i64(v, 100)
    vec_sum_i64(v) == 1 + 2 + 3 + 4 + 100

test_vec_get_clamps_index :: () -> bool => do
    mut v := vec_new_i64()
    v = vec_push_i64(v, 10)
    v = vec_push_i64(v, 20)
    v = vec_push_i64(v, 30)
    vec_get_i64(v, 9) == 30

# ============ BOOL VEC CHECKS ============

test_vec_bool_len :: () -> bool => do
    mut v := vec_new_bool()
    v = vec_push_bool(v, true)
    v = vec_push_bool(v, false)
    vec_len_bool(v) == 2

test_vec_bool_truthy_lookup :: () -> bool => do
    mut v := vec_new_bool()
    v = vec_push_bool(v, false)
    v = vec_push_bool(v, true)
    vec_get_bool(v, 1)

test_vec_bool_any_true :: () -> bool => do
    mut v := vec_new_bool()
    v = vec_push_bool(v, false)
    v = vec_push_bool(v, false)
    v = vec_push_bool(v, true)
    vec_any_true(v)
