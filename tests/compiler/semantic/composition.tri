# Compose & reactive pipeline semantic tests
# Verifies brace-free schemas and trigger annotations type-check.

SemanticEvents :: table
	@primary id: u64,
	payload: String,

SemanticRuntime :: @resource struct
	counter: u64,

SemanticDatabase :: db
	Events: SemanticEvents,
	Runtime: SemanticRuntime,

SemanticTick :: Signal<Mpsc, Buffer, none>

produce_event :: sys () -> !?String => do
	ret ok some String::from_cstr("payload" as *u8)

decode_event :: sys (
	@sys_input raw: String,
) -> !String => do
	ret ok raw

persist_event :: sys (
	@sys_input value: String,
) -> !none => do
	println(value)
	ret ok none

@trigger SemanticTick, SemanticDatabase
semantic_pipeline :: compose
	produce_event ?-> decode_event -> persist_event

# Semantic-level assertion to ensure optional chaining compiles
# and resources referenced in the database can be accessed.
test_semantic_compose_optional :: () -> bool => do
	match produce_event():
		ok some payload => do
			match decode_event(payload):
				ok decoded => do
					match persist_event(decoded):
						ok _ => do
							ret true
						err _ => do
							ret false
				err _ => do
					ret false
		ok none => do
			ret false
		err _ => do
			ret false
