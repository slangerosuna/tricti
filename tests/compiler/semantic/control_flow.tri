# Control Flow Type Consistency Tests - 12 tests for control flow type checking
# Tests if/else branch types, match arm consistency, and early return type checking

# ============ IF/ELSE BRANCH TYPE MATCHING (5 tests) ============

# Test: if/else with matching i64 types
test_if_else_i64 :: () -> bool => do
    result := if true: 42 else: 99
    x := result
    ret x == 42

# Test: if/else with matching bool types
test_if_else_bool :: () -> bool => do
    result := if true: true else: false
    x := result
    ret x

# Test: if/else with matching string types
test_if_else_string :: () -> bool => do
    result := if true: "yes" else: "no"
    x := result
    ret streq(x, "yes")

# Test: if/else with computation
test_if_else_compute :: () -> bool => do
    result := if 10 > 5: 100 + 200 else: 50
    x := result
    ret x == 300

# Test: nested if/else type consistency
test_nested_if_else :: () -> bool => do
    result := if true: if true: 42 else: 0 else: 99
    x := result
    ret x == 42

# ============ MATCH ARM TYPE CONSISTENCY (4 tests) ============

# Test: if-else chain with consistent i64
test_if_chain_i64_consistent :: () -> bool => do
    val := 1
    result := if val == 0: 10 elif val == 1: 20 elif val == 2: 30 else: 40
    x := result
    ret x == 20

# Test: if-else with consistent bool
test_if_chain_bool_consistent :: () -> bool => do
    val := 0
    result := if val == 0: true else: false
    x := result
    ret x

# Test: if-else with computation in arms
test_if_chain_compute :: () -> bool => do
    val := 2
    result := if val == 1: 5 + 5 else: if val == 2: 10 + 10 else: 0
    x := result
    ret x == 20

# Test: if-else with consistent string types
test_if_chain_string :: () -> bool => do
    val := 1
    result := if val == 1: "one" else: if val == 2: "two" else: "other"
    x := result
    ret streq(x, "one")

# ============ EARLY RETURN TYPE CHECKING (3 tests) ============

# Test: early return with same type
test_early_return_same :: () -> i64 => do
    cond := true
    if cond: ret 42
    ret 99

# Test: function with multiple early returns
test_multi_early_return :: () -> i64 => do
    x := 1
    if x == 0:
        ret 0
    if x == 1:
        ret 100
    ret 99

# Test: early return type matches function return
test_early_return_match :: () -> bool => do
    f :: () -> i64 => do
        if true:
            ret 42
        ret 0
    result := f()
    ret result == 42
