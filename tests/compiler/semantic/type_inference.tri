# Type Inference Tests - 45 tests for type inference validation
# Tests basic inference, function call inference, generic inference, backward inference, and control flow inference

# ============ BASIC TYPE INFERENCE (10 tests) ============

# Test: integer literal inference to i64
test_infer_i64_literal :: () -> bool => do
    x := 42
    y := x
    (y == 42)

# Test: float literal inference to f64
test_infer_f64_literal :: () -> bool => do
    x := 3.14
    y := x
    (y == 3.14)

# Test: boolean literal inference
test_infer_bool_literal :: () -> bool => do
    x := true
    y := x
    y

# Test: string literal inference
test_infer_string_literal :: () -> bool => do
    x := "hello"
    y := x
    streq(y, "hello")

# Test: inference from arithmetic expression
test_infer_arithmetic :: () -> bool => do
    x := 10 + 20
    y := x
    (y == 30)

# Test: inference from comparison expression
test_infer_comparison :: () -> bool => do
    x := (5 > 3)
    y := x
    y

# Test: inference from logical expression
test_infer_logical :: () -> bool => do
    x := (true and false)
    y := x
    (y == false)

# Test: inference from negation
test_infer_negation :: () -> bool => do
    x := -42
    y := x
    (y == -42)

# Test: inference with multiple operations
test_infer_complex_expr :: () -> bool => do
    x := (10 + 20) * 2
    y := x
    (y == 60)

# Test: inference from variable assignment chain
test_infer_chain :: () -> bool => do
    a := 42
    b := a
    c := b
    (c == 42)

# ============ FUNCTION CALL INFERENCE (10 tests) ============

# Helper function for inference tests
add_i64 :: (x: i64, y: i64) -> i64 => do x + y }
get_bool :: () -> bool => do true }
get_string :: () -> string => do "test" }

# Test: inference from function return type
test_infer_from_func_return :: () -> bool => do
    x := add_i64(10, 20)
    y := x
    (y == 30)

# Test: inference from parameterless function
test_infer_from_no_param_func :: () -> bool => do
    x := get_bool()
    y := x
    y

# Test: inference through nested function calls
test_infer_nested_calls :: () -> bool => do
    x := add_i64(add_i64(1, 2), add_i64(3, 4))
    y := x
    (y == 10)

# Test: inference from function with type annotation
test_infer_annotated_func :: () -> bool => do
    result := add_i64(5, 10)
    check := result
    (check == 15)

# Test: inference through multiple statements
test_infer_multi_stmt :: () -> bool => do
    a := 10
    b := 20
    c := add_i64(a, b)
    d := c
    (d == 30)

# Test: inference with string function
test_infer_string_func :: () -> bool => do
    s := get_string()
    t := s
    streq(t, "test")

# Test: inference from built-in function
test_infer_builtin :: () -> bool => do
    s := "hello"
    length := len(s)
    check := length
    (check == 5)

# Test: inference with function composition
test_infer_composition :: () -> bool => do
    x := add_i64(1, 2)
    y := add_i64(x, 3)
    z := y
    (z == 6)

# Test: inference from equality check
test_infer_eq_check :: () -> bool => do
    result := (10 == 10)
    check := result
    check

# Test: inference from string equality
test_infer_string_eq :: () -> bool => do
    result := streq("a", "a")
    check := result
    check

# ============ CONTROL FLOW INFERENCE (10 tests) ============

# Test: inference through if expression
test_infer_if_expr :: () -> bool => do
    x := if (true) { 42 } else { 0 }
    y := x
    (y == 42)

# Test: inference through if-else branches
test_infer_if_else :: () -> bool => do
    cond := true
    x := if (cond) { 10 } else { 20 }
    y := x
    (y == 10)

# Test: inference with nested if
test_infer_nested_if :: () -> bool => do
    x := if (true) { if (true) { 42 } else { 0 } } else { 0 }
    y := x
    (y == 42)

# Test: inference in if condition
test_infer_if_cond :: () -> bool => do
    x := (5 > 3)
    result := if (x) { true } else { false }
    check := result
    check

# Test: inference through if-else chain (replaces match with literals)
test_infer_if_chain_simple :: () -> bool => do
    x := 1
    result := if ((x == 0)) { 10 } else { if ((x == 1)) { 20 } else { 30 } }
    y := result
    (y == 20)

# Test: inference with conditional on bool
test_infer_cond_bool :: () -> bool => do
    b := true
    result := if (b) { 1 } else { 0 }
    y := result
    (y == 1)

# Test: inference through if-else with computation
test_infer_if_compute :: () -> bool => do
    x := 2
    result := if ((x == 1)) { 10 + 5 } else { if ((x == 2)) { 20 + 5 } else { 30 } }
    y := result
    (y == 25)

# Test: inference with if returning bool
test_infer_if_bool :: () -> bool => do
    x := if (true) { true } else { false }
    y := x
    y

# Test: inference across block boundaries
test_infer_block :: () -> bool => do
    x := do
        a := 10
        b := 20
        a + b
    y := x
    (y == 30)

# Test: inference with early computation
test_infer_early_compute :: () -> bool => do
    x := 1
    y := 2
    result := x + y
    z := result
    (z == 3)

# ============ INFERENCE WITH OPERATORS (8 tests) ============

# Test: inference with addition
test_infer_add :: () -> bool => do
    x := 5 + 10
    y := x
    (y == 15)

# Test: inference with subtraction
test_infer_sub :: () -> bool => do
    x := 20 - 5
    y := x
    (y == 15)

# Test: inference with multiplication
test_infer_mul :: () -> bool => do
    x := 5 * 3
    y := x
    (y == 15)

# Test: inference with division
test_infer_div :: () -> bool => do
    x := 30 / 2
    y := x
    (y == 15)

# Test: inference with comparison operators
test_infer_gt :: () -> bool => do
    x := (10 > 5)
    y := x
    y

# Test: inference with logical AND
test_infer_and :: () -> bool => do
    x := (true and true)
    y := x
    y

# Test: inference with logical OR
test_infer_or :: () -> bool => do
    x := (false or true)
    y := x
    y

# Test: inference with NOT operator
test_infer_not :: () -> bool => do
    x := !false
    y := x
    y

# ============ BACKWARD INFERENCE (7 tests) ============

# Test: backward inference from return type
test_backward_from_return :: () -> i64 => do
    x := 42
    x

# Test: backward inference from typed variable
test_backward_from_typed :: () -> bool => do
    result := 42
    (result == 42)

# Test: backward inference from function parameter
test_backward_from_param :: () -> bool => do
    x := 42
    result := add_i64(x, 8)
    (result == 50)

# Test: backward inference in assignment
test_backward_assignment :: () -> bool => do
    y := 0
    y = 42
    (y == 42)

# Test: backward inference through if expression
test_backward_if :: () -> i64 => do
    x := if (true) { 42 } else { 0 }
    x

# Test: backward inference from comparison
test_backward_comparison :: () -> bool => do
    x := 10
    result := (x > 5)
    result

# Test: backward inference through if-else
test_backward_if_chain :: () -> i64 => do
    x := 1
    result := if ((x == 1)) { 100 } else { 0 }
    result
