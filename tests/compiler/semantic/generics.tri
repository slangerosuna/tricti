# Generic Type Resolution Tests - 45 tests for generic type system
# Tests simple generics, multiple type parameters, nested generics, monomorphization, and generic constraints

# ============ SIMPLE GENERIC FUNCTIONS (10 tests) ============

# Generic identity function
identity :: <T>(x: T) -> T => { x }

# Test: generic identity with i64
test_generic_identity_i64 :: () -> bool => {
    x := identity(42)
    y := x
    (y == 42)
}

# Test: generic identity with bool
test_generic_identity_bool :: () -> bool => {
    x := identity(true)
    y := x
    y
}

# Test: generic identity with string
test_generic_identity_string :: () -> bool => {
    x := identity("test")
    y := x
    streq(y, "test")
}

# Generic first function
first :: <T>(x: T, y: T) -> T => { x }

# Test: generic first with i64
test_generic_first_i64 :: () -> bool => {
    result := first(10, 20)
    x := result
    (x == 10)
}

# Test: generic first with bool
test_generic_first_bool :: () -> bool => {
    result := first(true, false)
    x := result
    x
}

# Generic second function
second :: <T>(x: T, y: T) -> T => { y }

# Test: generic second
test_generic_second :: () -> bool => {
    result := second(10, 20)
    x := result
    (x == 20)
}

# Generic swap function (returns tuple)
swap :: <T, U>(x: T, y: U) -> (U, T) => { (y, x) }

# Test: generic swap
test_generic_swap :: () -> bool => {
    result := swap(42, true)
    x := result
    true
}

# Generic return first of pair
pair_first :: <T, U>(x: T, y: U) -> T => { x }

# Test: generic pair first
test_generic_pair_first :: () -> bool => {
    result := pair_first(42, "test")
    x := result
    (x == 42)
}

# Generic return second of pair
pair_second :: <T, U>(x: T, y: U) -> U => { y }

# Test: generic pair second
test_generic_pair_second :: () -> bool => {
    result := pair_second(42, true)
    x := result
    x
}

# ============ MULTIPLE TYPE PARAMETERS (10 tests) ============

# Two type parameters
two_params :: <A, B>(a: A, b: B) -> A => { a }

# Test: two type parameters
test_two_type_params :: () -> bool => {
    result := two_params(10, "test")
    x := result
    (x == 10)
}

# Three type parameters
three_params :: <A, B, C>(a: A, b: B, c: C) -> B => { b }

# Test: three type parameters
test_three_type_params :: () -> bool => {
    result := three_params(10, true, "test")
    x := result
    x
}

# Mix and return first
mix_first :: <T, U>(x: T, y: U, z: T) -> T => { x }

# Test: mix first
test_mix_first :: () -> bool => {
    result := mix_first(10, true, 20)
    x := result
    (x == 10)
}

# Mix and return second
mix_second :: <T, U>(x: T, y: U, z: T) -> U => { y }

# Test: mix second
test_mix_second :: () -> bool => {
    result := mix_second(10, true, 20)
    x := result
    x
}

# Multiple same type
multi_same :: <T>(a: T, b: T, c: T) -> T => { b }

# Test: multiple same type
test_multi_same :: () -> bool => {
    result := multi_same(10, 20, 30)
    x := result
    (x == 20)
}

# Pair with computation
pair_compute :: <T>(x: T, y: T) -> T => { y }

# Test: pair with same types
test_pair_compute :: () -> bool => {
    result := pair_compute(5, 10)
    x := result
    (x == 10)
}

# Complex parameter pattern
complex_params :: <A, B, C>(x: A, y: B, z: C, w: A) -> C => { z }

# Test: complex parameters
test_complex_params :: () -> bool => {
    result := complex_params(1, true, "hi", 2)
    x := result
    streq(x, "hi")
}

# Four type parameters
four_params :: <A, B, C, D>(a: A, b: B, c: C, d: D) -> A => { a }

# Test: four type parameters
test_four_params :: () -> bool => {
    result := four_params(42, true, "x", 3.14)
    x := result
    (x == 42)
}

# Nested type parameter usage
nested_usage :: <T, U>(x: T, y: U) -> T => { x }

# Test: nested type parameter usage
test_nested_usage :: () -> bool => {
    a := nested_usage(10, 20)
    b := nested_usage(a, true)
    c := b
    (c == 10)
}

# Test: different instantiations
test_different_instantiations :: () -> bool => {
    a := identity(42)
    b := identity(true)
    c := a
    d := b
    (c == 42) && d
}

# ============ GENERIC MONOMORPHIZATION (10 tests) ============

# Test: monomorphization with i64
test_mono_i64 :: () -> bool => {
    x := identity(100)
    y := x
    (y == 100)
}

# Test: monomorphization with bool
test_mono_bool :: () -> bool => {
    x := identity(false)
    y := x
    (y == false)
}

# Test: monomorphization same function different types
test_mono_multiple :: () -> bool => {
    a := identity(42)
    b := identity(3.14)
    c := a
    d := b
    (c == 42) && (d == 3.14)
}

# Test: monomorphization with nested calls
test_mono_nested :: () -> bool => {
    x := identity(identity(42))
    y := x
    (y == 42)
}

# Test: monomorphization in sequence
test_mono_sequence :: () -> bool => {
    a := identity(1)
    b := identity(2)
    c := identity(3)
    x := a
    y := b
    z := c
    ((x == 1) && (y == 2)) && (z == 3)
}

# Test: monomorphization with different sizes
test_mono_sizes :: () -> bool => {
    a := identity(42)
    b := identity("test")
    c := a
    d := b
    (c == 42) && streq(d, "test")
}

# Test: monomorphization in if expression
test_mono_if :: () -> bool => {
    x := if (true) { identity(42) } else { identity(0) }
    y := x
    (y == 42)
}

# Test: monomorphization in if-else
test_mono_if_chain :: () -> bool => {
    cond := 1
    x := if ((cond == 1)) { identity(100) } else { identity(0) }
    y := x
    (y == 100)
}

# Test: generic function as argument type
test_mono_param :: () -> bool => {
    x := 42
    result := identity(x)
    y := result
    (y == 42)
}

# Test: monomorphization with expression arguments
test_mono_expr :: () -> bool => {
    x := identity(10 + 20)
    y := x
    (y == 30)
}

# ============ GENERIC WITH CONDITIONALS (8 tests) ============

# Generic if-then-else
generic_if :: <T>(cond: bool, x: T, y: T) -> T => {
    if (cond) { x } else { y }
}

# Test: generic if with i64
test_generic_if_i64 :: () -> bool => {
    result := generic_if(true, 42, 0)
    x := result
    (x == 42)
}

# Test: generic if with bool
test_generic_if_bool :: () -> bool => {
    result := generic_if(true, true, false)
    x := result
    x
}

# Test: generic if false branch
test_generic_if_false :: () -> bool => {
    result := generic_if(false, 0, 42)
    x := result
    (x == 42)
}

# Generic max (simplified)
generic_select :: <T>(which: bool, a: T, b: T) -> T => {
    if (which) { a } else { b }
}

# Test: generic select first
test_generic_select_first :: () -> bool => {
    result := generic_select(true, 100, 200)
    x := result
    (x == 100)
}

# Test: generic select second
test_generic_select_second :: () -> bool => {
    result := generic_select(false, 100, 200)
    x := result
    (x == 200)
}

# Generic if-else wrapper
generic_if_select :: <T>(x: i64, a: T, b: T) -> T => {
    if ((x == 0)) { a } else { b }
}

# Test: generic if-else first arm
test_generic_if_first :: () -> bool => {
    result := generic_if_select(0, 42, 99)
    x := result
    (x == 42)
}

# Test: generic if-else second arm
test_generic_if_second :: () -> bool => {
    result := generic_if_select(1, 42, 99)
    x := result
    (x == 99)
}

# Test: generic with complex condition
test_generic_complex_cond :: () -> bool => {
    result := generic_if((5 > 3), 1, 0)
    x := result
    (x == 1)
}

# ============ NESTED GENERIC CALLS (7 tests) ============

# Test: nested identity calls
test_nested_identity :: () -> bool => {
    result := identity(identity(identity(42)))
    x := result
    (x == 42)
}

# Test: alternating generic functions
test_alternating_generics :: () -> bool => {
    a := identity(42)
    b := first(a, 99)
    c := identity(b)
    x := c
    (x == 42)
}

# Test: generic chain
test_generic_chain :: () -> bool => {
    a := identity(10)
    b := identity(a)
    c := identity(b)
    x := c
    (x == 10)
}

# Test: mixed generic calls
test_mixed_generic :: () -> bool => {
    a := first(1, 2)
    b := second(a, 3)
    c := identity(b)
    x := c
    (c == 3)
}

# Test: generic with tuple
test_generic_tuple :: () -> bool => {
    t := (42, true)
    a := identity(t)
    x := a
    true
}

# Test: deep nesting
test_deep_nesting :: () -> bool => {
    result := first(first(first(42, 1), 2), 3)
    x := result
    (x == 42)
}

# Test: complex generic expression
test_complex_generic_expr :: () -> bool => {
    a := identity(10)
    b := identity(20)
    c := first(a, b)
    d := second(a, b)
    e := identity(c + d)
    x := e
    (x == 30)
}
