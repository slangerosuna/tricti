# Function Type Checking Tests - 35 tests for function type validation
# Tests parameter matching, return types, generic functions, recursion, and higher-order patterns

# ============ PARAMETER TYPE MATCHING (10 tests) ============

# Test: single parameter type check
test_param_single :: () -> bool => {
    f :: (x: i64) -> i64 => { x }
    result := f(42)
    (result == 42)
}

# Test: two parameter type check
test_param_two :: () -> bool => {
    f :: (x: i64, y: i64) -> i64 => { x + y }
    result := f(10, 20)
    (result == 30)
}

# Test: three parameter type check
test_param_three :: () -> bool => {
    f :: (a: i64, b: i64, c: i64) -> i64 => { a + b + c }
    result := f(1, 2, 3)
    (result == 6)
}

# Test: mixed parameter types
test_param_mixed :: () -> bool => {
    f :: (x: i64, b: bool) -> i64 => { if (b) { x } else { 0 } }
    result := f(42, true)
    (result == 42)
}

# Test: string parameter
test_param_string :: () -> bool => {
    f :: (s: string) -> bool => { streq(s, "test") }
    result := f("test")
    result
}

# Test: bool parameter
test_param_bool :: () -> bool => {
    f :: (b: bool) -> bool => { b }
    result := f(true)
    result
}

# Test: f64 parameter
test_param_f64 :: () -> bool => {
    f :: (x: f64) -> f64 => { x }
    result := f(3.14)
    (result == 3.14)
}

# Test: multiple same-type parameters
test_param_same_type :: () -> bool => {
    f :: (a: i64, b: i64, c: i64, d: i64) -> i64 => { a + b + c + d }
    result := f(1, 2, 3, 4)
    (result == 10)
}

# Test: parameter with computation
test_param_compute :: () -> bool => {
    f :: (x: i64) -> i64 => { x * 2 }
    result := f(21)
    (result == 42)
}

# Test: parameter passing chain
test_param_chain :: () -> bool => {
    f :: (x: i64) -> i64 => { x }
    g :: (y: i64) -> i64 => { f(y) }
    result := g(42)
    (result == 42)
}

# ============ RETURN TYPE VALIDATION (10 tests) ============

# Test: i64 return type
test_return_i64 :: () -> bool => {
    f :: () -> i64 => { 42 }
    result := f()
    (result == 42)
}

# Test: bool return type
test_return_bool :: () -> bool => {
    f :: () -> bool => { true }
    result := f()
    result
}

# Test: string return type
test_return_string :: () -> bool => {
    f :: () -> string => { "test" }
    result := f()
    streq(result, "test")
}

# Test: f64 return type
test_return_f64 :: () -> bool => {
    f :: () -> f64 => { 2.71 }
    result := f()
    (result == 2.71)
}

# Test: return from if expression
test_return_if :: () -> bool => {
    f :: (x: bool) -> i64 => { if (x) { 1 } else { 0 } }
    result := f(true)
    (result == 1)
}

# Test: return from if-else chain
test_return_if_chain :: () -> bool => {
    f :: (x: i64) -> i64 => {
        if ((x == 0)) { 10 } else { if ((x == 1)) { 20 } else { 30 } }
    }
    result := f(1)
    (result == 20)
}

# Test: return from computation
test_return_compute :: () -> bool => {
    f :: (x: i64, y: i64) -> i64 => { x * y }
    result := f(6, 7)
    (result == 42)
}

# Test: return type inference
test_return_infer :: () -> bool => {
    f :: (x: i64) -> i64 => { x + 1 }
    result := f(41)
    (result == 42)
}

# Test: nested return
test_return_nested :: () -> bool => {
    f :: () -> i64 => { { { 42 } } }
    result := f()
    (result == 42)
}

# Test: conditional return
test_return_conditional :: () -> bool => {
    f :: (x: i64) -> i64 => { if ((x > 0)) { x } else { 0 } }
    result := f(42)
    (result == 42)
}

# ============ GENERIC FUNCTION CALLS (8 tests) ============

# Test: generic with explicit type args
test_generic_explicit :: () -> bool => {
    id :: <T>(x: T) -> T => { x }
    result := id(42)
    (result == 42)
}

# Test: generic with inferred type args
test_generic_inferred :: () -> bool => {
    id :: <T>(x: T) -> T => { x }
    a := id(100)
    b := a
    (b == 100)
}

# Test: generic with two type params
test_generic_two_params :: () -> bool => {
    pair :: <A, B>(x: A, y: B) -> A => { x }
    result := pair(42, true)
    (result == 42)
}

# Test: generic with return type inference
test_generic_return_infer :: () -> bool => {
    get :: <T>(x: T) -> T => { x }
    result := get(99)
    check := result
    (check == 99)
}

# Test: generic function composition
test_generic_compose :: () -> bool => {
    id :: <T>(x: T) -> T => { x }
    result := id(id(42))
    (result == 42)
}

# Test: generic with different instantiations
test_generic_multi_inst :: () -> bool => {
    id :: <T>(x: T) -> T => { x }
    a := id(10)
    b := id(true)
    c := a
    d := b
    (c == 10) and d
}

# Test: generic parameter passing
test_generic_param_pass :: () -> bool => {
    id :: <T>(x: T) -> T => { x }
    use :: <T>(x: T) -> T => { id(x) }
    result := use(42)
    (result == 42)
}

# Test: generic with computation
test_generic_compute :: () -> bool => {
    double :: <T>(x: i64) -> i64 => { x * 2 }
    result := double(21)
    (result == 42)
}

# ============ RECURSION TYPE CHECKING (4 tests) ============

# Test: simple recursive function
test_recursion_simple :: () -> bool => {
    countdown :: (n: i64) -> i64 => {
        if ((n <= 0)) { 0 } else { countdown(n - 1) }
    }
    result := countdown(5)
    (result == 0)
}

# Test: recursive with accumulator
test_recursion_accum :: () -> bool => {
    sum :: (n: i64, acc: i64) -> i64 => {
        if ((n <= 0)) { acc } else { sum(n - 1, acc + n) }
    }
    result := sum(5, 0)
    (result == 15)
}

# Test: recursive factorial
test_recursion_factorial :: () -> bool => {
    fact :: (n: i64) -> i64 => {
        if ((n <= 1)) { 1 } else { n * fact(n - 1) }
    }
    result := fact(5)
    (result == 120)
}

# Test: recursive with multiple branches
test_recursion_branches :: () -> bool => {
    fib :: (n: i64) -> i64 => {
        if ((n <= 1)) {
            n
        } else {
            fib(n - 1) + fib(n - 2)
        }
    }
    result := fib(6)
    (result == 8)
}

# ============ FUNCTION AS VALUE (3 tests) ============

# Test: function stored in variable
test_func_as_value :: () -> bool => {
    add :: (x: i64, y: i64) -> i64 => { x + y }
    f := add
    result := f(10, 20)
    (result == 30)
}

# Test: function passed as argument concept
test_func_pass_concept :: () -> bool => {
    apply :: (x: i64, y: i64) -> i64 => { x + y }
    result := apply(15, 27)
    (result == 42)
}

# Test: function return concept
test_func_return_concept :: () -> bool => {
    get_adder :: () -> i64 => { 42 }
    result := get_adder()
    (result == 42)
}
