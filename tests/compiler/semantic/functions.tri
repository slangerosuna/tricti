# Function Type Checking Tests - 35 tests for function type validation
# Tests parameter matching, return types, generic functions, recursion, and higher-order patterns

# ============ PARAMETER TYPE MATCHING (10 tests) ============

# Test: single parameter type check
test_param_single :: () -> bool => do
    f :: (x: i64) -> i64 => do x }
    result := f(42)
    (result == 42)

# Test: two parameter type check
test_param_two :: () -> bool => do
    f :: (x: i64, y: i64) -> i64 => do x + y }
    result := f(10, 20)
    (result == 30)

# Test: three parameter type check
test_param_three :: () -> bool => do
    f :: (a: i64, b: i64, c: i64) -> i64 => do a + b + c }
    result := f(1, 2, 3)
    (result == 6)

# Test: mixed parameter types
test_param_mixed :: () -> bool => do
    f :: (x: i64, b: bool) -> i64 => do if (b) { x } else { 0 } }
    result := f(42, true)
    (result == 42)

# Test: string parameter
test_param_string :: () -> bool => do
    f :: (s: string) -> bool => do streq(s, "test") }
    result := f("test")
    result

# Test: bool parameter
test_param_bool :: () -> bool => do
    f :: (b: bool) -> bool => do b }
    result := f(true)
    result

# Test: f64 parameter
test_param_f64 :: () -> bool => do
    f :: (x: f64) -> f64 => do x }
    result := f(3.14)
    (result == 3.14)

# Test: multiple same-type parameters
test_param_same_type :: () -> bool => do
    f :: (a: i64, b: i64, c: i64, d: i64) -> i64 => do a + b + c + d }
    result := f(1, 2, 3, 4)
    (result == 10)

# Test: parameter with computation
test_param_compute :: () -> bool => do
    f :: (x: i64) -> i64 => do x * 2 }
    result := f(21)
    (result == 42)

# Test: parameter passing chain
test_param_chain :: () -> bool => do
    f :: (x: i64) -> i64 => do x }
    g :: (y: i64) -> i64 => do f(y) }
    result := g(42)
    (result == 42)

# ============ RETURN TYPE VALIDATION (10 tests) ============

# Test: i64 return type
test_return_i64 :: () -> bool => do
    f :: () -> i64 => do 42 }
    result := f()
    (result == 42)

# Test: bool return type
test_return_bool :: () -> bool => do
    f :: () -> bool => do true }
    result := f()
    result

# Test: string return type
test_return_string :: () -> bool => do
    f :: () -> string => do "test" }
    result := f()
    streq(result, "test")

# Test: f64 return type
test_return_f64 :: () -> bool => do
    f :: () -> f64 => do 2.71 }
    result := f()
    (result == 2.71)

# Test: return from if expression
test_return_if :: () -> bool => do
    f :: (x: bool) -> i64 => do if (x) { 1 } else { 0 } }
    result := f(true)
    (result == 1)

# Test: return from if-else chain
test_return_if_chain :: () -> bool => do
    f :: (x: i64) -> i64 => do
        if ((x == 0)) { 10 } else { if ((x == 1)) { 20 } else { 30 } }
    result := f(1)
    (result == 20)

# Test: return from computation
test_return_compute :: () -> bool => do
    f :: (x: i64, y: i64) -> i64 => do x * y }
    result := f(6, 7)
    (result == 42)

# Test: return type inference
test_return_infer :: () -> bool => do
    f :: (x: i64) -> i64 => do x + 1 }
    result := f(41)
    (result == 42)

# Test: nested return
test_return_nested :: () -> bool => do
    f :: () -> i64 => do { { 42 } } }
    result := f()
    (result == 42)

# Test: conditional return
test_return_conditional :: () -> bool => do
    f :: (x: i64) -> i64 => do if ((x > 0)) { x } else { 0 } }
    result := f(42)
    (result == 42)

# ============ GENERIC FUNCTION CALLS (8 tests) ============

# Test: generic with explicit type args
test_generic_explicit :: () -> bool => do
    id :: <T>(x: T) -> T => do x }
    result := id(42)
    (result == 42)

# Test: generic with inferred type args
test_generic_inferred :: () -> bool => do
    id :: <T>(x: T) -> T => do x }
    a := id(100)
    b := a
    (b == 100)

# Test: generic with two type params
test_generic_two_params :: () -> bool => do
    pair :: <A, B>(x: A, y: B) -> A => do x }
    result := pair(42, true)
    (result == 42)

# Test: generic with return type inference
test_generic_return_infer :: () -> bool => do
    get :: <T>(x: T) -> T => do x }
    result := get(99)
    check := result
    (check == 99)

# Test: generic function composition
test_generic_compose :: () -> bool => do
    id :: <T>(x: T) -> T => do x }
    result := id(id(42))
    (result == 42)

# Test: generic with different instantiations
test_generic_multi_inst :: () -> bool => do
    id :: <T>(x: T) -> T => do x }
    a := id(10)
    b := id(true)
    c := a
    d := b
    (c == 10) and d

# Test: generic parameter passing
test_generic_param_pass :: () -> bool => do
    id :: <T>(x: T) -> T => do x }
    use :: <T>(x: T) -> T => do id(x) }
    result := use(42)
    (result == 42)

# Test: generic with computation
test_generic_compute :: () -> bool => do
    double :: <T>(x: i64) -> i64 => do x * 2 }
    result := double(21)
    (result == 42)

# ============ RECURSION TYPE CHECKING (4 tests) ============

# Test: simple recursive function
test_recursion_simple :: () -> bool => do
    countdown :: (n: i64) -> i64 => do
        if ((n <= 0)) { 0 } else { countdown(n - 1) }
    result := countdown(5)
    (result == 0)

# Test: recursive with accumulator
test_recursion_accum :: () -> bool => do
    sum :: (n: i64, acc: i64) -> i64 => do
        if ((n <= 0)) { acc } else { sum(n - 1, acc + n) }
    result := sum(5, 0)
    (result == 15)

# Test: recursive factorial
test_recursion_factorial :: () -> bool => do
    fact :: (n: i64) -> i64 => do
        if ((n <= 1)) { 1 } else { n * fact(n - 1) }
    result := fact(5)
    (result == 120)

# Test: recursive with multiple branches
test_recursion_branches :: () -> bool => do
    fib :: (n: i64) -> i64 => do
        if n <= 1:
            n
        else:
            fib(n - 1) + fib(n - 2)
    result := fib(6)
    (result == 8)

# ============ FUNCTION AS VALUE (3 tests) ============

# Test: function stored in variable
test_func_as_value :: () -> bool => do
    add :: (x: i64, y: i64) -> i64 => do x + y }
    f := add
    result := f(10, 20)
    (result == 30)

# Test: function passed as argument concept
test_func_pass_concept :: () -> bool => do
    apply :: (x: i64, y: i64) -> i64 => do x + y }
    result := apply(15, 27)
    (result == 42)

# Test: function return concept
test_func_return_concept :: () -> bool => do
    get_adder :: () -> i64 => do 42 }
    result := get_adder()
    (result == 42)
