# Operator Type Checking Tests - 18 tests for operator type validation
# Tests arithmetic, comparison, logical, and bitwise operators with type checking

# ============ ARITHMETIC OPERATORS (6 tests) ============

# Test: addition with i64
test_add_i64 :: () -> bool => do
    result := 10 + 20
    x := result
    (x == 30)

# Test: subtraction with i64
test_sub_i64 :: () -> bool => do
    result := 50 - 20
    x := result
    (x == 30)

# Test: multiplication with i64
test_mul_i64 :: () -> bool => do
    result := 6 * 7
    x := result
    (x == 42)

# Test: division with i64
test_div_i64 :: () -> bool => do
    result := 84 / 2
    x := result
    (x == 42)

# Test: modulo with i64
test_mod_i64 :: () -> bool => do
    result := 43 % 10
    x := result
    (x == 3)

# Test: negation with i64
test_neg_i64 :: () -> bool => do
    result := -42
    x := result
    (x == -42)

# ============ COMPARISON OPERATORS (6 tests) ============

# Test: equality returns bool
test_eq_bool :: () -> bool => do
    result := (10 == 10)
    x := result
    x

# Test: inequality returns bool
test_neq_bool :: () -> bool => do
    result := (10 ~= 20)
    x := result
    x

# Test: greater than returns bool
test_gt_bool :: () -> bool => do
    result := (20 > 10)
    x := result
    x

# Test: less than returns bool
test_lt_bool :: () -> bool => do
    result := (10 < 20)
    x := result
    x

# Test: greater or equal returns bool
test_gte_bool :: () -> bool => do
    result := (20 >= 20)
    x := result
    x

# Test: less or equal returns bool
test_lte_bool :: () -> bool => do
    result := (10 <= 20)
    x := result
    x

# ============ LOGICAL OPERATORS (6 tests) ============

# Test: AND operator with bool
test_and_bool :: () -> bool => do
    result := (true and true)
    x := result
    x

# Test: OR operator with bool
test_or_bool :: () -> bool => do
    result := (false or true)
    x := result
    x

# Test: NOT operator with bool
test_not_bool :: () -> bool => do
    result := !false
    x := result
    x

# Test: complex AND expression
test_complex_and :: () -> bool => do
    result := (true and true and true)
    x := result
    x

# Test: complex OR expression
test_complex_or :: () -> bool => do
    result := (false or false or true)
    x := result
    x

# Test: mixed logical operators
test_mixed_logical :: () -> bool => do
    result := ((true and false) or true)
    x := result
    x
