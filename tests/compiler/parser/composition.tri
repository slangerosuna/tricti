# Compose & reactive pipeline parser tests
# Ensures the compiler can parse brace-free tables/dbs, trigger attributes without parens,
# and compose definitions using optional edges.

ParserEvents :: table
	@primary id: u64,
	payload: String,

ParserRuntime :: @resource struct
	counter: u64,

ParserDatabase :: db
	Events: ParserEvents,
	Runtime: ParserRuntime,

PipelineTick :: Signal<Mpsc, Buffer, none>

fetch_event :: sys (
	@sys_input raw: String,
) -> !?String => do
	ret ok some raw

decode_event :: sys (
	@sys_input raw: String,
) -> !String => do
	ret ok raw

finalize_event :: sys (
	@sys_input value: String,
) -> !none => do
	println(value)
	ret ok none

@trigger PipelineTick, ParserDatabase
parser_pipeline :: compose
	fetch_event ?-> decode_event -> finalize_event

# Dummy test to keep harness happy
parser_compose_smoke :: () -> bool => do true
