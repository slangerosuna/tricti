# Operator Tests - 110+ tests for all operators and precedence
# Tests arithmetic, logical, comparison, bitwise, unary operators and precedence rules

# ============ ARITHMETIC OPERATORS (25 tests) ============

# Test: addition
test_op_add :: () -> i64 => { 10 + 20 }

# Test: subtraction
test_op_sub :: () -> i64 => { 30 - 10 }

# Test: multiplication
test_op_mul :: () -> i64 => { 5 * 6 }

# Test: division
test_op_div :: () -> i64 => { 20 / 4 }

# Test: modulo
test_op_mod :: () -> i64 => { 17 % 5 }

# Test: chained addition
test_op_add_chain :: () -> i64 => { 1 + 2 + 3 + 4 }

# Test: chained subtraction
test_op_sub_chain :: () -> i64 => { 100 - 10 - 5 - 3 }

# Test: chained multiplication
test_op_mul_chain :: () -> i64 => { 2 * 3 * 4 }

# Test: chained division
test_op_div_chain :: () -> i64 => { 100 / 2 / 5 }

# Test: mixed arithmetic
test_op_mixed :: () -> i64 => { 10 + 20 - 5 * 2 / 1 }

# Test: element-wise multiplication
test_op_elemwise_mul :: () => { x .* y }

# Test: element-wise division
test_op_elemwise_div :: () => { x ./ y }

# Test: element-wise modulo
test_op_elemwise_mod :: () => { x .% y }

# Test: backslash operator
test_op_backslash :: () => { x \ y }

# Test: addition with variables
test_op_add_var :: () -> i64 => {
    a := 10
    b := 20
    a + b
}

# Test: subtraction with variables
test_op_sub_var :: () -> i64 => {
    a := 30
    b := 10
    a - b
}

# Test: multiplication with variables
test_op_mul_var :: () -> i64 => {
    a := 5
    b := 6
    a * b
}

# Test: division with variables
test_op_div_var :: () -> i64 => {
    a := 20
    b := 4
    a / b
}

# Test: modulo with variables
test_op_mod_var :: () -> i64 => {
    a := 17
    b := 5
    a % b
}

# Test: complex arithmetic expression
test_op_complex_arith :: () -> i64 => { 2 + 3 * 4 - 10 / 2 }

# Test: arithmetic with parentheses
test_op_arith_parens :: () -> i64 => { (2 + 3) * (4 - 1) }

# Test: nested arithmetic
test_op_nested_arith :: () -> i64 => { ((10 + 20) * 3) / 2 }

# Test: arithmetic with negative
test_op_arith_negative :: () -> i64 => { 10 + -5 }

# Test: all arithmetic operators together
test_op_all_arith :: () -> i64 => { 100 + 50 - 20 * 2 / 4 % 3 }

# Test: float arithmetic
test_op_float_arith :: () -> f64 => { 1.5 + 2.5 * 3.0 }


# ============ COMPARISON OPERATORS (20 tests) ============

# Test: equality
test_op_eq :: () -> bool => { (10 == 10) }

# Test: approximate equality
test_op_approx_eq :: () -> bool => { (3.14 ~= 3.14) }

# Test: less than
test_op_lt :: () -> bool => { (5 < 10) }

# Test: greater than
test_op_gt :: () -> bool => { (10 > 5) }

# Test: less than or equal
test_op_le :: () -> bool => { (5 <= 10) }

# Test: greater than or equal
test_op_ge :: () -> bool => { (10 >= 5) }

# Test: equality with variables
test_op_eq_var :: () -> bool => {
    a := 10
    b := 10
    (a == b)
}

# Test: inequality chain
test_op_ineq_chain :: () -> bool => { (1 < 2) && (2 < 3) }

# Test: comparison with arithmetic
test_op_cmp_arith :: () -> bool => { (10 + 5 > 12) }

# Test: multiple comparisons
test_op_multi_cmp :: () -> bool => { (5 < 10) && (10 < 20) }

# Test: comparison with parentheses
test_op_cmp_parens :: () -> bool => { ((5 + 5) == 10) }

# Test: float comparison
test_op_float_cmp :: () -> bool => { (3.14 > 2.0) }

# Test: bool equality
test_op_bool_eq :: () -> bool => { (true == true) }

# Test: less than chain
test_op_lt_multi :: () -> bool => { (1 < 2) && (2 < 3) && (3 < 4) }

# Test: greater than chain
test_op_gt_multi :: () -> bool => { (10 > 5) && (5 > 1) }

# Test: mixed comparison operators
test_op_mixed_cmp :: () -> bool => { (5 < 10) && (10 >= 10) && (10 <= 10) }

# Test: comparison in variable
test_op_cmp_var_assign :: () -> bool => {
    result := (42 == 42)
    result
}

# Test: nested comparison
test_op_nested_cmp :: () -> bool => { ((5 + 5) == (3 + 7)) }

# Test: comparison with negative
test_op_cmp_negative :: () -> bool => { (-5 < 0) }

# Test: string comparison (if supported)
test_op_cmp_in_if :: () -> i64 => {
    if (10 > 5) {
        ret 1
    }
    0
}


# ============ LOGICAL OPERATORS (20 tests) ============

# Test: logical and
test_op_and :: () -> bool => { true && true }

# Test: logical or
test_op_or :: () -> bool => { true || false }

# Test: logical and with word
test_op_and_word :: () -> bool => { true and true }

# Test: logical or with word
test_op_or_word :: () -> bool => { true or false }

# Test: logical xor
test_op_xor :: () -> bool => { true xor false }

# Test: negation
test_op_not :: () -> bool => { !false }

# Test: chained and
test_op_and_chain :: () -> bool => { true && true && true }

# Test: chained or
test_op_or_chain :: () -> bool => { false || false || true }

# Test: mixed and or
test_op_mixed_logical :: () -> bool => { true && false || true }

# Test: and with variables
test_op_and_var :: () -> bool => {
    a := true
    b := false
    a && b
}

# Test: or with variables
test_op_or_var :: () -> bool => {
    a := true
    b := false
    a || b
}

# Test: not with variable
test_op_not_var :: () -> bool => {
    a := true
    !a
}

# Test: complex logical expression
test_op_complex_logical :: () -> bool => { (true && false) || (true && true) }

# Test: logical with comparison
test_op_logical_cmp :: () -> bool => { (5 < 10) && (10 < 20) }

# Test: double negation (using separate expression)
test_op_double_not :: () -> bool => { !(!true) }

# Test: and or precedence
test_op_and_or_prec :: () -> bool => { false || true && true }

# Test: logical in if condition
test_op_logical_if :: () -> i64 => {
    if (true && true) {
        ret 1
    }
    0
}

# Test: nested logical
test_op_nested_logical :: () -> bool => { ((true && false) || true) && true }

# Test: logical with parentheses
test_op_logical_parens :: () -> bool => { (true || false) && (false || true) }

# Test: all logical operators
test_op_all_logical :: () -> bool => { (true and false) or (true xor false) }


# ============ BITWISE OPERATORS (15 tests) ============

# Test: bitwise left shift
test_op_shl :: () -> i64 => { 1 << 3 }

# Test: bitwise right shift
test_op_shr :: () -> i64 => { 8 >> 2 }

# Test: bitwise and
test_op_bitand :: () -> i64 => { 5 & 3 }

# Test: bitwise or
test_op_bitor :: () -> i64 => { 5 | 3 }

# Test: bitwise xor
test_op_bitxor :: () -> i64 => { 5 ^ 3 }

# Test: bitwise not (complement)
test_op_bitnot :: () -> i64 => { ~5 }

# Test: chained shifts
test_op_shift_chain :: () -> i64 => { 1 << 2 << 1 }

# Test: shift with variables
test_op_shift_var :: () -> i64 => {
    a := 4
    b := 1
    a << b
}

# Test: bitwise and with variables
test_op_bitand_var :: () -> i64 => {
    a := 12
    b := 10
    a & b
}

# Test: bitwise or with variables
test_op_bitor_var :: () -> i64 => {
    a := 12
    b := 10
    a | b
}

# Test: complex bitwise expression
test_op_complex_bitwise :: () -> i64 => { (5 & 3) | (2 ^ 4) }

# Test: bitwise with arithmetic
test_op_bitwise_arith :: () -> i64 => { (2 << 3) + 1 }

# Test: nested bitwise
test_op_nested_bitwise :: () -> i64 => { ((8 >> 1) & 7) | 1 }

# Test: bitwise in variable
test_op_bitwise_var :: () -> i64 => {
    result := 5 & 3
    result
}

# Test: all bitwise operators
test_op_all_bitwise :: () -> i64 => { ((5 & 3) | (2 ^ 1)) << 1 }


# ============ UNARY OPERATORS (15 tests) ============

# Test: unary minus
test_op_unary_minus :: () -> i64 => { -42 }

# Test: unary not
test_op_unary_not :: () -> bool => { !true }

# Test: unary bitwise not
test_op_unary_bitnot :: () -> i64 => { ~10 }

# Test: reference operator
test_op_unary_ref :: () => { &x }

# Test: mutable reference
test_op_unary_mut_ref :: () => { &mut x }

# Test: dereference operator
test_op_unary_deref :: () => { *ptr }

# Test: some operator
test_op_unary_some :: () => { some value }

# Test: double unary minus (using separate expression)
test_op_double_minus :: () -> i64 => { -(-5) }

# Test: unary with expression
test_op_unary_expr :: () -> i64 => { -(10 + 5) }

# Test: unary in variable
test_op_unary_var :: () -> i64 => {
    x := -42
    x
}

# Test: multiple unary operators
test_op_multi_unary :: () -> bool => { !(!true) }

# Test: unary not in expression
test_op_unary_not_expr :: () -> bool => { !(5 > 10) }

# Test: unary minus with multiplication
test_op_unary_mul :: () -> i64 => { -5 * 3 }

# Test: unary in complex expression
test_op_unary_complex :: () -> i64 => { -10 + 20 - -5 }

# Test: unary bitwise in expression
test_op_unary_bitwise_expr :: () -> i64 => { ~(5 & 3) }


# ============ OPERATOR PRECEDENCE (15 tests) ============

# Test: multiplication before addition
test_prec_mul_add :: () -> i64 => { 2 + 3 * 4 }

# Test: division before subtraction
test_prec_div_sub :: () -> i64 => { 20 - 10 / 2 }

# Test: parentheses override precedence
test_prec_parens :: () -> i64 => { (2 + 3) * 4 }

# Test: nested parentheses
test_prec_nested_parens :: () -> i64 => { ((2 + 3) * 4) - 1 }

# Test: and before or
test_prec_and_or :: () -> bool => { false || true && true }

# Test: comparison before and
test_prec_cmp_and :: () -> bool => { (5 < 10) && (10 < 20) }

# Test: arithmetic before comparison
test_prec_arith_cmp :: () -> bool => { (2 + 3 > 4) }

# Test: shift before addition
test_prec_shift_add :: () -> i64 => { 1 + 2 << 3 }

# Test: unary before binary
test_prec_unary_binary :: () -> i64 => { -5 + 10 }

# Test: complex precedence
test_prec_complex :: () -> i64 => { 2 + 3 * 4 - 10 / 2 }

# Test: all precedence levels
test_prec_all_levels :: () -> bool => { (2 + 3 * 4 > 10) && (5 < 10) }

# Test: bitwise and arithmetic precedence
test_prec_bitwise_arith :: () -> i64 => { 2 + 3 & 7 }

# Test: precedence with variables
test_prec_with_vars :: () -> i64 => {
    a := 2
    b := 3
    c := 4
    a + b * c
}

# Test: multiple precedence levels
test_prec_multi_level :: () -> i64 => { 1 + 2 * 3 - 4 / 2 }

# Test: precedence chain
test_prec_chain :: () -> i64 => { 10 + 20 * 2 - 15 / 3 + 1 }
