# Expression Tests - 55+ tests for complex expressions
# Tests nested expressions, call chains, field access, array indexing, and mixed patterns

# ============ NESTED EXPRESSIONS (15 tests) ============

# Test: deeply nested parentheses
test_expr_nested_parens :: () -> i64 => do (((10 + 20) * 3) - 5) }

# Test: complex arithmetic nesting
test_expr_complex_arith :: () -> i64 => do ((10 + 20) * (30 - 15)) / 5 }

# Test: nested logical expressions
test_expr_nested_logical :: () -> bool => do ((true and false) or (true and true)) }

# Test: nested comparison
test_expr_nested_cmp :: () -> bool => do (((5 + 5) == 10) and ((3 * 3) == 9)) }

# Test: nested function calls
test_expr_nested_calls :: () => do outer(inner(value)) }

# Test: triple nested calls
test_expr_triple_nested :: () => do a(b(c(d()))) }

# Test: nested with operators
test_expr_nested_ops :: () -> i64 => do (10 + (20 * (30 - 5))) }

# Test: nested match expressions
test_expr_nested_match :: () -> i64 => do
    x := 1
    match x:
        value => do
            y := 2
            match y:
                inner => 100

# Test: nested if expressions
test_expr_nested_if :: () -> i64 => do
    if true:
        if true:
            ret 1
    0

# Test: nested blocks
test_expr_nested_blocks :: () -> i64 => do
        x := 10
            y := 20
                z := 30
                x + y + z

# Test: deeply nested arithmetic
test_expr_deep_arith :: () -> i64 => do 1 + (2 + (3 + (4 + 5))) }

# Test: nested with all operators
test_expr_all_nested :: () -> i64 => do ((10 + 20) * 3 - (40 / 2)) }

# Test: nested bitwise operations
test_expr_nested_bitwise :: () -> i64 => do ((5 & 3) | (2 ^ 4)) << 1 }

# Test: nested with negation
test_expr_nested_negation :: () -> i64 => do -(-(10)) }

# Test: complex nested expression
test_expr_super_nested :: () -> i64 => do (((1 + 2) * (3 + 4)) - ((5 - 3) * 2)) }


# ============ FIELD ACCESS (10 tests) ============

# Test: simple field access
test_expr_field :: () => do obj.field }

# Test: chained field access
test_expr_field_chain :: () => do obj.field1.field2 }

# Test: triple field chain
test_expr_field_triple :: () => do obj.a.b.c }

# Test: long field chain
test_expr_field_long :: () => do root.module.component.value }

# Test: field access with method call
test_expr_field_method :: () => do obj.field.method() }

# Test: field access on result
test_expr_field_result :: () => do compute().field }

# Test: nested field and method
test_expr_field_nested :: () => do obj.get_inner().value }

# Test: field access in expression
test_expr_field_in_expr :: () => do obj.x + obj.y }

# Test: field access with index
test_expr_field_index :: () => do obj.array[0] }

# Test: complex field chain
test_expr_field_complex :: () => do root.module.get_data().items[0].value }


# ============ ARRAY INDEXING (10 tests) ============

# Test: simple array index
test_expr_index :: () => do arr[0] }

# Test: multiple indices
test_expr_index_multi :: () => do arr[0, 1] }

# Test: nested array indexing
test_expr_index_nested :: () => do matrix[0][1] }

# Test: triple nested indexing
test_expr_index_triple :: () => do cube[0][1][2] }

# Test: index with expression
test_expr_index_expr :: () => do arr[i + 1] }

# Test: index on result
test_expr_index_result :: () => do get_array()[0] }

# Test: index with field access
test_expr_index_field :: () => do obj.array[0] }

# Test: chained index and field
test_expr_index_field_chain :: () => do arr[0].field }

# Test: complex indexing
test_expr_index_complex :: () => do matrix[i][j].value }

# Test: index with trailing comma
test_expr_index_trailing :: () => do arr[0,] }


# ============ CALL EXPRESSIONS (10 tests) ============

# Test: simple function call
test_expr_call :: () => do function() }

# Test: call with one argument
test_expr_call_one_arg :: () => do function(42) }

# Test: call with multiple arguments
test_expr_call_multi :: () => do function(1, 2, 3) }

# Test: call with trailing comma
test_expr_call_trailing :: () => do function(1, 2,) }

# Test: chained calls
test_expr_call_chain :: () => do obj.method1().method2() }

# Test: call with named argument
test_expr_call_named :: () => do function(x: 42) }

# Test: call with mixed arguments
test_expr_call_mixed :: () => do function(x: 1, 2, z: 3) }

# Test: call with complex arguments
test_expr_call_complex :: () => do function(a + b, c * d) }

# Test: nested calls in arguments
test_expr_call_nested_args :: () => do outer(inner(value), other()) }

# Test: call with type arguments
test_expr_call_type_args :: () => do function<i64>(42) }


# ============ MIXED EXPRESSIONS (10 tests) ============

# Test: field access and indexing
test_expr_mixed_field_index :: () => do obj.array[0] }

# Test: call and field access
test_expr_mixed_call_field :: () => do get_obj().field }

# Test: call and indexing
test_expr_mixed_call_index :: () => do get_array()[0] }

# Test: all three combined
test_expr_mixed_all :: () => do get_obj().array[0] }

# Test: complex mixed expression
test_expr_mixed_complex :: () => do obj.method().data[i].value }

# Test: arithmetic with calls
test_expr_mixed_arith_call :: () => do compute() + calculate() }

# Test: comparison with field access
test_expr_mixed_cmp_field :: () -> bool => do (obj.value > 10) }

# Test: logical with calls
test_expr_mixed_logical_call :: () -> bool => do check() and verify() }

# Test: nested mixed expression
test_expr_mixed_nested :: () => do obj.get_data()[0].items.len() }

# Test: super complex mixed
test_expr_mixed_super :: () => do root.module.get_items()[idx].process().result }
