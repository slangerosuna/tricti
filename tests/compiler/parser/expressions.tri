# Expression Tests - 55+ tests for complex expressions
# Tests nested expressions, call chains, field access, array indexing, and mixed patterns

# ============ NESTED EXPRESSIONS (15 tests) ============

# Test: deeply nested parentheses
test_expr_nested_parens :: () -> i64 => { (((10 + 20) * 3) - 5) }

# Test: complex arithmetic nesting
test_expr_complex_arith :: () -> i64 => { ((10 + 20) * (30 - 15)) / 5 }

# Test: nested logical expressions
test_expr_nested_logical :: () -> bool => { ((true && false) || (true && true)) }

# Test: nested comparison
test_expr_nested_cmp :: () -> bool => { (((5 + 5) == 10) && ((3 * 3) == 9)) }

# Test: nested function calls
test_expr_nested_calls :: () => { outer(inner(value)) }

# Test: triple nested calls
test_expr_triple_nested :: () => { a(b(c(d()))) }

# Test: nested with operators
test_expr_nested_ops :: () -> i64 => { (10 + (20 * (30 - 5))) }

# Test: nested match expressions
test_expr_nested_match :: () -> i64 => {
    x := 1
    match x {
        value => {
            y := 2
            match y {
                inner => 100
            }
        }
    }
}

# Test: nested if expressions
test_expr_nested_if :: () -> i64 => {
    if true {
        if true {
            ret 1
        }
    }
    0
}

# Test: nested blocks
test_expr_nested_blocks :: () -> i64 => {
    {
        x := 10
        {
            y := 20
            {
                z := 30
                x + y + z
            }
        }
    }
}

# Test: deeply nested arithmetic
test_expr_deep_arith :: () -> i64 => { 1 + (2 + (3 + (4 + 5))) }

# Test: nested with all operators
test_expr_all_nested :: () -> i64 => { ((10 + 20) * 3 - (40 / 2)) }

# Test: nested bitwise operations
test_expr_nested_bitwise :: () -> i64 => { ((5 & 3) | (2 ^ 4)) << 1 }

# Test: nested with negation
test_expr_nested_negation :: () -> i64 => { -(-(10)) }

# Test: complex nested expression
test_expr_super_nested :: () -> i64 => { (((1 + 2) * (3 + 4)) - ((5 - 3) * 2)) }


# ============ FIELD ACCESS (10 tests) ============

# Test: simple field access
test_expr_field :: () => { obj.field }

# Test: chained field access
test_expr_field_chain :: () => { obj.field1.field2 }

# Test: triple field chain
test_expr_field_triple :: () => { obj.a.b.c }

# Test: long field chain
test_expr_field_long :: () => { root.module.component.value }

# Test: field access with method call
test_expr_field_method :: () => { obj.field.method() }

# Test: field access on result
test_expr_field_result :: () => { compute().field }

# Test: nested field and method
test_expr_field_nested :: () => { obj.get_inner().value }

# Test: field access in expression
test_expr_field_in_expr :: () => { obj.x + obj.y }

# Test: field access with index
test_expr_field_index :: () => { obj.array[0] }

# Test: complex field chain
test_expr_field_complex :: () => { root.module.get_data().items[0].value }


# ============ ARRAY INDEXING (10 tests) ============

# Test: simple array index
test_expr_index :: () => { arr[0] }

# Test: multiple indices
test_expr_index_multi :: () => { arr[0, 1] }

# Test: nested array indexing
test_expr_index_nested :: () => { matrix[0][1] }

# Test: triple nested indexing
test_expr_index_triple :: () => { cube[0][1][2] }

# Test: index with expression
test_expr_index_expr :: () => { arr[i + 1] }

# Test: index on result
test_expr_index_result :: () => { get_array()[0] }

# Test: index with field access
test_expr_index_field :: () => { obj.array[0] }

# Test: chained index and field
test_expr_index_field_chain :: () => { arr[0].field }

# Test: complex indexing
test_expr_index_complex :: () => { matrix[i][j].value }

# Test: index with trailing comma
test_expr_index_trailing :: () => { arr[0,] }


# ============ CALL EXPRESSIONS (10 tests) ============

# Test: simple function call
test_expr_call :: () => { function() }

# Test: call with one argument
test_expr_call_one_arg :: () => { function(42) }

# Test: call with multiple arguments
test_expr_call_multi :: () => { function(1, 2, 3) }

# Test: call with trailing comma
test_expr_call_trailing :: () => { function(1, 2,) }

# Test: chained calls
test_expr_call_chain :: () => { obj.method1().method2() }

# Test: call with named argument
test_expr_call_named :: () => { function(x: 42) }

# Test: call with mixed arguments
test_expr_call_mixed :: () => { function(x: 1, 2, z: 3) }

# Test: call with complex arguments
test_expr_call_complex :: () => { function(a + b, c * d) }

# Test: nested calls in arguments
test_expr_call_nested_args :: () => { outer(inner(value), other()) }

# Test: call with type arguments
test_expr_call_type_args :: () => { function<i64>(42) }


# ============ MIXED EXPRESSIONS (10 tests) ============

# Test: field access and indexing
test_expr_mixed_field_index :: () => { obj.array[0] }

# Test: call and field access
test_expr_mixed_call_field :: () => { get_obj().field }

# Test: call and indexing
test_expr_mixed_call_index :: () => { get_array()[0] }

# Test: all three combined
test_expr_mixed_all :: () => { get_obj().array[0] }

# Test: complex mixed expression
test_expr_mixed_complex :: () => { obj.method().data[i].value }

# Test: arithmetic with calls
test_expr_mixed_arith_call :: () => { compute() + calculate() }

# Test: comparison with field access
test_expr_mixed_cmp_field :: () -> bool => { (obj.value > 10) }

# Test: logical with calls
test_expr_mixed_logical_call :: () -> bool => { check() && verify() }

# Test: nested mixed expression
test_expr_mixed_nested :: () => { obj.get_data()[0].items.len() }

# Test: super complex mixed
test_expr_mixed_super :: () => { root.module.get_items()[idx].process().result }
