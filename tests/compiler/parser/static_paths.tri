test_static_option_bool_none :: () => { Option<bool>::None }

# Test: Result<i64, bool>::Ok
test_static_result_ok_typed :: () => { Result<i64, bool>::Ok(100) }

# Test: Result<i64, bool>::Err
test_static_result_err_typed :: () => { Result<i64, bool>::Err(false) }

# Test: Box<i64>::new
test_static_box_i64_new :: () => { Box<i64>::new(42) }

# Test: Rc<MyType>::new
test_static_rc_typed_new :: () => { Rc<MyType>::new(value) }

# Test: Arc<Data>::new
test_static_arc_typed_new :: () => { Arc<Data>::new(data) }

# Test: HashMap<i64, bool>::new
test_static_hashmap_typed_new :: () => { HashMap<i64, bool>::new() }

# Test: generic with custom type
test_static_generic_custom :: () => { Container<MyType>::new() }

# Test: multiple type arguments
test_static_multi_typeargs :: () => { Pair<i64, bool>::new(1, true) }

# Test: nested generic type arguments
test_static_nested_generic :: () => { Vec<Vec<i64>>::new() }


# ============ CHAINED STATIC PATHS (10 tests) ============

# Test: two-level path
test_static_path_two_level :: () => { std::vec::new() }

# Test: three-level path
test_static_path_three_level :: () => { std::collections::vec::new() }

# Test: path with Vec
test_static_path_vec :: () => { std::vec::Vec::new() }

# Test: path with HashMap
test_static_path_hashmap :: () => { std::collections::HashMap::new() }

# Test: path with generic
test_static_path_generic :: () => { std::vec::Vec<i64>::new() }

# Test: long path
test_static_path_long :: () => { root::module::submodule::Type::method() }

# Test: path to enum variant
test_static_path_enum :: () => { std::option::Option::Some(42) }

# Test: path to result
test_static_path_result :: () => { std::result::Result::Ok(100) }

# Test: path with multiple modules
test_static_path_modules :: () => { crate::types::MyType::new() }

# Test: path with self
test_static_path_self :: () => { self::Type::method() }


# ============ STATIC PATHS IN MATCH (10 tests) ============

# Test: Option::Some in match pattern
test_static_match_option_some :: () => {
    x := Option::Some(42)
    match x {
        Option::Some => 1
        Option::None => 0
    }
}

# Test: Option::None in match pattern
test_static_match_option_none :: () => {
    x := Option::None
    match x {
        Option::None => 1
        Option::Some => 0
    }
}

# Test: Result::Ok in match
test_static_match_result_ok :: () => {
    x := Result::Ok(100)
    match x {
        Result::Ok => 1
        Result::Err => 0
    }
}

# Test: Result::Err in match
test_static_match_result_err :: () => {
    x := Result::Err(false)
    match x {
        Result::Err => 1
        Result::Ok => 0
    }
}

# Test: multiple enum variants in match
test_static_match_multi :: () => {
    x := Status::Active
    match x {
        Status::Active => 1
        Status::Inactive => 2
        Status::Pending => 3
    }
}

# Test: nested match with static paths
test_static_match_nested :: () => {
    x := Option::Some(Result::Ok(42))
    match x {
        Option::Some => 1
        Option::None => 0
    }
}

# Test: match with path and value
test_static_match_with_value :: () => {
    x := Option::Some(42)
    match x {
        Option::Some => 1
        Option::None => 0
    }
}

# Test: match with generic static path
test_static_match_generic :: () => {
    x := Option<i64>::Some(42)
    match x {
        Option::Some => 1
        Option::None => 0
    }
}

# Test: match with chained path
test_static_match_chained :: () => {
    x := std::option::Option::Some(42)
    match x {
        Option::Some => 1
        Option::None => 0
    }
}

# Test: complex match with multiple patterns
test_static_match_complex :: () => {
    x := Result::Ok(42)
    match x {
        Result::Ok => 1
        Result::Err => 0
    }
}


# ============ STATIC PATHS IN VARIABLES (5 tests) ============

# Test: static path in variable assignment
test_static_var_assign :: () => {
    v := Vec::new()
    v
}

# Test: generic static path in variable
test_static_var_generic :: () => {
    v := Vec<i64>::new()
    v
}

# Test: enum variant in variable
test_static_var_enum :: () => {
    opt := Option::Some(42)
    opt
}

# Test: result in variable
test_static_var_result :: () => {
    res := Result::Ok(100)
    res
}

# Test: multiple static paths in variables
test_static_var_multiple :: () => {
    a := Vec::new()
    b := Option::None
    c := Result::Ok(1)
    c
}


