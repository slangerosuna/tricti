test_static_result_ok_typed :: () => do Result<i64, bool>::Ok(100) }

# Test: Result<i64, bool>::Err
test_static_result_err_typed :: () => do Result<i64, bool>::Err(false) }

# Test: Box<i64>::new
test_static_box_i64_new :: () => do Box<i64>::new(42) }

