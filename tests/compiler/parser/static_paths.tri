test_static_arc_typed_new :: () => do Arc<Data>::new(data) }

# Test: HashMap<i64, bool>::new
test_static_hashmap_typed_new :: () => do HashMap<i64, bool>::new() }

# Test: generic with custom type
test_static_generic_custom :: () => do Container<MyType>::new() }

# Test: multiple type arguments
test_static_multi_typeargs :: () => do Pair<i64, bool>::new(1, true) }

# Test: nested generic type arguments
test_static_nested_generic :: () => do Vec<Vec<i64>>::new() }


# ============ CHAINED STATIC PATHS (10 tests) ============

# Test: two-level path
test_static_path_two_level :: () => do std::vec::new() }

# Test: three-level path
test_static_path_three_level :: () => do std::collections::vec::new() }

# Test: path with Vec
test_static_path_vec :: () => do std::vec::Vec::new() }

# Test: path with HashMap
test_static_path_hashmap :: () => do std::collections::HashMap::new() }

# Test: path with generic
test_static_path_generic :: () => do std::vec::Vec<i64>::new() }

# Test: long path
test_static_path_long :: () => do root::module::submodule::Type::method() }

# Test: path to enum variant
test_static_path_enum :: () => do std::option::Option::Some(42) }

# Test: path to result
test_static_path_result :: () => do std::result::Result::Ok(100) }

# Test: path with multiple modules
test_static_path_modules :: () => do crate::types::MyType::new() }

# Test: path with self
test_static_path_self :: () => do self::Type::method() }


# ============ STATIC PATHS IN MATCH (10 tests) ============

# Test: Option::Some in match pattern
test_static_match_option_some :: () => do
    x := Option::Some(42)
    match x:
        Option::Some => 1
        Option::None => 0

# Test: Option::None in match pattern
test_static_match_option_none :: () => do
    x := Option::None
    match x:
        Option::None => 1
        Option::Some => 0

# Test: Result::Ok in match
test_static_match_result_ok :: () => do
    x := Result::Ok(100)
    match x:
        Result::Ok => 1
        Result::Err => 0

# Test: Result::Err in match
test_static_match_result_err :: () => do
    x := Result::Err(false)
    match x:
        Result::Err => 1
        Result::Ok => 0

# Test: multiple enum variants in match
test_static_match_multi :: () => do
    x := Status::Active
    match x:
        Status::Active => 1
        Status::Inactive => 2
        Status::Pending => 3

# Test: nested match with static paths
test_static_match_nested :: () => do
    x := Option::Some(Result::Ok(42))
    match x:
        Option::Some => 1
        Option::None => 0

# Test: match with path and value
test_static_match_with_value :: () => do
    x := Option::Some(42)
    match x:
        Option::Some => 1
        Option::None => 0

# Test: match with generic static path
test_static_match_generic :: () => do
    x := Option<i64>::Some(42)
    match x:
        Option::Some => 1
        Option::None => 0

# Test: match with chained path
test_static_match_chained :: () => do
    x := std::option::Option::Some(42)
    match x:
        Option::Some => 1
        Option::None => 0

# Test: complex match with multiple patterns
test_static_match_complex :: () => do
    x := Result::Ok(42)
    match x:
        Result::Ok => 1
        Result::Err => 0


# ============ STATIC PATHS IN VARIABLES (5 tests) ============

# Test: static path in variable assignment
test_static_var_assign :: () => do
    v := Vec::new()
    v

# Test: generic static path in variable
test_static_var_generic :: () => do
    v := Vec<i64>::new()
    v

# Test: enum variant in variable
test_static_var_enum :: () => do
    opt := Option::Some(42)
    opt

# Test: result in variable
test_static_var_result :: () => do
    res := Result::Ok(100)
    res

# Test: multiple static paths in variables
test_static_var_multiple :: () => do
    a := Vec::new()
    b := Option::None
    c := Result::Ok(1)
    c


# ============ CHAINED STATIC PATHS (15 tests) ============

# Test: multi-segment path to HashMap
test_chained_hashmap :: () => do 
    std::collections::HashMap::new() 

# Test: chained path with type arguments
test_chained_with_generics :: () => do 
    std::collections::HashMap<String, i64>::new() 

# Test: deep path nesting
test_chained_deep :: () => do 
    a::b::c::d::E::f() 

# Test: chained path to Vec
test_chained_vec :: () => do 
    std::collections::Vec::new() 

# Test: chained path with complex generics
test_chained_complex_generic :: () => do 
    std::collections::HashMap<String, Vec<i64>>::new() 

# Test: chained path to BTreeMap
test_chained_btreemap :: () => do 
    std::collections::BTreeMap::new() 

# Test: chained path with nested Option
test_chained_nested_option :: () => do 
    std::option::Option<Vec<i64>>::Some(v) 

# Test: chained path to Result
test_chained_result :: () => do 
    std::result::Result<i64, bool>::Ok(42) 

# Test: chained crate path
test_chained_crate :: () => do 
    crate::types::custom::MyType::new() 

# Test: chained self path
test_chained_self :: () => do 
    self::module::Type::method() 

# Test: very deep chained path
test_chained_very_deep :: () => do 
    root::level1::level2::level3::level4::Type::new() 

# Test: chained path with multiple generics
test_chained_multi_generic :: () => do 
    std::collections::HashMap<i64, Result<bool, String>>::new() 

# Test: chained path followed by method call
test_chained_then_method :: () => do 
    v := Vec::new()
    v

# Test: chained enum variant path
test_chained_enum :: () => do 
    std::option::Option::None 

# Test: chained path in variable
test_chained_var :: () => do 
    map := std::collections::HashMap<i64, bool>::new()
    map
