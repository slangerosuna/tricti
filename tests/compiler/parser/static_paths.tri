# Static Path Tests - 55+ tests for static paths and method calls
# Tests Type::method(), Type<T>::method(), Enum::Variant, and chained paths

# ============ SIMPLE STATIC PATHS (15 tests) ============

# Test: Vec::new static call
test_static_vec_new :: () => do Vec::new() }

# Test: Option::None variant
test_static_option_none :: () => do Option::None }

# Test: Option::Some variant with value
test_static_option_some :: () => do Option::Some(42) }

# Test: Result::Ok variant
test_static_result_ok :: () => do Result::Ok(100) }

# Test: Result::Err variant
test_static_result_err :: () => do Result::Err(false) }

# Test: String::new
test_static_string_new :: () => do String::new() }

# Test: Box::new
test_static_box_new :: () => do Box::new(42) }

# Test: Rc::new
test_static_rc_new :: () => do Rc::new(value) }

# Test: Arc::new
test_static_arc_new :: () => do Arc::new(data) }

# Test: Cell::new
test_static_cell_new :: () => do Cell::new(10) }

# Test: RefCell::new
test_static_refcell_new :: () => do RefCell::new(true) }

# Test: Mutex::new
test_static_mutex_new :: () => do Mutex::new(state) }

# Test: HashMap::new
test_static_hashmap_new :: () => do HashMap::new() }

# Test: HashSet::new
test_static_hashset_new :: () => do HashSet::new() }

# Test: BTreeMap::new
test_static_btreemap_new :: () => do BTreeMap::new() }


