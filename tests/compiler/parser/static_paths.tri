# Test: chained path followed by method call
test_chained_then_method :: () => { 
    v := Vec::new()
    v
}

# Test: chained enum variant path
test_chained_enum :: () => { 
    std::option::Option::None 
}

# Test: chained path in variable
test_chained_var :: () => { 
