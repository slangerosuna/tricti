# Invalid Function Tests
# These tests contain invalid function syntax that should fail to parse

# INVALID: function without arrow
# test_invalid_fn_no_arrow :: () { 42 }

# INVALID: function with mismatched braces
# test_invalid_fn_mismatch_brace :: () => { 42 }}

# INVALID: function with invalid parameter
# test_invalid_fn_param :: (,) => { x }

# INVALID: function with duplicate parameters
# test_invalid_fn_dup_param :: (x: i64, x: i64) => { x }

# INVALID: async without function
# test_invalid_async :: async 42

# INVALID: type parameter without brackets
# test_invalid_type_param_no_brackets :: T() => { x }

# INVALID: function with only comma in params
# test_invalid_fn_only_comma :: (,) => { x }

# INVALID: return type without arrow
# test_invalid_return_no_arrow :: () i64 => { 42 }

# INVALID: const without value
# test_invalid_const_no_value :: i64

# INVALID: function with invalid body
# test_invalid_fn_body :: () => }
