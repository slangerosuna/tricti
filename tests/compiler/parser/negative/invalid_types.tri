# Invalid Type Tests
# These tests contain invalid type syntax that should fail to parse

# INVALID: type argument without identifier
# test_invalid_type_no_id :: () -> <i64> => { x }

# INVALID: mismatched angle brackets
# test_invalid_type_mismatch :: () -> Vec<i64 => { v }

# INVALID: empty type arguments
# test_invalid_type_empty :: () -> Vec<> => { v }

# INVALID: type with space in generic (ambiguous with comparison)
# test_invalid_type_space :: () -> Vec < i64 > => { v }

# INVALID: invalid reference syntax
# test_invalid_ref :: () -> &&i64 => { x }

# INVALID: type without name
# test_invalid_type_anonymous :: () -> <T> => { x }

# INVALID: tuple type with one element (not a tuple)
# test_invalid_single_tuple :: () -> (i64) => { x }

# INVALID: function type without arrow
# test_invalid_fn_type :: () -> (i64) i64 => { x }

# INVALID: invalid pointer syntax
# test_invalid_ptr :: () -> **i64 => { x }

# INVALID: missing type in annotation
# test_invalid_missing_type :: (x: ) => { x }
