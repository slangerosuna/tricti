# Invalid Expression Tests
# These tests contain invalid expression syntax that should fail to parse

# INVALID: mismatched parentheses
# test_invalid_mismatch_parens :: () => { (5 + 5 }

# INVALID: unclosed function call
# test_invalid_unclosed_call :: () => { func( }

# INVALID: field access without field name
# test_invalid_field_no_name :: () => { obj. }

# INVALID: array index without index
# test_invalid_index_empty :: () => { arr[] }

# INVALID: double dot operator
# test_invalid_double_dot :: () => { obj..field }

# INVALID: static path without identifier
# test_invalid_static_no_id :: () => { Vec:: }

# INVALID: call with invalid argument separator
# test_invalid_call_separator :: () => { func(1; 2) }

# INVALID: struct literal without closing brace
# test_invalid_struct_unclosed :: () => { { a: 1 }

# INVALID: nested parentheses mismatch
# test_invalid_nested_parens :: () => { ((1 + 2) }

# INVALID: expression with trailing operator
# test_invalid_trailing_op :: () => { 1 + 2 + }
