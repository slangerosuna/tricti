# Simple test for Vec_new function
# This test uses a simplified Vec implementation that the parser can handle

rawr :: () -> i64 => do
    42  # placeholder return value

main :: () -> i32 => do
    result := rawr()
    if result == 42:
        println("Vec_new test passed!")
        ret 0
    else:
        println("Vec_new test failed!")
        ret 1