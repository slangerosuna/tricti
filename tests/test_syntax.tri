Apps :: table {
    @primary id: u64,
    title: String,
    display: bool = false,
    downloads: u64 = 0,
}

Gui :: @resource { }

display_apps :: sys (
    query: (id: u64, name: String) from Apps where downloads > 1000,
    gui: res &mut Gui,
) -> !none {
    a := 1
    # verify that you can parse this pattern without it thinking it's multiplication
    *gui = *gui
        
    ret none
}
