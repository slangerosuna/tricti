# Comprehensive Trait Tests for TriCTI stdlib
# Tests Hash and Eq trait implementations

use std::prelude
use std::core::traits
use std::core::string
use std::collections::hashmap
use std::collections::hashset

# Test Hash trait for i64
test_hash_i64 :: () -> bool => do
    val1 := 42
    val2 := 42
    val3 := 100
    
    hash1 := Hash::hash(&val1)
    hash2 := Hash::hash(&val2)
    hash3 := Hash::hash(&val3)
    
    # Same values should have same hash
    result1 := hash1 == hash2
    # Different values should (likely) have different hash
    result2 := hash1 ~= hash3
    
    result1 and result2

# Test Hash trait for u64
test_hash_u64 :: () -> bool => do
    val1: u64 = 42
    val2: u64 = 42
    val3: u64 = 100
    
    hash1 := Hash::hash(&val1)
    hash2 := Hash::hash(&val2)
    hash3 := Hash::hash(&val3)
    
    hash1 == hash2 and hash1 ~= hash3

# Test Hash trait for bool
test_hash_bool :: () -> bool => do
    t1 := true
    t2 := true
    f1 := false
    
    hash_t1 := Hash::hash(&t1)
    hash_t2 := Hash::hash(&t2)
    hash_f1 := Hash::hash(&f1)
    
    hash_t1 == hash_t2 and hash_t1 ~= hash_f1

# Test Hash trait for String
test_hash_string :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr("Hello")
    s3 := String::from_cstr("World")
    
    hash1 := Hash::hash(&s1)
    hash2 := Hash::hash(&s2)
    hash3 := Hash::hash(&s3)
    
    hash1 == hash2 and hash1 ~= hash3

# Test Eq trait for i64
test_eq_i64 :: () -> bool => do
    val1 := 42
    val2 := 42
    val3 := 100
    
    eq1 := Eq::eq(&val1, &val2)
    eq2 := Eq::eq(&val1, &val3)
    
    eq1 and !eq2

# Test Eq trait for u64
test_eq_u64 :: () -> bool => do
    val1: u64 = 42
    val2: u64 = 42
    val3: u64 = 100
    
    eq1 := Eq::eq(&val1, &val2)
    eq2 := Eq::eq(&val1, &val3)
    
    eq1 and !eq2

# Test Eq trait for bool
test_eq_bool :: () -> bool => do
    t1 := true
    t2 := true
    f1 := false
    
    eq1 := Eq::eq(&t1, &t2)
    eq2 := Eq::eq(&t1, &f1)
    
    eq1 and !eq2

# Test Eq trait for String
test_eq_string :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr("Hello")
    s3 := String::from_cstr("World")
    
    eq1 := Eq::eq(&s1, &s2)
    eq2 := Eq::eq(&s1, &s3)
    
    eq1 and !eq2

# Test HashMap uses Hash trait properly
test_hashmap_uses_hash_trait :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    
    # Insert values - should use Hash::hash internally
    HashMap::insert::<i64, i64>(&map, 1, 100)
    HashMap::insert::<i64, i64>(&map, 2, 200)
    HashMap::insert::<i64, i64>(&map, 3, 300)
    
    # Retrieve values - should use Hash::hash and Eq::eq
    v1 := HashMap::get::<i64, i64>(&map, 1)
    v2 := HashMap::get::<i64, i64>(&map, 2)
    v3 := HashMap::get::<i64, i64>(&map, 3)
    
    result := v1 ~= (0 as *i64) and v1[0] == 100 and
              v2 ~= (0 as *i64) and v2[0] == 200 and
              v3 ~= (0 as *i64) and v3[0] == 300
    
    HashMap::destroy::<i64, i64>(&map)
    result

# Test HashMap collision handling with traits
test_hashmap_collision_handling :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    
    # Insert many values to force collisions
    for i in 0..100:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    
    # Verify all values are retrievable
    all_correct := true
    for i in 0..100:
        val := HashMap::get::<i64, i64>(&map, i as i64)
    if val == (0 as *i64) or val[0] ~= (i * 10) as i64:
            all_correct = false
            break
    
    HashMap::destroy::<i64, i64>(&map)
    all_correct

# Test HashMap with String keys uses traits
test_hashmap_string_keys_traits :: () -> bool => do
    map := HashMap::new::<*String, i64>()
    
    key1 := String::from_cstr("one")
    key2 := String::from_cstr("two")
    key3 := String::from_cstr("three")
    
    HashMap::insert::<*String, i64>(&map, &key1, 1)
    HashMap::insert::<*String, i64>(&map, &key2, 2)
    HashMap::insert::<*String, i64>(&map, &key3, 3)
    
    v1 := HashMap::get::<*String, i64>(&map, &key1)
    v2 := HashMap::get::<*String, i64>(&map, &key2)
    v3 := HashMap::get::<*String, i64>(&map, &key3)
    
    result := v1 ~= (0 as *i64) and v1[0] == 1 and
              v2 ~= (0 as *i64) and v2[0] == 2 and
              v3 ~= (0 as *i64) and v3[0] == 3
    
    HashMap::destroy::<*String, i64>(&map)
    result

# Test HashSet uses traits properly
test_hashset_uses_traits :: () -> bool => do
    set := HashSet::new::<i64>()
    
    # Insert values - should use Hash trait
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    
    # Check contains - should use Hash and Eq traits
    c1 := HashSet::contains::<i64>(&set, 1)
    c2 := HashSet::contains::<i64>(&set, 2)
    c3 := HashSet::contains::<i64>(&set, 3)
    c4 := HashSet::contains::<i64>(&set, 999)
    
    result := c1 and c2 and c3 and !c4
    
    HashSet::destroy::<i64>(&set)
    result

# Test associated function syntax works
test_associated_function_syntax :: () -> bool => do
    # Test String associated functions
    s := String::new()
    String::push_cstr(&s, "Test")
    len_correct := String::len(&s) == 4
    
    # Test HashMap associated functions
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    contains_correct := HashMap::contains_key::<i64, i64>(&map, 42)
    
    # Test HashSet associated functions
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 42)
    set_contains_correct := HashSet::contains::<i64>(&set, 42)
    
    HashMap::destroy::<i64, i64>(&map)
    HashSet::destroy::<i64>(&set)
    
    len_correct and contains_correct and set_contains_correct

# Test no "all keys hash to 0" bug
test_no_zero_hash_bug :: () -> bool => do
    # Verify different keys produce different hashes
    hash1 := Hash::hash(&1)
    hash2 := Hash::hash(&2)
    hash3 := Hash::hash(&100)
    hash4 := Hash::hash(&999)
    
    # At least some should be non-zero and different
    non_zero := hash1 ~= 0 or hash2 ~= 0 or hash3 ~= 0 or hash4 ~= 0
    different := hash1 ~= hash2 or hash2 ~= hash3 or hash3 ~= hash4

    non_zero and different

# Test no "equality always false" bug
test_no_equality_bug :: () -> bool => do
    # Test that equal values are actually detected as equal
    val1 := 42
    val2 := 42
    
    s1 := String::from_cstr("Test")
    s2 := String::from_cstr("Test")
    
    int_eq := Eq::eq(&val1, &val2)
    str_eq := Eq::eq(&s1, &s2)
    
    int_eq and str_eq

# Test HashMap properly handles duplicate keys
test_hashmap_duplicate_keys :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    
    HashMap::insert::<i64, i64>(&map, 42, 100)
    HashMap::insert::<i64, i64>(&map, 42, 200)  # Overwrite
    
    val := HashMap::get::<i64, i64>(&map, 42)
    len := HashMap::len::<i64, i64>(&map)
    
    # Should have value 200 (overwritten) and length 1 (not duplicate entry)
    result := val ~= (0 as *i64) and val[0] == 200 and len == 1
    
    HashMap::destroy::<i64, i64>(&map)
    result

# Main test runner
main :: () => do
    println("Running Trait Implementation Tests...")
    
    tests_passed := 0
    tests_failed := 0
    
    # Run all tests
    if test_hash_i64():
        println("✓ Hash trait for i64")
        tests_passed = tests_passed + 1
    else:
        println("✗ Hash trait for i64")
        tests_failed = tests_failed + 1
    
    if test_hash_u64():
        println("✓ Hash trait for u64")
        tests_passed = tests_passed + 1
    else:
        println("✗ Hash trait for u64")
        tests_failed = tests_failed + 1
    
    if test_hash_bool():
        println("✓ Hash trait for bool")
        tests_passed = tests_passed + 1
    else:
        println("✗ Hash trait for bool")
        tests_failed = tests_failed + 1
    
    if test_hash_string():
        println("✓ Hash trait for String")
        tests_passed = tests_passed + 1
    else:
        println("✗ Hash trait for String")
        tests_failed = tests_failed + 1
    
    if test_eq_i64():
        println("✓ Eq trait for i64")
        tests_passed = tests_passed + 1
    else:
        println("✗ Eq trait for i64")
        tests_failed = tests_failed + 1
    
    if test_eq_u64():
        println("✓ Eq trait for u64")
        tests_passed = tests_passed + 1
    else:
        println("✗ Eq trait for u64")
        tests_failed = tests_failed + 1
    
    if test_eq_bool():
        println("✓ Eq trait for bool")
        tests_passed = tests_passed + 1
    else:
        println("✗ Eq trait for bool")
        tests_failed = tests_failed + 1
    
    if test_eq_string():
        println("✓ Eq trait for String")
        tests_passed = tests_passed + 1
    else:
        println("✗ Eq trait for String")
        tests_failed = tests_failed + 1
    
    if test_hashmap_uses_hash_trait():
        println("✓ HashMap uses Hash trait")
        tests_passed = tests_passed + 1
    else:
        println("✗ HashMap uses Hash trait")
        tests_failed = tests_failed + 1
    
    if test_hashmap_collision_handling():
        println("✓ HashMap collision handling")
        tests_passed = tests_passed + 1
    else:
        println("✗ HashMap collision handling")
        tests_failed = tests_failed + 1
    
    if test_hashmap_string_keys_traits():
        println("✓ HashMap with String keys uses traits")
        tests_passed = tests_passed + 1
    else:
        println("✗ HashMap with String keys uses traits")
        tests_failed = tests_failed + 1
    
    if test_hashset_uses_traits():
        println("✓ HashSet uses traits")
        tests_passed = tests_passed + 1
    else:
        println("✗ HashSet uses traits")
        tests_failed = tests_failed + 1
    
    if test_associated_function_syntax():
        println("✓ Associated function syntax")
        tests_passed = tests_passed + 1
    else:
        println("✗ Associated function syntax")
        tests_failed = tests_failed + 1
    
    if test_no_zero_hash_bug():
        println("✓ No 'all keys hash to 0' bug")
        tests_passed = tests_passed + 1
    else:
        println("✗ No 'all keys hash to 0' bug")
        tests_failed = tests_failed + 1
    
    if test_no_equality_bug():
        println("✓ No 'equality always false' bug")
        tests_passed = tests_passed + 1
    else:
        println("✗ No 'equality always false' bug")
        tests_failed = tests_failed + 1
    
    if test_hashmap_duplicate_keys():
        println("✓ HashMap duplicate keys handling")
        tests_passed = tests_passed + 1
    else:
        println("✗ HashMap duplicate keys handling")
        tests_failed = tests_failed + 1
    
    println("")
    println("===============================")
    println("Tests passed: " + (tests_passed as *u8))
    println("Tests failed: " + (tests_failed as *u8))
    println("===============================")
    
    if tests_failed == 0:
        println("All tests passed! ✓")
