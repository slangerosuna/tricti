# Comprehensive HashSet Tests
# 50+ tests covering all HashSet functionality

use prelude
use collections::hashmap
use collections::hashset

# Specialize hash functions for i64
hash_value_i64 :: (value: i64) -> u64 => do
    hash_i64(value)

# ============ Construction Tests (5 tests) ============

test_hashset_new :: () -> bool => do
    set := HashSet::new::<i64>()
    result := HashSet::len::<i64>(&set) == 0 and 
              HashSet::is_empty::<i64>(&set) and
              HashSet::capacity::<i64>(&set) >= 16
    HashSet::destroy::<i64>(&set)
    result

test_hashset_with_capacity :: () -> bool => do
    set := HashSet::with_capacity::<i64>(32)
    result := HashSet::capacity::<i64>(&set) >= 32 and
              HashSet::len::<i64>(&set) == 0
    HashSet::destroy::<i64>(&set)
    result

test_hashset_initial_is_empty :: () -> bool => do
    set := HashSet::new::<i64>()
    result := HashSet::is_empty::<i64>(&set)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_initial_len_zero :: () -> bool => do
    set := HashSet::new::<i64>()
    result := HashSet::len::<i64>(&set) == 0
    HashSet::destroy::<i64>(&set)
    result

test_hashset_load_factor :: () -> bool => do
    set := HashSet::new::<i64>()
    result := HashSet::load::<i64>(&set) == 0.0
    HashSet::destroy::<i64>(&set)
    result

# ============ Insert/Contains Tests (10 tests) ============

test_hashset_insert :: () -> bool => do
    set := HashSet::new::<i64>()
    inserted := HashSet::insert::<i64>(&set, 42)
    result := inserted and HashSet::contains::<i64>(&set, 42)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_insert_multiple :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    
    result := HashSet::contains::<i64>(&set, 1) and
              HashSet::contains::<i64>(&set, 2) and
              HashSet::contains::<i64>(&set, 3) and
              HashSet::len::<i64>(&set) == 3
    HashSet::destroy::<i64>(&set)
    result

test_hashset_insert_duplicate :: () -> bool => do
    set := HashSet::new::<i64>()
    first := HashSet::insert::<i64>(&set, 42)
    second := HashSet::insert::<i64>(&set, 42)
    result := first and !second and HashSet::len::<i64>(&set) == 1
    HashSet::destroy::<i64>(&set)
    result

test_hashset_contains_missing :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    result := !HashSet::contains::<i64>(&set, 999)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_contains_empty :: () -> bool => do
    set := HashSet::new::<i64>()
    result := !HashSet::contains::<i64>(&set, 42)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_insert_negative :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, -5)
    HashSet::insert::<i64>(&set, -100)
    result := HashSet::contains::<i64>(&set, -5) and
              HashSet::contains::<i64>(&set, -100)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_insert_zero :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 0)
    result := HashSet::contains::<i64>(&set, 0)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_size_after_inserts :: () -> bool => do
    set := HashSet::new::<i64>()
    for i in 0..10:
        HashSet::insert::<i64>(&set, i as i64)
    result := HashSet::len::<i64>(&set) == 10 and
              HashSet::size::<i64>(&set) == 10
    HashSet::destroy::<i64>(&set)
    result

test_hashset_insert_sequential :: () -> bool => do
    set := HashSet::new::<i64>()
    for i in 0..20:
        HashSet::insert::<i64>(&set, i as i64)
    
    all_present := true
    for i in 0..20:
        if !HashSet::contains::<i64>(&set, i as i64):
            all_present = false
    
    result := all_present and HashSet::len::<i64>(&set) == 20
    HashSet::destroy::<i64>(&set)
    result

test_hashset_insert_duplicates :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 5)
    HashSet::insert::<i64>(&set, 5)
    HashSet::insert::<i64>(&set, 5)
    result := HashSet::len::<i64>(&set) == 1
    HashSet::destroy::<i64>(&set)
    result

# ============ Remove Tests (5 tests) ============

test_hashset_remove_existing :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 42)
    removed := HashSet::remove::<i64>(&set, 42)
    result := removed and !HashSet::contains::<i64>(&set, 42)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_remove_missing :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    removed := HashSet::remove::<i64>(&set, 999)
    result := !removed and HashSet::len::<i64>(&set) == 1
    HashSet::destroy::<i64>(&set)
    result

test_hashset_remove_updates_len :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::remove::<i64>(&set, 1)
    result := HashSet::len::<i64>(&set) == 1
    HashSet::destroy::<i64>(&set)
    result

test_hashset_remove_all :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    HashSet::remove::<i64>(&set, 1)
    HashSet::remove::<i64>(&set, 2)
    HashSet::remove::<i64>(&set, 3)
    result := HashSet::is_empty::<i64>(&set)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_clear :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::clear::<i64>(&set)
    result := HashSet::is_empty::<i64>(&set) and HashSet::len::<i64>(&set) == 0
    HashSet::destroy::<i64>(&set)
    result

# ============ Set Operations Tests (15 tests) ============

test_hashset_union_basic :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    
    union := HashSet::union::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&union) == 3 and
              HashSet::contains::<i64>(&union, 1) and
              HashSet::contains::<i64>(&union, 2) and
              HashSet::contains::<i64>(&union, 3)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&union)
    result

test_hashset_union_empty :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    
    set2 := HashSet::new::<i64>()
    
    union := HashSet::union::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&union) == 1 and
              HashSet::contains::<i64>(&union, 1)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&union)
    result

test_hashset_union_identical :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    union := HashSet::union::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&union) == 2
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&union)
    result

test_hashset_intersection_basic :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    HashSet::insert::<i64>(&set1, 3)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    HashSet::insert::<i64>(&set2, 4)
    
    intersection := HashSet::intersection::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&intersection) == 2 and
              HashSet::contains::<i64>(&intersection, 2) and
              HashSet::contains::<i64>(&intersection, 3)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&intersection)
    result

test_hashset_intersection_empty :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 3)
    HashSet::insert::<i64>(&set2, 4)
    
    intersection := HashSet::intersection::<i64>(&set1, &set2)
    
    result := HashSet::is_empty::<i64>(&intersection)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&intersection)
    result

test_hashset_intersection_identical :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    intersection := HashSet::intersection::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&intersection) == 2
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&intersection)
    result

test_hashset_difference_basic :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    HashSet::insert::<i64>(&set1, 3)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 4)
    
    diff := HashSet::difference::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&diff) == 2 and
              HashSet::contains::<i64>(&diff, 1) and
              HashSet::contains::<i64>(&diff, 3)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&diff)
    result

test_hashset_difference_empty :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    diff := HashSet::difference::<i64>(&set1, &set2)
    
    result := HashSet::is_empty::<i64>(&diff)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&diff)
    result

test_hashset_difference_no_overlap :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 3)
    HashSet::insert::<i64>(&set2, 4)
    
    diff := HashSet::difference::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&diff) == 2
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&diff)
    result

test_hashset_symmetric_difference_basic :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    HashSet::insert::<i64>(&set1, 3)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    HashSet::insert::<i64>(&set2, 4)
    
    sym_diff := HashSet::symmetric_difference::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&sym_diff) == 2 and
              HashSet::contains::<i64>(&sym_diff, 1) and
              HashSet::contains::<i64>(&sym_diff, 4)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&sym_diff)
    result

test_hashset_symmetric_difference_identical :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    sym_diff := HashSet::symmetric_difference::<i64>(&set1, &set2)
    
    result := HashSet::is_empty::<i64>(&sym_diff)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&sym_diff)
    result

test_hashset_symmetric_difference_no_overlap :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 3)
    HashSet::insert::<i64>(&set2, 4)
    
    sym_diff := HashSet::symmetric_difference::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&sym_diff) == 4
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&sym_diff)
    result

test_hashset_extend :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    
    HashSet::extend::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&set1) == 3 and
              HashSet::contains::<i64>(&set1, 1) and
              HashSet::contains::<i64>(&set1, 2) and
              HashSet::contains::<i64>(&set1, 3)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_extend_duplicates :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    
    HashSet::extend::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&set1) == 3
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_multiple_operations :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    
    union := HashSet::union::<i64>(&set1, &set2)
    intersection := HashSet::intersection::<i64>(&set1, &set2)
    
    result := HashSet::len::<i64>(&union) == 3 and
              HashSet::len::<i64>(&intersection) == 1
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    HashSet::destroy::<i64>(&union)
    HashSet::destroy::<i64>(&intersection)
    result

# ============ Set Relations Tests (10 tests) ============

test_hashset_is_subset :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 3)
    
    result := HashSet::is_subset::<i64>(&set1, &set2)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_is_subset_false :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 4)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    result := !HashSet::is_subset::<i64>(&set1, &set2)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_is_superset :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    HashSet::insert::<i64>(&set1, 3)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    result := HashSet::is_superset::<i64>(&set1, &set2)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_is_superset_false :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 1)
    HashSet::insert::<i64>(&set2, 2)
    
    result := !HashSet::is_superset::<i64>(&set1, &set2)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_is_disjoint :: () -> bool => do
    set1 := HashSet::new::<i64>()
