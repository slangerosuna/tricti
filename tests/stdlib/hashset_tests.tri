    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    
    set2 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set2, 2)
    HashSet::insert::<i64>(&set2, 1)
    
    result := HashSet::equals::<i64>(&set1, &set2)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

# ============ Edge Cases Tests (5 tests) ============

test_hashset_empty_operations :: () -> bool => do
    set := HashSet::new::<i64>()
    result := HashSet::is_empty::<i64>(&set) and
              HashSet::len::<i64>(&set) == 0 and
              !HashSet::contains::<i64>(&set, 0)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_single_element :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 7)
    result := HashSet::len::<i64>(&set) == 1 and
              !HashSet::is_empty::<i64>(&set) and
              HashSet::contains::<i64>(&set, 7)
    HashSet::destroy::<i64>(&set)
    result

test_hashset_clone :: () -> bool => do
    set1 := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set1, 1)
    HashSet::insert::<i64>(&set1, 2)
    HashSet::insert::<i64>(&set1, 3)
    
    set2 := HashSet::clone::<i64>(&set1)
    
    result := HashSet::len::<i64>(&set2) == 3 and
              HashSet::contains::<i64>(&set2, 1) and
              HashSet::contains::<i64>(&set2, 2) and
              HashSet::contains::<i64>(&set2, 3)
    
    HashSet::destroy::<i64>(&set1)
    HashSet::destroy::<i64>(&set2)
    result

test_hashset_reserve_shrink :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::reserve::<i64>(&set, 100)
    cap1 := HashSet::capacity::<i64>(&set)
    
    HashSet::insert::<i64>(&set, 1)
    HashSet::shrink_to_fit::<i64>(&set)
    cap2 := HashSet::capacity::<i64>(&set)
    
    result := cap1 >= 100 and cap2 < cap1
    HashSet::destroy::<i64>(&set)
    result

test_hashset_large_dataset :: () -> bool => do
    set := HashSet::new::<i64>()
    
    for i in 0..100:
        HashSet::insert::<i64>(&set, i as i64)
    
    all_present := true
    for i in 0..100:
        if !HashSet::contains::<i64>(&set, i as i64):
            all_present = false
    
    result := HashSet::len::<i64>(&set) == 100 and all_present
    HashSet::destroy::<i64>(&set)
    result

# ============ Additional Utility Tests (5 tests) ============

test_hashset_any :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    
    has_large := HashSet::any::<i64>(&set, (val: i64) -> bool => do
        val > 2
    
    result := has_large
    HashSet::destroy::<i64>(&set)
    result

test_hashset_all :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    
    all_positive := HashSet::all::<i64>(&set, (val: i64) -> bool => do
        val > 0
    
    result := all_positive
    HashSet::destroy::<i64>(&set)
    result

test_hashset_count_if :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    HashSet::insert::<i64>(&set, 4)
    
    count := HashSet::count_if::<i64>(&set, (val: i64) -> bool => do
        val % 2 == 0
    
    result := count == 2
    HashSet::destroy::<i64>(&set)
    result

test_hashset_find :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 5)
    HashSet::insert::<i64>(&set, 10)
    
    found := HashSet::find::<i64>(&set, (val: i64) -> bool => do
        val > 7
    
    result := found ~= (0 as *i64) and found[0] == 10
    HashSet::destroy::<i64>(&set)
    result

test_hashset_retain :: () -> bool => do
    set := HashSet::new::<i64>()
    HashSet::insert::<i64>(&set, 1)
    HashSet::insert::<i64>(&set, 2)
    HashSet::insert::<i64>(&set, 3)
    HashSet::insert::<i64>(&set, 4)
    
    HashSet::retain::<i64>(&set, (val: i64) -> bool => do
        val % 2 == 0
    
    result := HashSet::len::<i64>(&set) == 2 and
              HashSet::contains::<i64>(&set, 2) and
              HashSet::contains::<i64>(&set, 4)
    HashSet::destroy::<i64>(&set)
    result
