# Comprehensive HashSet Tests
# 50+ tests covering all HashSet functionality

use prelude
use collections::hashmap
use collections::hashset

# Specialize hash functions for i64
hash_value_i64 :: (value: i64) -> u64 => {
    hash_i64(value)
}

# ============ Construction Tests (5 tests) ============

test_hashset_new :: () -> bool => {
    set := HashSet_new::<i64>()
    result := HashSet_len::<i64>(&set) == 0 && 
              HashSet_is_empty::<i64>(&set) &&
              HashSet_capacity::<i64>(&set) >= 16
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_with_capacity :: () -> bool => {
    set := HashSet_with_capacity::<i64>(32)
    result := HashSet_capacity::<i64>(&set) >= 32 &&
              HashSet_len::<i64>(&set) == 0
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_initial_is_empty :: () -> bool => {
    set := HashSet_new::<i64>()
    result := HashSet_is_empty::<i64>(&set)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_initial_len_zero :: () -> bool => {
    set := HashSet_new::<i64>()
    result := HashSet_len::<i64>(&set) == 0
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_load_factor :: () -> bool => {
    set := HashSet_new::<i64>()
    result := HashSet_load::<i64>(&set) == 0.0
    HashSet_destroy::<i64>(&set)
    result
}

# ============ Insert/Contains Tests (10 tests) ============

test_hashset_insert :: () -> bool => {
    set := HashSet_new::<i64>()
    inserted := HashSet_insert::<i64>(&set, 42)
    result := inserted && HashSet_contains::<i64>(&set, 42)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_insert_multiple :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_insert::<i64>(&set, 3)
    
    result := HashSet_contains::<i64>(&set, 1) &&
              HashSet_contains::<i64>(&set, 2) &&
              HashSet_contains::<i64>(&set, 3) &&
              HashSet_len::<i64>(&set) == 3
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_insert_duplicate :: () -> bool => {
    set := HashSet_new::<i64>()
    first := HashSet_insert::<i64>(&set, 42)
    second := HashSet_insert::<i64>(&set, 42)
    result := first && !second && HashSet_len::<i64>(&set) == 1
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_contains_missing :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    result := !HashSet_contains::<i64>(&set, 999)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_contains_empty :: () -> bool => {
    set := HashSet_new::<i64>()
    result := !HashSet_contains::<i64>(&set, 42)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_insert_negative :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, -5)
    HashSet_insert::<i64>(&set, -100)
    result := HashSet_contains::<i64>(&set, -5) &&
              HashSet_contains::<i64>(&set, -100)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_insert_zero :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 0)
    result := HashSet_contains::<i64>(&set, 0)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_size_after_inserts :: () -> bool => {
    set := HashSet_new::<i64>()
    for i in 0:10 {
        HashSet_insert::<i64>(&set, i as i64)
    }
    result := HashSet_len::<i64>(&set) == 10 &&
              HashSet_size::<i64>(&set) == 10
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_insert_sequential :: () -> bool => {
    set := HashSet_new::<i64>()
    for i in 0:20 {
        HashSet_insert::<i64>(&set, i as i64)
    }
    
    all_present := true
    for i in 0:20 {
        if !HashSet_contains::<i64>(&set, i as i64) {
            all_present = false
        }
    }
    
    result := all_present && HashSet_len::<i64>(&set) == 20
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_insert_duplicates :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 5)
    HashSet_insert::<i64>(&set, 5)
    HashSet_insert::<i64>(&set, 5)
    result := HashSet_len::<i64>(&set) == 1
    HashSet_destroy::<i64>(&set)
    result
}

# ============ Remove Tests (5 tests) ============

test_hashset_remove_existing :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 42)
    removed := HashSet_remove::<i64>(&set, 42)
    result := removed && !HashSet_contains::<i64>(&set, 42)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_remove_missing :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    removed := HashSet_remove::<i64>(&set, 999)
    result := !removed && HashSet_len::<i64>(&set) == 1
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_remove_updates_len :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_remove::<i64>(&set, 1)
    result := HashSet_len::<i64>(&set) == 1
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_remove_all :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_insert::<i64>(&set, 3)
    HashSet_remove::<i64>(&set, 1)
    HashSet_remove::<i64>(&set, 2)
    HashSet_remove::<i64>(&set, 3)
    result := HashSet_is_empty::<i64>(&set)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_clear :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_clear::<i64>(&set)
    result := HashSet_is_empty::<i64>(&set) && HashSet_len::<i64>(&set) == 0
    HashSet_destroy::<i64>(&set)
    result
}

# ============ Set Operations Tests (15 tests) ============

test_hashset_union_basic :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    
    union := HashSet_union::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&union) == 3 &&
              HashSet_contains::<i64>(&union, 1) &&
              HashSet_contains::<i64>(&union, 2) &&
              HashSet_contains::<i64>(&union, 3)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&union)
    result
}

test_hashset_union_empty :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    
    set2 := HashSet_new::<i64>()
    
    union := HashSet_union::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&union) == 1 &&
              HashSet_contains::<i64>(&union, 1)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&union)
    result
}

test_hashset_union_identical :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    union := HashSet_union::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&union) == 2
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&union)
    result
}

test_hashset_intersection_basic :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    HashSet_insert::<i64>(&set1, 3)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    HashSet_insert::<i64>(&set2, 4)
    
    intersection := HashSet_intersection::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&intersection) == 2 &&
              HashSet_contains::<i64>(&intersection, 2) &&
              HashSet_contains::<i64>(&intersection, 3)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&intersection)
    result
}

test_hashset_intersection_empty :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 3)
    HashSet_insert::<i64>(&set2, 4)
    
    intersection := HashSet_intersection::<i64>(&set1, &set2)
    
    result := HashSet_is_empty::<i64>(&intersection)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&intersection)
    result
}

test_hashset_intersection_identical :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    intersection := HashSet_intersection::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&intersection) == 2
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&intersection)
    result
}

test_hashset_difference_basic :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    HashSet_insert::<i64>(&set1, 3)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 4)
    
    diff := HashSet_difference::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&diff) == 2 &&
              HashSet_contains::<i64>(&diff, 1) &&
              HashSet_contains::<i64>(&diff, 3)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&diff)
    result
}

test_hashset_difference_empty :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    diff := HashSet_difference::<i64>(&set1, &set2)
    
    result := HashSet_is_empty::<i64>(&diff)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&diff)
    result
}

test_hashset_difference_no_overlap :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 3)
    HashSet_insert::<i64>(&set2, 4)
    
    diff := HashSet_difference::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&diff) == 2
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&diff)
    result
}

test_hashset_symmetric_difference_basic :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    HashSet_insert::<i64>(&set1, 3)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    HashSet_insert::<i64>(&set2, 4)
    
    sym_diff := HashSet_symmetric_difference::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&sym_diff) == 2 &&
              HashSet_contains::<i64>(&sym_diff, 1) &&
              HashSet_contains::<i64>(&sym_diff, 4)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&sym_diff)
    result
}

test_hashset_symmetric_difference_identical :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    sym_diff := HashSet_symmetric_difference::<i64>(&set1, &set2)
    
    result := HashSet_is_empty::<i64>(&sym_diff)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&sym_diff)
    result
}

test_hashset_symmetric_difference_no_overlap :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 3)
    HashSet_insert::<i64>(&set2, 4)
    
    sym_diff := HashSet_symmetric_difference::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&sym_diff) == 4
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&sym_diff)
    result
}

test_hashset_extend :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    
    HashSet_extend::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&set1) == 3 &&
              HashSet_contains::<i64>(&set1, 1) &&
              HashSet_contains::<i64>(&set1, 2) &&
              HashSet_contains::<i64>(&set1, 3)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_extend_duplicates :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    
    HashSet_extend::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&set1) == 3
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_multiple_operations :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    
    union := HashSet_union::<i64>(&set1, &set2)
    intersection := HashSet_intersection::<i64>(&set1, &set2)
    
    result := HashSet_len::<i64>(&union) == 3 &&
              HashSet_len::<i64>(&intersection) == 1
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    HashSet_destroy::<i64>(&union)
    HashSet_destroy::<i64>(&intersection)
    result
}

# ============ Set Relations Tests (10 tests) ============

test_hashset_is_subset :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    HashSet_insert::<i64>(&set2, 3)
    
    result := HashSet_is_subset::<i64>(&set1, &set2)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_is_subset_false :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 4)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    result := !HashSet_is_subset::<i64>(&set1, &set2)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_is_superset :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    HashSet_insert::<i64>(&set1, 3)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    result := HashSet_is_superset::<i64>(&set1, &set2)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_is_superset_false :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    
    set2 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set2, 1)
    HashSet_insert::<i64>(&set2, 2)
    
    result := !HashSet_is_superset::<i64>(&set1, &set2)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_is_disjoint :: () -> bool => {
    set1 := HashSet_new::<i64>()
