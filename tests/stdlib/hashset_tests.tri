# ============ Edge Cases Tests (5 tests) ============

test_hashset_empty_operations :: () -> bool => {
    set := HashSet_new::<i64>()
    result := HashSet_is_empty::<i64>(&set) &&
              HashSet_len::<i64>(&set) == 0 &&
              !HashSet_contains::<i64>(&set, 0)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_single_element :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 7)
    result := HashSet_len::<i64>(&set) == 1 &&
              !HashSet_is_empty::<i64>(&set) &&
              HashSet_contains::<i64>(&set, 7)
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_clone :: () -> bool => {
    set1 := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set1, 1)
    HashSet_insert::<i64>(&set1, 2)
    HashSet_insert::<i64>(&set1, 3)
    
    set2 := HashSet_clone::<i64>(&set1)
    
    result := HashSet_len::<i64>(&set2) == 3 &&
              HashSet_contains::<i64>(&set2, 1) &&
              HashSet_contains::<i64>(&set2, 2) &&
              HashSet_contains::<i64>(&set2, 3)
    
    HashSet_destroy::<i64>(&set1)
    HashSet_destroy::<i64>(&set2)
    result
}

test_hashset_reserve_shrink :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_reserve::<i64>(&set, 100)
    cap1 := HashSet_capacity::<i64>(&set)
    
    HashSet_insert::<i64>(&set, 1)
    HashSet_shrink_to_fit::<i64>(&set)
    cap2 := HashSet_capacity::<i64>(&set)
    
    result := cap1 >= 100 && cap2 < cap1
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_large_dataset :: () -> bool => {
    set := HashSet_new::<i64>()
    
    for i in 0:100 {
        HashSet_insert::<i64>(&set, i as i64)
    }
    
    all_present := true
    for i in 0:100 {
        if !HashSet_contains::<i64>(&set, i as i64) {
            all_present = false
        }
    }
    
    result := HashSet_len::<i64>(&set) == 100 && all_present
    HashSet_destroy::<i64>(&set)
    result
}

# ============ Additional Utility Tests (5 tests) ============

test_hashset_any :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_insert::<i64>(&set, 3)
    
    has_large := HashSet_any::<i64>(&set, (val: i64) -> bool => {
        val > 2
    })
    
    result := has_large
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_all :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_insert::<i64>(&set, 3)
    
    all_positive := HashSet_all::<i64>(&set, (val: i64) -> bool => {
        val > 0
    })
    
    result := all_positive
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_count_if :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_insert::<i64>(&set, 3)
    HashSet_insert::<i64>(&set, 4)
    
    count := HashSet_count_if::<i64>(&set, (val: i64) -> bool => {
        val % 2 == 0
    })
    
    result := count == 2
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_find :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 5)
    HashSet_insert::<i64>(&set, 10)
    
    found := HashSet_find::<i64>(&set, (val: i64) -> bool => {
        val > 7
    })
    
    result := found ~= (0 as *i64) && found[0] == 10
    HashSet_destroy::<i64>(&set)
    result
}

test_hashset_retain :: () -> bool => {
    set := HashSet_new::<i64>()
    HashSet_insert::<i64>(&set, 1)
    HashSet_insert::<i64>(&set, 2)
    HashSet_insert::<i64>(&set, 3)
    HashSet_insert::<i64>(&set, 4)
    
    HashSet_retain::<i64>(&set, (val: i64) -> bool => {
        val % 2 == 0
    })
    
    result := HashSet_len::<i64>(&set) == 2 &&
              HashSet_contains::<i64>(&set, 2) &&
              HashSet_contains::<i64>(&set, 4)
    HashSet_destroy::<i64>(&set)
    result
}
