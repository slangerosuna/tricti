# Simplified Conversion Traits Tests for TriCTI stdlib
# Tests From, Into, TryFrom, TryInto conversions

use stdlib::core::string
use stdlib::core::traits
use stdlib::core::result
use stdlib::core::errors

# Test counter
test_count := 0
passed_count := 0
failed_count := 0

# Test helper
run_test :: (name: string, test: () -> bool) -> none => {
    test_count = test_count + 1
    result := test()
    
    if result {
        passed_count = passed_count + 1
        println("✓ " + name)
    } else {
        failed_count = failed_count + 1
        println("✗ " + name)
    }
}

# ===== FROM TESTS (10 tests) =====

test_from_u8_to_u64 :: () -> bool => {
    val: u8 = 42
    result := u64::from(val)
    result == 42
}

test_from_u8_to_i64 :: () -> bool => {
    val: u8 = 100
    result := i64::from(val)
    result == 100
}

test_from_bool_to_i64_true :: () -> bool => {
    val := true
    result := i64::from(val)
    result == 1
}

test_from_bool_to_i64_false :: () -> bool => {
    val := false
    result := i64::from(val)
    result == 0
}

test_from_bool_to_u64_true :: () -> bool => {
    val := true
    result := u64::from(val)
    result == 1
}

test_from_i64_to_string_positive :: () -> bool => {
    val: i64 = 42
    result := String::from(val)
    String::equals(&result, &String::from_cstr("42" as *u8))
}

test_from_i64_to_string_negative :: () -> bool => {
    val: i64 = -42
    result := String::from(val)
    String::equals(&result, &String::from_cstr("-42" as *u8))
}

test_from_u64_to_string :: () -> bool => {
    val: u64 = 999
    result := String::from(val)
    String::equals(&result, &String::from_cstr("999" as *u8))
}

test_from_bool_to_string_true :: () -> bool => {
    val := true
    result := String::from(val)
    String::equals(&result, &String::from_cstr("true" as *u8))
}

test_from_bool_to_string_false :: () -> bool => {
    val := false
    result := String::from(val)
    String::equals(&result, &String::from_cstr("false" as *u8))
}

# ===== INTO TESTS (5 tests) =====

test_into_u8_to_u64 :: () -> bool => {
    val: u8 = 42
    result: u64 = val.into()
    result == 42
}

test_into_bool_to_i64 :: () -> bool => {
    val := true
    result: i64 = val.into()
    result == 1
}

test_into_i64_to_string :: () -> bool => {
    val: i64 = 42
    result: String = val.into()
    String::equals(&result, &String::from_cstr("42" as *u8))
}

test_into_u64_to_string :: () -> bool => {
    val: u64 = 777
    result: String = val.into()
    String::equals(&result, &String::from_cstr("777" as *u8))
}

test_into_bool_to_string :: () -> bool => {
    val := false
    result: String = val.into()
    String::equals(&result, &String::from_cstr("false" as *u8))
}

# ===== TRYFROM TESTS (10 tests) =====

test_tryfrom_u64_to_u8_success :: () -> bool => {
    val: u64 = 100
    result := u8::try_from(val)
    String::contains(&result.to_string(), &String::from_cstr("Ok" as *u8))
}

test_tryfrom_u64_to_u8_overflow :: () -> bool => {
    val: u64 = 300
    result := u8::try_from(val)
    String::contains(&result.to_string(), &String::from_cstr("Err" as *u8))
}

test_tryfrom_i64_to_u8_success :: () -> bool => {
    val: i64 = 50
    result := u8::try_from(val)
    String::contains(&result.to_string(), &String::from_cstr("Ok" as *u8))
}

test_tryfrom_i64_to_u8_negative :: () -> bool => {
    val: i64 = -1
    result := u8::try_from(val)
    String::contains(&result.to_string(), &String::from_cstr("Err" as *u8))
}

test_tryfrom_i64_to_u64_success :: () -> bool => {
    val: i64 = 500
    result := u64::try_from(val)
    String::contains(&result.to_string(), &String::from_cstr("Ok" as *u8))
}

test_tryfrom_i64_to_u64_negative :: () -> bool => {
    val: i64 = -10
    result := u64::try_from(val)
    String::contains(&result.to_string(), &String::from_cstr("Err" as *u8))
}

test_tryfrom_string_to_i64_success :: () -> bool => {
    s := String::from_cstr("42" as *u8)
    result := i64::try_from(s)
    String::contains(&result.to_string(), &String::from_cstr("Ok" as *u8))
}

test_tryfrom_string_to_i64_invalid :: () -> bool => {
    s := String::from_cstr("abc" as *u8)
    result := i64::try_from(s)
    String::contains(&result.to_string(), &String::from_cstr("Err" as *u8))
}

test_tryfrom_string_to_bool_true :: () -> bool => {
    s := String::from_cstr("true" as *u8)
    result := bool::try_from(s)
    String::contains(&result.to_string(), &String::from_cstr("Ok" as *u8))
}

test_tryfrom_string_to_bool_false :: () -> bool => {
    s := String::from_cstr("false" as *u8)
    result := bool::try_from(s)
    String::contains(&result.to_string(), &String::from_cstr("Ok" as *u8))
}

# Main test runner
main :: () -> i64 => {
    println("========================================")
    println("Conversion Traits Test Suite (Simplified)")
    println("========================================")
    println("")
    
    println("===== FROM TESTS (10 tests) =====")
    run_test("u8 -> u64", test_from_u8_to_u64)
    run_test("u8 -> i64", test_from_u8_to_i64)
    run_test("bool -> i64 (true)", test_from_bool_to_i64_true)
    run_test("bool -> i64 (false)", test_from_bool_to_i64_false)
    run_test("bool -> u64 (true)", test_from_bool_to_u64_true)
    run_test("i64 -> String (positive)", test_from_i64_to_string_positive)
    run_test("i64 -> String (negative)", test_from_i64_to_string_negative)
    run_test("u64 -> String", test_from_u64_to_string)
    run_test("bool -> String (true)", test_from_bool_to_string_true)
    run_test("bool -> String (false)", test_from_bool_to_string_false)
    
    println("")
    println("===== INTO TESTS (5 tests) =====")
    run_test("u8.into() -> u64", test_into_u8_to_u64)
    run_test("bool.into() -> i64", test_into_bool_to_i64)
    run_test("i64.into() -> String", test_into_i64_to_string)
    run_test("u64.into() -> String", test_into_u64_to_string)
    run_test("bool.into() -> String", test_into_bool_to_string)
    
    println("")
    println("===== TRYFROM TESTS (10 tests) =====")
    run_test("u64 -> u8 (success)", test_tryfrom_u64_to_u8_success)
    run_test("u64 -> u8 (overflow)", test_tryfrom_u64_to_u8_overflow)
    run_test("i64 -> u8 (success)", test_tryfrom_i64_to_u8_success)
    run_test("i64 -> u8 (negative)", test_tryfrom_i64_to_u8_negative)
    run_test("i64 -> u64 (success)", test_tryfrom_i64_to_u64_success)
    run_test("i64 -> u64 (negative)", test_tryfrom_i64_to_u64_negative)
    run_test("String -> i64 (success)", test_tryfrom_string_to_i64_success)
    run_test("String -> i64 (invalid)", test_tryfrom_string_to_i64_invalid)
    run_test("String -> bool (true)", test_tryfrom_string_to_bool_true)
    run_test("String -> bool (false)", test_tryfrom_string_to_bool_false)
    
    println("")
    println("========================================")
    println("Test Summary:")
    println("Total: " + test_count)
    println("Passed: " + passed_count)
    println("Failed: " + failed_count)
    println("========================================")
    
    if failed_count == 0 {
        println("✅ All tests passed!")
        ret 0
    } else {
        println("❌ Some tests failed")
        ret 1
    }
}
