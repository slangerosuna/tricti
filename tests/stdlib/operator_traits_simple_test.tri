# Simple Operator Traits Test for TriCTI
# Quick verification that operators work

use std::prelude
use std::core::traits
use std::core::string

main :: () -> i64 => do
    println("Testing Operator Traits...")
    println("")
    
    # Test i64 arithmetic
    print("i64 add: ")
    a := 10
    b := 20
    result := Add::add(a, b)
    println_i64(result)
    
    print("i64 sub: ")
    c := 5
    result2 := Sub::sub(a, c)
    println_i64(result2)
    
    print("i64 mul: ")
    d := 3
    result3 := Mul::mul(a, d)
    println_i64(result3)
    
    print("i64 div: ")
    e := 4
    result4 := Div::div(b, e)
    println_i64(result4)
    
    print("i64 neg: ")
    result5 := Neg::neg(a)
    println_i64(result5)
    
    println("")
    
    # Test bitwise
    print("i64 bitand: ")
    x := 12
    y := 10
    result6 := BitAnd::bitand(x, y)
    println_i64(result6)
    
    print("i64 bitor: ")
    result7 := BitOr::bitor(x, y)
    println_i64(result7)
    
    print("i64 bitxor: ")
    result8 := BitXor::bitxor(x, y)
    println_i64(result8)
    
    print("i64 shl: ")
    f := 5
    g := 2
    result9 := Shl::shl(f, g)
    println_i64(result9)
    
    print("i64 shr: ")
    h := 20
    i := 2
    result10 := Shr::shr(h, i)
    println_i64(result10)
    
    print("i64 not: ")
    j := 0
    result11 := Not::not(j)
    println_i64(result11)
    
    println("")
    
    # Test bool bitwise
    print("bool bitand: ")
    t := true
    ff := false
    if BitAnd::bitand(t, ff):
        println("true")
    else:
        println("false")
    
    print("bool bitor: ")
    if BitOr::bitor(t, ff):
        println("true")
    else:
        println("false")
    
    print("bool not: ")
    if Not::not(t):
        println("true")
    else:
        println("false")
    
    println("")
    
    # Test String add
    print("String add: ")
    s1 := String::from_cstr("Hello" as *u8)
    s2 := String::from_cstr(" World" as *u8)
    s3 := Add::add(s1, s2)
    print_cstr(s3.data)
    println("")
    
    println("")
    println("All basic operator tests completed!")
    
    ret 0
