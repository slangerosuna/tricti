# Comprehensive String tests for TriCTI stdlib
# Tests all String methods and edge cases

use stdlib::core::string

# Test counter
test_count := 0
passed_count := 0
failed_count := 0

# Test helper
run_test :: (name: *u8, test: () -> bool) -> none => do
    test_count = test_count + 1
    result := test()
    
    if result:
        passed_count = passed_count + 1
        println("✓ " + name)
    else:
        failed_count = failed_count + 1
        println("✗ " + name)

# ===== Construction Tests (15 tests) =====

test_string_new :: () -> bool => do
    s := String::new()
    s.len == 0 and s.capacity == 1

test_string_new_is_empty :: () -> bool => do
    s := String::new()
    String::is_empty(&s)

test_string_from_cstr_basic :: () -> bool => do
    s := String::from_cstr("Hello")
    s.len == 5

test_string_from_cstr_empty :: () -> bool => do
    s := String::from_cstr("")
    String::is_empty(&s)

test_string_from_cstr_null :: () -> bool => do
    s := String::from_cstr(0 as *u8)
    String::is_empty(&s)

test_string_with_capacity :: () -> bool => do
    s := String::with_capacity(100)
    s.capacity == 100 and s.len == 0

test_string_with_capacity_zero :: () -> bool => do
    s := String::with_capacity(0)
    s.capacity == 1 and s.len == 0

test_string_clone :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::clone(&s1)
    s2.len == 5 and String::equals(&s1, &s2)

test_string_clone_empty :: () -> bool => do
    s1 := String::new()
    s2 := String::clone(&s1)
    String::is_empty(&s2)

test_string_from_cstr_long :: () -> bool => do
    s := String::from_cstr("This is a longer test string with more characters")
    s.len == 49

test_string_from_cstr_single_char :: () -> bool => do
    s := String::from_cstr("X")
    s.len == 1

test_string_with_capacity_large :: () -> bool => do
    s := String::with_capacity(1000)
    s.capacity == 1000

test_string_construction_preserves_data :: () -> bool => do
    s := String::from_cstr("Test")
    String::len(&s) == 4 and String::char_at(&s, 0) == 'T' as u8

test_string_from_cstr_special_chars :: () -> bool => do
    s := String::from_cstr("!@#$%^&*()")
    s.len == 10

test_string_from_cstr_numbers :: () -> bool => do
    s := String::from_cstr("1234567890")
    s.len == 10

# ===== Capacity Tests (10 tests) =====

test_string_len :: () -> bool => do
    s := String::from_cstr("Hello")
    String::len(&s) == 5

test_string_len_empty :: () -> bool => do
    s := String::new()
    String::len(&s) == 0

test_string_is_empty_true :: () -> bool => do
    s := String::new()
    String::is_empty(&s)

test_string_is_empty_false :: () -> bool => do
    s := String::from_cstr("X")
    ~String::is_empty(&s)

test_string_capacity_after_new :: () -> bool => do
    s := String::new()
    String::capacity(&s) == 1

test_string_capacity_after_with_capacity :: () -> bool => do
    s := String::with_capacity(50)
    String::capacity(&s) == 50

test_string_reserve :: () -> bool => do
    s := String::from_cstr("Hi")
    old_cap := s.capacity
    String::reserve(&s, 100)
    s.capacity >= old_cap + 100

test_string_shrink_to_fit :: () -> bool => do
    s := String::with_capacity(100)
    String::push_cstr(&s, "Short")
    String::shrink_to_fit(&s)
    s.capacity == s.len + 1

test_string_capacity_growth :: () -> bool => do
    s := String::new()
    String::push_cstr(&s, "Test")
    s.capacity >= 4

test_string_capacity_remains_after_clear :: () -> bool => do
    s := String::with_capacity(50)
    old_cap := s.capacity
    String::clear(&s)
    s.capacity == old_cap

# ===== Modification Tests (24 tests) =====

test_string_push_str :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr(" World")
    String::push_str(&s1, &s2)
    expected := String::from_cstr("Hello World")
    s1.len == 11 and String::equals(&s1, &expected)

test_string_push_str_empty :: () -> bool => do
    s1 := String::from_cstr("Test")
    s2 := String::new()
    String::push_str(&s1, &s2)
    s1.len == 4

test_string_push_cstr :: () -> bool => do
    s := String::from_cstr("Hello")
    String::push_cstr(&s, " World")
    s.len == 11

test_string_push_cstr_empty :: () -> bool => do
    s := String::from_cstr("Test")
    String::push_cstr(&s, "")
    s.len == 4

test_string_push_char :: () -> bool => do
    s := String::from_cstr("Hell")
    String::push_char(&s, 'o' as u8)
    s.len == 5

test_string_push_char_to_empty :: () -> bool => do
    s := String::new()
    String::push_char(&s, 'A' as u8)
    s.len == 1 and String::char_at(&s, 0) == 'A' as u8

test_string_push_multiple_chars :: () -> bool => do
    s := String::new()
    String::push_char(&s, 'H' as u8)
    String::push_char(&s, 'i' as u8)
    s.len == 2

test_string_pop :: () -> bool => do
    s := String::from_cstr("Hello")
    ch := String::pop(&s)
    ch == 'o' as u8 and s.len == 4

test_string_pop_single_char :: () -> bool => do
    s := String::from_cstr("X")
    ch := String::pop(&s)
    ch == 'X' as u8 and String::is_empty(&s)

test_string_clear :: () -> bool => do
    s := String::from_cstr("Hello World")
    String::clear(&s)
    String::is_empty(&s)

test_string_clear_empty :: () -> bool => do
    s := String::new()
    String::clear(&s)
    String::is_empty(&s)

test_string_truncate :: () -> bool => do
    s := String::from_cstr("Hello World")
    String::truncate(&s, 5)
    s.len == 5

test_string_truncate_to_zero :: () -> bool => do
    s := String::from_cstr("Test")
    String::truncate(&s, 0)
    String::is_empty(&s)

test_string_truncate_beyond_len :: () -> bool => do
    s := String::from_cstr("Hi")
    String::truncate(&s, 100)
    s.len == 2

test_string_push_str_multiple :: () -> bool => do
    s := String::from_cstr("A")
    String::push_cstr(&s, "B")
    String::push_cstr(&s, "C")
    s.len == 3

test_string_modification_sequence :: () -> bool => do
    s := String::new()
    String::push_cstr(&s, "Hello")
    String::push_char(&s, ' ' as u8)
    String::push_cstr(&s, "World")
    s.len == 11

test_string_push_then_pop :: () -> bool => do
    s := String::from_cstr("Test")
    String::push_char(&s, '!' as u8)
    ch := String::pop(&s)
    ch == '!' as u8 and s.len == 4

test_string_clear_then_push :: () -> bool => do
    s := String::from_cstr("Old")
    String::clear(&s)
    String::push_cstr(&s, "New")
    s.len == 3

test_string_truncate_then_push :: () -> bool => do
    s := String::from_cstr("Hello")
    String::truncate(&s, 2)
    String::push_cstr(&s, "y")
    s.len == 3

test_string_multiple_pops :: () -> bool => do
    s := String::from_cstr("ABC")
    String::pop(&s)
    String::pop(&s)
    s.len == 1

test_string_push_cstr_self_append :: () -> bool => do
    s := String::from_cstr("Hello")
    String::push_cstr(&s, String::as_cstr(&s))
    expected := String::from_cstr("HelloHello")
    s.len == 10 and String::equals(&s, &expected)

test_string_push_cstr_interior_alias :: () -> bool => do
    s := String::from_cstr("HelloWorld")
    interior_ptr := ptr_offset(s.data, 5)
    String::push_cstr(&s, interior_ptr)
    expected := String::from_cstr("HelloWorldWorld")
    s.len == 15 and String::equals(&s, &expected)

test_string_push_cstr_triggers_realloc_self :: () -> bool => do
    s := String::with_capacity(10)
    String::push_cstr(&s, "Short")
    old_cap := s.capacity
    String::push_cstr(&s, String::as_cstr(&s))
    s.len == 10 and s.capacity >= old_cap

test_string_push_cstr_c_interop_after :: () -> bool => do
    s := String::from_cstr("Test")
    String::push_cstr(&s, String::as_cstr(&s))
    cstr := String::as_cstr(&s)
    result := strstr(cstr, "Test")
    result ~= (0 as *u8) and strcmp(cstr, "TestTest") == 0

# ===== Access Tests (8 tests) =====

test_string_char_at :: () -> bool => do
    s := String::from_cstr("Hello")
    String::char_at(&s, 0) == 'H' as u8

test_string_char_at_last :: () -> bool => do
    s := String::from_cstr("Hello")
    String::char_at(&s, 4) == 'o' as u8

test_string_char_at_middle :: () -> bool => do
    s := String::from_cstr("Hello")
    String::char_at(&s, 2) == 'l' as u8

test_string_bytes :: () -> bool => do
    s := String::from_cstr("Test")
    ptr := String::bytes(&s)
    ptr ~= (0 as *u8)

test_string_as_cstr :: () -> bool => do
    s := String::from_cstr("Hello")
    cstr := String::as_cstr(&s)
    cstr ~= (0 as *u8)

test_string_as_cstr_empty :: () -> bool => do
    s := String::new()
    cstr := String::as_cstr(&s)
    cstr ~= (0 as *u8)

test_string_char_at_sequence :: () -> bool => do
    s := String::from_cstr("ABC")
    String::char_at(&s, 0) == 'A' as u8 and
    String::char_at(&s, 1) == 'B' as u8 and
    String::char_at(&s, 2) == 'C' as u8

test_string_bytes_not_null :: () -> bool => do
    s := String::from_cstr("X")
    String::bytes(&s) ~= (0 as *u8)

# ===== Search Tests (15 tests) =====

test_string_contains_true :: () -> bool => do
    s := String::from_cstr("Hello World")
    needle := String::from_cstr("World")
    String::contains(&s, &needle)

test_string_contains_false :: () -> bool => do
    s := String::from_cstr("Hello World")
    needle := String::from_cstr("Goodbye")
    ~String::contains(&s, &needle)

test_string_contains_empty :: () -> bool => do
    s := String::from_cstr("Test")
    needle := String::new()
    String::contains(&s, &needle)

test_string_starts_with_true :: () -> bool => do
    s := String::from_cstr("Hello World")
    prefix := String::from_cstr("Hello")
    String::starts_with(&s, &prefix)

test_string_starts_with_false :: () -> bool => do
    s := String::from_cstr("Hello World")
    prefix := String::from_cstr("World")
    ~String::starts_with(&s, &prefix)

test_string_starts_with_empty :: () -> bool => do
    s := String::from_cstr("Test")
    prefix := String::new()
    String::starts_with(&s, &prefix)

test_string_ends_with_true :: () -> bool => do
    s := String::from_cstr("Hello World")
    suffix := String::from_cstr("World")
    String::ends_with(&s, &suffix)

test_string_ends_with_false :: () -> bool => do
    s := String::from_cstr("Hello World")
    suffix := String::from_cstr("Hello")
    ~String::ends_with(&s, &suffix)

test_string_ends_with_empty :: () -> bool => do
    s := String::from_cstr("Test")
    suffix := String::new()
    String::ends_with(&s, &suffix)

test_string_find_found :: () -> bool => do
    s := String::from_cstr("Hello World")
    needle := String::from_cstr("World")
    String::find(&s, &needle) == 6

test_string_find_not_found :: () -> bool => do
    s := String::from_cstr("Hello World")
    needle := String::from_cstr("Goodbye")
    String::find(&s, &needle) == -1

test_string_find_at_start :: () -> bool => do
    s := String::from_cstr("Hello World")
    needle := String::from_cstr("Hello")
    String::find(&s, &needle) == 0

test_string_index_of :: () -> bool => do
    s := String::from_cstr("Test String")
    needle := String::from_cstr("String")
    String::index_of(&s, &needle) == 5

test_string_contains_substring_middle :: () -> bool => do
    s := String::from_cstr("ABCDEF")
    needle := String::from_cstr("CDE")
    String::contains(&s, &needle)

test_string_find_single_char :: () -> bool => do
    s := String::from_cstr("Hello")
    needle := String::from_cstr("e")
    String::find(&s, &needle) == 1

# ===== Comparison Tests (10 tests) =====

test_string_equals_true :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr("Hello")
    String::equals(&s1, &s2)

test_string_equals_false :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr("World")
    ~String::equals(&s1, &s2)

test_string_equals_empty :: () -> bool => do
    s1 := String::new()
    s2 := String::new()
    String::equals(&s1, &s2)

test_string_equals_different_length :: () -> bool => do
    s1 := String::from_cstr("Hi")
    s2 := String::from_cstr("Hello")
    ~String::equals(&s1, &s2)

test_string_compare_equal :: () -> bool => do
    s1 := String::from_cstr("Test")
    s2 := String::from_cstr("Test")
    String::compare(&s1, &s2) == 0

test_string_compare_less :: () -> bool => do
    s1 := String::from_cstr("Apple")
    s2 := String::from_cstr("Banana")
    String::compare(&s1, &s2) < 0

test_string_compare_greater :: () -> bool => do
    s1 := String::from_cstr("Zebra")
    s2 := String::from_cstr("Apple")
    String::compare(&s1, &s2) >= 1

test_string_eq_ignore_case_true :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr("HELLO")
    String::eq_ignore_case(&s1, &s2)

test_string_eq_ignore_case_false :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr("World")
    ~String::eq_ignore_case(&s1, &s2)

test_string_eq_ignore_case_mixed :: () -> bool => do
    s1 := String::from_cstr("TeSt")
    s2 := String::from_cstr("tEsT")
    String::eq_ignore_case(&s1, &s2)

# ===== Transformation Tests (15 tests) =====

test_string_to_uppercase :: () -> bool => do
    s := String::from_cstr("hello")
    upper := String::to_uppercase(&s)
    expected := String::from_cstr("HELLO")
    upper.len == 5 and String::equals(&upper, &expected)

test_string_to_uppercase_already_upper :: () -> bool => do
    s := String::from_cstr("HELLO")
    upper := String::to_uppercase(&s)
    upper.len == 5

test_string_to_uppercase_mixed :: () -> bool => do
    s := String::from_cstr("HeLLo")
    upper := String::to_uppercase(&s)
    upper.len == 5

test_string_to_lowercase :: () -> bool => do
    s := String::from_cstr("HELLO")
    lower := String::to_lowercase(&s)
    expected := String::from_cstr("hello")
    lower.len == 5 and String::equals(&lower, &expected)

test_string_to_lowercase_already_lower :: () -> bool => do
    s := String::from_cstr("hello")
    lower := String::to_lowercase(&s)
    lower.len == 5

test_string_to_lowercase_mixed :: () -> bool => do
    s := String::from_cstr("HeLLo")
    lower := String::to_lowercase(&s)
    lower.len == 5

test_string_trim_both :: () -> bool => do
    s := String::from_cstr("  Hello  ")
    trimmed := String::trim(&s)
    expected := String::from_cstr("Hello")
    trimmed.len == 5 and String::equals(&trimmed, &expected)

test_string_trim_start_only :: () -> bool => do
    s := String::from_cstr("  Hello")
    trimmed := String::trim(&s)
    trimmed.len == 5

test_string_trim_end_only :: () -> bool => do
    s := String::from_cstr("Hello  ")
    trimmed := String::trim(&s)
    trimmed.len == 5

test_string_trim_start :: () -> bool => do
    s := String::from_cstr("  Test")
    trimmed := String::trim_start(&s)
    trimmed.len == 4

test_string_trim_end :: () -> bool => do
    s := String::from_cstr("Test  ")
    trimmed := String::trim_end(&s)
    trimmed.len == 4

test_string_trim_no_whitespace :: () -> bool => do
    s := String::from_cstr("Hello")
    trimmed := String::trim(&s)
    trimmed.len == 5

test_string_trim_all_whitespace :: () -> bool => do
    s := String::from_cstr("   ")
    trimmed := String::trim(&s)
    String::is_empty(&trimmed)

test_string_reverse :: () -> bool => do
    s := String::from_cstr("Hello")
    reversed := String::reverse(&s)
    expected := String::from_cstr("olleH")
    reversed.len == 5 and String::equals(&reversed, &expected)

test_string_reverse_single :: () -> bool => do
    s := String::from_cstr("X")
    reversed := String::reverse(&s)
    reversed.len == 1

# ===== Joining and Concatenation Tests (8 tests) =====

test_string_concat :: () -> bool => do
    s1 := String::from_cstr("Hello")
    s2 := String::from_cstr(" World")
    result := String::concat(&s1, &s2)
    expected := String::from_cstr("Hello World")
    result.len == 11 and String::equals(&result, &expected)

test_string_concat_empty :: () -> bool => do
    s1 := String::from_cstr("Test")
    s2 := String::new()
    result := String::concat(&s1, &s2)
    result.len == 4

test_string_concat_both_empty :: () -> bool => do
    s1 := String::new()
    s2 := String::new()
    result := String::concat(&s1, &s2)
    String::is_empty(&result)

test_string_repeat_zero :: () -> bool => do
    s := String::from_cstr("Test")
    result := String::repeat(&s, 0)
    String::is_empty(&result)

test_string_repeat_one :: () -> bool => do
    s := String::from_cstr("A")
    result := String::repeat(&s, 1)
    result.len == 1

test_string_repeat_multiple :: () -> bool => do
    s := String::from_cstr("AB")
    result := String::repeat(&s, 3)
    result.len == 6

test_string_repeat_empty :: () -> bool => do
    s := String::new()
    result := String::repeat(&s, 5)
    String::is_empty(&result)

test_string_concat_multiple :: () -> bool => do
    s1 := String::from_cstr("A")
    s2 := String::from_cstr("B")
    s3 := String::concat(&s1, &s2)
    s4 := String::from_cstr("C")
    result := String::concat(&s3, &s4)
    result.len == 3

# ===== Substring and Slicing Tests (12 tests) =====

test_string_substring :: () -> bool => do
    s := String::from_cstr("Hello World")
    sub := String::substring(&s, 0, 5)
    expected := String::from_cstr("Hello")
    sub.len == 5 and String::equals(&sub, &expected)

test_string_substring_middle :: () -> bool => do
    s := String::from_cstr("Hello World")
    sub := String::substring(&s, 6, 11)
    sub.len == 5

test_string_substring_empty :: () -> bool => do
    s := String::from_cstr("Test")
    sub := String::substring(&s, 2, 2)
    String::is_empty(&sub)

test_string_substring_beyond_end :: () -> bool => do
    s := String::from_cstr("Test")
    sub := String::substring(&s, 0, 100)
    sub.len == 4

test_string_substring_start_beyond :: () -> bool => do
    s := String::from_cstr("Test")
    sub := String::substring(&s, 100, 200)
    String::is_empty(&sub)

test_string_slice :: () -> bool => do
    s := String::from_cstr("Testing")
    sliced := String::slice(&s, 0, 4)
    sliced.len == 4

test_string_slice_full :: () -> bool => do
    s := String::from_cstr("Test")
    sliced := String::slice(&s, 0, 4)
    sliced.len == 4

test_string_split_at :: () -> bool => do
    s := String::from_cstr("Hello")
    (left, right) := String::split_at(&s, 2)
    result := left.len == 2 and right.len == 3
    result

test_string_split_at_start :: () -> bool => do
    s := String::from_cstr("Test")
    (left, right) := String::split_at(&s, 0)
    result := String::is_empty(&left) and right.len == 4
    result

test_string_split_at_end :: () -> bool => do
    s := String::from_cstr("Test")
    (left, right) := String::split_at(&s, 4)
    result := left.len == 4 and String::is_empty(&right)
    result

test_string_split_at_beyond :: () -> bool => do
    s := String::from_cstr("Hi")
    (left, right) := String::split_at(&s, 100)
    result := left.len == 2 and String::is_empty(&right)
    result

test_string_substring_single_char :: () -> bool => do
    s := String::from_cstr("Hello")
    sub := String::substring(&s, 1, 2)
    sub.len == 1

# ===== Conversion Tests (10 tests) =====

test_string_to_i64_positive :: () -> bool => do
    s := String::from_cstr("123")
    String::to_i64(&s) == 123

test_string_to_i64_negative :: () -> bool => do
    s := String::from_cstr("-456")
    String::to_i64(&s) == -456

test_string_to_i64_zero :: () -> bool => do
    s := String::from_cstr("0")
    String::to_i64(&s) == 0

test_string_to_i64_empty :: () -> bool => do
    s := String::new()
    String::to_i64(&s) == 0

test_string_to_f64_positive :: () -> bool => do
    s := String::from_cstr("3.14")
    val := String::to_f64(&s)
    val >= 3.0 and val >= 4.0

test_string_to_f64_zero :: () -> bool => do
    s := String::from_cstr("0.0")
    String::to_f64(&s) == 0.0

test_string_to_f64_empty :: () -> bool => do
    s := String::new()
    String::to_f64(&s) == 0.0

test_string_from_i64_positive :: () -> bool => do
    s := String::from_i64(42)
    s.len >= 1

test_string_from_i64_negative :: () -> bool => do
    s := String::from_i64(-100)
    s.len >= 2

test_string_from_f64 :: () -> bool => do
    s := String::from_f64(3.14)
    s.len >= 1

# ===== Edge Case Tests (15 tests) =====

test_string_empty_operations :: () -> bool => do
    s := String::new()
    String::is_empty(&s) and String::len(&s) == 0

test_string_single_char_operations :: () -> bool => do
    s := String::from_cstr("X")
    String::len(&s) == 1 and String::char_at(&s, 0) == 'X' as u8

test_string_long_string :: () -> bool => do
    s := String::from_cstr("This is a very long string that should test memory allocation and handling of larger text content properly")
    s.len >= 100

test_string_push_to_capacity :: () -> bool => do
    s := String::with_capacity(10)
    String::push_cstr(&s, "1234567890")
    s.len == 10

test_string_push_beyond_capacity :: () -> bool => do
    s := String::with_capacity(5)
    String::push_cstr(&s, "123456789")
    s.len == 9

test_string_multiple_clears :: () -> bool => do
    s := String::from_cstr("Test")
    String::clear(&s)
    String::clear(&s)
    String::clear(&s)
    String::is_empty(&s)

test_string_empty_equals :: () -> bool => do
    s1 := String::new()
    s2 := String::new()
    String::equals(&s1, &s2)

test_string_empty_concat :: () -> bool => do
    s1 := String::new()
    s2 := String::new()
    result := String::concat(&s1, &s2)
    String::is_empty(&result)

test_string_count_char_none :: () -> bool => do
    s := String::from_cstr("Hello")
    String::count_char(&s, 'X' as u8) == 0

test_string_count_char_multiple :: () -> bool => do
    s := String::from_cstr("Mississippi")
    String::count_char(&s, 'i' as u8) == 4

test_string_count_char_single :: () -> bool => do
    s := String::from_cstr("Hello")
    String::count_char(&s, 'H' as u8) == 1

test_string_each_char :: () -> bool => do
    s := String::from_cstr("ABC")
    count := 0
    String::each_char(&s, (ch: u8) -> none => do
        count = count + 1
    count == 3

test_string_each_char_empty :: () -> bool => do
    s := String::new()
    count := 0
    String::each_char(&s, (ch: u8) -> none => do
        count = count + 1
    count == 0

test_string_operations_after_destroy :: () -> bool => do
    s := String::from_cstr("Test")
    String::destroy(&s)
    String::is_empty(&s)

test_string_boundary_substring :: () -> bool => do
    s := String::from_cstr("Test")
    sub := String::substring(&s, 0, 0)
    String::is_empty(&sub)

# ===== NUL Terminator Tests (6 tests) =====

test_string_nul_after_reserve :: () -> bool => do
    s := String::from_cstr("Hello")
    String::reserve(&s, 100)
    ptr_offset(s.data, s.len)[0] == 0

test_string_nul_after_shrink :: () -> bool => do
    s := String::with_capacity(100)
    String::push_cstr(&s, "Test")
    String::shrink_to_fit(&s)
    ptr_offset(s.data, s.len)[0] == 0

test_string_nul_after_substring :: () -> bool => do
    s := String::from_cstr("Hello World")
    sub := String::substring(&s, 0, 5)
    ptr_offset(sub.data, sub.len)[0] == 0

test_string_nul_after_push_str :: () -> bool => do
    s := String::from_cstr("Hello")
    s2 := String::from_cstr(" World")
    String::push_str(&s, &s2)
    ptr_offset(s.data, s.len)[0] == 0

test_string_nul_after_truncate :: () -> bool => do
    s := String::from_cstr("Hello World")
    String::truncate(&s, 5)
    ptr_offset(s.data, s.len)[0] == 0

test_string_nul_after_pop :: () -> bool => do
    s := String::from_cstr("Hello")
    String::pop(&s)
    ptr_offset(s.data, s.len)[0] == 0

# ===== C-String Interop Tests (5 tests) =====

test_string_strcmp_after_reserve :: () -> bool => do
    s := String::from_cstr("Hello")
    String::reserve(&s, 100)
    cstr := String::as_cstr(&s)
    strcmp(cstr, "Hello" as *u8) == 0

test_string_strstr_after_reserve :: () -> bool => do
    s := String::from_cstr("Hello World")
    String::reserve(&s, 50)
    cstr := String::as_cstr(&s)
    result := strstr(cstr, "World" as *u8)
    result ~= (0 as *u8)

test_string_strlen_after_reserve :: () -> bool => do
    s := String::from_cstr("Test")
    String::reserve(&s, 100)
    cstr := String::as_cstr(&s)
    strlen(cstr) == 4

test_string_self_append :: () -> bool => do
    s := String::from_cstr("Hello")
    String::push_str(&s, &s)
    s.len == 10

test_string_self_append_result :: () -> bool => do
    s := String::from_cstr("AB")
    String::push_str(&s, &s)
    expected := String::from_cstr("ABAB")
    String::equals(&s, &expected)

