# HashMap Bug Fix Tests
# Tests for critical bugs: collision handling, tombstone reuse, hash functions, bounds checking

use prelude
use collections::hashmap

# Note: HashMap currently uses generic hash_value::<K> which returns 0 by default
# This is a known limitation - users must ensure proper hash functions are used
# For testing, we rely on the hash functions defined in hashmap.tri

# ============ Hash Function Tests (5 tests) ============

test_hash_i64_different_values :: () -> bool => {
    h1 := hash_i64(1)
    h2 := hash_i64(2)
    h3 := hash_i64(100)
    h4 := hash_i64(-50)
    
    # All hashes should be different (FNV-1a should produce distinct hashes)
    result := h1 ~= h2 and h1 ~= h3 and h1 ~= h4 and 
              h2 ~= h3 and h2 ~= h4 and h3 ~= h4
    result
}

test_hash_i64_zero :: () -> bool => {
    h1 := hash_i64(0)
    h2 := hash_i64(1)
    
    # Zero should produce a distinct hash
    result := h1 ~= h2 and h1 ~= 0
    result
}

test_hash_u64_different_values :: () -> bool => {
    h1 := hash_u64(1)
    h2 := hash_u64(2)
    h3 := hash_u64(1000)
    
    # All hashes should be different
    result := h1 ~= h2 and h1 ~= h3 and h2 ~= h3
    result
}

test_hash_bool_values :: () -> bool => {
    h_true := hash_bool(true)
    h_false := hash_bool(false)
    
    # true and false should produce different hashes
    result := h_true ~= h_false
    result
}

test_hash_consistency :: () -> bool => {
    # Same value should always produce same hash
    h1 := hash_i64(42)
    h2 := hash_i64(42)
    h3 := hash_i64(42)
    
    result := h1 == h2 and h2 == h3
    result
}

# ============ Collision Handling Tests (10 tests) ============

# Helper: Create a custom hash that forces collisions for testing
# We'll use modulo to force multiple values to same hash
forced_hash :: (value: i64) -> u64 => {
    # Map all values to hash % 4 to force collisions
    (hash_i64(value) % 4)
}

test_collision_insert_distinct_keys :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert keys that will collide (using same hash mod)
    HashMap::insert::<i64, i64>(&map, 1, 100)
    HashMap::insert::<i64, i64>(&map, 2, 200)
    HashMap::insert::<i64, i64>(&map, 3, 300)
    
    # All three should be stored
    result := HashMap::len::<i64, i64>(&map) == 3
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_get_correct_values :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert multiple distinct keys
    HashMap::insert::<i64, i64>(&map, 10, 100)
    HashMap::insert::<i64, i64>(&map, 20, 200)
    HashMap::insert::<i64, i64>(&map, 30, 300)
    
    # Retrieve each value - should get correct one for each key
    v1 := HashMap::get::<i64, i64>(&map, 10)
    v2 := HashMap::get::<i64, i64>(&map, 20)
    v3 := HashMap::get::<i64, i64>(&map, 30)
    
    result := v1 ~= (0 as *i64) and v1[0] == 100 and
              v2 ~= (0 as *i64) and v2[0] == 200 and
              v3 ~= (0 as *i64) and v3[0] == 300
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_remove_correct_key :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert multiple keys
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    
    # Remove key 2
    removed := HashMap::remove::<i64, i64>(&map, 2)
    
    # Key 2 should be removed, but 1 and 3 should remain
    v1 := HashMap::get::<i64, i64>(&map, 1)
    v2 := HashMap::get::<i64, i64>(&map, 2)
    v3 := HashMap::get::<i64, i64>(&map, 3)
    
    result := removed and
              v1 ~= (0 as *i64) and v1[0] == 10 and
              v2 == (0 as *i64) and
              v3 ~= (0 as *i64) and v3[0] == 30 and
              HashMap::len::<i64, i64>(&map) == 2
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_update_correct_key :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert keys
    HashMap::insert::<i64, i64>(&map, 5, 50)
    HashMap::insert::<i64, i64>(&map, 6, 60)
    HashMap::insert::<i64, i64>(&map, 7, 70)
    
    # Update key 6
    HashMap::insert::<i64, i64>(&map, 6, 600)
    
    # Only key 6 should be updated
    v5 := HashMap::get::<i64, i64>(&map, 5)
    v6 := HashMap::get::<i64, i64>(&map, 6)
    v7 := HashMap::get::<i64, i64>(&map, 7)
    
    result := v5 ~= (0 as *i64) and v5[0] == 50 and
              v6 ~= (0 as *i64) and v6[0] == 600 and
              v7 ~= (0 as *i64) and v7[0] == 70 and
              HashMap::len::<i64, i64>(&map) == 3
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_many_keys :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert many keys to force collisions
    for i in 0..20 {
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    }
    
    # Verify all keys are retrievable with correct values
    all_correct := true
    for i in 0..20 {
        val := HashMap::get::<i64, i64>(&map, i as i64)
    if val == (0 as *i64) or val[0] ~= (i * 10) as i64 {
            all_correct = false
        }
    }
    
    result := all_correct and HashMap::len::<i64, i64>(&map) == 20
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_contains_key_accuracy :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    HashMap::insert::<i64, i64>(&map, 10, 100)
    HashMap::insert::<i64, i64>(&map, 11, 110)
    HashMap::insert::<i64, i64>(&map, 12, 120)
    
    # Check that contains_key is accurate for each key
    result := HashMap::contains_key::<i64, i64>(&map, 10) and
              HashMap::contains_key::<i64, i64>(&map, 11) and
              HashMap::contains_key::<i64, i64>(&map, 12) and
              !HashMap::contains_key::<i64, i64>(&map, 13) and
              !HashMap::contains_key::<i64, i64>(&map, 9)
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_sequential_values :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Sequential values often have similar hashes, test them
    for i in 100..110 {
        HashMap::insert::<i64, i64>(&map, i as i64, i as i64)
    }
    
    # Verify all are distinct
    result := HashMap::len::<i64, i64>(&map) == 10
    
    # Verify retrieval
    for i in 100..110 {
        val := HashMap::get::<i64, i64>(&map, i as i64)
    if val == (0 as *i64) or val[0] ~= i as i64 {
            result = false
        }
    }
    
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_negative_positive_keys :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Mix of negative and positive keys
    HashMap::insert::<i64, i64>(&map, -5, 50)
    HashMap::insert::<i64, i64>(&map, 5, 55)
    HashMap::insert::<i64, i64>(&map, -10, 100)
    HashMap::insert::<i64, i64>(&map, 10, 110)
    
    v1 := HashMap::get::<i64, i64>(&map, -5)
    v2 := HashMap::get::<i64, i64>(&map, 5)
    v3 := HashMap::get::<i64, i64>(&map, -10)
    v4 := HashMap::get::<i64, i64>(&map, 10)
    
    result := v1 ~= (0 as *i64) and v1[0] == 50 and
              v2 ~= (0 as *i64) and v2[0] == 55 and
              v3 ~= (0 as *i64) and v3[0] == 100 and
              v4 ~= (0 as *i64) and v4[0] == 110
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_zero_and_nearby :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Test zero and nearby values
    HashMap::insert::<i64, i64>(&map, -1, 10)
    HashMap::insert::<i64, i64>(&map, 0, 20)
    HashMap::insert::<i64, i64>(&map, 1, 30)
    
    v1 := HashMap::get::<i64, i64>(&map, -1)
    v2 := HashMap::get::<i64, i64>(&map, 0)
    v3 := HashMap::get::<i64, i64>(&map, 1)
    
    result := v1 ~= (0 as *i64) and v1[0] == 10 and
              v2 ~= (0 as *i64) and v2[0] == 20 and
              v3 ~= (0 as *i64) and v3[0] == 30
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_collision_large_values :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Large values that might collide
    HashMap::insert::<i64, i64>(&map, 1000000, 1)
    HashMap::insert::<i64, i64>(&map, 1000001, 2)
    HashMap::insert::<i64, i64>(&map, 1000002, 3)
    HashMap::insert::<i64, i64>(&map, 2000000, 4)
    
    v1 := HashMap::get::<i64, i64>(&map, 1000000)
    v2 := HashMap::get::<i64, i64>(&map, 1000001)
    v3 := HashMap::get::<i64, i64>(&map, 1000002)
    v4 := HashMap::get::<i64, i64>(&map, 2000000)
    
    result := v1 ~= (0 as *i64) and v1[0] == 1 and
              v2 ~= (0 as *i64) and v2[0] == 2 and
              v3 ~= (0 as *i64) and v3[0] == 3 and
              v4 ~= (0 as *i64) and v4[0] == 4
    HashMap::destroy::<i64, i64>(&map)
    result
}

# ============ Tombstone Reuse Tests (5 tests) ============

test_tombstone_reuse_basic :: () -> bool => {
    map := HashMap::with_capacity::<i64, i64>(16)
    initial_cap := HashMap::capacity::<i64, i64>(&map)
    
    # Insert, remove, insert again
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::remove::<i64, i64>(&map, 1)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    
    # Capacity should not grow if tombstone is reused
    final_cap := HashMap::capacity::<i64, i64>(&map)
    
    # Value should be retrievable
    val := HashMap::get::<i64, i64>(&map, 2)
    
    result := final_cap == initial_cap and
              val ~= (0 as *i64) and val[0] == 20
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_tombstone_multiple_removals :: () -> bool => {
    map := HashMap::with_capacity::<i64, i64>(32)
    
    # Insert many keys
    for i in 0..10 {
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    }
    
    # Remove half of them
    for i in 0..5 {
        HashMap::remove::<i64, i64>(&map, i as i64)
    }
    
    # Insert new keys - should reuse tombstones
    for i in 10..15 {
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    }
    
    # Verify all expected keys are present
    len := HashMap::len::<i64, i64>(&map)
    
    # Should have keys 5-14 (10 keys total)
    result := len == 10
    
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_tombstone_no_corruption :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert keys
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    
    # Remove middle key
    HashMap::remove::<i64, i64>(&map, 2)
    
    # Insert new key that might use tombstone
    HashMap::insert::<i64, i64>(&map, 4, 40)
    
    # Verify remaining keys are uncorrupted
    v1 := HashMap::get::<i64, i64>(&map, 1)
    v2 := HashMap::get::<i64, i64>(&map, 2)
    v3 := HashMap::get::<i64, i64>(&map, 3)
    v4 := HashMap::get::<i64, i64>(&map, 4)
    
    result := v1 ~= (0 as *i64) and v1[0] == 10 and
              v2 == (0 as *i64) and
              v3 ~= (0 as *i64) and v3[0] == 30 and
              v4 ~= (0 as *i64) and v4[0] == 40
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_tombstone_after_resize :: () -> bool => {
    map := HashMap::with_capacity::<i64, i64>(16)
    
    # Insert many keys to force resize
    for i in 0..20 {
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    }
    
    # Remove some keys
    for i in 0..5 {
        HashMap::remove::<i64, i64>(&map, i as i64)
    }
    
    # Verify remaining keys are intact
    all_correct := true
    for i in 5..20 {
        val := HashMap::get::<i64, i64>(&map, i as i64)
    if val == (0 as *i64) or val[0] ~= (i * 10) as i64 {
            all_correct = false
        }
    }
    
    result := all_correct and HashMap::len::<i64, i64>(&map) == 15
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_tombstone_reinsertion_same_key :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Insert, remove, reinsert same key
    HashMap::insert::<i64, i64>(&map, 42, 100)
    removed := HashMap::remove::<i64, i64>(&map, 42)
    HashMap::insert::<i64, i64>(&map, 42, 200)
    
    val := HashMap::get::<i64, i64>(&map, 42)
    
    result := removed and
              val ~= (0 as *i64) and val[0] == 200 and
              HashMap::len::<i64, i64>(&map) == 1
    HashMap::destroy::<i64, i64>(&map)
    result
}

# ============ Bounds Checking Tests (5 tests) ============

test_bounds_key_at_valid :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    
    # Valid indices should work
    k0 := HashMap::key_at::<i64, i64>(&map, 0)
    k1 := HashMap::key_at::<i64, i64>(&map, 1)
    k2 := HashMap::key_at::<i64, i64>(&map, 2)
    
    # Should get back one of our keys (order may vary)
    result := (k0 == 1 or k0 == 2 or k0 == 3) and
              (k1 == 1 or k1 == 2 or k1 == 3) and
              (k2 == 1 or k2 == 2 or k2 == 3)
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_bounds_value_at_valid :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    
    # Valid indices should work
    v0 := HashMap::value_at::<i64, i64>(&map, 0)
    v1 := HashMap::value_at::<i64, i64>(&map, 1)
    
    # Should get back one of our values
    result := (v0 == 10 or v0 == 20) and
              (v1 == 10 or v1 == 20)
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_bounds_key_at_out_of_range :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    HashMap::insert::<i64, i64>(&map, 1, 10)
    
    # Out of range index - should not crash
    # With bounds checking, should return default or first value
    k := HashMap::key_at::<i64, i64>(&map, 999)
    
    # Should not crash - that's the main success criterion
    result := true
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_bounds_value_at_out_of_range :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    HashMap::insert::<i64, i64>(&map, 1, 10)
    
    # Out of range index
    v := HashMap::value_at::<i64, i64>(&map, 999)
    
    # Should not crash
    result := true
    HashMap::destroy::<i64, i64>(&map)
    result
}

test_bounds_empty_map :: () -> bool => {
    map := HashMap::new::<i64, i64>()
    
    # Accessing empty map should not crash
    k := HashMap::key_at::<i64, i64>(&map, 0)
    v := HashMap::value_at::<i64, i64>(&map, 0)
    
    # Should not crash
    result := true
    HashMap::destroy::<i64, i64>(&map)
    result
}
