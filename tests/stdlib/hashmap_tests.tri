# Comprehensive HashMap Tests
# 70+ tests covering all HashMap functionality

use prelude
use collections::hashmap

# Specialize hash functions for i64
hash_value_i64 :: (value: i64) -> u64 => do
    hash_i64(value)

# ============ Construction Tests (10 tests) ============

test_hashmap_new :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    result := HashMap::len::<i64, i64>(&map) == 0 and 
              HashMap::is_empty::<i64, i64>(&map) and
              HashMap::capacity::<i64, i64>(&map) >= 16
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_with_capacity :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(32)
    result := HashMap::capacity::<i64, i64>(&map) >= 32 and
              HashMap::len::<i64, i64>(&map) == 0
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_with_zero_capacity :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(0)
    result := HashMap::capacity::<i64, i64>(&map) >= 16
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_initial_is_empty :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    result := HashMap::is_empty::<i64, i64>(&map)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_initial_len_zero :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    result := HashMap::len::<i64, i64>(&map) == 0
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_initial_capacity_nonzero :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    result := HashMap::capacity::<i64, i64>(&map) > 0
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_load_factor_initial :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    result := HashMap::load::<i64, i64>(&map) == 0.0
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_large_capacity :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(1000)
    result := HashMap::capacity::<i64, i64>(&map) >= 1000
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_multiple_instances :: () -> bool => do
    map1 := HashMap::new::<i64, i64>()
    map2 := HashMap::new::<i64, i64>()
    result := HashMap::is_empty::<i64, i64>(&map1) and 
              HashMap::is_empty::<i64, i64>(&map2)
    HashMap::destroy::<i64, i64>(&map1)
    HashMap::destroy::<i64, i64>(&map2)
    result

test_hashmap_bool_type :: () -> bool => do
    map := HashMap::new::<i64, bool>()
    result := HashMap::is_empty::<i64, bool>(&map)
    HashMap::destroy::<i64, bool>(&map)
    result

# ============ Insert/Get Tests (15 tests) ============

test_hashmap_insert_get :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    val := HashMap::get::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) and val[0] == 100
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_insert_multiple :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    
    v1 := HashMap::get::<i64, i64>(&map, 1)
    v2 := HashMap::get::<i64, i64>(&map, 2)
    v3 := HashMap::get::<i64, i64>(&map, 3)
    
    result := v1 ~= (0 as *i64) and v1[0] == 10 and
              v2 ~= (0 as *i64) and v2[0] == 20 and
              v3 ~= (0 as *i64) and v3[0] == 30
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_overwrite_value :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    HashMap::insert::<i64, i64>(&map, 42, 200)
    val := HashMap::get::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) and val[0] == 200 and
              HashMap::len::<i64, i64>(&map) == 1
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_get_missing :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    val := HashMap::get::<i64, i64>(&map, 999)
    result := val == (0 as *i64)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_get_from_empty :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    val := HashMap::get::<i64, i64>(&map, 42)
    result := val == (0 as *i64)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_get_mut :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    val := HashMap::get_mut::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) and val[0] == 100
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_get_or_default :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    v1 := HashMap::get_or_default::<i64, i64>(&map, 1, 999)
    v2 := HashMap::get_or_default::<i64, i64>(&map, 999, 777)
    result := v1 == 10 and v2 == 777
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_contains_key :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    result := HashMap::contains_key::<i64, i64>(&map, 42) and
              !HashMap::contains_key::<i64, i64>(&map, 999)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_insert_negative_keys :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, -1, 10)
    HashMap::insert::<i64, i64>(&map, -100, 20)
    v1 := HashMap::get::<i64, i64>(&map, -1)
    v2 := HashMap::get::<i64, i64>(&map, -100)
    result := v1 ~= (0 as *i64) and v1[0] == 10 and
              v2 ~= (0 as *i64) and v2[0] == 20
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_insert_zero :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 0, 42)
    val := HashMap::get::<i64, i64>(&map, 0)
    result := val ~= (0 as *i64) and val[0] == 42
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_bool_values :: () -> bool => do
    map := HashMap::new::<i64, bool>()
    HashMap::insert::<i64, bool>(&map, 1, true)
    HashMap::insert::<i64, bool>(&map, 2, false)
    v1 := HashMap::get::<i64, bool>(&map, 1)
    v2 := HashMap::get::<i64, bool>(&map, 2)
    result := v1 ~= (0 as *bool) and v1[0] == true and
              v2 ~= (0 as *bool) and v2[0] == false
    HashMap::destroy::<i64, bool>(&map)
    result

test_hashmap_large_values :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 9223372036854775807)
    val := HashMap::get::<i64, i64>(&map, 1)
    result := val ~= (0 as *i64) and val[0] == 9223372036854775807
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_sequential_insert :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    for i in 0..10:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 2) as i64)
    
    all_correct := true
    for i in 0..10:
        val := HashMap::get::<i64, i64>(&map, i as i64)
    if val == (0 as *i64) or val[0] ~= (i * 2) as i64:
            all_correct = false
    
    HashMap::destroy::<i64, i64>(&map)
    all_correct

test_hashmap_get_after_overwrite :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 5, 50)
    HashMap::insert::<i64, i64>(&map, 5, 60)
    HashMap::insert::<i64, i64>(&map, 5, 70)
    val := HashMap::get::<i64, i64>(&map, 5)
    result := val ~= (0 as *i64) and val[0] == 70
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_contains_after_insert :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 123, 456)
    result := HashMap::contains_key::<i64, i64>(&map, 123)
    HashMap::destroy::<i64, i64>(&map)
    result

# ============ Remove Tests (10 tests) ============

test_hashmap_remove_existing :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    removed := HashMap::remove::<i64, i64>(&map, 42)
    val := HashMap::get::<i64, i64>(&map, 42)
    result := removed and val == (0 as *i64)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_missing :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    removed := HashMap::remove::<i64, i64>(&map, 999)
    result := !removed
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_from_empty :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    removed := HashMap::remove::<i64, i64>(&map, 42)
    result := !removed
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_updates_len :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    len_before := HashMap::len::<i64, i64>(&map)
    HashMap::remove::<i64, i64>(&map, 1)
    len_after := HashMap::len::<i64, i64>(&map)
    result := len_before == 2 and len_after == 1
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_all :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::remove::<i64, i64>(&map, 1)
    HashMap::remove::<i64, i64>(&map, 2)
    result := HashMap::is_empty::<i64, i64>(&map)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_reinsert :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 42, 100)
    HashMap::remove::<i64, i64>(&map, 42)
    HashMap::insert::<i64, i64>(&map, 42, 200)
    val := HashMap::get::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) and val[0] == 200
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_negative :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, -5, 50)
    removed := HashMap::remove::<i64, i64>(&map, -5)
    val := HashMap::get::<i64, i64>(&map, -5)
    result := removed and val == (0 as *i64)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_zero :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 0, 42)
    removed := HashMap::remove::<i64, i64>(&map, 0)
    result := removed and !HashMap::contains_key::<i64, i64>(&map, 0)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_middle :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    HashMap::remove::<i64, i64>(&map, 2)
    
    result := HashMap::contains_key::<i64, i64>(&map, 1) and
              !HashMap::contains_key::<i64, i64>(&map, 2) and
              HashMap::contains_key::<i64, i64>(&map, 3)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_remove_sequential :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    for i in 0..5:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    
    HashMap::remove::<i64, i64>(&map, 2)
    HashMap::remove::<i64, i64>(&map, 4)
    
    result := HashMap::len::<i64, i64>(&map) == 3 and
              HashMap::contains_key::<i64, i64>(&map, 0) and
              !HashMap::contains_key::<i64, i64>(&map, 2) and
              !HashMap::contains_key::<i64, i64>(&map, 4)
    HashMap::destroy::<i64, i64>(&map)
    result

# ============ Capacity Tests (10 tests) ============

test_hashmap_len_after_insert :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    result := HashMap::len::<i64, i64>(&map) == 2
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_is_empty_false :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    result := !HashMap::is_empty::<i64, i64>(&map)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_capacity_grows :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    initial_cap := HashMap::capacity::<i64, i64>(&map)
    
    for i in 0..100:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 2) as i64)
    
    new_cap := HashMap::capacity::<i64, i64>(&map)
    result := new_cap > initial_cap
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_reserve :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::reserve::<i64, i64>(&map, 100)
    cap := HashMap::capacity::<i64, i64>(&map)
    result := cap >= 100
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_reserve_small :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(100)
    initial_cap := HashMap::capacity::<i64, i64>(&map)
    HashMap::reserve::<i64, i64>(&map, 10)
    new_cap := HashMap::capacity::<i64, i64>(&map)
    result := new_cap == initial_cap
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_shrink_to_fit :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(1000)
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::shrink_to_fit::<i64, i64>(&map)
    cap := HashMap::capacity::<i64, i64>(&map)
    result := cap < 1000
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_shrink_empty :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(1000)
    HashMap::shrink_to_fit::<i64, i64>(&map)
    cap := HashMap::capacity::<i64, i64>(&map)
    result := cap >= 16 and cap < 1000
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_load_factor :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    load := HashMap::load::<i64, i64>(&map)
    result := load > 0.0 and load < 1.0
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_clear :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::clear::<i64, i64>(&map)
    result := HashMap::is_empty::<i64, i64>(&map) and 
              HashMap::len::<i64, i64>(&map) == 0
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_clear_empty :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::clear::<i64, i64>(&map)
    result := HashMap::is_empty::<i64, i64>(&map)
    HashMap::destroy::<i64, i64>(&map)
    result

# ============ Collision Handling Tests (10 tests) ============

test_hashmap_collision_insert :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(16)
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 17, 20)
    
    v1 := HashMap::get::<i64, i64>(&map, 1)
    v2 := HashMap::get::<i64, i64>(&map, 17)
    
    result := v1 ~= (0 as *i64) and v1[0] == 10 and
              v2 ~= (0 as *i64) and v2[0] == 20
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_many_collisions :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(16)
    
    for i in 0..10:
        key := (i * 16) as i64
        HashMap::insert::<i64, i64>(&map, key, (i * 100) as i64)
    
    all_found := true
    for i in 0..10:
        key := (i * 16) as i64
        val := HashMap::get::<i64, i64>(&map, key)
    if val == (0 as *i64) or val[0] ~= (i * 100) as i64:
            all_found = false
    
    HashMap::destroy::<i64, i64>(&map)
    all_found

test_hashmap_probe_distance :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(8)
    HashMap::insert::<i64, i64>(&map, 0, 10)
    HashMap::insert::<i64, i64>(&map, 8, 20)
    HashMap::insert::<i64, i64>(&map, 16, 30)
    
    result := HashMap::len::<i64, i64>(&map) == 3
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_collision_remove :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(16)
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 17, 20)
    HashMap::remove::<i64, i64>(&map, 1)
    
    v1 := HashMap::get::<i64, i64>(&map, 1)
    v2 := HashMap::get::<i64, i64>(&map, 17)
    
    result := v1 == (0 as *i64) and v2 ~= (0 as *i64) and v2[0] == 20
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_collision_overwrite :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(16)
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 17, 20)
    HashMap::insert::<i64, i64>(&map, 1, 100)
    
    v1 := HashMap::get::<i64, i64>(&map, 1)
    result := v1 ~= (0 as *i64) and v1[0] == 100 and
              HashMap::len::<i64, i64>(&map) == 2
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_wrap_around :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(8)
    
    for i in 0..8:
        HashMap::insert::<i64, i64>(&map, (i * 8) as i64, (i * 10) as i64)
    
    result := HashMap::len::<i64, i64>(&map) == 8
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_tombstone_reuse :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::remove::<i64, i64>(&map, 1)
    HashMap::insert::<i64, i64>(&map, 1, 20)
    
    val := HashMap::get::<i64, i64>(&map, 1)
    result := val ~= (0 as *i64) and val[0] == 20
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_dense_hash :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    
    for i in 0..20:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 5) as i64)
    
    result := HashMap::len::<i64, i64>(&map) == 20
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_collision_chain :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(4)
    HashMap::insert::<i64, i64>(&map, 0, 10)
    HashMap::insert::<i64, i64>(&map, 4, 20)
    HashMap::insert::<i64, i64>(&map, 8, 30)
    
    v0 := HashMap::get::<i64, i64>(&map, 0)
    v4 := HashMap::get::<i64, i64>(&map, 4)
    v8 := HashMap::get::<i64, i64>(&map, 8)
    
    result := v0 ~= (0 as *i64) and v0[0] == 10 and
              v4 ~= (0 as *i64) and v4[0] == 20 and
              v8 ~= (0 as *i64) and v8[0] == 30
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_mixed_collision_ops :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(8)
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 9, 20)
    HashMap::insert::<i64, i64>(&map, 17, 30)
    HashMap::remove::<i64, i64>(&map, 9)
    HashMap::insert::<i64, i64>(&map, 25, 40)
    
    result := HashMap::len::<i64, i64>(&map) == 3 and
              HashMap::contains_key::<i64, i64>(&map, 1) and
              !HashMap::contains_key::<i64, i64>(&map, 9) and
              HashMap::contains_key::<i64, i64>(&map, 17) and
              HashMap::contains_key::<i64, i64>(&map, 25)
    HashMap::destroy::<i64, i64>(&map)
    result

# ============ Iteration Tests (5 tests) ============

test_hashmap_keys_count :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    count := HashMap::keys_count::<i64, i64>(&map)
    result := count == 2
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_values_count :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    count := HashMap::values_count::<i64, i64>(&map)
    result := count == 3
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_entries_count :: () -> bool => do
    map := HashMap::new::<i64, i64>()
