# ============ Edge Cases Tests (10 tests) ============

test_hashmap_empty_operations :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    result := HashMap::is_empty::<i64, i64>(&map) and
              HashMap::len::<i64, i64>(&map) == 0 and
              !HashMap::contains_key::<i64, i64>(&map, 0)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_single_element :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 7, 77)
    result := HashMap::len::<i64, i64>(&map) == 1 and
              !HashMap::is_empty::<i64, i64>(&map)
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_resize_trigger :: () -> bool => do
    map := HashMap::with_capacity::<i64, i64>(16)
    initial_cap := HashMap::capacity::<i64, i64>(&map)
    
    for i in 0..20:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 2) as i64)
    
    new_cap := HashMap::capacity::<i64, i64>(&map)
    result := new_cap > initial_cap
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_clone :: () -> bool => do
    map1 := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map1, 1, 10)
    HashMap::insert::<i64, i64>(&map1, 2, 20)
    
    map2 := HashMap::clone::<i64, i64>(&map1)
    
    result := HashMap::len::<i64, i64>(&map2) == 2 and
              HashMap::contains_key::<i64, i64>(&map2, 1) and
              HashMap::contains_key::<i64, i64>(&map2, 2)
    
    HashMap::destroy::<i64, i64>(&map1)
    HashMap::destroy::<i64, i64>(&map2)
    result

test_hashmap_clone_empty :: () -> bool => do
    map1 := HashMap::new::<i64, i64>()
    map2 := HashMap::clone::<i64, i64>(&map1)
    result := HashMap::is_empty::<i64, i64>(&map2)
    HashMap::destroy::<i64, i64>(&map1)
    HashMap::destroy::<i64, i64>(&map2)
    result

test_hashmap_extend :: () -> bool => do
    map1 := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map1, 1, 10)
    
    map2 := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map2, 2, 20)
    HashMap::insert::<i64, i64>(&map2, 3, 30)
    
    HashMap::extend::<i64, i64>(&map1, &map2)
    
    result := HashMap::len::<i64, i64>(&map1) == 3
    HashMap::destroy::<i64, i64>(&map1)
    HashMap::destroy::<i64, i64>(&map2)
    result

test_hashmap_any :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    
    found := HashMap::any::<i64, i64>(&map, (k: i64, v: i64) -> bool => do
        v == 20
    
    result := found
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_all :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    
    all_positive := HashMap::all::<i64, i64>(&map, (k: i64, v: i64) -> bool => do
        v > 0
    
    result := all_positive
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_count_if :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    HashMap::insert::<i64, i64>(&map, 1, 10)
    HashMap::insert::<i64, i64>(&map, 2, 20)
    HashMap::insert::<i64, i64>(&map, 3, 30)
    
    count := HashMap::count_if::<i64, i64>(&map, (k: i64, v: i64) -> bool => do
        v >= 20
    
    result := count == 2
    HashMap::destroy::<i64, i64>(&map)
    result

test_hashmap_large_dataset :: () -> bool => do
    map := HashMap::new::<i64, i64>()
    
    for i in 0..100:
        HashMap::insert::<i64, i64>(&map, i as i64, (i * 3) as i64)
    
    all_correct := true
    for i in 0..100:
        val := HashMap::get::<i64, i64>(&map, i as i64)
    if val == (0 as *i64) or val[0] ~= (i * 3) as i64:
            all_correct = false
    
    result := HashMap::len::<i64, i64>(&map) == 100 and all_correct
    HashMap::destroy::<i64, i64>(&map)
    result
