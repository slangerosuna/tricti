# Comprehensive HashMap Tests
# 70+ tests covering all HashMap functionality

use prelude
use collections::hashmap

# Specialize hash functions for i64
hash_value_i64 :: (value: i64) -> u64 => {
    hash_i64(value)
}

# ============ Construction Tests (10 tests) ============

test_hashmap_new :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    result := HashMap_len::<i64, i64>(&map) == 0 && 
              HashMap_is_empty::<i64, i64>(&map) &&
              HashMap_capacity::<i64, i64>(&map) >= 16
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_with_capacity :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(32)
    result := HashMap_capacity::<i64, i64>(&map) >= 32 &&
              HashMap_len::<i64, i64>(&map) == 0
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_with_zero_capacity :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(0)
    result := HashMap_capacity::<i64, i64>(&map) >= 16
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_initial_is_empty :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    result := HashMap_is_empty::<i64, i64>(&map)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_initial_len_zero :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    result := HashMap_len::<i64, i64>(&map) == 0
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_initial_capacity_nonzero :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    result := HashMap_capacity::<i64, i64>(&map) > 0
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_load_factor_initial :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    result := HashMap_load::<i64, i64>(&map) == 0.0
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_large_capacity :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(1000)
    result := HashMap_capacity::<i64, i64>(&map) >= 1000
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_multiple_instances :: () -> bool => {
    map1 := HashMap_new::<i64, i64>()
    map2 := HashMap_new::<i64, i64>()
    result := HashMap_is_empty::<i64, i64>(&map1) && 
              HashMap_is_empty::<i64, i64>(&map2)
    HashMap_destroy::<i64, i64>(&map1)
    HashMap_destroy::<i64, i64>(&map2)
    result
}

test_hashmap_bool_type :: () -> bool => {
    map := HashMap_new::<i64, bool>()
    result := HashMap_is_empty::<i64, bool>(&map)
    HashMap_destroy::<i64, bool>(&map)
    result
}

# ============ Insert/Get Tests (15 tests) ============

test_hashmap_insert_get :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    val := HashMap_get::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) && val[0] == 100
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_insert_multiple :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    HashMap_insert::<i64, i64>(&map, 3, 30)
    
    v1 := HashMap_get::<i64, i64>(&map, 1)
    v2 := HashMap_get::<i64, i64>(&map, 2)
    v3 := HashMap_get::<i64, i64>(&map, 3)
    
    result := v1 ~= (0 as *i64) && v1[0] == 10 &&
              v2 ~= (0 as *i64) && v2[0] == 20 &&
              v3 ~= (0 as *i64) && v3[0] == 30
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_overwrite_value :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    HashMap_insert::<i64, i64>(&map, 42, 200)
    val := HashMap_get::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) && val[0] == 200 &&
              HashMap_len::<i64, i64>(&map) == 1
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_get_missing :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    val := HashMap_get::<i64, i64>(&map, 999)
    result := val == (0 as *i64)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_get_from_empty :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    val := HashMap_get::<i64, i64>(&map, 42)
    result := val == (0 as *i64)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_get_mut :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    val := HashMap_get_mut::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) && val[0] == 100
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_get_or_default :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    v1 := HashMap_get_or_default::<i64, i64>(&map, 1, 999)
    v2 := HashMap_get_or_default::<i64, i64>(&map, 999, 777)
    result := v1 == 10 && v2 == 777
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_contains_key :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    result := HashMap_contains_key::<i64, i64>(&map, 42) &&
              !HashMap_contains_key::<i64, i64>(&map, 999)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_insert_negative_keys :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, -1, 10)
    HashMap_insert::<i64, i64>(&map, -100, 20)
    v1 := HashMap_get::<i64, i64>(&map, -1)
    v2 := HashMap_get::<i64, i64>(&map, -100)
    result := v1 ~= (0 as *i64) && v1[0] == 10 &&
              v2 ~= (0 as *i64) && v2[0] == 20
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_insert_zero :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 0, 42)
    val := HashMap_get::<i64, i64>(&map, 0)
    result := val ~= (0 as *i64) && val[0] == 42
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_bool_values :: () -> bool => {
    map := HashMap_new::<i64, bool>()
    HashMap_insert::<i64, bool>(&map, 1, true)
    HashMap_insert::<i64, bool>(&map, 2, false)
    v1 := HashMap_get::<i64, bool>(&map, 1)
    v2 := HashMap_get::<i64, bool>(&map, 2)
    result := v1 ~= (0 as *bool) && v1[0] == true &&
              v2 ~= (0 as *bool) && v2[0] == false
    HashMap_destroy::<i64, bool>(&map)
    result
}

test_hashmap_large_values :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 9223372036854775807)
    val := HashMap_get::<i64, i64>(&map, 1)
    result := val ~= (0 as *i64) && val[0] == 9223372036854775807
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_sequential_insert :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    for i in 0:10 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 2) as i64)
    }
    
    all_correct := true
    for i in 0:10 {
        val := HashMap_get::<i64, i64>(&map, i as i64)
        if val == (0 as *i64) || val[0] ~= (i * 2) as i64 {
            all_correct = false
        }
    }
    
    HashMap_destroy::<i64, i64>(&map)
    all_correct
}

test_hashmap_get_after_overwrite :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 5, 50)
    HashMap_insert::<i64, i64>(&map, 5, 60)
    HashMap_insert::<i64, i64>(&map, 5, 70)
    val := HashMap_get::<i64, i64>(&map, 5)
    result := val ~= (0 as *i64) && val[0] == 70
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_contains_after_insert :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 123, 456)
    result := HashMap_contains_key::<i64, i64>(&map, 123)
    HashMap_destroy::<i64, i64>(&map)
    result
}

# ============ Remove Tests (10 tests) ============

test_hashmap_remove_existing :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    removed := HashMap_remove::<i64, i64>(&map, 42)
    val := HashMap_get::<i64, i64>(&map, 42)
    result := removed && val == (0 as *i64)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_missing :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    removed := HashMap_remove::<i64, i64>(&map, 999)
    result := !removed
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_from_empty :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    removed := HashMap_remove::<i64, i64>(&map, 42)
    result := !removed
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_updates_len :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    len_before := HashMap_len::<i64, i64>(&map)
    HashMap_remove::<i64, i64>(&map, 1)
    len_after := HashMap_len::<i64, i64>(&map)
    result := len_before == 2 && len_after == 1
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_all :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    HashMap_remove::<i64, i64>(&map, 1)
    HashMap_remove::<i64, i64>(&map, 2)
    result := HashMap_is_empty::<i64, i64>(&map)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_reinsert :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    HashMap_remove::<i64, i64>(&map, 42)
    HashMap_insert::<i64, i64>(&map, 42, 200)
    val := HashMap_get::<i64, i64>(&map, 42)
    result := val ~= (0 as *i64) && val[0] == 200
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_negative :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, -5, 50)
    removed := HashMap_remove::<i64, i64>(&map, -5)
    val := HashMap_get::<i64, i64>(&map, -5)
    result := removed && val == (0 as *i64)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_zero :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 0, 42)
    removed := HashMap_remove::<i64, i64>(&map, 0)
    result := removed && !HashMap_contains_key::<i64, i64>(&map, 0)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_middle :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    HashMap_insert::<i64, i64>(&map, 3, 30)
    HashMap_remove::<i64, i64>(&map, 2)
    
    result := HashMap_contains_key::<i64, i64>(&map, 1) &&
              !HashMap_contains_key::<i64, i64>(&map, 2) &&
              HashMap_contains_key::<i64, i64>(&map, 3)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_remove_sequential :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    for i in 0:5 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    }
    
    HashMap_remove::<i64, i64>(&map, 2)
    HashMap_remove::<i64, i64>(&map, 4)
    
    result := HashMap_len::<i64, i64>(&map) == 3 &&
              HashMap_contains_key::<i64, i64>(&map, 0) &&
              !HashMap_contains_key::<i64, i64>(&map, 2) &&
              !HashMap_contains_key::<i64, i64>(&map, 4)
    HashMap_destroy::<i64, i64>(&map)
    result
}

# ============ Capacity Tests (10 tests) ============

test_hashmap_len_after_insert :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    result := HashMap_len::<i64, i64>(&map) == 2
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_is_empty_false :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    result := !HashMap_is_empty::<i64, i64>(&map)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_capacity_grows :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    initial_cap := HashMap_capacity::<i64, i64>(&map)
    
    for i in 0:100 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 2) as i64)
    }
    
    new_cap := HashMap_capacity::<i64, i64>(&map)
    result := new_cap > initial_cap
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_reserve :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_reserve::<i64, i64>(&map, 100)
    cap := HashMap_capacity::<i64, i64>(&map)
    result := cap >= 100
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_reserve_small :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(100)
    initial_cap := HashMap_capacity::<i64, i64>(&map)
    HashMap_reserve::<i64, i64>(&map, 10)
    new_cap := HashMap_capacity::<i64, i64>(&map)
    result := new_cap == initial_cap
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_shrink_to_fit :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(1000)
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_shrink_to_fit::<i64, i64>(&map)
    cap := HashMap_capacity::<i64, i64>(&map)
    result := cap < 1000
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_shrink_empty :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(1000)
    HashMap_shrink_to_fit::<i64, i64>(&map)
    cap := HashMap_capacity::<i64, i64>(&map)
    result := cap >= 16 && cap < 1000
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_load_factor :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    load := HashMap_load::<i64, i64>(&map)
    result := load > 0.0 && load < 1.0
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_clear :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    HashMap_clear::<i64, i64>(&map)
    result := HashMap_is_empty::<i64, i64>(&map) && 
              HashMap_len::<i64, i64>(&map) == 0
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_clear_empty :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_clear::<i64, i64>(&map)
    result := HashMap_is_empty::<i64, i64>(&map)
    HashMap_destroy::<i64, i64>(&map)
    result
}

# ============ Collision Handling Tests (10 tests) ============

test_hashmap_collision_insert :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(16)
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 17, 20)
    
    v1 := HashMap_get::<i64, i64>(&map, 1)
    v2 := HashMap_get::<i64, i64>(&map, 17)
    
    result := v1 ~= (0 as *i64) && v1[0] == 10 &&
              v2 ~= (0 as *i64) && v2[0] == 20
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_many_collisions :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(16)
    
    for i in 0:10 {
        key := (i * 16) as i64
        HashMap_insert::<i64, i64>(&map, key, (i * 100) as i64)
    }
    
    all_found := true
    for i in 0:10 {
        key := (i * 16) as i64
        val := HashMap_get::<i64, i64>(&map, key)
        if val == (0 as *i64) || val[0] ~= (i * 100) as i64 {
            all_found = false
        }
    }
    
    HashMap_destroy::<i64, i64>(&map)
    all_found
}

test_hashmap_probe_distance :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(8)
    HashMap_insert::<i64, i64>(&map, 0, 10)
    HashMap_insert::<i64, i64>(&map, 8, 20)
    HashMap_insert::<i64, i64>(&map, 16, 30)
    
    result := HashMap_len::<i64, i64>(&map) == 3
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_collision_remove :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(16)
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 17, 20)
    HashMap_remove::<i64, i64>(&map, 1)
    
    v1 := HashMap_get::<i64, i64>(&map, 1)
    v2 := HashMap_get::<i64, i64>(&map, 17)
    
    result := v1 == (0 as *i64) && v2 ~= (0 as *i64) && v2[0] == 20
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_collision_overwrite :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(16)
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 17, 20)
    HashMap_insert::<i64, i64>(&map, 1, 100)
    
    v1 := HashMap_get::<i64, i64>(&map, 1)
    result := v1 ~= (0 as *i64) && v1[0] == 100 &&
              HashMap_len::<i64, i64>(&map) == 2
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_wrap_around :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(8)
    
    for i in 0:8 {
        HashMap_insert::<i64, i64>(&map, (i * 8) as i64, (i * 10) as i64)
    }
    
    result := HashMap_len::<i64, i64>(&map) == 8
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_tombstone_reuse :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_remove::<i64, i64>(&map, 1)
    HashMap_insert::<i64, i64>(&map, 1, 20)
    
    val := HashMap_get::<i64, i64>(&map, 1)
    result := val ~= (0 as *i64) && val[0] == 20
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_dense_hash :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    
    for i in 0:20 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 5) as i64)
    }
    
    result := HashMap_len::<i64, i64>(&map) == 20
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_collision_chain :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(4)
    HashMap_insert::<i64, i64>(&map, 0, 10)
    HashMap_insert::<i64, i64>(&map, 4, 20)
    HashMap_insert::<i64, i64>(&map, 8, 30)
    
    v0 := HashMap_get::<i64, i64>(&map, 0)
    v4 := HashMap_get::<i64, i64>(&map, 4)
    v8 := HashMap_get::<i64, i64>(&map, 8)
    
    result := v0 ~= (0 as *i64) && v0[0] == 10 &&
              v4 ~= (0 as *i64) && v4[0] == 20 &&
              v8 ~= (0 as *i64) && v8[0] == 30
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_mixed_collision_ops :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(8)
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 9, 20)
    HashMap_insert::<i64, i64>(&map, 17, 30)
    HashMap_remove::<i64, i64>(&map, 9)
    HashMap_insert::<i64, i64>(&map, 25, 40)
    
    result := HashMap_len::<i64, i64>(&map) == 3 &&
              HashMap_contains_key::<i64, i64>(&map, 1) &&
              !HashMap_contains_key::<i64, i64>(&map, 9) &&
              HashMap_contains_key::<i64, i64>(&map, 17) &&
              HashMap_contains_key::<i64, i64>(&map, 25)
    HashMap_destroy::<i64, i64>(&map)
    result
}

# ============ Iteration Tests (5 tests) ============

test_hashmap_keys_count :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    count := HashMap_keys_count::<i64, i64>(&map)
    result := count == 2
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_values_count :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    HashMap_insert::<i64, i64>(&map, 3, 30)
    count := HashMap_values_count::<i64, i64>(&map)
    result := count == 3
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_entries_count :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    for i in 0:5 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 10) as i64)
    }
    count := HashMap_entries_count::<i64, i64>(&map)
    result := count == 5
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_key_at :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    key := HashMap_key_at::<i64, i64>(&map, 0)
    result := key == 42
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_value_at :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 42, 100)
    val := HashMap_value_at::<i64, i64>(&map, 0)
    result := val == 100
    HashMap_destroy::<i64, i64>(&map)
    result
}

# ============ Edge Cases Tests (10 tests) ============

test_hashmap_empty_operations :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    result := HashMap_is_empty::<i64, i64>(&map) &&
              HashMap_len::<i64, i64>(&map) == 0 &&
              !HashMap_contains_key::<i64, i64>(&map, 0)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_single_element :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 7, 77)
    result := HashMap_len::<i64, i64>(&map) == 1 &&
              !HashMap_is_empty::<i64, i64>(&map)
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_resize_trigger :: () -> bool => {
    map := HashMap_with_capacity::<i64, i64>(16)
    initial_cap := HashMap_capacity::<i64, i64>(&map)
    
    for i in 0:20 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 2) as i64)
    }
    
    new_cap := HashMap_capacity::<i64, i64>(&map)
    result := new_cap > initial_cap
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_clone :: () -> bool => {
    map1 := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map1, 1, 10)
    HashMap_insert::<i64, i64>(&map1, 2, 20)
    
    map2 := HashMap_clone::<i64, i64>(&map1)
    
    result := HashMap_len::<i64, i64>(&map2) == 2 &&
              HashMap_contains_key::<i64, i64>(&map2, 1) &&
              HashMap_contains_key::<i64, i64>(&map2, 2)
    
    HashMap_destroy::<i64, i64>(&map1)
    HashMap_destroy::<i64, i64>(&map2)
    result
}

test_hashmap_clone_empty :: () -> bool => {
    map1 := HashMap_new::<i64, i64>()
    map2 := HashMap_clone::<i64, i64>(&map1)
    result := HashMap_is_empty::<i64, i64>(&map2)
    HashMap_destroy::<i64, i64>(&map1)
    HashMap_destroy::<i64, i64>(&map2)
    result
}

test_hashmap_extend :: () -> bool => {
    map1 := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map1, 1, 10)
    
    map2 := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map2, 2, 20)
    HashMap_insert::<i64, i64>(&map2, 3, 30)
    
    HashMap_extend::<i64, i64>(&map1, &map2)
    
    result := HashMap_len::<i64, i64>(&map1) == 3
    HashMap_destroy::<i64, i64>(&map1)
    HashMap_destroy::<i64, i64>(&map2)
    result
}

test_hashmap_any :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    
    found := HashMap_any::<i64, i64>(&map, (k: i64, v: i64) -> bool => {
        v == 20
    })
    
    result := found
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_all :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    
    all_positive := HashMap_all::<i64, i64>(&map, (k: i64, v: i64) -> bool => {
        v > 0
    })
    
    result := all_positive
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_count_if :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    HashMap_insert::<i64, i64>(&map, 1, 10)
    HashMap_insert::<i64, i64>(&map, 2, 20)
    HashMap_insert::<i64, i64>(&map, 3, 30)
    
    count := HashMap_count_if::<i64, i64>(&map, (k: i64, v: i64) -> bool => {
        v >= 20
    })
    
    result := count == 2
    HashMap_destroy::<i64, i64>(&map)
    result
}

test_hashmap_large_dataset :: () -> bool => {
    map := HashMap_new::<i64, i64>()
    
    for i in 0:100 {
        HashMap_insert::<i64, i64>(&map, i as i64, (i * 3) as i64)
    }
    
    all_correct := true
    for i in 0:100 {
        val := HashMap_get::<i64, i64>(&map, i as i64)
        if val == (0 as *i64) || val[0] ~= (i * 3) as i64 {
            all_correct = false
        }
    }
    
    result := HashMap_len::<i64, i64>(&map) == 100 && all_correct
    HashMap_destroy::<i64, i64>(&map)
    result
}
