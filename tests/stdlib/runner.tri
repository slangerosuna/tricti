# Test Runner for TriCTI stdlib tests
# Documentation for running stdlib tests

# ==============================================================================
# HOW TO RUN TESTS
# ==============================================================================
#
# Since TriCTI doesn't yet have a full module import system for tests,
# run each test file separately:
#
# 1. Platform Tests:
#    ./run-tricti.sh stdlib/test/platform_tests.tri
#    
#    Tests: timestamps, memory allocation, platform capabilities
#
# 2. Collections Tests:
#    ./run-tricti.sh stdlib/test/collections_tests.tri
#    
#    Tests: Vec<u64> - new, push, pop, set, get, is_empty
#
# ==============================================================================
# TEST FRAMEWORK
# ==============================================================================
#
# All tests use stdlib/test/test_framework.tri which provides:
#   - assert_true(condition, message) -> bool
#   - assert_false(condition, message) -> bool
#   - assert_eq_u64(actual, expected, message) -> bool
#   - assert_eq_i64(actual, expected, message) -> bool
#   - assert_ne_u64(actual, expected, message) -> bool
#   - assert_ne_i64(actual, expected, message) -> bool
#
# ==============================================================================
# TDD METHODOLOGY
# ==============================================================================
#
# These tests demonstrate TDD best practices:
#   1. Each test is focused on a single behavior
#   2. Tests use descriptive names (test_vec_u64_push, test_timestamp_monotonic)
#   3. Tests follow Arrange-Act-Assert pattern
#   4. Comparison expressions use parentheses for parser compatibility
#   5. Tests validate return values and side effects
#
# ==============================================================================

use std::prelude

main :: () => do
    println("=== TriCTI Stdlib Test Suite ===")
    println("")
    println("This runner provides documentation for the test suite.")
    println("Run individual test files to execute tests:")
    println("")
    println("  Platform Tests:")
    println("    ./run-tricti.sh stdlib/test/platform_tests.tri")
    println("")
    println("  Collections Tests:")
    println("    ./run-tricti.sh stdlib/test/collections_tests.tri")
    println("")
    println("Each test file includes a run_*_tests() function that")
    println("executes all tests and reports results.")
    println("")
