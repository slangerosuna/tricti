# Primitive Display tests
test_display_bool_true :: () -> none => {
    b := true
    s := b.to_string()
    expected := String::from_cstr("true" as *u8)
    test_assert(s.eq(&expected), "bool true display")
}

test_display_bool_false :: () -> none => {
    b := false
    s := b.to_string()
    expected := String::from_cstr("false" as *u8)
    test_assert(s.eq(&expected), "bool false display")
}

test_display_i64_positive :: () -> none => {
    n := 42
    s := n.to_string()
    test_assert(s.len > 0, "i64 positive display")
}

test_display_i64_negative :: () -> none => {
    n := -42
    s := n.to_string()
    test_assert(s.len > 0, "i64 negative display")
}

test_display_i64_zero :: () -> none => {
    n := 0
    s := n.to_string()
    test_assert(s.len > 0, "i64 zero display")
}

test_display_u64 :: () -> none => {
    n := 100 as u64
    s := n.to_string()
    test_assert(s.len > 0, "u64 display")
}

test_display_u64_large :: () -> none => {
    n := 9223372036854775808 as u64
    s := n.to_string()
    expected := String::from_cstr("9223372036854775808" as *u8)
    test_assert(s.eq(&expected), "u64 display large value > i64::MAX")
}

test_display_u64_max :: () -> none => {
    n := 18446744073709551615 as u64
    s := n.to_string()
    expected := String::from_cstr("18446744073709551615" as *u8)
    test_assert(s.eq(&expected), "u64 display max value")
}

test_display_u64_near_i64_max :: () -> none => {
    n := 9223372036854775807 as u64
    s := n.to_string()
    expected := String::from_cstr("9223372036854775807" as *u8)
    test_assert(s.eq(&expected), "u64 display i64::MAX")
}

test_debug_u64_large :: () -> none => {
    n := 9223372036854775808 as u64
    s := n.debug_string()
    expected := String::from_cstr("9223372036854775808" as *u8)
    test_assert(s.eq(&expected), "u64 debug large value > i64::MAX")
}

test_debug_u64_max :: () -> none => {
    n := 18446744073709551615 as u64
    s := n.debug_string()
    expected := String::from_cstr("18446744073709551615" as *u8)
    test_assert(s.eq(&expected), "u64 debug max value")
}

test_display_u8 :: () -> none => {
    n := 255 as u8
    s := n.to_string()
    test_assert(s.len > 0, "u8 display")
}

test_display_f64 :: () -> none => {
    f := 3.14
    s := f.to_string()
    test_assert(s.len > 0, "f64 display")
}

# String Display tests
test_display_string :: () -> none => {
    s := String::from_cstr("hello" as *u8)
    d := s.to_string()
    test_assert(s.eq(&d), "string display identity")
}

test_display_string_empty :: () -> none => {
    s := String::new()
    d := s.to_string()
    test_assert(d.len == 0, "empty string display")
}

# Debug tests
test_debug_bool :: () -> none => {
    b := true
    s := b.debug_string()
    expected := String::from_cstr("true" as *u8)
    test_assert(s.eq(&expected), "bool debug")
}

test_debug_i64 :: () -> none => {
    n := 42
    s := n.debug_string()
    test_assert(s.len > 0, "i64 debug")
}

test_debug_u64 :: () -> none => {
    n := 100 as u64
    s := n.debug_string()
    test_assert(s.len > 0, "u64 debug")
}

test_debug_f64 :: () -> none => {
    f := 2.71828
    s := f.debug_string()
    test_assert(s.len > 0, "f64 debug")
}

test_debug_string_quoted :: () -> none => {
    s := String::from_cstr("test" as *u8)
    d := s.debug_string()
    first := d.char_at(0)
    last := d.char_at(d.len - 1)
    test_assert(first == 34, "string debug starts with quote")
    test_assert(last == 34, "string debug ends with quote")
}

# Option Display/Debug tests
test_display_option_none :: () -> none => {
    o := none as ?i64
    s := o.to_string()
    expected := String::from_cstr("None" as *u8)
    test_assert(s.eq(&expected), "option none display")
}

test_display_option_some :: () -> none => {
    o := some 5
    s := o.to_string()
    test_assert(s.contains(&String::from_cstr("Some(" as *u8)), "option some display contains 'Some('")
    test_assert(s.contains(&String::from_cstr("5" as *u8)), "option some display contains value")
}

test_debug_option_none :: () -> none => {
    o := none as ?i64
    s := o.debug_string()
    expected := String::from_cstr("None" as *u8)
    test_assert(s.eq(&expected), "option none debug")
}

test_debug_option_some :: () -> none => {
    o := some 42
    s := o.debug_string()
    test_assert(s.contains(&String::from_cstr("Some(" as *u8)), "option some debug format")
}

# Result Display/Debug tests
test_display_result_ok :: () -> none => {
    r := std_ok(5)
    s := r.to_string()
    test_assert(s.contains(&String::from_cstr("Ok(" as *u8)), "result ok display contains 'Ok('")
    test_assert(s.contains(&String::from_cstr("5" as *u8)), "result ok display contains value")
}

test_display_result_err :: () -> none => {
    r := std_err::<i64>(std_error_message_only("test error"))
    s := r.to_string()
    test_assert(s.contains(&String::from_cstr("Err(" as *u8)), "result err display contains 'Err('")
}

test_debug_result_ok :: () -> none => {
    r := std_ok(42)
    s := r.debug_string()
    test_assert(s.contains(&String::from_cstr("Ok(" as *u8)), "result ok debug format")
}

test_debug_result_err :: () -> none => {
    r := std_err::<i64>(std_error_message_only("error message"))
    s := r.debug_string()
    test_assert(s.contains(&String::from_cstr("Err(" as *u8)), "result err debug format")
}

# Special cases
test_display_f64_special :: () -> none => {
    zero := 0.0
    neg_zero := -0.0
    s1 := zero.to_string()
    s2 := neg_zero.to_string()
    test_assert(s1.len > 0, "f64 zero display")
    test_assert(s2.len > 0, "f64 negative zero display")
}

# =============================================================================
# DEFAULT TESTS (20+ tests)
# =============================================================================

# bool default
test_default_bool :: () -> none => {
    b := bool::default()
    test_assert_eq_bool(b, false, "bool default is false")
}

# Numeric defaults
test_default_i64 :: () -> none => {
    n := i64::default()
    test_assert_eq_i64(n, 0, "i64 default is 0")
}

test_default_u64 :: () -> none => {
    n := u64::default()
    test_assert(n == 0, "u64 default is 0")
}

test_default_u8 :: () -> none => {
    n := u8::default()
    test_assert(n == 0, "u8 default is 0")
}

test_default_f64 :: () -> none => {
    f := f64::default()
    test_assert(f == 0.0, "f64 default is 0.0")
}

# String default
test_default_string :: () -> none => {
    s := String::default()
    test_assert(s.is_empty(), "string default is empty")
    test_assert_eq_i64(s.len as i64, 0, "string default length is 0")
}

# Option default
test_default_option :: () -> none => {
    o := (?i64)::default()
    match o {
        none => test_assert(true, "option default is none"),
        _ => test_assert(false, "option default should be none"),
    }
}

test_default_option_bool :: () -> none => {
    o := (?bool)::default()
    match o {
        none => test_assert(true, "option<bool> default is none"),
        _ => test_assert(false, "option<bool> default should be none"),
    }
}

test_default_option_string :: () -> none => {
    o := (?String)::default()
    match o {
        none => test_assert(true, "option<string> default is none"),
        _ => test_assert(false, "option<string> default should be none"),
    }
}

# Default usage tests
test_default_initialization_i64 :: () -> none => {
    n := i64::default()
    test_assert(n.eq(&0), "i64 default usable")
}

test_default_initialization_bool :: () -> none => {
    b := bool::default()
    test_assert(b.eq(&false), "bool default usable")
}

test_default_initialization_string :: () -> none => {
    s := String::default()
    empty := String::new()
    test_assert(s.eq(&empty), "string default usable")
}

# Multiple defaults
test_default_multiple_i64 :: () -> none => {
    a := i64::default()
    b := i64::default()
    test_assert(a.eq(&b), "multiple i64 defaults equal")
}

test_default_multiple_bool :: () -> none => {
    a := bool::default()
    b := bool::default()
    test_assert(a.eq(&b), "multiple bool defaults equal")
}

test_default_multiple_string :: () -> none => {
    s1 := String::default()
    s2 := String::default()
    test_assert(s1.eq(&s2), "multiple string defaults equal")
}

# Default comparisons
test_default_compare_i64 :: () -> none => {
    d := i64::default()
    zero := 0
    test_assert(d.eq(&zero), "i64 default equals 0")
}

test_default_compare_bool :: () -> none => {
    d := bool::default()
    f := false
    test_assert(d.eq(&f), "bool default equals false")
}

# Default with operations
test_default_with_ops_i64 :: () -> none => {
    d := i64::default()
    result := d + 10
    test_assert_eq_i64(result, 10, "i64 default + 10")
}

test_default_with_ops_bool :: () -> none => {
    d := bool::default()
    result := d or true
    test_assert_eq_bool(result, true, "bool default or true")
}

# =============================================================================
# CROSS-TRAIT LAW TESTS (10+ tests)
# =============================================================================

# PartialEq + PartialOrd consistency: x == y iff partial_cmp(x,y) == Some(0)
test_law_eq_partialord_i64 :: () -> none => {
    a := 42
    b := 42
    c := 100
    
    eq_ab := a.eq(&b)
    cmp_ab := a.partial_cmp(&b)
    match cmp_ab {
        some 0 => test_assert(eq_ab, "i64 eq-partialord law equal"),
        _ => test_assert(~eq_ab, "i64 eq-partialord law not zero"),
    }
    
    eq_ac := a.eq(&c)
    cmp_ac := a.partial_cmp(&c)
    match cmp_ac {
        some 0 => test_assert(eq_ac, "i64 eq-partialord law not equal 1"),
        _ => test_assert(~eq_ac, "i64 eq-partialord law not equal 2"),
    }
}

test_law_eq_partialord_bool :: () -> none => {
    t := true
    f := false
    
    eq := t.eq(&t)
    cmp := t.partial_cmp(&t)
    match cmp {
        some 0 => test_assert(eq, "bool eq-partialord law"),
        _ => test_assert(~eq, "bool eq-partialord law not zero"),
    }
}

test_law_eq_partialord_u64 :: () -> none => {
    a := 50 as u64
    b := 50 as u64
    
    eq := a.eq(&b)
    cmp := a.partial_cmp(&b)
    match cmp {
        some 0 => test_assert(eq, "u64 eq-partialord law"),
        _ => test_assert(~eq, "u64 eq-partialord law not zero"),
    }
}

# Ord + Eq consistency: x == y iff cmp(x,y) == 0
test_law_ord_eq_i64 :: () -> none => {
    a := 7
    b := 7
    c := 10
    
    eq_ab := a.eq(&b)
    cmp_ab := a.cmp(&b)
    test_assert(eq_ab == (cmp_ab == 0), "i64 ord-eq law equal")
    
    eq_ac := a.eq(&c)
    cmp_ac := a.cmp(&c)
    test_assert(eq_ac == (cmp_ac == 0), "i64 ord-eq law not equal")
}

test_law_ord_eq_bool :: () -> none => {
    t := true
    f := false
    
    eq := t.eq(&f)
    cmp := t.cmp(&f)
    test_assert(eq == (cmp == 0), "bool ord-eq law")
}

test_law_ord_eq_u64 :: () -> none => {
    a := 100 as u64
    b := 100 as u64
    
    eq := a.eq(&b)
    cmp := a.cmp(&b)
    test_assert(eq == (cmp == 0), "u64 ord-eq law")
}

# Ord requires Eq: types implementing Ord must also implement Eq
test_ord_requires_eq_i64 :: () -> none => {
    a := 42
    b := 42
    c := 100
    test_assert(a.eq(&b), "i64 Ord type implements Eq - equal")
    test_assert(~a.eq(&c), "i64 Ord type implements Eq - not equal")
}

test_ord_requires_eq_bool :: () -> none => {
    t := true
    f := false
    test_assert(t.eq(&t), "bool Ord type implements Eq - true")
    test_assert(f.eq(&f), "bool Ord type implements Eq - false")
    test_assert(~t.eq(&f), "bool Ord type implements Eq - different")
}

test_ord_requires_eq_u64 :: () -> none => {
    a := 9223372036854775808 as u64
    b := 9223372036854775808 as u64
    c := 18446744073709551615 as u64
    test_assert(a.eq(&b), "u64 Ord type implements Eq - large equal")
    test_assert(~a.eq(&c), "u64 Ord type implements Eq - large not equal")
}

test_ord_requires_eq_u8 :: () -> none => {
    a := 255 as u8
    b := 255 as u8
    c := 128 as u8
    test_assert(a.eq(&b), "u8 Ord type implements Eq - equal")
    test_assert(~a.eq(&c), "u8 Ord type implements Eq - not equal")
}

test_ord_requires_eq_string :: () -> none => {
    s1 := String::from_cstr("hello" as *u8)
    s2 := String::from_cstr("hello" as *u8)
    s3 := String::from_cstr("world" as *u8)
    test_assert(s1.eq(&s2), "String Ord type implements Eq - equal")
    test_assert(~s1.eq(&s3), "String Ord type implements Eq - not equal")
}

# Clone + Eq: clone(x) == x
test_law_clone_eq_i64 :: () -> none => {
    a := 42
    b := a.clone()
    test_assert(a.eq(&b), "i64 clone-eq law")
}

test_law_clone_eq_bool :: () -> none => {
    t := true
    c := t.clone()
    test_assert(t.eq(&c), "bool clone-eq law")
}

test_law_clone_eq_u64 :: () -> none => {
    a := 100 as u64
    c := a.clone()
    test_assert(a.eq(&c), "u64 clone-eq law")
}

test_law_clone_eq_string :: () -> none => {
    s := String::from_cstr("test" as *u8)
    c := s.clone()
    test_assert(s.eq(&c), "string clone-eq law")
}

test_law_clone_eq_option :: () -> none => {
    o := some 42
    c := o.clone()
    test_assert(o.eq(&c), "option clone-eq law")
}

test_law_clone_eq_result :: () -> none => {
    r := std_ok(42)
    c := r.clone()
    test_assert(r.eq(&c), "result clone-eq law")
}

