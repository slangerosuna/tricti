# Foundation Traits Tests for TriCTI stdlib
# Comprehensive test suite with 150+ tests for core trait system

use prelude
use core::traits
use core::string

# =============================================================================
# Test Framework Helpers
# =============================================================================

test_count := 0
passed_count := 0
failed_count := 0

test_assert :: (condition: bool, test_name: string) -> none => {
    test_count = test_count + 1
    if condition {
        passed_count = passed_count + 1
        println("[PASS]", test_name)
    } else {
        failed_count = failed_count + 1
        println("[FAIL]", test_name)
    }
}

test_assert_eq_i64 :: (actual: i64, expected: i64, test_name: string) -> none => {
    test_assert(actual == expected, test_name)
}

test_assert_eq_bool :: (actual: bool, expected: bool, test_name: string) -> none => {
    test_assert(actual == expected, test_name)
}

# =============================================================================
# PARTIALEQ/EQ TESTS (30+ tests)
# =============================================================================

# Reflexivity tests (x == x)
test_partialeq_reflexivity_bool :: () -> none => {
    a := true
    b := false
    test_assert(a.eq(&a), "bool reflexivity true")
    test_assert(b.eq(&b), "bool reflexivity false")
}

test_partialeq_reflexivity_i64 :: () -> none => {
    a := 42
    b := -100
    c := 0
    test_assert(a.eq(&a), "i64 reflexivity positive")
    test_assert(b.eq(&b), "i64 reflexivity negative")
    test_assert(c.eq(&c), "i64 reflexivity zero")
}

test_partialeq_reflexivity_u64 :: () -> none => {
    a := 100 as u64
    b := 0 as u64
    test_assert(a.eq(&a), "u64 reflexivity positive")
    test_assert(b.eq(&b), "u64 reflexivity zero")
}

test_partialeq_reflexivity_u8 :: () -> none => {
    a := 255 as u8
    b := 0 as u8
    test_assert(a.eq(&a), "u8 reflexivity max")
    test_assert(b.eq(&b), "u8 reflexivity zero")
}

test_partialeq_reflexivity_f64 :: () -> none => {
    a := 3.14
    b := -2.5
    c := 0.0
    test_assert(a.eq(&a), "f64 reflexivity positive")
    test_assert(b.eq(&b), "f64 reflexivity negative")
    test_assert(c.eq(&c), "f64 reflexivity zero")
}

# Symmetry tests (x == y implies y == x)
test_partialeq_symmetry_i64 :: () -> none => {
    a := 42
    b := 42
    c := 100
    test_assert(a.eq(&b) == b.eq(&a), "i64 symmetry equal")
    test_assert(a.eq(&c) == c.eq(&a), "i64 symmetry not equal")
}

test_partialeq_symmetry_bool :: () -> none => {
    t := true
    f := false
    test_assert(t.eq(&t) == t.eq(&t), "bool symmetry true-true")
    test_assert(f.eq(&f) == f.eq(&f), "bool symmetry false-false")
    test_assert(t.eq(&f) == f.eq(&t), "bool symmetry true-false")
}

test_partialeq_symmetry_u64 :: () -> none => {
    a := 100 as u64
    b := 100 as u64
    c := 200 as u64
    test_assert(a.eq(&b) == b.eq(&a), "u64 symmetry equal")
    test_assert(a.eq(&c) == c.eq(&a), "u64 symmetry not equal")
}

# Transitivity tests (x == y and y == z implies x == z)
test_partialeq_transitivity_i64 :: () -> none => {
    a := 5
    b := 5
    c := 5
    xy := a.eq(&b)
    yz := b.eq(&c)
    xz := a.eq(&c)
    test_assert(~xy or ~yz or xz, "i64 transitivity")
}

test_partialeq_transitivity_bool :: () -> none => {
    a := true
    b := true
    c := true
    xy := a.eq(&b)
    yz := b.eq(&c)
    xz := a.eq(&c)
    test_assert(~xy or ~yz or xz, "bool transitivity")
}

# ne consistency tests (x != y == !(x == y))
test_partialeq_ne_consistency_i64 :: () -> none => {
    a := 10
    b := 20
    c := 10
    test_assert(a.ne(&b) == ~a.eq(&b), "i64 ne consistency not equal")
    test_assert(a.ne(&c) == ~a.eq(&c), "i64 ne consistency equal")
}

test_partialeq_ne_consistency_bool :: () -> none => {
    t := true
    f := false
    test_assert(t.ne(&f) == ~t.eq(&f), "bool ne consistency different")
    test_assert(t.ne(&t) == ~t.eq(&t), "bool ne consistency same")
}

test_partialeq_ne_consistency_u64 :: () -> none => {
    a := 50 as u64
    b := 100 as u64
    test_assert(a.ne(&b) == ~a.eq(&b), "u64 ne consistency")
}

# String equality tests
test_string_partialeq_empty :: () -> none => {
    s1 := String::new()
    s2 := String::new()
    test_assert(s1.eq(&s2), "empty strings equal")
}

test_string_partialeq_equal :: () -> none => {
    s1 := String::from_cstr("hello" as *u8)
    s2 := String::from_cstr("hello" as *u8)
    test_assert(s1.eq(&s2), "equal strings")
}

test_string_partialeq_different :: () -> none => {
    s1 := String::from_cstr("hello" as *u8)
    s2 := String::from_cstr("world" as *u8)
    test_assert(~s1.eq(&s2), "different strings")
}

test_string_partialeq_length_mismatch :: () -> none => {
    s1 := String::from_cstr("hi" as *u8)
    s2 := String::from_cstr("hello" as *u8)
    test_assert(~s1.eq(&s2), "different length strings")
}

# Option equality tests
test_option_partialeq_none_none :: () -> none => {
    a := none as ?i64
    b := none as ?i64
    test_assert(a.eq(&b), "none equals none")
}

test_option_partialeq_some_some_equal :: () -> none => {
    a := some 42
    b := some 42
    test_assert(a.eq(&b), "some(42) equals some(42)")
}

test_option_partialeq_some_some_different :: () -> none => {
    a := some 10
    b := some 20
    test_assert(~a.eq(&b), "some(10) not equals some(20)")
}

test_option_partialeq_some_none :: () -> none => {
    a := some 5
    b := none as ?i64
    test_assert(~a.eq(&b), "some not equals none")
    test_assert(~b.eq(&a), "none not equals some")
}

# Result equality tests
test_result_partialeq_ok_ok_equal :: () -> none => {
    a := std_ok(42)
    b := std_ok(42)
    test_assert(a.eq(&b), "Ok(42) equals Ok(42)")
}

test_result_partialeq_ok_ok_different :: () -> none => {
    a := std_ok(10)
    b := std_ok(20)
    test_assert(~a.eq(&b), "Ok(10) not equals Ok(20)")
}

test_result_partialeq_ok_err :: () -> none => {
    a := std_ok(42)
    b := std_err::<i64>(std_error_message_only("error"))
    test_assert(~a.eq(&b), "Ok not equals Err")
}

# Eq marker trait tests
test_eq_marker_i64 :: () -> none => {
    a := 5
    b := 5
    test_assert(a == b, "Eq marker i64")
}

test_eq_marker_bool :: () -> none => {
    a := true
    b := true
    test_assert(a == b, "Eq marker bool")
}

test_eq_marker_string :: () -> none => {
    s1 := String::from_cstr("test" as *u8)
    s2 := String::from_cstr("test" as *u8)
    test_assert(s1.eq(&s2), "Eq marker string")
}

# =============================================================================
# PARTIALORD/ORD TESTS (40+ tests)
# =============================================================================

# Totality tests (cmp always returns -1, 0, or 1)
test_ord_totality_i64 :: () -> none => {
    a := 5
    b := 10
    c := 5
    r1 := a.cmp(&b)
    r2 := b.cmp(&a)
    r3 := a.cmp(&c)
    test_assert(r1 == -1 or r1 == 0 or r1 == 1, "i64 cmp totality 1")
    test_assert(r2 == -1 or r2 == 0 or r2 == 1, "i64 cmp totality 2")
    test_assert(r3 == -1 or r3 == 0 or r3 == 1, "i64 cmp totality 3")
}

test_ord_totality_bool :: () -> none => {
    t := true
    f := false
    r1 := t.cmp(&f)
    r2 := f.cmp(&t)
    r3 := t.cmp(&t)
    test_assert(r1 == -1 or r1 == 0 or r1 == 1, "bool cmp totality 1")
    test_assert(r2 == -1 or r2 == 0 or r2 == 1, "bool cmp totality 2")
    test_assert(r3 == -1 or r3 == 0 or r3 == 1, "bool cmp totality 3")
}

# Antisymmetry tests (x <= y && y <= x implies x == y)
test_partialord_antisymmetry_i64 :: () -> none => {
    a := 7
    b := 7
    xy := a.le(&b)
    yx := b.le(&a)
    eq := a.eq(&b)
    test_assert(~xy or ~yx or eq, "i64 antisymmetry")
}

test_partialord_antisymmetry_u64 :: () -> none => {
    a := 50 as u64
    b := 50 as u64
    xy := a.le(&b)
    yx := b.le(&a)
    eq := a.eq(&b)
    test_assert(~xy or ~yx or eq, "u64 antisymmetry")
}

# Transitivity tests (x <= y && y <= z implies x <= z)
test_partialord_transitivity_i64 :: () -> none => {
    a := 1
    b := 5
    c := 10
    xy := a.le(&b)
    yz := b.le(&c)
    xz := a.le(&c)
    test_assert(~xy or ~yz or xz, "i64 transitivity")
}

test_partialord_transitivity_u64 :: () -> none => {
    a := 10 as u64
    b := 20 as u64
    c := 30 as u64
    xy := a.le(&b)
    yz := b.le(&c)
    xz := a.le(&c)
    test_assert(~xy or ~yz or xz, "u64 transitivity")
}

# cmp/lt/le/gt/ge consistency tests
test_ord_consistency_lt_i64 :: () -> none => {
    a := 5
    b := 10
    cmp_result := a.cmp(&b)
    lt_result := a.lt(&b)
    test_assert((cmp_result < 0) == lt_result, "i64 lt consistency")
}

test_ord_consistency_le_i64 :: () -> none => {
    a := 5
    b := 5
    c := 10
    cmp1 := a.cmp(&b)
    le1 := a.le(&b)
    cmp2 := a.cmp(&c)
    le2 := a.le(&c)
    test_assert((cmp1 <= 0) == le1, "i64 le consistency equal")
    test_assert((cmp2 <= 0) == le2, "i64 le consistency less")
}

test_ord_consistency_gt_i64 :: () -> none => {
    a := 10
    b := 5
    cmp_result := a.cmp(&b)
    gt_result := a.gt(&b)
    test_assert((cmp_result > 0) == gt_result, "i64 gt consistency")
}

test_ord_consistency_ge_i64 :: () -> none => {
    a := 10
    b := 5
    c := 10
    cmp1 := a.cmp(&b)
    ge1 := a.ge(&b)
    cmp2 := a.cmp(&c)
    ge2 := a.ge(&c)
    test_assert((cmp1 >= 0) == ge1, "i64 ge consistency greater")
    test_assert((cmp2 >= 0) == ge2, "i64 ge consistency equal")
}

# max/min correctness tests
test_ord_max_i64 :: () -> none => {
    a := 5
    b := 10
    m := a.max(b)
    test_assert_eq_i64(m, 10, "i64 max")
}

test_ord_max_u64 :: () -> none => {
    a := 100 as u64
    b := 50 as u64
    m := a.max(b)
    test_assert(m == 100, "u64 max")
}

test_ord_min_i64 :: () -> none => {
    a := 5
    b := 10
    m := a.min(b)
    test_assert_eq_i64(m, 5, "i64 min")
}

test_ord_min_u64 :: () -> none => {
    a := 100 as u64
    b := 50 as u64
    m := a.min(b)
    test_assert(m == 50, "u64 min")
}

test_ord_max_bool :: () -> none => {
    t := true
    f := false
    m := t.max(f)
    test_assert_eq_bool(m, true, "bool max true")
}

test_ord_min_bool :: () -> none => {
    t := true
    f := false
    m := t.min(f)
    test_assert_eq_bool(m, false, "bool min false")
}

# f64 NaN handling (PartialOrd only, returns None)
test_partialord_f64_nan_partial_cmp :: () -> none => {
    nan := 0.0 / 0.0
    a := 5.0
    result := a.partial_cmp(&nan)
    match result {
        none => test_assert(true, "f64 NaN partial_cmp returns none"),
        some _ => test_assert(false, "f64 NaN partial_cmp should return none"),
    }
}

test_partialord_f64_regular :: () -> none => {
    a := 3.14
    b := 2.5
    c := 3.14
    test_assert(a.gt(&b), "f64 gt")
    test_assert(b.lt(&a), "f64 lt")
    test_assert(a.eq(&c), "f64 eq")
}

test_partialord_f64_partial_cmp_regular :: () -> none => {
    a := 5.0
    b := 3.0
    c := 5.0
    match a.partial_cmp(&b) {
        some 1 => test_assert(true, "f64 partial_cmp greater"),
        _ => test_assert(false, "f64 partial_cmp greater failed"),
    }
    match b.partial_cmp(&a) {
        some -1 => test_assert(true, "f64 partial_cmp less"),
        _ => test_assert(false, "f64 partial_cmp less failed"),
    }
    match a.partial_cmp(&c) {
        some 0 => test_assert(true, "f64 partial_cmp equal"),
        _ => test_assert(false, "f64 partial_cmp equal failed"),
    }
}

# String ordering (lexicographic)
test_string_ord_lexicographic :: () -> none => {
    s1 := String::from_cstr("apple" as *u8)
    s2 := String::from_cstr("banana" as *u8)
    test_assert(s1.lt(&s2), "string lt lexicographic")
    test_assert(s2.gt(&s1), "string gt lexicographic")
}

test_string_ord_prefix :: () -> none => {
    s1 := String::from_cstr("test" as *u8)
    s2 := String::from_cstr("testing" as *u8)
    test_assert(s1.lt(&s2), "string lt prefix")
}

test_string_ord_equal :: () -> none => {
    s1 := String::from_cstr("hello" as *u8)
    s2 := String::from_cstr("hello" as *u8)
    r := s1.cmp(&s2)
    test_assert_eq_i64(r as i64, 0, "string cmp equal")
}

test_string_max_min :: () -> none => {
    s1 := String::from_cstr("apple" as *u8)
    s2 := String::from_cstr("banana" as *u8)
    max_s := s1.max(s2.clone())
    min_s := s1.clone().min(s2)
    test_assert(max_s.eq(&s2), "string max")
    test_assert(min_s.eq(&s1), "string min")
}

# Option ordering (None < Some)
test_option_ord_none_some :: () -> none => {
    a := none as ?i64
    b := some 5
    test_assert(a.lt(&b), "none < some")
    test_assert(b.gt(&a), "some > none")
}

test_option_ord_some_some :: () -> none => {
    a := some 5
    b := some 10
    test_assert(a.lt(&b), "some(5) < some(10)")
}

test_option_ord_none_none :: () -> none => {
    a := none as ?i64
    b := none as ?i64
    r := a.cmp(&b)
    test_assert_eq_i64(r, 0, "none cmp none")
}

test_option_max :: () -> none => {
    a := some 5
    b := some 10
    c := none as ?i64
    m1 := a.max(b)
    m2 := a.max(c)
    match m1 {
        some 10 => test_assert(true, "option max some some"),
        _ => test_assert(false, "option max some some failed"),
    }
    match m2 {
        some 5 => test_assert(true, "option max some none"),
        _ => test_assert(false, "option max some none failed"),
    }
}

test_option_min :: () -> none => {
    a := some 5
    b := some 10
    c := none as ?i64
    m1 := a.min(b)
    m2 := a.min(c)
    match m1 {
        some 5 => test_assert(true, "option min some some"),
        _ => test_assert(false, "option min some some failed"),
    }
    match m2 {
        none => test_assert(true, "option min some none"),
        _ => test_assert(false, "option min some none failed"),
    }
}

# Result ordering (Ok < Err)
test_result_ord_ok_err :: () -> none => {
    a := std_ok(5)
    b := std_err::<i64>(std_error_message_only("error"))
    test_assert(a.lt(&b), "ok < err")
    test_assert(b.gt(&a), "err > ok")
}

test_result_ord_ok_ok :: () -> none => {
    a := std_ok(5)
    b := std_ok(10)
    test_assert(a.lt(&b), "ok(5) < ok(10)")
}

test_result_max_min :: () -> none => {
    a := std_ok(5)
    b := std_ok(10)
    max_r := a.max(b.clone())
    min_r := a.clone().min(b)
    match max_r {
        StdResult::Ok { value: 10 } => test_assert(true, "result max ok ok"),
        _ => test_assert(false, "result max ok ok failed"),
    }
    match min_r {
        StdResult::Ok { value: 5 } => test_assert(true, "result min ok ok"),
        _ => test_assert(false, "result min ok ok failed"),
    }
}

# =============================================================================
# COPY/CLONE TESTS (20+ tests)
# =============================================================================

# Copy semantics (bitwise copy)
test_copy_i64 :: () -> none => {
    a := 42
    b := a
    test_assert_eq_i64(a, b, "i64 copy")
    test_assert_eq_i64(a, 42, "i64 copy original unchanged")
}

test_copy_bool :: () -> none => {
    a := true
    b := a
    test_assert_eq_bool(a, b, "bool copy")
}

test_copy_u64 :: () -> none => {
    a := 100 as u64
    b := a
    test_assert(a == b, "u64 copy")
}

test_copy_u8 :: () -> none => {
    a := 255 as u8
    b := a
    test_assert(a == b, "u8 copy")
}

test_copy_f64 :: () -> none => {
    a := 3.14
    b := a
    test_assert(a == b, "f64 copy")
}

# Clone creates independent copy
test_clone_i64 :: () -> none => {
    a := 42
    b := a.clone()
    test_assert_eq_i64(b, 42, "i64 clone")
}

test_clone_bool :: () -> none => {
    a := true
    b := a.clone()
    test_assert_eq_bool(b, true, "bool clone")
}

test_clone_u64 :: () -> none => {
    a := 100 as u64
    b := a.clone()
    test_assert(b == 100, "u64 clone")
}

test_clone_u8 :: () -> none => {
    a := 50 as u8
    b := a.clone()
    test_assert(b == 50, "u8 clone")
}

test_clone_f64 :: () -> none => {
    a := 2.71828
    b := a.clone()
    test_assert(b == 2.71828, "f64 clone")
}

# String clone is deep copy (independent memory)
test_string_clone_deep_copy :: () -> none => {
    s1 := String::from_cstr("original" as *u8)
    s2 := s1.clone()
    test_assert(s1.eq(&s2), "string clone equal")
    test_assert(s1.data ~= s2.data, "string clone independent memory")
}

test_string_clone_modify :: () -> none => {
    s1 := String::from_cstr("hello" as *u8)
    s2 := s1.clone()
    String::push_cstr(&s2, " world" as *u8)
    test_assert(~s1.eq(&s2), "string clone modify independent")
    s1_str := String::from_cstr("hello" as *u8)
    test_assert(s1.eq(&s1_str), "string clone original unchanged")
}

# Option/Result clone
test_option_clone_none :: () -> none => {
    a := none as ?i64
    b := a.clone()
    match b {
        none => test_assert(true, "option clone none"),
        _ => test_assert(false, "option clone none failed"),
    }
}

test_option_clone_some :: () -> none => {
    a := some 42
    b := a.clone()
    match b {
        some 42 => test_assert(true, "option clone some"),
        _ => test_assert(false, "option clone some failed"),
    }
}

test_result_clone_ok :: () -> none => {
    a := std_ok(42)
    b := a.clone()
    match b {
        StdResult::Ok { value: 42 } => test_assert(true, "result clone ok"),
        _ => test_assert(false, "result clone ok failed"),
    }
}

test_result_clone_err :: () -> none => {
    a := std_err::<i64>(std_error_message_only("test error"))
    b := a.clone()
    match b {
        StdResult::Err { .. } => test_assert(true, "result clone err"),
        _ => test_assert(false, "result clone err failed"),
    }
}

# Clone equality
test_clone_equals_original_i64 :: () -> none => {
    a := 42
    b := a.clone()
    test_assert(a.eq(&b), "i64 clone equals original")
}

test_clone_equals_original_string :: () -> none => {
    s := String::from_cstr("test" as *u8)
    c := s.clone()
    test_assert(s.eq(&c), "string clone equals original")
}

# =============================================================================
# DISPLAY/DEBUG TESTS (30+ tests)
