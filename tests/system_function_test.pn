// System Function Syntax Test File
// Tests the target syntax: display_apps :: sys (query: select ..., gui: res &mut Gui) -> !nil

table apps {
    id: i64 @primary,
    name: String,
    category: String,
    downloads: i64
}

struct Gui {
    width: i32,
    height: i32,
    widgets: i32
}

// System function with query parameter and resource parameter
display_apps :: sys (
    query q: select id, name, category from apps where downloads > 1000,
    gui gui_handle: res &mut Gui,
    limit max_apps: i64 = 10
) -> !nil {
    // System function body that processes query results and updates GUI
    for app in q {
        gui_handle.add_widget(app.name);
    }
    return nil;
}

// System function with immutable resource
get_app_stats :: sys (
    query q: select * from apps,
    counter stats: res &Counter
) -> i64 {
    let total = 0;
    for app in q {
        total = total + 1;
    }
    return total;
}

// System function with owned resource
process_data :: sys (
    data input: res Data,
    threshold min_val: i64
) -> !nil {
    if input.value > min_val {
        input.process();
    }
    return nil;
}