# Comprehensive tests for Vec functionality
# This file tests the Vec type operations that the compiler supports

# Simplified Vec implementation for testing (parser-compatible)
Vec_new :: () -> i64 => {
    42  # placeholder - represents Vec creation
}

Vec_with_capacity :: (capacity: i64) -> i64 => {
    capacity  # placeholder - represents capacity setting
}

Vec_len :: (vec: i64) -> i64 => {
    vec  # placeholder - represents getting length
}

Vec_push :: (vec: i64, value: i64) -> i64 => {
    vec + value  # placeholder - represents pushing value
}

Vec_get :: (vec: i64, index: i64) -> i64 => {
    vec + index  # placeholder - represents getting element
}

Vec_pop :: (vec: i64) -> i64 => {
    vec - 1  # placeholder - represents popping element
}

Vec_is_empty :: (vec: i64) -> bool => {
    vec == 0  # placeholder - represents checking if empty
}

Vec_clear :: (vec: i64) -> i64 => {
    0  # placeholder - represents clearing vec
}

# Test functions
test_vec_new :: () -> bool => {
    vec := Vec_new();
    vec == 42
}

test_vec_with_capacity :: () -> bool => {
    vec := Vec_with_capacity(10);
    vec == 10
}

test_vec_len :: () -> bool => {
    vec := Vec_new();
    len := Vec_len(vec);
    len == 42
}

test_vec_push :: () -> bool => {
    vec := Vec_new();  # 42
    vec := Vec_push(vec, 8);  # 42 + 8 = 50
    vec == 50
}

test_vec_get :: () -> bool => {
    vec := Vec_new();  # 42
    value := Vec_get(vec, 5);  # 42 + 5 = 47
    value == 47
}

test_vec_pop :: () -> bool => {
    vec := Vec_new();  # 42
    popped := Vec_pop(vec);  # 42 - 1 = 41
    popped == 41
}

test_vec_is_empty :: () -> bool => {
    empty_vec := Vec_clear(42);  # becomes 0
    non_empty_vec := Vec_new();  # 42
    Vec_is_empty(empty_vec) and !Vec_is_empty(non_empty_vec)
}

test_vec_clear :: () -> bool => {
    vec := Vec_new();  # 42
    cleared := Vec_clear(vec);  # becomes 0
    cleared == 0
}

# Test multiple operations
test_vec_operations_chain :: () -> bool => {
    vec := Vec_new();  # 42
    vec := Vec_push(vec, 10);  # 42 + 10 = 52
    len := Vec_len(vec);  # should be 52
    value := Vec_get(vec, 3);  # 52 + 3 = 55
    vec := Vec_clear(vec);  # becomes 0
    is_empty := Vec_is_empty(vec);  # should be true

    len == 52 and value == 55 and is_empty
}

# Main test runner
main :: () -> i32 => {
    tests_passed := 0;
    total_tests := 0;

    # Test Vec_new
    total_tests := total_tests + 1;
    if test_vec_new() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_new passed");
    } else {
        println("✗ test_vec_new failed");
    }

    # Test Vec_with_capacity
    total_tests := total_tests + 1;
    if test_vec_with_capacity() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_with_capacity passed");
    } else {
        println("✗ test_vec_with_capacity failed");
    }

    # Test Vec_len
    total_tests := total_tests + 1;
    if test_vec_len() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_len passed");
    } else {
        println("✗ test_vec_len failed");
    }

    # Test Vec_push
    total_tests := total_tests + 1;
    if test_vec_push() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_push passed");
    } else {
        println("✗ test_vec_push failed");
    }

    # Test Vec_get
    total_tests := total_tests + 1;
    if test_vec_get() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_get passed");
    } else {
        println("✗ test_vec_get failed");
    }

    # Test Vec_pop
    total_tests := total_tests + 1;
    if test_vec_pop() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_pop passed");
    } else {
        println("✗ test_vec_pop failed");
    }

    # Test Vec_is_empty
    total_tests := total_tests + 1;
    if test_vec_is_empty() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_is_empty passed");
    } else {
        println("✗ test_vec_is_empty failed");
    }

    # Test Vec_clear
    total_tests := total_tests + 1;
    if test_vec_clear() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_clear passed");
    } else {
        println("✗ test_vec_clear failed");
    }

    # Test operations chain
    total_tests := total_tests + 1;
    if test_vec_operations_chain() {
        tests_passed := tests_passed + 1;
        println("✓ test_vec_operations_chain passed");
    } else {
        println("✗ test_vec_operations_chain failed");
    }

    # Summary
    println("");
    println("Vec functionality tests completed:");
    println("Passed: ", tests_passed, "/", total_tests);

    if tests_passed == total_tests {
        println("🎉 All Vec tests passed!");
        0
    } else {
        println("❌ Some Vec tests failed!");
        1
    }
}