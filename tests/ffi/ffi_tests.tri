# Comprehensive FFI Tests
# Tests all aspects of the Foreign Function Interface system

use ffi
use ffi::marshal
use test

# ==== Memory Allocation Tests ====

test_malloc_free :: () -> bool => {
    ptr := ffi_malloc(100u64)
    if ptr == (0 as *u8) {
        ret false
    }
    ffi_free(ptr)
    ret true
}

test_malloc_zero_size :: () -> bool => {
    ptr := ffi_malloc(0u64)
    ret ptr == (0 as *u8)
}

test_memset :: () -> bool => {
    size := 10u64
    ptr := ffi_malloc(size)
    if ptr == (0 as *u8) {
        ret false
    }
    
    ffi_memset(ptr, 42, size)
    
    mut all_42 := true
    mut i := 0u64
    loop {
        if i >= size { break }
        if *(ptr + i) != 42 {
            all_42 = false
            break
        }
        i = i + 1
    }
    
    ffi_free(ptr)
    ret all_42
}

test_memcpy :: () -> bool => {
    size := 20u64
    src := ffi_malloc(size)
    dest := ffi_malloc(size)
    
    if src == (0 as *u8) or dest == (0 as *u8) {
        ffi_free(src)
        ffi_free(dest)
        ret false
    }
    
    # Fill source with pattern
    mut i := 0u64
    loop {
        if i >= size { break }
        *(src + i) = (i as u8)
        i = i + 1
    }
    
    # Copy to dest
    ffi_memcpy(dest, src, size)
    
    # Verify
    mut matches := true
    i = 0u64
    loop {
        if i >= size { break }
        if *(dest + i) != (i as u8) {
            matches = false
            break
        }
        i = i + 1
    }
    
    ffi_free(src)
    ffi_free(dest)
    ret matches
}

test_memcpy_overlapping :: () -> bool => {
    size := 30u64
    ptr := ffi_malloc(size)
    
    if ptr == (0 as *u8) {
        ret false
    }
    
    # Fill with data
    mut i := 0u64
    loop {
        if i >= size { break }
        *(ptr + i) = (i as u8)
        i = i + 1
    }
    
    # Non-overlapping copy
    ffi_memcpy(ptr + 10, ptr, 5u64)
    
    # Verify
    success := *(ptr + 10) == 0 and *(ptr + 11) == 1
    
    ffi_free(ptr)
    ret success
}

# ==== String Marshalling Tests ====

test_string_to_cstr_basic :: () -> bool => {
    tri_str := "Hello"
    c_str := string_to_cstr(tri_str)
    
    if c_str == (0 as *u8) {
        ret false
    }
    
    # Check null terminator
    len := String::len(&tri_str)
    null_term := *(c_str + len) == 0
    
    free_cstr(c_str)
    ret null_term
}

test_string_to_cstr_empty :: () -> bool => {
    tri_str := ""
    c_str := string_to_cstr(tri_str)
    
    if c_str == (0 as *u8) {
        ret false
    }
    
    # Should be just null terminator
    result := *c_str == 0
    
    free_cstr(c_str)
    ret result
}

test_cstr_to_string :: () -> bool => {
    original := "Test String"
    c_str := string_to_cstr(original)
    
    if c_str == (0 as *u8) {
        ret false
    }
    
    back := cstr_to_string(c_str)
    result := String::eq(&original, &back)
    
    free_cstr(c_str)
    ret result
}

test_cstr_to_string_null :: () -> bool => {
    null_ptr := 0 as *u8
    result := cstr_to_string(null_ptr)
    ret String::len(&result) == 0
}

test_string_roundtrip :: () -> bool => {
    original := "TriCTI FFI Test 123!@#"
    c_str := string_to_cstr(original)
    back := cstr_to_string(c_str)
    free_cstr(c_str)
    ret String::eq(&original, &back)
}

test_string_with_spaces :: () -> bool => {
    original := "  spaces  everywhere  "
    c_str := string_to_cstr(original)
    back := cstr_to_string(c_str)
    free_cstr(c_str)
    ret String::eq(&original, &back)
}

test_string_with_numbers :: () -> bool => {
    original := "0123456789"
    c_str := string_to_cstr(original)
    back := cstr_to_string(c_str)
    free_cstr(c_str)
    ret String::eq(&original, &back)
}

# ==== Array Marshalling Tests ====

test_array_to_c_basic :: () -> bool => {
    arr := [1i32, 2, 3, 4, 5]
    c_arr := array_to_c(&arr)
    
    if c_arr == (0 as *i32) {
        ret false
    }
    
    # Verify first and last elements
    result := *c_arr == 1 and *(c_arr + 4) == 5
    
    c_free(c_arr)
    ret result
}

test_array_to_c_empty :: () -> bool => {
    arr := new [i32; 0]
    c_arr := array_to_c(&arr)
    ret c_arr == (0 as *i32)
}

test_c_array_to_vec :: () -> bool => {
    # Create C array
    c_arr := ffi_malloc(5u64 * 4u64) as *i32
    *c_arr = 10
    *(c_arr + 1) = 20
    *(c_arr + 2) = 30
    *(c_arr + 3) = 40
    *(c_arr + 4) = 50
    
    # Convert to vec
    vec := c_array_to_vec(c_arr, 5u64)
    
    result := vec.len == 5 and vec[0] == 10 and vec[4] == 50
    
    ffi_free(c_arr as *u8)
    ret result
}

test_array_roundtrip :: () -> bool => {
    original := [100i32, 200, 300, 400, 500]
    c_arr := array_to_c(&original)
    back := c_array_to_vec(c_arr, 5u64)
    c_free(c_arr)
    
    if back.len != original.len {
        ret false
    }
    
    mut i := 0u64
    loop {
        if i >= original.len { break }
        if original[i] != back[i] {
            ret false
        }
        i = i + 1
    }
    
    ret true
}

# ==== C Allocation Helper Tests ====

test_c_alloc :: () -> bool => {
    ptr := c_alloc::<i64>()
    if ptr == (0 as *i64) {
        ret false
    }
    *ptr = 12345
    result := *ptr == 12345
    c_free(ptr)
    ret result
}

test_c_alloc_array :: () -> bool => {
    count := 10u64
    ptr := c_alloc_array::<u32>(count)
    
    if ptr == (0 as *u32) {
        ret false
    }
    
    # Fill array
    mut i := 0u64
    loop {
        if i >= count { break }
        *(ptr + i) = (i as u32) * 2
        i = i + 1
    }
    
    # Verify
    result := *ptr == 0 and *(ptr + 5) == 10
    
    c_free(ptr)
    ret result
}

test_c_zero :: () -> bool => {
    ptr := c_alloc::<i64>()
    *ptr = 999
    c_zero(ptr)
    result := *ptr == 0
    c_free(ptr)
    ret result
}

# ==== Dynamic Library Tests ====

test_dynlib_open_close :: () -> bool => {
    lib_opt := DynLib::open("libm.so.6")
    
    lib := lib_opt? else {
        ret false
    }
    
    result := lib.is_open and DynLib::close(&mut lib)
    ret result
}

test_dynlib_open_nonexistent :: () -> bool => {
    lib_opt := DynLib::open("nonexistent_library_xyz.so")
    ret !lib_opt
}

test_dynlib_get_symbol :: () -> bool => {
    lib_opt := DynLib::open("libm.so.6")
    
    lib := lib_opt? else {
        ret false
    }
    
    symbol_opt := DynLib::get_symbol(&lib, "sin")
    result := symbol_opt != none
    
    DynLib::close(&mut lib)
    ret result
}

test_dynlib_get_invalid_symbol :: () -> bool => {
    lib_opt := DynLib::open("libm.so.6")
    
    lib := lib_opt? else {
        ret false
    }
    
    symbol_opt := DynLib::get_symbol(&lib, "nonexistent_function_xyz")
    result := !symbol_opt
    
    DynLib::close(&mut lib)
    ret result
}

test_dynlib_double_close :: () -> bool => {
    lib_opt := DynLib::open("libm.so.6")
    
    lib := lib_opt? else {
        ret false
    }
    
    first_close := DynLib::close(&mut lib)
    second_close := DynLib::close(&mut lib)
    
    ret first_close and second_close
}

test_dynlib_get_symbol_after_close :: () -> bool => {
    lib_opt := DynLib::open("libm.so.6")
    
    lib := lib_opt? else {
        ret false
    }
    
    DynLib::close(&mut lib)
    
    symbol_opt := DynLib::get_symbol(&lib, "sin")
    ret !symbol_opt
}

# ==== Type Alias Tests ====

test_type_aliases :: () -> bool => {
    # Just verify type aliases compile correctly
    int_val: CInt = 42
    uint_val: CUInt = 100
    long_val: CLong = 1000
    ulong_val: CULong = 2000
    size_val: CSize = 4096
    char_val: CChar = 65
    
    ret int_val == 42 and uint_val == 100
}

# ==== Main Test Runner ====

main :: () => {
    println("Running FFI Tests...\n")
    
    mut passed := 0
    mut failed := 0
    
    # Memory allocation tests
    if test_malloc_free() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_malloc_free") }
    if test_malloc_zero_size() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_malloc_zero_size") }
    if test_memset() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_memset") }
    if test_memcpy() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_memcpy") }
    if test_memcpy_overlapping() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_memcpy_overlapping") }
    
    # String marshalling tests
    if test_string_to_cstr_basic() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_string_to_cstr_basic") }
    if test_string_to_cstr_empty() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_string_to_cstr_empty") }
    if test_cstr_to_string() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_cstr_to_string") }
    if test_cstr_to_string_null() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_cstr_to_string_null") }
    if test_string_roundtrip() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_string_roundtrip") }
    if test_string_with_spaces() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_string_with_spaces") }
    if test_string_with_numbers() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_string_with_numbers") }
    
    # Array marshalling tests
    if test_array_to_c_basic() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_array_to_c_basic") }
    if test_array_to_c_empty() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_array_to_c_empty") }
    if test_c_array_to_vec() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_c_array_to_vec") }
    if test_array_roundtrip() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_array_roundtrip") }
    
    # C allocation helpers
    if test_c_alloc() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_c_alloc") }
    if test_c_alloc_array() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_c_alloc_array") }
    if test_c_zero() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_c_zero") }
    
    # Dynamic library tests
    if test_dynlib_open_close() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_dynlib_open_close") }
    if test_dynlib_open_nonexistent() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_dynlib_open_nonexistent") }
    if test_dynlib_get_symbol() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_dynlib_get_symbol") }
    if test_dynlib_get_invalid_symbol() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_dynlib_get_invalid_symbol") }
    if test_dynlib_double_close() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_dynlib_double_close") }
    if test_dynlib_get_symbol_after_close() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_dynlib_get_symbol_after_close") }
    
    # Type alias tests
    if test_type_aliases() { passed = passed + 1 } else { failed = failed + 1; println("FAILED: test_type_aliases") }
    
    println("\n=== FFI Test Results ===")
    println("Passed: ")
    println(passed as i64)
    println("Failed: ")
    println(failed as i64)
    println("Total:  ")
    println((passed + failed) as i64)
    
    if failed == 0 {
        println("\n✓ All tests passed!")
    } else {
        println("\n✗ Some tests failed")
    }
}
