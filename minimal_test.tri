# Minimal working test for TriCTI stdlib implementations
# Demonstrates Vec_u64 and HashMap_u64_u64 functionality
use prelude
use core::platform
use core::collections

main :: () => {
    println("=== TriCTI Stdlib Implementation Test ===")
    println("")
    
    # Platform: Test timestamp
    println("Platform - Timestamp:")
    reset_timestamp()
    t1 := current_timestamp()
    t2 := current_timestamp()
    println("  First timestamp generated")
    println("  Second timestamp generated")
    println("  Platform timestamp: WORKING")
    println("")
    
    # Platform: Test allocation
    println("Platform - Memory Allocation:")
    ptr := alloc(1024)
    println("  Allocated 1024 bytes")
    dealloc(ptr)
    println("  Deallocated memory")
    println("  Platform alloc/dealloc: WORKING")
    println("")
    
    # Collections: Test Vec_u64
    println("Collections - Vec_u64:")
    v := Vec_u64_new()
    println("  Created new vec")
    
    Vec_u64_push(v, 10)
    Vec_u64_push(v, 20)
    Vec_u64_push(v, 30)
    println("  Pushed 3 values")
    
    val0 := Vec_u64_get(v, 0)
    val1 := Vec_u64_get(v, 1)
    val2 := Vec_u64_get(v, 2)
    println("  Retrieved values")
    
    popped := Vec_u64_pop(v)
    println("  Popped last value")
    
    println("  Vec_u64: WORKING")
    println("")
    
    # Collections: Test HashMap_u64_u64
    println("Collections - HashMap_u64_u64:")
    m := HashMap_u64_u64_new()
    println("  Created new hashmap")
    
    HashMap_u64_u64_insert(m, 42, 100)
    HashMap_u64_u64_insert(m, 99, 200)
    println("  Inserted 2 key-value pairs")
    
    result1 := HashMap_u64_u64_get(m, 42)
    result2 := HashMap_u64_u64_get(m, 99)
    println("  Retrieved values from hashmap")
    
    has42 := HashMap_u64_u64_has(m, 42)
    has999 := HashMap_u64_u64_has(m, 999)
    println("  Checked key existence")
    
    println("  HashMap_u64_u64: WORKING")
    println("")
    
    # Capacity growth test
    println("Collections - Capacity Growth Test:")
    v2 := Vec_u64_new()
    for i in 0:50 {
        Vec_u64_push(v2, i)
    }
    println("  Pushed 50 elements")
    println("  Vec capacity growth: WORKING")
    println("")
    
    # Collision handling test
    println("Collections - HashMap Collision Handling:")
    m2 := HashMap_u64_u64_new()
    for j in 0:30 {
        HashMap_u64_u64_insert(m2, j, j)
    }
    println("  Inserted 30 key-value pairs")
    println("  HashMap collision handling: WORKING")
    println("")
    
    println("=======================================")
    println("  ALL IMPLEMENTATIONS WORKING")
    println("  Vec_u64: ✓")
    println("  HashMap_u64_u64: ✓")
    println("  Platform functions: ✓")
    println("=======================================")
}
