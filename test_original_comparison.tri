# Test if original < operator works
use prelude

test_less_than :: (x: i64) -> bool => {
    if x < 0 {
        true
    } else {
        false
    }
}

main :: () => {
    println("Testing original < operator...")
    result := test_less_than(-5)
    if result {
        println("PASS: < operator works")
    }
}
