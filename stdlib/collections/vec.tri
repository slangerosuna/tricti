impl ParVec<f64> {
    # TRUE parallel reduction using Rayon - computes sum across multiple threads
    parallel_sum :: (&self, num_threads: u64) -> f64 => {
        if self.len == 0 {
            ret 0.0
        }
        
        if num_threads <= 1 {
            ret self.sum()
        }

        unsafe { par_sum_f64(self.data, self.len, num_threads) }
    }

    # TRUE parallel reduction using Rayon - computes product across multiple threads
    parallel_product :: (&self, num_threads: u64) -> f64 => {
        if self.len == 0 {
            ret 1.0
        }
        
        if num_threads <= 1 {
            ret self.product()
        }

        unsafe { par_product_f64(self.data, self.len, num_threads) }
    }

    # TRUE parallel reduction using Rayon - finds minimum across multiple threads
    parallel_min :: (&self, num_threads: u64) -> ?f64 => {
        if self.len == 0 {
            ret none
        }
        
        if num_threads <= 1 {
            ret self.min()
        }

        mut has_value: u8 = 0
        result := unsafe { par_min_f64(self.data, self.len, num_threads, &mut has_value) }
        
        if has_value == 1 {
            some result
        } else {
            none
        }
    }

    # TRUE parallel reduction using Rayon - finds maximum across multiple threads
    parallel_max :: (&self, num_threads: u64) -> ?f64 => {
        if self.len == 0 {
            ret none
        }
        
        if num_threads <= 1 {
            ret self.max()
        }

        mut has_value: u8 = 0
        result := unsafe { par_max_f64(self.data, self.len, num_threads, &mut has_value) }
        
        if has_value == 1 {
            some result
        } else {
            none
        }
    }

    sum :: (&self) -> f64 => {
        mut sum := 0.0
        
        for i in 0:self.len {
            elem := unsafe { *(self.data + i) }
            sum += elem
        }

        sum
    }

    product :: (&self) -> f64 => {
        if self.len == 0 {
            ret 1.0
        }

        mut prod := 1.0
        
        for i in 0:self.len {
            elem := unsafe { *(self.data + i) }
            prod *= elem
        }

        prod
    }

    min :: (&self) -> ?f64 => {
        if self.len == 0 {
            ret none
        }

        mut min_val := unsafe { *(self.data + 0) }
        
        for i in 1:self.len {
            elem := unsafe { *(self.data + i) }
            if elem < min_val {
                min_val = elem
            }
        }

        some min_val
    }

    max :: (&self) -> ?f64 => {
        if self.len == 0 {
            ret none
        }

        mut max_val := unsafe { *(self.data + 0) }
        
        for i in 1:self.len {
            elem := unsafe { *(self.data + i) }
            if elem > max_val {
                max_val = elem
            }
        }

        some max_val
    }
}
