use std::prelude
use std::core::traits

# External C functions
extern malloc :: (size: u64) -> *raw u8
extern free :: (ptr: *raw u8) -> none
extern memcpy :: (dest: *raw u8, src: *raw u8, n: u64) -> *raw u8
extern memset :: (s: *raw u8, c: i32, n: u64) -> *raw u8

# Hash entry structure with tombstone support
MapEntry<K, V> :: struct
    key: K,
    value: V,
    occupied: bool,
    tombstone: bool,
    hash: u64,

# HashMap structure with open addressing
HashMap<K, V> :: struct
    buckets: *raw MapEntry<K, V>,
    capacity: u64,
    len: u64,
    load_factor: f64,

# Constants
HASHMAP_INITIAL_CAPACITY :: 16
HASHMAP_LOAD_FACTOR :: 0.75
HASHMAP_GROWTH_FACTOR :: 2

# HashMap implementation with associated functions
impl<K, V> HashMap<K, V> where K: Hash + Eq:
    # Constructor: Create new empty HashMap
    new :: () -> Self => Self::with_capacity(HASHMAP_INITIAL_CAPACITY)

    # Constructor: Create HashMap with specific capacity
    with_capacity :: (cap: u64) -> Self => do
        if cap < HASHMAP_INITIAL_CAPACITY:
            cap = HASHMAP_INITIAL_CAPACITY

        size := cap * sizeof(MapEntry<K, V>)
        buckets := unsafe { malloc(size) as *raw MapEntry<K, V> }

        for i in 0..cap:
            buckets[i].occupied = false
            buckets[i].tombstone = false
            buckets[i].hash = 0

        Self {
            buckets: buckets,
            capacity: cap,
            len: 0,
            load_factor: HASHMAP_LOAD_FACTOR,
        }

    # Get length (number of entries)
    len :: (&self) -> u64 => self.len

    # Check if empty
    is_empty :: (&self) -> bool => self.len == 0

    # Get capacity
    capacity :: (&self) -> u64 => self.capacity

    # Get current load factor
    load :: (&self) -> f64 =>
        if self.capacity == 0: 0.0
        else: (self.len as f64) / (self.capacity as f64)

    # Find index for key using linear probing with tombstone reuse
    find_slot :: (&self, key: &K, hash: u64) -> u64 => do
        index := hash % self.capacity
        start := index
        first_tombstone := self.capacity

        loop:
            entry := &self.buckets[index]

            # Track first tombstone for potential reuse
            if entry.tombstone and ~entry.occupied and first_tombstone == self.capacity:
                first_tombstone = index

            # Empty slot (not occupied, not tombstone) - end of probe sequence
            if not (entry.occupied or entry.tombstone):
                # Return first tombstone if we found one, otherwise this empty slot
                if first_tombstone ~= self.capacity:
                    ret first_tombstone

                ret index

            # Found occupied slot with matching hash - check key equality
            if entry.occupied and entry.hash == hash:
                if Eq::eq(&entry.key, key): ret index
                # Hash collision - different keys with same hash, continue probing

            index = (index + 1) % self.capacity

            if index == start:
                # Wrapped around - return first tombstone if found
                if first_tombstone ~= self.capacity:
                    ret first_tombstone

                ret self.capacity

        ret self.capacity

    # Resize and rehash the map
    resize :: (&mut self, new_cap: u64) => do
        old_buckets := self.buckets
        old_capacity := self.capacity

        size := new_cap * sizeof(MapEntry<K, V>)
        new_buckets := unsafe { malloc(size) as *raw MapEntry<K, V> }

        for i in 0..new_cap:
            new_buckets[i].occupied = false
            new_buckets[i].tombstone = false
            new_buckets[i].hash = 0

        self.buckets = new_buckets
        self.capacity = new_cap
        old_len := self.len
        self.len = 0

        for i in 0..old_capacity:
            entry := &old_buckets[i]
            if entry.occupied:
                self.insert(entry.key, entry.value)

        self.len = old_len
        unsafe { free(old_buckets as *raw u8) }

    # Reserve capacity for additional elements
    reserve :: (&mut self, additional: u64) => do
        needed := self.len + additional
        threshold := (self.capacity as f64 * self.load_factor) as u64

        if needed > threshold:
            new_cap := self.capacity * HASHMAP_GROWTH_FACTOR
            while (new_cap as f64 * self.load_factor) as u64 < needed:
                new_cap = new_cap * HASHMAP_GROWTH_FACTOR

            self.resize(new_cap)

    # Shrink capacity to fit current size
    shrink_to_fit :: (&mut self) => do
        if self.len == 0:
            self.resize(HASHMAP_INITIAL_CAPACITY)
            ret

        min_cap := ((self.len as f64 / self.load_factor) as u64) + 1
        if min_cap < HASHMAP_INITIAL_CAPACITY:
            min_cap = HASHMAP_INITIAL_CAPACITY

        if min_cap < self.capacity:
            self.resize(min_cap)

    # Insert or update key-value pair
    insert :: (&mut self, key: K, value: V) => do
        threshold := (self.capacity as f64 * self.load_factor) as u64
        if self.len >= threshold:
            self.resize(self.capacity * HASHMAP_GROWTH_FACTOR)

        if self.capacity == 0: ret

        hash := key.hash()
        index := self.find_slot(&key, hash)

        if index >= self.capacity: ret

        entry := &mut self.buckets[index]
        was_occupied := entry.occupied

        entry.key = key
        entry.value = value
        entry.occupied = true
        entry.tombstone = false
        entry.hash = hash

        if not was_occupied: self.len = self.len + 1

    get<'a> :: (&'a self, key: K) -> ?&'a V => do
        if self.capacity == 0: ret none

        hash := key.hash()
        index := hash % self.capacity
        start := index

        loop:
            entry := &self.buckets[index]

            # Empty slot - key not found
            if not (entry.occupied or entry.tombstone): ret none

            # Check both hash AND key equality
            if entry.occupied and entry.hash == hash:
                if Eq::eq(&entry.key, &key):
                    ret some &entry.value
                # Hash collision - different keys with same hash, continue probing

            index = (index + 1) % self.capacity

            if index == start: ret none
                ret none

        ret none

    # Get mutable value by key
    get_mut<'a> :: (&'a mut self, key: K) -> ?&'a mut V => do
        if self.capacity == 0: ret none

        hash := key.hash()
        index := hash % self.capacity
        start := index

        loop:
            entry := &mut self.buckets[index]

            # Empty slot - key not found
            if not (entry.occupied or entry.tombstone): ret none

            if entry.occupied and entry.hash == hash:
                if Eq::eq(&entry.key, &key):
                    ret some &mut entry.value

            index = (index + 1) % self.capacity

            if index == start: ret none

        ret none

    # Get value or default
    get_or_default :: (&self, key: K, default: V) -> V
        where V: Copy => match self.get(key):
            some value => *value,
            none => default,

    # Check if key exists
    contains_key :: (&self, key: K) -> bool => self.get(key) ~= none

    # Remove key-value pair
    remove :: (&mut self, key: K) -> bool => do
        if self.capacity == 0: ret false

        hash := key.hash()
        index := hash % self.capacity
        start := index

        loop:
            entry := &mut self.buckets[index]

            # Empty slot - key not found
            if not (entry.occupied or entry.tombstone):
                ret false

            # Check both hash AND key equality
            if entry.occupied and entry.hash == hash:
                if Eq::eq(&entry.key, &key):
                    entry.occupied = false
                    entry.tombstone = true
                    self.len = self.len - 1
                    ret true
                # Hash collision - different keys with same hash, continue probing

            index = (index + 1) % self.capacity

            if index == start: ret false

        false

    # Clear all entries
    clear :: (&mut self) => do
        for i in 0..self.capacity:
            self.buckets[i].occupied = false
            self.buckets[i].tombstone = false
            self.buckets[i].hash = 0

        self.len = 0

    # Get all keys count
    keys_count :: (&self) -> u64 => self.len

    # Collect key at index (returns default-initialized value if out of bounds)
    key_at<'a> :: (&'a self, idx: u64) -> ?&'a K => do
        # Bounds check
        if idx >= self.len: ret none

        count := 0
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                if count == idx:
                    ret some &self.buckets[i].key
                count += 1

        ret none

    # Get all values count
    values_count :: (&self) -> u64 => self.len

    # Collect value at index (returns none if out of bounds)
    value_at<'a> :: (&'a self, idx: u64) -> ?&'a V => do
        if idx >= self.len: ret none

        count := 0
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                if count == idx:
                    ret some &self.buckets[i].value
                count += 1

        ret none

    entries_count :: (&self) -> u64 => self.len

    entry_key_at<'a> :: (&'a self, idx: u64) -> ?&'a K => self.key_at(idx)

    entry_value_at<'a> :: (&'a self, idx: u64) -> ?&'a V => self.value_at(idx)

    # Iterate with callback
    each :: (&self, callback: (&K, &V) -> none) => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                callback(&self.buckets[i].key, &self.buckets[i].value)

    # Iterate keys with callback
    each_key :: (&self, callback: (&K) -> none) => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                callback(&self.buckets[i].key)

    # Iterate values with callback
    each_value :: (&self, callback: (&V) -> none) => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                callback(&self.buckets[i].value)

    clone :: (&self) -> HashMap<K, V>
        where K: Clone + Hash + Eq, V: Clone => do
        new_map := Self::with_capacity(self.capacity)

        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                new_map.insert(self.buckets[i].key.clone(), self.buckets[i].value.clone())

        new_map

    destroy :: (&mut self) => do
        if self.buckets ~= (unsafe { 0 as *raw MapEntry<K, V> }):
            unsafe { free(self.buckets as *raw u8) }
            self.buckets = unsafe { 0 as *raw MapEntry<K, V> }

        self.capacity = 0
        self.len = 0

    retain :: (&mut self, predicate: (&K, &V) -> bool) => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                keep := predicate(&self.buckets[i].key, &self.buckets[i].value)
                if ~keep:
                    self.buckets[i].occupied = false
                    self.buckets[i].tombstone = true
                    self.len = self.len - 1

    any :: (&self, predicate: (&K, &V) -> bool) -> bool => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                if predicate(&self.buckets[i].key, &self.buckets[i].value):
                    ret true

        false

    all :: (&self, predicate: (&K, &V) -> bool) -> bool => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                if ~predicate(&self.buckets[i].key, &self.buckets[i].value):
                    ret false

        true

    count_if :: (&self, predicate: (&K, &V) -> bool) -> u64 => do
        count := 0
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                if predicate(&self.buckets[i].key, &self.buckets[i].value):
                    count = count + 1

        count

    find_key<'a> :: (&'a self, predicate: (&K, &V) -> bool) -> ?&'a K => do
        for i in 0..self.capacity:
            if self.buckets[i].occupied:
                if predicate(&self.buckets[i].key, &self.buckets[i].value):
                    ret some &self.buckets[i].key

        none

    extend :: (&mut self, other: &HashMap<K, V>)
        where K: Clone, V: Clone => do
        for i in 0..other.capacity:
            if other.buckets[i].occupied:
                self.insert(other.buckets[i].key.clone(), other.buckets[i].value.clone())