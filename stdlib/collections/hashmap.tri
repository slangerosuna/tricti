# HashMap<K,V> - Generic hash map with open addressing and linear probing
# Production-ready hash-based collection for TriCTI stdlib

use prelude
use core::traits

# External C functions
extern malloc :: (size: u64) -> *u8
extern free :: (ptr: *u8) -> none
extern memcpy :: (dest: *u8, src: *u8, n: u64) -> *u8
extern memset :: (s: *u8, c: i32, n: u64) -> *u8

# Hash entry structure with tombstone support
MapEntry<K, V> :: struct {
    key: K,
    value: V,
    occupied: bool,
    tombstone: bool,
    hash: u64
}

# HashMap structure with open addressing
HashMap<K, V> :: struct {
    buckets: *MapEntry<K, V>,
    capacity: u64,
    len: u64,
    load_factor: f64
}

# Constants
HASHMAP_INITIAL_CAPACITY :: 16
HASHMAP_LOAD_FACTOR :: 0.75
HASHMAP_GROWTH_FACTOR :: 2

# HashMap implementation with associated functions
impl HashMap {
    # Constructor: Create new empty HashMap
    new :: <K, V>() -> HashMap<K, V> => {
        HashMap::with_capacity::<K, V>(HASHMAP_INITIAL_CAPACITY)
    }

    # Constructor: Create HashMap with specific capacity
    with_capacity :: <K, V>(cap: u64) -> HashMap<K, V> => {
        if cap < HASHMAP_INITIAL_CAPACITY {
            cap = HASHMAP_INITIAL_CAPACITY
        }
        
        size := cap * sizeof(MapEntry<K, V>)
        buckets := malloc(size) as *MapEntry<K, V>
        
        for i in 0:cap {
            buckets[i].occupied = false
            buckets[i].tombstone = false
            buckets[i].hash = 0
        }
        
        {
            buckets: buckets,
            capacity: cap,
            len: 0,
            load_factor: HASHMAP_LOAD_FACTOR
        }
    }

    # Get length (number of entries)
    len :: <K, V>(self: *HashMap<K, V>) -> u64 => {
        self.len
    }

    # Check if empty
    is_empty :: <K, V>(self: *HashMap<K, V>) -> bool => {
        self.len == 0
    }

    # Get capacity
    capacity :: <K, V>(self: *HashMap<K, V>) -> u64 => {
        self.capacity
    }

    # Get current load factor
    load :: <K, V>(self: *HashMap<K, V>) -> f64 => {
        if self.capacity == 0 {
            ret 0.0
        }
        (self.len as f64) / (self.capacity as f64)
    }

    # Find index for key using linear probing with tombstone reuse
    find_slot :: <K, V>(self: *HashMap<K, V>, key: K, hash: u64) -> u64 
        where K: Hash + Eq => {
        index := hash % self.capacity
        start := index
        first_tombstone := self.capacity
        
        loop {
            entry := &self.buckets[index]
            
            # Track first tombstone for potential reuse
            if entry.tombstone && !entry.occupied && first_tombstone == self.capacity {
                first_tombstone = index
            }
            
            # Empty slot (not occupied, not tombstone) - end of probe sequence
            if !entry.occupied && !entry.tombstone {
                # Return first tombstone if we found one, otherwise this empty slot
                if first_tombstone ~= self.capacity {
                    ret first_tombstone
                }
                ret index
            }
            
            # Found occupied slot with matching hash - check key equality
            if entry.occupied && entry.hash == hash {
                if Eq::eq(&entry.key, &key) {
                    ret index
                }
                # Hash collision - different keys with same hash, continue probing
            }
            
            index = (index + 1) % self.capacity
            
            if index == start {
                # Wrapped around - return first tombstone if found
                if first_tombstone ~= self.capacity {
                    ret first_tombstone
                }
                ret self.capacity
            }
        }
        
        self.capacity
    }

    # Resize and rehash the map
    resize :: <K, V>(self: *HashMap<K, V>, new_cap: u64) 
        where K: Hash + Eq => {
        old_buckets := self.buckets
        old_capacity := self.capacity
        
        size := new_cap * sizeof(MapEntry<K, V>)
        new_buckets := malloc(size) as *MapEntry<K, V>
        
        for i in 0:new_cap {
            new_buckets[i].occupied = false
            new_buckets[i].tombstone = false
            new_buckets[i].hash = 0
        }
        
        self.buckets = new_buckets
        self.capacity = new_cap
        old_len := self.len
        self.len = 0
        
        for i in 0:old_capacity {
            entry := &old_buckets[i]
            if entry.occupied {
                HashMap::insert::<K, V>(self, entry.key, entry.value)
            }
        }
        
        self.len = old_len
        free(old_buckets as *u8)
    }

    # Reserve capacity for additional elements
    reserve :: <K, V>(self: *HashMap<K, V>, additional: u64) 
        where K: Hash + Eq => {
        needed := self.len + additional
        threshold := (self.capacity as f64 * self.load_factor) as u64
        
        if needed > threshold {
            new_cap := self.capacity * HASHMAP_GROWTH_FACTOR
            while (new_cap as f64 * self.load_factor) as u64 < needed {
                new_cap = new_cap * HASHMAP_GROWTH_FACTOR
            }
            HashMap::resize::<K, V>(self, new_cap)
        }
    }

    # Shrink capacity to fit current size
    shrink_to_fit :: <K, V>(self: *HashMap<K, V>) 
        where K: Hash + Eq => {
        if self.len == 0 {
            HashMap::resize::<K, V>(self, HASHMAP_INITIAL_CAPACITY)
            ret none
        }
        
        min_cap := ((self.len as f64 / self.load_factor) as u64) + 1
        if min_cap < HASHMAP_INITIAL_CAPACITY {
            min_cap = HASHMAP_INITIAL_CAPACITY
        }
        
        if min_cap < self.capacity {
            HashMap::resize::<K, V>(self, min_cap)
        }
    }

    # Insert or update key-value pair
    insert :: <K, V>(self: *HashMap<K, V>, key: K, value: V) 
        where K: Hash + Eq => {
        threshold := (self.capacity as f64 * self.load_factor) as u64
        if self.len >= threshold {
            HashMap::resize::<K, V>(self, self.capacity * HASHMAP_GROWTH_FACTOR)
        }
        
        hash := Hash::hash(&key)
        index := HashMap::find_slot::<K, V>(self, key, hash)
        
        if index >= self.capacity {
            ret none
        }
        
        entry := &self.buckets[index]
        was_occupied := entry.occupied
        
        entry.key = key
        entry.value = value
        entry.occupied = true
        entry.tombstone = false
        entry.hash = hash
        
        if !was_occupied {
            self.len = self.len + 1
        }
    }

    # Get value by key (returns null pointer if not found)
    get :: <K, V>(self: *HashMap<K, V>, key: K) -> *V 
        where K: Hash + Eq => {
        hash := Hash::hash(&key)
        index := hash % self.capacity
        start := index
        
        loop {
            entry := &self.buckets[index]
            
            # Empty slot - key not found
            if !entry.occupied && !entry.tombstone {
                ret 0 as *V
            }
            
            # Check both hash AND key equality
            if entry.occupied && entry.hash == hash {
                if Eq::eq(&entry.key, &key) {
                    ret &entry.value
                }
                # Hash collision - different keys with same hash, continue probing
            }
            
            index = (index + 1) % self.capacity
            
            if index == start {
                ret 0 as *V
            }
        }
        
        0 as *V
    }

    # Get mutable value by key
    get_mut :: <K, V>(self: *HashMap<K, V>, key: K) -> *V 
        where K: Hash + Eq => {
        HashMap::get::<K, V>(self, key)
    }

    # Get value or default
    get_or_default :: <K, V>(self: *HashMap<K, V>, key: K, default: V) -> V 
        where K: Hash + Eq => {
        val := HashMap::get::<K, V>(self, key)
        if val == (0 as *V) {
            ret default
        }
        val[0]
    }

    # Check if key exists
    contains_key :: <K, V>(self: *HashMap<K, V>, key: K) -> bool 
        where K: Hash + Eq => {
        HashMap::get::<K, V>(self, key) ~= (0 as *V)
    }

    # Remove key-value pair
    remove :: <K, V>(self: *HashMap<K, V>, key: K) -> bool 
        where K: Hash + Eq => {
        hash := Hash::hash(&key)
        index := hash % self.capacity
        start := index
        
        loop {
            entry := &self.buckets[index]
            
            # Empty slot - key not found
            if !entry.occupied && !entry.tombstone {
                ret false
            }
            
            # Check both hash AND key equality
            if entry.occupied && entry.hash == hash {
                if Eq::eq(&entry.key, &key) {
                    entry.occupied = false
                    entry.tombstone = true
                    self.len = self.len - 1
                    ret true
                }
                # Hash collision - different keys with same hash, continue probing
            }
            
            index = (index + 1) % self.capacity
            
            if index == start {
                ret false
            }
        }
        
        false
    }

    # Clear all entries
    clear :: <K, V>(self: *HashMap<K, V>) -> none => {
        for i in 0:self.capacity {
            self.buckets[i].occupied = false
            self.buckets[i].tombstone = false
            self.buckets[i].hash = 0
        }
        self.len = 0
    }

    # Get all keys count
    keys_count :: <K, V>(self: *HashMap<K, V>) -> u64 => {
        self.len
    }

    # Collect key at index (returns default-initialized value if out of bounds)
    key_at :: <K, V>(self: *HashMap<K, V>, idx: u64) -> K => {
        # Bounds check
        if idx >= self.len {
            # Find first occupied entry to return its key as fallback
            for i in 0:self.capacity {
                if self.buckets[i].occupied {
                    ret self.buckets[i].key
                }
            }
            # If no occupied entries, return default value
            default: K
            ret default
        }
        
        count := 0
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                if count == idx {
                    ret self.buckets[i].key
                }
                count = count + 1
            }
        }
        
        # Fallback
        default: K
        ret default
    }

    # Get all values count
    values_count :: <K, V>(self: *HashMap<K, V>) -> u64 => {
        self.len
    }

    # Collect value at index (returns default-initialized value if out of bounds)
    value_at :: <K, V>(self: *HashMap<K, V>, idx: u64) -> V => {
        # Bounds check
        if idx >= self.len {
            # Find first occupied entry to return its value as fallback
            for i in 0:self.capacity {
                if self.buckets[i].occupied {
                    ret self.buckets[i].value
                }
            }
            # If no occupied entries, return default value
            default: V
            ret default
        }
        
        count := 0
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                if count == idx {
                    ret self.buckets[i].value
                }
                count = count + 1
            }
        }
        
        # Fallback
        default: V
        ret default
    }

    # Get entries count
    entries_count :: <K, V>(self: *HashMap<K, V>) -> u64 => {
        self.len
    }

    # Get entry key at index
    entry_key_at :: <K, V>(self: *HashMap<K, V>, idx: u64) -> K => {
        HashMap::key_at::<K, V>(self, idx)
    }

    # Get entry value at index
    entry_value_at :: <K, V>(self: *HashMap<K, V>, idx: u64) -> V => {
        HashMap::value_at::<K, V>(self, idx)
    }

    # Iterate with callback
    each :: <K, V>(self: *HashMap<K, V>, callback: (K, V) -> none) -> none => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                callback(self.buckets[i].key, self.buckets[i].value)
            }
        }
    }

    # Iterate keys with callback
    each_key :: <K, V>(self: *HashMap<K, V>, callback: (K) -> none) -> none => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                callback(self.buckets[i].key)
            }
        }
    }

    # Iterate values with callback
    each_value :: <K, V>(self: *HashMap<K, V>, callback: (V) -> none) -> none => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                callback(self.buckets[i].value)
            }
        }
    }

    # Clone/copy the map
    clone :: <K, V>(self: *HashMap<K, V>) -> HashMap<K, V> 
        where K: Hash + Eq => {
        new_map := HashMap::with_capacity::<K, V>(self.capacity)
        
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                HashMap::insert::<K, V>(&new_map, self.buckets[i].key, self.buckets[i].value)
            }
        }
        
        new_map
    }

    # Destroy and free memory
    destroy :: <K, V>(self: *HashMap<K, V>) -> none => {
        if self.buckets ~= (0 as *MapEntry<K, V>) {
            free(self.buckets as *u8)
            self.buckets = 0 as *MapEntry<K, V>
        }
        self.capacity = 0
        self.len = 0
    }

    # Retain only elements that match predicate
    retain :: <K, V>(self: *HashMap<K, V>, predicate: (K, V) -> bool) -> none => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                keep := predicate(self.buckets[i].key, self.buckets[i].value)
                if !keep {
                    self.buckets[i].occupied = false
                    self.buckets[i].tombstone = true
                    self.len = self.len - 1
                }
            }
        }
    }

    # Check if any entry matches predicate
    any :: <K, V>(self: *HashMap<K, V>, predicate: (K, V) -> bool) -> bool => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                if predicate(self.buckets[i].key, self.buckets[i].value) {
                    ret true
                }
            }
        }
        false
    }

    # Check if all entries match predicate
    all :: <K, V>(self: *HashMap<K, V>, predicate: (K, V) -> bool) -> bool => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                if !predicate(self.buckets[i].key, self.buckets[i].value) {
                    ret false
                }
            }
        }
        true
    }

    # Count entries matching predicate
    count_if :: <K, V>(self: *HashMap<K, V>, predicate: (K, V) -> bool) -> u64 => {
        count := 0
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                if predicate(self.buckets[i].key, self.buckets[i].value) {
                    count = count + 1
                }
            }
        }
        count
    }

    # Find first key matching predicate
    find_key :: <K, V>(self: *HashMap<K, V>, predicate: (K, V) -> bool) -> *K => {
        for i in 0:self.capacity {
            if self.buckets[i].occupied {
                if predicate(self.buckets[i].key, self.buckets[i].value) {
                    ret &self.buckets[i].key
                }
            }
        }
        0 as *K
    }

    # Extend with entries from another map
    extend :: <K, V>(self: *HashMap<K, V>, other: *HashMap<K, V>) 
        where K: Hash + Eq => {
        for i in 0:other.capacity {
            if other.buckets[i].occupied {
                HashMap::insert::<K, V>(self, other.buckets[i].key, other.buckets[i].value)
            }
        }
    }
}
