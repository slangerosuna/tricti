# I/O module for TriCTI
# Provides file system operations, path manipulation, and I/O traits

# POSIX FFI layer (must be first)
use io::posix

# Core I/O types
use io::file
use io::path
use io::metadata
use io::dir

# Re-export main types and functions for convenience
pub use io::file::File
pub use io::path::Path
pub use io::metadata::Metadata
pub use io::dir::DirEntry
pub use io::dir::create_dir
pub use io::dir::remove_dir
pub use io::dir::remove_file
pub use io::dir::rename
pub use io::dir::copy_file
pub use io::dir::move_file
pub use io::dir::exists
pub use io::dir::is_file
pub use io::dir::is_dir
