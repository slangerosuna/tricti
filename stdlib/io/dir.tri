# Directory operations for TriCTI
# Provides directory reading, creation, and manipulation

use std::core::traits
use std::core::string
use std::io::posix
use std::io::file
use std::io::path

# =============================================================================
# DIRENTRY TYPE
# =============================================================================

# DirEntry represents an entry in a directory
DirEntry :: struct
    name: String,
    path: String,
    is_dir: bool,
    is_file: bool,

impl DirEntry:
    # Get entry name (file or directory name)
    name :: (entry: &DirEntry) -> String => String::clone(&entry.name)

    # Get full path to entry
    path :: (entry: &DirEntry) -> String => String::clone(&entry.path)
    
    # Check if entry is a directory
    is_dir :: (entry: &DirEntry) -> bool => entry.is_dir
    
    # Check if entry is a file
    is_file :: (entry: &DirEntry) -> bool => entry.is_file

# Trait implementations for DirEntry
impl Clone for DirEntry:
    clone :: (&self) -> DirEntry => do
        DirEntry {
            name: String::clone(&self.name),
            path: String::clone(&self.path),
            is_dir: self.is_dir,
            is_file: self.is_file,
        }

impl Display for DirEntry:
    to_string :: (&self) -> String =>
        String::clone(&self.name)

impl Debug for DirEntry:
    debug_string :: (&self) -> String =>
        String::clone(&self.name)

# commented out as this should be handled by the borrow checker
# impl Drop for DirEntry:
#     drop :: (*self) => do
#         String::destroy(&mut self.name)
#         String::destroy(&mut self.path)

# =============================================================================
# DIRECTORY OPERATIONS
# =============================================================================

# Create directory with default permissions (0755)
# Returns true on success, false on error
create_dir :: (path: String) -> bool =>
    posix_mkdir(path.as_ptr(), 493) == 0

# Create directory with custom permissions
# mode: permission bits (e.g., 0755 = 493)
# Returns true on success, false on error
create_dir_with_mode :: (path: String, mode: u32) -> bool =>
    posix_mkdir(path.as_ptr(), mode) == 0

# Remove empty directory
# Returns true on success, false on error
remove_dir :: (path: String) -> bool =>
    posix_rmdir(path.as_ptr()) == 0

# Remove file
# Returns true on success, false on error
remove_file :: (path: String) -> bool =>
    posix_unlink(path.as_ptr()) == 0

# Rename/move file or directory
# Returns true on success, false on error
rename :: (from: String, to: String) -> bool =>
    posix_rename(from.as_ptr(), to.as_ptr()) == 0

# Copy file from source to destination
# Returns true on success, false on error
copy_file :: (from: String, to: String) -> bool => do
    content := File::read_to_string(from)? else: ret false
    ret File::write_string(to, content)

# Move file from source to destination (rename or copy+delete)
# Returns true on success, false on error
move_file :: (from: String, to: String) -> bool => do
    if rename(String::clone(&from), String::clone(&to)):
        ret true

    if copy_file(String::clone(&from), String::clone(&to)):
        ret remove_file(from)
    
    ret false

# Check if path exists (file or directory)
exists :: (path: String) -> bool => posix_access(path.as_ptr(), F_OK) == 0

# Check if path is a file
is_file :: (path: String) -> bool => do
    p := Path::new(path)
    ret p.is_file()

# Check if path is a directory
is_dir :: (path: String) -> bool => do
    p := Path::new(path)
    ret p.is_dir()

# Helper: Read directory entry name from dirent structure
# dirent structure layout (simplified):
#   u64 d_ino
#   u64 d_off  
#   u16 d_reclen
#   u8  d_type
#   char d_name[256]
read_dirent_name :: unsafe (dirent_ptr: *raw u8) -> String => do
    unsafe: name_ptr := dirent_ptr + 19
    result := String::new()
    i := 0u64

    while i < 256:
        unsafe: ch := *(name_ptr + i)
        if ch == 0: break

        result.push_char(ch)
        i += 1
    ret result

# Helper: Get directory entry type from dirent structure
read_dirent_type :: unsafe (dirent_ptr: *raw u8) -> u8 => do
    unsafe: type_ptr := dirent_ptr + 18
    ret *type_ptr

