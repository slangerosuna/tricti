# TriCTI Standard Library Prelude
# Core types and functions available to all TriCTI programs

# Errors and assertions
# Assert a condition holds; otherwise panic with message
assert :: (cond: bool, msg: String) => if not cond: panic(msg)

# Print a message and terminate the process with non-zero status
panic :: (msg: String) => do
        println(msg)
        exit(1)

# String functions
streq :: (a: string, b: string) -> bool => do
        len_a := len(a)
        if len_a ~= len(b): ret false

        for i in 0..len_a:
                if a[i] ~= b[i]: ret false
        ret true

# Simple error message functions for immediate use
# TODO: Add rich error types when pattern matching supports value extraction

LogLevel :: enum
        Trace,
        Debug,
        Info,
        Warn,
        Error,

log_message :: (level: LogLevel, message: String) => do
        # Pattern matching on enum variants isn't supported in the analyzer yet;
        # keep logging simple for now.
        println("[log]")
        println(message)

log_info :: (message: String) => do
        log_message(LogLevel::Info, message)

log_error :: (message: String) => do
        log_message(LogLevel::Error, message)

# Basic math helpers
abs_i64 :: (value: i64) -> i64 => do
        if value < 0:
                ret -value
        else:
                ret value

min_i64 :: (a: i64, b: i64) -> i64 => do
        if a < b:
                ret a
        else:
                ret b

max_i64 :: (a: i64, b: i64) -> i64 => do
        if a > b:
                ret a
        else:
                ret b

rem_i64 :: (a: i64, b: i64) -> i64 => a % b

RuntimeConfigOptions :: struct
        enable_preemption: bool,
        scheduling_quantum_ms: i64,

IOConfigOptions :: struct
        default_timeout_ms: i64,
        enable_tracing: bool,

StdConfig :: struct
        runtime: RuntimeConfigOptions,
        io: IOConfigOptions,

std_default_config :: () -> StdConfig => StdConfig {
        runtime: RuntimeConfigOptions {
                enable_preemption: true,
                scheduling_quantum_ms: 10,
        },
        io: IOConfigOptions {
                default_timeout_ms: 5_000,
                enable_tracing: false,
        },
}
