# FFI Type Marshalling Utilities
# Convert between TriCTI and C types

use std::core::string
use std::ffi

# Convert TriCTI String to C string (null-terminated)
# Caller is responsible for freeing with free_cstr
string_to_cstr :: (s: String) -> *raw u8 => do
    len := String::len(&s)
    ptr := ffi::malloc(len + 1)
    ffi::memcpy(ptr, String::as_ptr(&s), len)
    unsafe: *(ptr + len) = 0

    ret ptr

# Convert C string to TriCTI String
cstr_to_string :: (cstr: *raw u8) -> String => do
    if cstr == (unsafe { 0 as *raw u8 }):
        ret String::new()
    
    len := 0u64
    loop:
        if unsafe { *(cstr + len) == 0 }: break
        len = len + 1
    
    ret String::from_bytes(cstr, len)

# Free C string allocated by string_to_cstr
free_cstr :: (cstr: *raw u8) => do
    if cstr ~= (unsafe { 0 as *raw u8 }):
        ffi::free(cstr)

# Convert TriCTI array to C array
# Caller is responsible for freeing with ffi_free
array_to_c :: <T>(arr: &[T]) -> *raw T => do
    if arr.len == 0:
        ret unsafe { 0 as *raw T }
    size := arr.len * sizeof<T>()
    ptr := ffi::malloc(size) as *raw T
    ffi::memcpy(ptr as *raw u8, arr.data as *raw u8, size)
    ret ptr

# Convert C array to TriCTI vector
c_array_to_vec :: <T>(ptr: *raw T, len: u64) -> [T] => do
    vec := new [T; len]
    size := len * sizeof<T>()
    ffi::memcpy(vec.data as *raw u8, ptr as *raw u8, size)
    ret vec

# Allocate C-compatible memory
c_alloc :: <T>() -> *raw T =>
    ffi::malloc(sizeof<T>()) as *raw T

# Allocate array of C-compatible memory
c_alloc_array<T> :: (count: u64) -> *raw T =>
    ffi::malloc(count * sizeof<T>()) as *raw T

# Free C-allocated memory
c_free<T> :: (ptr: *raw T) => ffi::free(ptr as *raw u8)

# Zero-initialize memory
c_zero<T> :: (ptr: *raw T) =>
    ffi::memset(ptr as *raw u8, 0, sizeof<T>())
