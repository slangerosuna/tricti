# FFI Type Marshalling Utilities
# Convert between TriCTI and C types

use ffi

# Convert TriCTI String to C string (null-terminated)
# Caller is responsible for freeing with free_cstr
string_to_cstr :: (s: String) -> *u8 => {
    len := String::len(&s)
    ptr := ffi_malloc(len + 1)
    ffi_memcpy(ptr, String::as_ptr(&s), len)
    *(ptr + len) = 0
    ret ptr
}

# Convert C string to TriCTI String
cstr_to_string :: (cstr: *u8) -> String => {
    if cstr == (0 as *u8) {
        ret String::new()
    }
    
    mut len := 0u64
    loop {
        if *(cstr + len) == 0 { break }
        len = len + 1
    }
    
    ret String::from_bytes(cstr, len)
}

# Free C string allocated by string_to_cstr
free_cstr :: (cstr: *u8) => {
    if cstr != (0 as *u8) {
        ffi_free(cstr)
    }
}

# Convert TriCTI array to C array
# Caller is responsible for freeing with ffi_free
array_to_c :: <T>(arr: &[T]) -> *T => {
    if arr.len == 0 {
        ret 0 as *T
    }
    size := arr.len * sizeof::<T>()
    ptr := ffi_malloc(size) as *T
    ffi_memcpy(ptr as *u8, arr.data as *u8, size)
    ret ptr
}

# Convert C array to TriCTI vector
c_array_to_vec :: <T>(ptr: *T, len: u64) -> [T] => {
    mut vec := new [T; len]
    size := len * sizeof::<T>()
    ffi_memcpy(vec.data as *u8, ptr as *u8, size)
    ret vec
}

# Allocate C-compatible memory
c_alloc :: <T>() -> *T => {
    ffi_malloc(sizeof::<T>()) as *T
}

# Allocate array of C-compatible memory
c_alloc_array :: <T>(count: u64) -> *T => {
    ffi_malloc(count * sizeof::<T>()) as *T
}

# Free C-allocated memory
c_free :: <T>(ptr: *T) => {
    ffi_free(ptr as *u8)
}

# Zero-initialize memory
c_zero :: <T>(ptr: *T) => {
    ffi_memset(ptr as *u8, 0, sizeof::<T>())
}
