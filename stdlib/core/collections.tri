impl<K, V> BinaryMap<K, V> {
    new :: () -> BinaryMap<K, V> => {
        {
            root: none,
            len: 0,
        }
    }

    insert :: (&mut self, key: K, value: V) -> ?V => {
        # Placeholder - would perform BST insertion
        old_value := self.get(key)
        self.len = self.len + 1
        old_value
    }

    get :: (&self, key: K) -> ?V => {
        # Placeholder - would perform BST search
        none
