            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
        ]
        
        HashMap_U64_TableRow {
            buckets: empty_buckets,
            size: 0,
        }
    }
    
    insert :: (&mut self, key: u64, value: TableRow) -> none => {
        hash := hash_u64(key)
        idx := hash % 64
        
        # Linear probing
        for i in 0:64 {
            probe_idx := (idx + i) % 64
            if ~self.buckets[probe_idx].occupied || self.buckets[probe_idx].key == key {
                self.buckets[probe_idx] = HashEntry_U64_TableRow {
                    key: key,
                    value: value,
                    occupied: true,
                }
                if ~self.buckets[probe_idx].occupied {
                    self.size += 1
                }
                ret
            }
        }
    }
    
    get :: (&self, key: u64) -> ?&TableRow => {
        hash := hash_u64(key)
        idx := hash % 64
        
        for i in 0:64 {
            probe_idx := (idx + i) % 64
            if self.buckets[probe_idx].occupied && self.buckets[probe_idx].key == key {
                ret some &self.buckets[probe_idx].value
            }
            if ~self.buckets[probe_idx].occupied {
                ret none
            }
        }
        
        none
    }
    
    get_mut :: (&mut self, key: u64) -> ?&mut TableRow => {
        hash := hash_u64(key)
        idx := hash % 64
        
        for i in 0:64 {
            probe_idx := (idx + i) % 64
            if self.buckets[probe_idx].occupied && self.buckets[probe_idx].key == key {
                ret some &mut self.buckets[probe_idx].value
            }
            if ~self.buckets[probe_idx].occupied {
                ret none
            }
        }
        
        none
    }
    
    remove :: (&mut self, key: u64) -> bool => {
        hash := hash_u64(key)
        idx := hash % 64
        
        for i in 0:64 {
            probe_idx := (idx + i) % 64
            if self.buckets[probe_idx].occupied && self.buckets[probe_idx].key == key {
                self.buckets[probe_idx].occupied = false
                self.size -= 1
                ret true
            }
            if ~self.buckets[probe_idx].occupied {
                ret false
            }
        }
        
        false
    }
}

