# Simple hash function for u64 keys
hash_u64 :: (key: u64) -> u64 => {
    key
}

# Bucket entry for HashMap_U64_TableRow
HashEntry_U64_TableRow :: {
    key: u64,
    value: TableRow,
    occupied: bool,
}

# HashMap for u64 -> TableRow (used in Table.rows)
HashMap_U64_TableRow :: {
    buckets: [HashEntry_U64_TableRow; 64],
    size: u64,
}

impl HashMap_U64_TableRow {
    new :: () -> HashMap_U64_TableRow => {
        empty_buckets: [HashEntry_U64_TableRow; 64] = [
            HashEntry_U64_TableRow { key: 0, value: TableRow { id: 0, versions: [], current_version: 0 }, occupied: false },
