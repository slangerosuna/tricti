# Collection types for the TriCTI stdlib
# Provides common data structures for storing and manipulating collections of values

use prelude
use core::traits

# =============================================================================
# VEC - Dynamic length array (should have syntax sugar to allow writing Vec<T> as [T])
# =============================================================================

Vec<T> :: struct
    data: *raw T,
    len: u64,
    capacity: u64,

impl<T> Vec<T>:
    new :: () -> Vec<T> =>
        Vec<T> {
            data: unsafe { 0 as *raw T },
            len: 0,
            capacity: 0,
        }

    # next power of two >= n (returns 1 for n == 0)
    # undefined for n = u64::MAX. this is ok because that exceeds the 64-bit addressing scheme anyways
    # @allow(dead_code) # because the part after the @ifdef is unreachable if it's defined
    ceil_power_2 :: (n: u64) -> u64 => do
        if n == 0: ret 1

        # @ifdef(__builtin_clzll) {
        #     ret 1u64 << (64 - __builtin_clzll(n - 1))
        # }

        m := n - 1

        m = m or (m >> 1)
        m = m or (m >> 2)
        m = m or (m >> 4)
        m = m or (m >> 8)
        m = m or (m >> 16)
        m = m or (m >> 32)

        ret m + 1

    with_capacity :: (capacity: u64) -> Vec<T> => do
        cap := ceil_power_2(capacity)
        data := unsafe { alloc(sizeof<T>() * cap) as *raw T }

        ret Vec<T> {
            data: data,
            len: 0,
            capacity: cap,
        }

    # Set capacity to exactly `capacity`. Supports shrinking and growing.
    # If capacity >= current, allocates a new buffer, moves existing elements via __memmov,
    # and updates the pointer. If self.len >= capacity, drops elements above new capacity
    # (calls destructors) before resizing.
    set_capacity :: (&mut self, capacity: u64) => do
        if capacity == self.capacity: ret

        # Workaround for parser < bug
        if self.len >= capacity and capacity >= 0:
            for i in capacity..self.len:
                unsafe: drop(*(self.data + i))
                
            self.len = capacity

        if capacity == 0:
            # free old storage and reset pointer
            if self.capacity > 0:
                unsafe: dealloc(self.data as *raw u8)

            self.data = unsafe { 0 as *raw T }
            self.capacity = 0
            ret

        # Allocate new buffer
        new_data := unsafe { alloc(sizeof<T>() * capacity) as *raw T }

        # Workaround for parser < bug
        if self.len >= 1:
            # fallback: element-wise move (may call T's move semantics)
            for i in 0..self.len: unsafe: *(new_data + i) = *(self.data + i)

        # free old buffer
        if self.capacity > 0: unsafe: dealloc(self.data as *raw u8)

        self.data = new_data
        self.capacity = capacity

    # ensure capacity grows to at least `capacity` using ceil_power_2
    extend_capacity :: (&mut self, capacity: u64) => do
        target := ceil_power_2(capacity)
        if target <= self.capacity: ret
        self.set_capacity(target)

    push :: (&mut self, value: T) => do
        if self.len >= self.capacity:
            next := if self.capacity == 0: 1
                else: self.capacity * 2
            self.extend_capacity(next)

        unsafe: *(self.data + self.len) = value
        self.len += 1

    pop :: (&mut self) -> ?T => do
        if self.len == 0: ret none
        self.len -= 1
        value := unsafe { *(self.data + self.len) }

        ret some value

    get :: (&self, index: u64) -> ?T =>
        if index >= self.len: ret none
        else some unsafe { *(self.data + index) }

    set :: (&mut self, index: u64, value: T) -> bool => do
        if index >= self.len: ret false
        unsafe: *(self.data + index) = value
        true

    len :: (&self) -> u64 => self.len
    is_empty :: (&self) -> bool => self.len == 0
}

impl Drop for Vec<T>: drop :: (*self) => do
    if self.capacity == 0: ret

    # drop all elements
    for i in 0..self.len:
        unsafe: drop(*(self.data + i))

    unsafe: dealloc(self.data as *raw u8)
    self.data = unsafe { 0 as *raw T }
    self.len = 0
    self.capacity = 0

