# =============================================================================
# f64 implementations (PartialOrd only, no Ord due to NaN)
# =============================================================================
impl PartialEq for f64 {
    eq :: (&self, other: &f64) -> bool => { *self == *other }
}

impl PartialOrd for f64 {
    partial_cmp :: (&self, other: &f64) -> ?i64 => {
        if *self == *other { ret some 0 }
        if *self >= *other { ret some 1 }
        if *self < *other { ret some (-1) }
        none
    }
    lt :: (&self, other: &f64) -> bool => { *self < *other }
    le :: (&self, other: &f64) -> bool => { *self <= *other }
    gt :: (&self, other: &f64) -> bool => { *self > *other }
    ge :: (&self, other: &f64) -> bool => { *self >= *other }
}

impl Copy for f64 {}

impl Clone for f64 {
    clone :: (&self) -> f64 => { *self }
}

impl Display for f64 {
    to_string :: (&self) -> String => {
        String::from_f64(*self)
    }
}

impl Debug for f64 {
    debug_string :: (&self) -> String => {
        String::from_f64(*self)
    }
}

impl Default for f64 {
    default :: () -> f64 => { 0.0 }
}

# Arithmetic operators for f64 (no Rem for floating point)
impl Add for f64 {
    add :: (self, other: f64) -> f64 => {
        self + other
    }
}

impl Sub for f64 {
    sub :: (self, other: f64) -> f64 => {
        self - other
    }
}

impl Mul for f64 {
    mul :: (self, other: f64) -> f64 => {
        self * other
    }
}

impl Div for f64 {
    div :: (self, other: f64) -> f64 => {
        self / other
    }
}

impl Neg for f64 {
    neg :: (self) -> f64 => {
        -self
    }
}

# =============================================================================
# char (u8) implementations - using u8 as char
# =============================================================================
# Note: char is represented as u8 in TriCTI

# =============================================================================
# isize (i64) and usize (u64) implementations
# =============================================================================
# Note: isize and usize are aliases for i64 and u64 respectively

# =============================================================================
# String implementations
# =============================================================================
use core::string

impl PartialEq for String {
    eq :: (&self, other: &String) -> bool => {
        String::equals(self, other)
    }
}

impl Eq for String {}

impl PartialOrd for String {
    partial_cmp :: (&self, other: &String) -> ?i64 => {
        result := String::compare(self, other)
        some (result as i64)
    }
    lt :: (&self, other: &String) -> bool => {
        String::compare(self, other) < 0
    }
    le :: (&self, other: &String) -> bool => {
        String::compare(self, other) <= 0
    }
    gt :: (&self, other: &String) -> bool => {
        String::compare(self, other) > 0
    }
    ge :: (&self, other: &String) -> bool => {
        String::compare(self, other) >= 0
    }
}

impl Ord for String {
    cmp :: (&self, other: &String) -> i64 => {
        String::compare(self, other) as i64
    }
    max :: (self, other: String) -> String => {
        if String::compare(&self, &other) >= 0 { self } else { other }
    }
    min :: (self, other: String) -> String => {
        if String::compare(&self, &other) <= 0 { self } else { other }
    }
}

impl Clone for String {
    clone :: (&self) -> String => {
        String::clone(self)
    }
}

impl Display for String {
    to_string :: (&self) -> String => {
        String::clone(self)
    }
}

impl Debug for String {
    debug_string :: (&self) -> String => {
        result := String::with_capacity(self.len + 2)
        String::push_char(&result, 34)
        String::push_str(&result, self)
        String::push_char(&result, 34)
        result
    }
}

impl Default for String {
    default :: () -> String => {
        String::new()
    }
}

impl Drop for String {
    drop :: (*self) => {
        String::destroy(self)
    }
}

impl Hash for String {
    hash :: (&self) -> u64 => {
        FNV_OFFSET_BASIS :: 14695981039346656037
        FNV_PRIME :: 1099511628211
        
        hash := FNV_OFFSET_BASIS
        for i in 0:self.len {
            byte := self.data[i] as u64
            hash = hash ^ byte
            hash = hash * FNV_PRIME
        }
        hash
    }
}

# Operators for String
impl Add for String {
    add :: (self, other: String) -> String => {
        result := String::clone(&self)
        String::push_str(&result, &other)
        result
    }
}

impl Mul for String {
    mul :: (self, other: String) -> String => {
        count := String::to_i64(&other)
        if count <= 0 {
            ret String::new()
        }
        
        result := String::with_capacity(self.len * (count as u64))
        for i in 0:(count as u64) {
            String::push_str(&result, &self)
        }
        result
    }
}

# =============================================================================
# Option<T> implementations (built-in ?T type)
# =============================================================================

# Note: Option is built-in with ?T syntax, some/none keywords
# These implementations work with the built-in Option type

# PartialEq for Option<T> where T: PartialEq
impl<T: PartialEq> PartialEq for ?T {
    eq :: (&self, other: &?T) -> bool => {
        match (*self, *other) {
            (some a, some b) => a.eq(&b),
            (none, none) => true,
            _ => false,
        }
    }
}

# Eq for Option<T> where T: Eq
impl<T: Eq> Eq for ?T {}

# PartialOrd for Option<T> where T: PartialOrd
# None < Some
impl<T: PartialOrd> PartialOrd for ?T {
    partial_cmp :: (&self, other: &?T) -> ?i64 => {
        match (*self, *other) {
            (some a, some b) => a.partial_cmp(&b),
            (none, none) => some 0,
            (none, some _) => some (-1),
            (some _, none) => some 1,
        }
    }
    lt :: (&self, other: &?T) -> bool => {
        match (*self, *other) {
            (none, some _) => true,
            (some a, some b) => a.lt(&b),
            _ => false,
        }
    }
    le :: (&self, other: &?T) -> bool => {
        match (*self, *other) {
            (none, _) => true,
            (some a, some b) => a.le(&b),
            _ => false,
        }
    }
    gt :: (&self, other: &?T) -> bool => {
        match (*self, *other) {
            (some _, none) => true,
            (some a, some b) => a.gt(&b),
            _ => false,
        }
    }
    ge :: (&self, other: &?T) -> bool => {
        match (*self, *other) {
            (some _, none) => true,
            (some a, some b) => a.ge(&b),
            (none, none) => true,
            _ => false,
        }
    }
}

# Ord for Option<T> where T: Ord
impl<T: Ord> Ord for ?T {
    cmp :: (&self, other: &?T) -> i64 => {
        match (*self, *other) {
            (some a, some b) => a.cmp(&b),
            (none, none) => 0,
            (none, some _) => -1,
            (some _, none) => 1,
        }
    }
    max :: (self, other: ?T) -> ?T => {
        match (self, other) {
            (some a, some b) => some a.max(b),
            (some a, none) => some a,
            (none, some b) => some b,
            (none, none) => none,
        }
    }
    min :: (self, other: ?T) -> ?T => {
        match (self, other) {
            (some a, some b) => some a.min(b),
            (none, _) => none,
            (_, none) => none,
        }
    }
}

# Clone for Option<T> where T: Clone
impl<T: Clone> Clone for ?T {
    clone :: (&self) -> ?T => {
        match *self {
            some ref val => some val.clone(),
            none => none,
        }
    }
}

# Display for Option<T> where T: Display
impl<T: Display> Display for ?T {
    to_string :: (&self) -> String => {
        match *self {
            some ref val => {
                result := String::from_cstr("Some(" as *u8)
                String::push_str(&result, &val.to_string())
                String::push_char(&result, 41)
                result
            },
            none => String::from_cstr("None" as *u8),
        }
    }
}

# Debug for Option<T> where T: Debug
impl<T: Debug> Debug for ?T {
    debug_string :: (&self) -> String => {
        match *self {
            some ref val => {
                result := String::from_cstr("Some(" as *u8)
                String::push_str(&result, &val.debug_string())
                String::push_char(&result, 41)
                result
            },
            none => String::from_cstr("None" as *u8),
        }
    }
}

# Default for Option<T> - always None
impl<T> Default for ?T {
    default :: () -> ?T => { none }
}

# =============================================================================
# StdResult<T> implementations
# =============================================================================
use core::result

# PartialEq for StdResult<T> where T: PartialEq
impl<T: PartialEq> PartialEq for StdResult<T> {
    eq :: (&self, other: &StdResult<T>) -> bool => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.eq(&b),
            (StdResult::Err { error: e1 }, StdResult::Err { error: e2 }) => {
                std_error_message(e1) == std_error_message(e2)
            },
            _ => false,
        }
    }
}

# Eq for StdResult<T> where T: Eq
impl<T: Eq> Eq for StdResult<T> {}

# PartialOrd for StdResult<T> where T: PartialOrd
# Ok < Err ordering
impl<T: PartialOrd> PartialOrd for StdResult<T> {
    partial_cmp :: (&self, other: &StdResult<T>) -> ?i64 => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.partial_cmp(&b),
            (StdResult::Err { .. }, StdResult::Err { .. }) => some 0,
            (StdResult::Ok { .. }, StdResult::Err { .. }) => some (-1),
            (StdResult::Err { .. }, StdResult::Ok { .. }) => some 1,
        }
    }
    lt :: (&self, other: &StdResult<T>) -> bool => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.lt(&b),
            (StdResult::Ok { .. }, StdResult::Err { .. }) => true,
            _ => false,
        }
    }
    le :: (&self, other: &StdResult<T>) -> bool => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.le(&b),
            (StdResult::Ok { .. }, StdResult::Err { .. }) => true,
            (StdResult::Err { .. }, StdResult::Err { .. }) => true,
            _ => false,
        }
    }
    gt :: (&self, other: &StdResult<T>) -> bool => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.gt(&b),
            (StdResult::Err { .. }, StdResult::Ok { .. }) => true,
            _ => false,
        }
    }
    ge :: (&self, other: &StdResult<T>) -> bool => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.ge(&b),
            (StdResult::Err { .. }, StdResult::Ok { .. }) => true,
            (StdResult::Err { .. }, StdResult::Err { .. }) => true,
            _ => false,
        }
    }
}

# Ord for StdResult<T> where T: Ord
impl<T: Ord> Ord for StdResult<T> {
    cmp :: (&self, other: &StdResult<T>) -> i64 => {
        match (*self, *other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => a.cmp(&b),
            (StdResult::Err { .. }, StdResult::Err { .. }) => 0,
            (StdResult::Ok { .. }, StdResult::Err { .. }) => -1,
            (StdResult::Err { .. }, StdResult::Ok { .. }) => 1,
        }
    }
    max :: (self, other: StdResult<T>) -> StdResult<T> => {
        match (self, other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => std_ok(a.max(b)),
            (StdResult::Err { error: e }, _) => std_err(e),
            (_, StdResult::Err { error: e }) => std_err(e),
        }
    }
    min :: (self, other: StdResult<T>) -> StdResult<T> => {
        match (self, other) {
            (StdResult::Ok { value: a }, StdResult::Ok { value: b }) => std_ok(a.min(b)),
            (StdResult::Ok { value: v }, StdResult::Err { .. }) => std_ok(v),
            (StdResult::Err { .. }, StdResult::Ok { value: v }) => std_ok(v),
            (StdResult::Err { error: e }, _) => std_err(e),
        }
    }
}

# Clone for StdResult<T> where T: Clone
impl<T: Clone> Clone for StdResult<T> {
    clone :: (&self) -> StdResult<T> => {
        match *self {
            StdResult::Ok { value: ref val } => std_ok(val.clone()),
            StdResult::Err { error: ref e } => std_err(*e),
        }
    }
}

# Display for StdResult<T> where T: Display
impl<T: Display> Display for StdResult<T> {
    to_string :: (&self) -> String => {
        match *self {
            StdResult::Ok { value: ref val } => {
                result := String::from_cstr("Ok(" as *u8)
                String::push_str(&result, &val.to_string())
                String::push_char(&result, 41)
                result
            },
            StdResult::Err { error: ref e } => {
                result := String::from_cstr("Err(" as *u8)
                String::push_cstr(&result, std_error_message(*e) as *u8)
                String::push_char(&result, 41)
                result
            },
        }
    }
}

# Debug for StdResult<T> where T: Debug
impl<T: Debug> Debug for StdResult<T> {
    debug_string :: (&self) -> String => {
        match *self {
            StdResult::Ok { value: ref val } => {
                result := String::from_cstr("Ok(" as *u8)
                String::push_str(&result, &val.debug_string())
                String::push_char(&result, 41)
                result
            },
            StdResult::Err { error: ref e } => {
                result := String::from_cstr("Err(" as *u8)
                String::push_cstr(&result, std_error_message(*e) as *u8)
                String::push_char(&result, 41)
                result
            },
        }
    }
}

# =============================================================================
# CONVERSION IMPLEMENTATIONS FOR PRIMITIVES
# =============================================================================

# Lossless widening conversions: u8 -> u64
impl From<u8> for u64 {
    from :: (value: u8) -> u64 => {
        value as u64
    }
}

# Lossless widening conversions: u8 -> i64
impl From<u8> for i64 {
    from :: (value: u8) -> i64 => {
        value as i64
    }
}

# Boolean to i64 conversion
impl From<bool> for i64 {
    from :: (value: bool) -> i64 => {
        if value { 1 } else { 0 }
    }
}

# Boolean to u64 conversion
impl From<bool> for u64 {
    from :: (value: bool) -> u64 => {
        if value { 1 } else { 0 }
    }
}

# i64 to String conversion
impl From<i64> for String {
    from :: (value: i64) -> String => {
        String::from_i64(value)
    }
}

# u64 to String conversion
impl From<u64> for String {
    from :: (value: u64) -> String => {
        String::from_u64(value)
    }
}

# bool to String conversion
impl From<bool> for String {
    from :: (value: bool) -> String => {
        if value {
            String::from_cstr("true" as *u8)
        } else {
            String::from_cstr("false" as *u8)
        }
    }
}

# u8 (char) to String conversion
impl From<u8> for String {
    from :: (value: u8) -> String => {
        result := String::with_capacity(2)
        String::push_char(&result, value)
        result
    }
}

# f64 to String conversion
impl From<f64> for String {
    from :: (value: f64) -> String => {
        String::from_f64(value)
    }
}

# Narrowing conversions (fallible): u64 -> u8
impl TryFrom<u64> for u8 {
    try_from :: (value: u64) -> StdResult<u8> => {
        if value > 255 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("u64 value exceeds u8 maximum (255)" as *u8)
            })
        } else {
            std_ok(value as u8)
        }
    }
}

# Narrowing conversions (fallible): i64 -> u8
impl TryFrom<i64> for u8 {
    try_from :: (value: i64) -> StdResult<u8> => {
        if value < 0 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("i64 value is negative, cannot convert to u8" as *u8)
            })
        } else if value > 255 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("i64 value exceeds u8 maximum (255)" as *u8)
            })
        } else {
            std_ok(value as u8)
        }
    }
}

# Narrowing conversions (fallible): u64 -> i64
impl TryFrom<u64> for i64 {
    try_from :: (value: u64) -> StdResult<i64> => {
        if value > 9223372036854775807 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("u64 value exceeds i64 maximum" as *u8)
            })
        } else {
            std_ok(value as i64)
        }
    }
}

# Narrowing conversions (fallible): i64 -> u64
impl TryFrom<i64> for u64 {
    try_from :: (value: i64) -> StdResult<u64> => {
        if value < 0 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("i64 value is negative, cannot convert to u64" as *u8)
            })
        } else {
            std_ok(value as u64)
        }
    }
}

# Fallible conversions: f64 -> i64
impl TryFrom<f64> for i64 {
    try_from :: (value: f64) -> StdResult<i64> => {
        if value ~= value {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("f64 value is NaN" as *u8)
            })
        } else if value > 9223372036854775807.0 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("f64 value exceeds i64 maximum" as *u8)
            })
        } else if value < -9223372036854775808.0 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("f64 value below i64 minimum" as *u8)
            })
        } else {
            std_ok(value as i64)
        }
    }
}

# Fallible conversions: f64 -> u64
impl TryFrom<f64> for u64 {
    try_from :: (value: f64) -> StdResult<u64> => {
        if value ~= value {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("f64 value is NaN" as *u8)
            })
        } else if value < 0.0 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("f64 value is negative, cannot convert to u64" as *u8)
            })
        } else if value > 18446744073709551615.0 {
            std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("f64 value exceeds u64 maximum" as *u8)
            })
        } else {
            std_ok(value as u64)
        }
    }
}

# String parsing: String -> i64
impl TryFrom<String> for i64 {
    try_from :: (value: String) -> StdResult<i64> => {
        result := String::parse_i64(&value)
        match result {
            some val => std_ok(val),
            none => std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("Invalid i64 string format" as *u8)
            })
        }
    }
}

# String parsing: String -> u64
impl TryFrom<String> for u64 {
    try_from :: (value: String) -> StdResult<u64> => {
        result := String::parse_u64(&value)
        match result {
            some val => std_ok(val),
            none => std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("Invalid u64 string format" as *u8)
            })
        }
    }
}

# String parsing: String -> f64
impl TryFrom<String> for f64 {
    try_from :: (value: String) -> StdResult<f64> => {
        result := String::parse_f64(&value)
        match result {
            some val => std_ok(val),
            none => std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("Invalid f64 string format" as *u8)
            })
        }
    }
}

# String parsing: String -> bool
impl TryFrom<String> for bool {
    try_from :: (value: String) -> StdResult<bool> => {
        result := String::parse_bool(&value)
        match result {
            some val => std_ok(val),
            none => std_err(StdError::InvalidArgument {
                parameter: String::from_cstr("value" as *u8),
                message: String::from_cstr("Invalid bool string format (expected 'true' or 'false')" as *u8)
            })
        }
    }
}

# T -> Option<T> conversion
impl<T> From<T> for ?T {
    from :: (value: T) -> ?T => {
        some value
    }
}

# Option<T> -> T fallible conversion
impl<T> TryFrom<?T> for T {
    try_from :: (value: ?T) -> StdResult<T> => {
        match value {
            some val => std_ok(val),
            none => std_err(StdError::Message {
                message: String::from_cstr("Cannot unwrap None value" as *u8)
            })
        }
    }
}

# T -> Result<T,E> conversion (Ok wrapper)
impl<T, E> From<T> for StdResult<T> {
    from :: (value: T) -> StdResult<T> => {
        std_ok(value)
    }
}

