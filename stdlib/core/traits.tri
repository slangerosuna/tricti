# Trait system for TriCTI
# Provides polymorphism through traits and implementations

use prelude
use core::errors
use core::result

# =============================================================================
# CORE TRAITS
# =============================================================================

# Partial equality comparison (allows for types that may not have total equality like f64 with NaN)
PartialEq :: trait {
    eq : (&Self, &Self) -> bool,
    ne : (&Self, &Self) -> bool,
}

# Full equality comparison (marker trait indicating reflexive, symmetric, transitive equality)
Eq :: trait {
    # Marker trait - requires PartialEq
    # Indicates reflexive, symmetric, transitive equality
}

# Partial ordering comparison (allows for incomparable values like NaN)
PartialOrd :: trait {
    partial_cmp : (&Self, &Self) -> ?i64,
    lt : (&Self, &Self) -> bool,
    le : (&Self, &Self) -> bool,
    gt : (&Self, &Self) -> bool,
    ge : (&Self, &Self) -> bool,
}

# Total ordering comparison
Ord :: trait {
    cmp : (&Self, &Self) -> i64,
    max : (Self, Self) -> Self,
    min : (Self, Self) -> Self,
}

# Hash for HashMap/HashSet
Hash :: trait {
    hash : (&Self) -> u64,
}

# Clone (deep copy)
Clone :: trait {
    clone : (&Self) -> Self,
    clone_from : (&mut Self, &Self) -> none,
}
# Copy - marker trait
Copy :: trait {
    # Just a marker trait to allow implicit cloning
}

# Drop (destructor)
# Implemented for all types by default
# Can be overridden for custom cleanup
Drop :: trait {
    drop : (*Self) -> none,
}

# Display for string representation
Display :: trait {
    to_string : (&Self) -> String,
}

# Debug for debug printing
Debug :: trait {
    debug_string : (&Self) -> String,
}

# Default value
Default :: trait {
    default : () -> Self,
}

# =============================================================================
# CONVERSION TRAITS
# =============================================================================

# Infallible conversion from T to Self
From<T> :: trait {
    from : (T) -> Self,
}

# Infallible conversion from Self to T
Into<T> :: trait {
    into : (Self) -> T,
}

# Fallible conversion from T to Self
TryFrom<T> :: trait {
    try_from : (T) -> StdResult<Self>,
}

# Fallible conversion from Self to T
TryInto<T> :: trait {
    try_into : (Self) -> StdResult<T>,
}

# Blanket implementation: Into<U> for any T where U: From<T>
# This means if you implement From<T> for U, you automatically get Into<U> for T
impl<T, U: From<T>> Into<U> for T {
    into :: (self: T) -> U => {
        ret U::from(self)
    }
}

# Blanket implementation: TryInto<U> for any T where U: TryFrom<T>
# This means if you implement TryFrom<T> for U, you automatically get TryInto<U> for T
impl<T, U: TryFrom<T>> TryInto<U> for T {
    try_into :: (self: T) -> StdResult<U> => {
        ret U::try_from(self)
    }
}

# =============================================================================
# OPERATOR TRAITS
# =============================================================================

# Arithmetic Operators
Add :: trait {
    add : (Self, Self) -> Self,
}

Sub :: trait {
    sub : (Self, Self) -> Self,
}

Mul :: trait {
    mul : (Self, Self) -> Self,
}

Div :: trait {
    div : (Self, Self) -> Self,
}

Rem :: trait {
    rem : (Self, Self) -> Self,
}

Neg :: trait {
    neg : (Self) -> Self,
}

# Bitwise Operators
BitAnd :: trait {
    bitand : (Self, Self) -> Self,
}

BitOr :: trait {
    bitor : (Self, Self) -> Self,
}

BitXor :: trait {
    bitxor : (Self, Self) -> Self,
}

Shl :: trait {
    shl : (Self, u64) -> Self,
}

Shr :: trait {
    shr : (Self, u64) -> Self,
}

Not :: trait {
    not : (Self) -> Self,
}

# Indexing Operators (definitions only, implementations deferred)
Index<Idx> :: trait {
    index : (&Self, Idx) -> u8,
}

IndexMut<Idx> :: trait {
    index_mut : (&mut Self, Idx) -> *u8,
}

# Assignment Operators
AddAssign :: trait {
    add_assign : (&mut Self, Self) -> none,
}

SubAssign :: trait {
    sub_assign : (&mut Self, Self) -> none,
}

MulAssign :: trait {
    mul_assign : (&mut Self, Self) -> none,
}

DivAssign :: trait {
    div_assign : (&mut Self, Self) -> none,
}

RemAssign :: trait {
    rem_assign : (&mut Self, Self) -> none,
}

BitAndAssign :: trait {
    bitand_assign : (&mut Self, Self) -> none,
}

BitOrAssign :: trait {
    bitor_assign : (&mut Self, Self) -> none,
}

BitXorAssign :: trait {
    bitxor_assign : (&mut Self, Self) -> none,
}

ShlAssign :: trait {
    shl_assign : (&mut Self, u64) -> none,
}

ShrAssign :: trait {
    shr_assign : (&mut Self, u64) -> none,
}

# =============================================================================
# I/O TRAITS
# =============================================================================

# Read trait for reading bytes from a source
Read :: trait {
    read : (&mut Self, buf: &mut u8, len: u64) -> ?u64,
    read_exact : (&mut Self, buf: &mut u8, len: u64) -> bool,
}

# Write trait for writing bytes to a destination
Write :: trait {
    write : (&mut Self, buf: &mut u8, len: u64) -> ?u64,
    write_all : (&mut Self, buf: &mut u8, len: u64) -> bool,
    flush : (&mut Self) -> bool,
}

# Seek trait for positioning within a stream
Seek :: trait {
    seek : (&mut Self, pos: i64, whence: i32) -> ?i64,
    tell : (&Self) -> ?i64,
}

# =============================================================================
# ITERATOR TRAITS
# =============================================================================

# Core iterator trait - provides sequential access to elements
Iterator<T> :: trait {
    next : (&mut Self) -> ?T,
}

# Conversion into an iterator
IntoIterator<T> :: trait {
    into_iter : (Self) -> Self,
}

# Double-ended iterator for bidirectional iteration
DoubleEndedIterator<T> :: trait {
    next_back : (&mut Self) -> ?T,
}

# =============================================================================
# SERIALIZATION TRAITS (COMMENTED OUT - Vec and StdResult not yet implemented)
# =============================================================================

# trait Serialize {
#     serialize :: (&self) -> StdResult<Vec<u8>>
# }

# trait Deserialize {
#     deserialize :: (data: Vec<u8>) -> StdResult<Self>
# }

