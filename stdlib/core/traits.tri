# =============================================================================
# TRAIT IMPLEMENTATIONS FOR PRIMITIVES
# =============================================================================

# i64 implementations
impl Eq for i64 {
    eq :: (&self, other: &i64) -> bool => { *self == *other }
}

impl Ord for i64 {
    lt :: (&self, other: &i64) -> bool => { *self < *other }
}

impl Hash for i64 {
    hash :: (&self) -> u64 => { *self as u64 }
}

impl Display for i64 {
    to_string :: (&self) -> string => {
        # TODO: Implement i64 to string conversion
        "i64"
    }
}

impl Default for i64 {
    default :: () -> i64 => { 0 }
}

# u64 implementations
impl Eq for u64 {
    eq :: (&self, other: &u64) -> bool => { *self == *other }
}

impl Ord for u64 {
    lt :: (&self, other: &u64) -> bool => { *self < *other }
}

impl Hash for u64 {
    hash :: (&self) -> u64 => { *self }
}

impl Display for u64 {
    to_string :: (&self) -> string => {
        # TODO: Implement u64 to string conversion
        "u64"
    }
}

impl Default for u64 {
    default :: () -> u64 => { 0 }
}

# bool implementations
impl Eq for bool {
    eq :: (&self, other: &bool) -> bool => { *self == *other }
}

impl Display for bool {
    to_string :: (&self) -> string => {
        if *self { "true" } else { "false" }
    }
}

impl Default for bool {
    default :: () -> bool => { false }
}

impl Hash for bool {
    hash :: (&self) -> u64 => {
        if *self { 1 } else { 0 }
    }
}

# String implementations (requires String type from core::string)
# Note: String struct is { data: *u8, len: u64, capacity: u64 }
impl Eq for String {
    eq :: (&self, other: &String) -> bool => {
        if self.len ~= other.len {
            ret false
        }
        for i in 0:self.len {
            if self.data[i] ~= other.data[i] {
                ret false
            }
        }
        true
    }
}

impl Hash for String {
    hash :: (&self) -> u64 => {
        # FNV-1a hash algorithm
        FNV_OFFSET_BASIS :: 14695981039346656037
        FNV_PRIME :: 1099511628211
        
        hash := FNV_OFFSET_BASIS
        for i in 0:self.len {
            byte := self.data[i] as u64
            hash = hash ^ byte
            hash = hash * FNV_PRIME
        }
        hash
    }
}

