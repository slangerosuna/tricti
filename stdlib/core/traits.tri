# Trait system for TriCTI
# Provides polymorphism through traits and implementations

use prelude
use core::errors

# =============================================================================
# CORE TRAITS
# =============================================================================

# Equality comparison
trait Eq {
    eq :: (&self, other: &Self) -> bool
    ne :: (&self, other: &Self) -> bool => { ~self.eq(other) }
}

# Ordering comparison
trait Ord: Eq {
    lt :: (&self, other: &Self) -> bool
    le :: (&self, other: &Self) -> bool => { self.lt(other) || self.eq(other) }
    gt :: (&self, other: &Self) -> bool => { ~self.le(other) }
    ge :: (&self, other: &Self) -> bool => { ~self.lt(other) }
}

# Hash for HashMap/HashSet
trait Hash {
    hash :: (&self) -> u64
}

# Clone (deep copy)
trait Clone {
    clone :: (&self) -> Self
}

# Copy (bitwise copy)
trait Copy: Clone {
    # Automatically implements Clone as bitwise copy
}

# Drop (destructor)
trait Drop {
    drop :: (self) => { }
}

# Display for string representation
trait Display {
    to_string :: (&self) -> string
}

# Debug for debug printing
trait Debug {
    debug_string :: (&self) -> string
}

# Default value
trait Default {
    default :: () -> Self
}

