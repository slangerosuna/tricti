# =============================================================================
# TRAIT IMPLEMENTATIONS FOR PRIMITIVES
# =============================================================================

# =============================================================================
# bool implementations
# =============================================================================
impl PartialEq for bool {
    eq :: (&self, other: &bool) -> bool => { *self == *other }
}

impl Eq for bool {}

impl PartialOrd for bool {
    partial_cmp :: (&self, other: &bool) -> ?i64 => {
        if *self == *other { ret some 0 }
        if *self { some 1 } else { some (-1) }
    }
    lt :: (&self, other: &bool) -> bool => { ~(*self) && *other }
    le :: (&self, other: &bool) -> bool => { ~(*self) || *self == *other }
    gt :: (&self, other: &bool) -> bool => { *self && ~(*other) }
    ge :: (&self, other: &bool) -> bool => { *self || *self == *other }
}

impl Ord for bool {
    cmp :: (&self, other: &bool) -> i64 => {
        if *self == *other { ret 0 }
        if *self { 1 } else { -1 }
    }
    max :: (self, other: bool) -> bool => { self || other }
    min :: (self, other: bool) -> bool => { self && other }
}

impl Copy for bool {}

impl Clone for bool {
    clone :: (&self) -> bool => { *self }
}

impl Display for bool {
    to_string :: (&self) -> String => {
        if *self { String::from_cstr("true" as *u8) } else { String::from_cstr("false" as *u8) }
    }
}

impl Debug for bool {
    debug_string :: (&self) -> String => {
        if *self { String::from_cstr("true" as *u8) } else { String::from_cstr("false" as *u8) }
    }
}

impl Default for bool {
    default :: () -> bool => { false }
}

impl Hash for bool {
    hash :: (&self) -> u64 => {
        if *self { 1 } else { 0 }
    }
}

# Bitwise operators for bool
impl BitAnd for bool {
    bitand :: (self, other: bool) -> bool => {
        self && other
    }
}

impl BitOr for bool {
    bitor :: (self, other: bool) -> bool => {
        self || other
    }
}

impl BitXor for bool {
    bitxor :: (self, other: bool) -> bool => {
        (self || other) && ~(self && other)
    }
}

impl Not for bool {
    not :: (self) -> bool => {
        ~self
    }
}

# =============================================================================
# i64 implementations
# =============================================================================
impl PartialEq for i64 {
    eq :: (&self, other: &i64) -> bool => { *self == *other }
}

impl Eq for i64 {}

impl PartialOrd for i64 {
    partial_cmp :: (&self, other: &i64) -> ?i64 => {
        if *self == *other { ret some 0 }
        if *self >= *other { some 1 } else { some (-1) }
    }
    lt :: (&self, other: &i64) -> bool => { *self < *other }
    le :: (&self, other: &i64) -> bool => { *self <= *other }
    gt :: (&self, other: &i64) -> bool => { *self > *other }
    ge :: (&self, other: &i64) -> bool => { *self >= *other }
}

impl Ord for i64 {
    cmp :: (&self, other: &i64) -> i64 => {
        if *self == *other { ret 0 }
        if *self >= *other { 1 } else { -1 }
    }
    max :: (self, other: i64) -> i64 => {
        if self >= other { self } else { other }
    }
    min :: (self, other: i64) -> i64 => {
        if self <= other { self } else { other }
    }
}

impl Copy for i64 {}

impl Clone for i64 {
    clone :: (&self) -> i64 => { *self }
}

impl Display for i64 {
    to_string :: (&self) -> String => {
        String::from_i64(*self)
    }
}

impl Debug for i64 {
    debug_string :: (&self) -> String => {
        String::from_i64(*self)
    }
}

impl Default for i64 {
    default :: () -> i64 => { 0 }
}

impl Hash for i64 {
    hash :: (&self) -> u64 => { *self as u64 }
}

# Arithmetic operators for i64
impl Add for i64 {
    add :: (self, other: i64) -> i64 => {
        self + other
    }
}

impl Sub for i64 {
    sub :: (self, other: i64) -> i64 => {
        self - other
    }
}

impl Mul for i64 {
    mul :: (self, other: i64) -> i64 => {
        self * other
    }
}

impl Div for i64 {
    div :: (self, other: i64) -> i64 => {
        self / other
    }
}

impl Rem for i64 {
    rem :: (self, other: i64) -> i64 => {
        self % other
    }
}

impl Neg for i64 {
    neg :: (self) -> i64 => {
        -self
    }
}

# Bitwise operators for i64
impl BitAnd for i64 {
    bitand :: (self, other: i64) -> i64 => {
        self & other
    }
}

impl BitOr for i64 {
    bitor :: (self, other: i64) -> i64 => {
        self | other
    }
}

impl BitXor for i64 {
    bitxor :: (self, other: i64) -> i64 => {
        self ^ other
    }
}

impl Shl for i64 {
    shl :: (self, shift: u64) -> i64 => {
        self << shift
    }
}

impl Shr for i64 {
    shr :: (self, shift: u64) -> i64 => {
        self >> shift
    }
}

impl Not for i64 {
    not :: (self) -> i64 => {
        ~self
    }
}

