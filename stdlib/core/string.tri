# String type for TriCTI stdlib
# A production-ready string implementation with comprehensive API

use prelude

# Core String struct
String :: struct {
    data: *u8,
    len: u64,
    capacity: u64
}

# Extern C standard library functions
extern malloc :: (size: u64) -> *u8
extern free :: (ptr: *u8) -> none
extern memcpy :: (dest: *u8, src: *u8, n: u64) -> *u8
extern memmove :: (dest: *u8, src: *u8, n: u64) -> *u8
extern memset :: (s: *u8, c: i32, n: u64) -> *u8
extern strlen :: (s: *u8) -> u64
extern strcmp :: (s1: *u8, s2: *u8) -> i32
extern strncmp :: (s1: *u8, s2: *u8, n: u64) -> i32
extern strcpy :: (dest: *u8, src: *u8) -> *u8
extern strncpy :: (dest: *u8, src: *u8, n: u64) -> *u8
extern strstr :: (haystack: *u8, needle: *u8) -> *u8
extern strchr :: (s: *u8, c: i32) -> *u8
extern strcat :: (dest: *u8, src: *u8) -> *u8
extern atoi :: (s: *u8) -> i32
extern atof :: (s: *u8) -> f64
extern sprintf :: (str: *u8, format: *u8, ...) -> i32
extern snprintf :: (str: *u8, size: u64, format: *u8, ...) -> i32
extern toupper :: (c: i32) -> i32
extern tolower :: (c: i32) -> i32
extern isspace :: (c: i32) -> i32

# Helper to convert pointer offset
ptr_offset :: (base: *u8, offset: u64) -> *u8 => {
    (base as u64 + offset) as *u8
}

# String implementation with associated functions
impl String {
    # Constructor: Create empty string
    new :: () -> String => {
        data := malloc(1)
        data[0] = 0
        {
            data: data,
            len: 0,
            capacity: 1
        }
    }

    # Constructor: Create string from C string
    from_cstr :: (cstr: *u8) -> String => {
        if cstr == (0 as *u8) {
            ret String::new()
        }
        
        len := strlen(cstr)
        if len == 0 {
            ret String::new()
        }
        
        capacity := len + 1
        data := malloc(capacity)
        strcpy(data, cstr)
        
        {
            data: data,
            len: len,
            capacity: capacity
        }
    }

    # Constructor: Create string with pre-allocated capacity
    with_capacity :: (cap: u64) -> String => {
        if cap == 0 {
            ret String::new()
        }
        
        data := malloc(cap)
        memset(data, 0, cap)
        
        {
            data: data,
            len: 0,
            capacity: cap
        }
    }

    # Get length
    len :: (self: *String) -> u64 => {
        self.len
    }

    # Check if empty
    is_empty :: (self: *String) -> bool => {
        self.len == 0
    }

    # Get capacity
    capacity :: (self: *String) -> u64 => {
        self.capacity
    }

    # Reserve additional capacity
    reserve :: (self: *String, additional: u64) -> none => {
        needed := self.len + additional + 1
        if needed <= self.capacity {
            ret none
        }
        
        new_cap := needed * 2
        new_data := malloc(new_cap)
        
        if self.data ~= (0 as *u8) {
            memcpy(new_data, self.data, self.len)
            free(self.data)
        }
        
        new_data[self.len] = 0
        self.data = new_data
        self.capacity = new_cap
    }

    # Shrink capacity to fit current length
    shrink_to_fit :: (self: *String) -> none => {
        if self.len == 0 {
            if self.data ~= (0 as *u8) {
                free(self.data)
            }
            self.data = malloc(1)
            self.data[0] = 0
            self.capacity = 1
            ret none
        }
        
        if self.capacity <= self.len + 1 {
            ret none
        }
        
        new_cap := self.len + 1
        new_data := malloc(new_cap)
        memcpy(new_data, self.data, self.len)
        new_data[self.len] = 0
        free(self.data)
        
        self.data = new_data
        self.capacity = new_cap
    }

    # Access character at index
    char_at :: (self: *String, index: u64) -> u8 => {
        if index >= self.len {
            panic("String index out of bounds")
        }
        ptr_offset(self.data, index)[0]
    }

    # Get bytes as C string
    as_cstr :: (self: *String) -> *u8 => {
        if self.data == (0 as *u8) {
            ret "" as *u8
        }
        self.data
    }

    # Get raw bytes pointer
    bytes :: (self: *String) -> *u8 => {
        self.data
    }

    # Push string
    push_str :: (self: *String, other: *String) -> none => {
        if other.len == 0 {
            ret none
        }
        
        new_len := self.len + other.len
        if new_len + 1 >= self.capacity {
            String::reserve(self, other.len)
        }
        
        memmove(ptr_offset(self.data, self.len), other.data, other.len)
        self.len = new_len
        ptr_offset(self.data, self.len)[0] = 0
    }

    # Push C string
    push_cstr :: (self: *String, cstr: *u8) -> none => {
        if cstr == (0 as *u8) {
            ret none
        }
        
        cstr_in_self := (cstr >= self.data && cstr < ptr_offset(self.data, self.len))
        offset := 0
        if cstr_in_self {
            offset = (cstr as u64) - (self.data as u64)
        }
        
        len := strlen(cstr)
        if len == 0 {
            ret none
        }
        
        String::reserve(self, self.len + len)
        
        src := cstr
        if cstr_in_self {
            src = ptr_offset(self.data, offset)
        }
        
        memmove(ptr_offset(self.data, self.len), src, len)
        self.len = self.len + len
        ptr_offset(self.data, self.len)[0] = 0
    }

    # Push single character
    push_char :: (self: *String, ch: u8) -> none => {
        if self.len + 1 >= self.capacity {
            String::reserve(self, 1)
        }
        
        ptr_offset(self.data, self.len)[0] = ch
        self.len = self.len + 1
        ptr_offset(self.data, self.len)[0] = 0
    }

    # Pop last character
    pop :: (self: *String) -> u8 => {
        if self.len == 0 {
            panic("Cannot pop from empty string")
        }
        
        self.len = self.len - 1
        ch := ptr_offset(self.data, self.len)[0]
        ptr_offset(self.data, self.len)[0] = 0
        ch
    }

    # Clear string
    clear :: (self: *String) -> none => {
        if self.data ~= (0 as *u8) {
            memset(self.data, 0, self.capacity)
        }
        self.len = 0
    }

    # Truncate to length
    truncate :: (self: *String, new_len: u64) -> none => {
        if new_len >= self.len {
            ret none
        }
        
        self.len = new_len
        if self.data ~= (0 as *u8) {
            ptr_offset(self.data, self.len)[0] = 0
        }
    }

    # Check if contains substring
    contains :: (self: *String, needle: *String) -> bool => {
        if needle.len == 0 {
            ret true
        }
        if self.len == 0 || needle.len > self.len {
            ret false
        }
        
        result := strstr(self.data, needle.data)
        result ~= (0 as *u8)
    }

    # Check if starts with
    starts_with :: (self: *String, prefix: *String) -> bool => {
        if prefix.len > self.len {
            ret false
        }
        if prefix.len == 0 {
            ret true
        }
        
        strncmp(self.data, prefix.data, prefix.len) == 0
    }

    # Check if ends with
    ends_with :: (self: *String, suffix: *String) -> bool => {
        if suffix.len > self.len {
            ret false
        }
        if suffix.len == 0 {
            ret true
        }
        
        offset := self.len - suffix.len
        strncmp(ptr_offset(self.data, offset), suffix.data, suffix.len) == 0
    }

    # Find first occurrence of substring
    find :: (self: *String, needle: *String) -> i64 => {
        if needle.len == 0 {
            ret 0
        }
        if self.len == 0 || needle.len > self.len {
            ret -1
        }
        
        result := strstr(self.data, needle.data)
        if result == (0 as *u8) {
            ret -1
        }
        
        (result as u64 - self.data as u64) as i64
    }

    # Index of (alias for find)
    index_of :: (self: *String, needle: *String) -> i64 => {
        String::find(self, needle)
    }

    # Equals comparison
    equals :: (self: *String, other: *String) -> bool => {
        if self.len ~= other.len {
            ret false
        }
        if self.len == 0 {
            ret true
        }
        
        strcmp(self.data, other.data) == 0
    }

    # Compare (returns -1, 0, or 1)
    compare :: (self: *String, other: *String) -> i32 => {
        result := strcmp(self.data, other.data)
        if result >= 0 {
            if result >= 1 {
                ret 1
            }
            ret 0
        }
        -1
    }

    # Case-insensitive equality
    eq_ignore_case :: (self: *String, other: *String) -> bool => {
        if self.len ~= other.len {
            ret false
        }
        if self.len == 0 {
            ret true
        }
        
        for i in 0:self.len {
            c1 := tolower(ptr_offset(self.data, i)[0] as i32)
            c2 := tolower(ptr_offset(other.data, i)[0] as i32)
            if c1 ~= c2 {
                ret false
            }
        }
        true
    }

    # Convert to uppercase
    to_uppercase :: (self: *String) -> String => {
        result := String::with_capacity(self.len + 1)
        
        for i in 0:self.len {
            ch := ptr_offset(self.data, i)[0] as i32
            upper := toupper(ch) as u8
            String::push_char(&result, upper)
        }
        
        result
    }

    # Convert to lowercase
    to_lowercase :: (self: *String) -> String => {
        result := String::with_capacity(self.len + 1)
        
        for i in 0:self.len {
            ch := ptr_offset(self.data, i)[0] as i32
            lower := tolower(ch) as u8
            String::push_char(&result, lower)
        }
        
        result
    }

    # Trim whitespace from both ends
    trim :: (self: *String) -> String => {
        if self.len == 0 {
            ret String::new()
        }
        
        start := self.len
        for i in 0:self.len {
            ch := ptr_offset(self.data, i)[0] as i32
            if isspace(ch) == 0 {
                start = i
                break
            }
        }
        
        if start == self.len {
            ret String::new()
        }
        
        end := self.len
        i := 0
        loop {
            if i < self.len {
                idx := self.len - 1 - i
                if idx < start {
                    break
                }
                ch := ptr_offset(self.data, idx)[0] as i32
                if isspace(ch) == 0 {
                    end = idx + 1
                    break
                }
                i = i + 1
            } else {
                break
            }
        }
        
        if start >= end {
            ret String::new()
        }
        
        String::substring(self, start, end)
    }

    # Trim whitespace from start
    trim_start :: (self: *String) -> String => {
        if self.len == 0 {
            ret String::new()
        }
        
        start := self.len
        for i in 0:self.len {
            ch := ptr_offset(self.data, i)[0] as i32
            if isspace(ch) == 0 {
                start = i
                break
            }
        }
        
        if start == self.len {
            ret String::new()
        }
        
        String::substring(self, start, self.len)
    }

    # Trim whitespace from end
    trim_end :: (self: *String) -> String => {
        if self.len == 0 {
            ret String::new()
        }
        
        end := self.len
        i := 0
        loop {
            if i < self.len {
                idx := self.len - 1 - i
                ch := ptr_offset(self.data, idx)[0] as i32
                if isspace(ch) == 0 {
                    end = idx + 1
                    break
                }
                i = i + 1
            } else {
                end = 0
                break
            }
        }
        
        String::substring(self, 0, end)
    }

    # Concatenate strings
    concat :: (self: *String, other: *String) -> String => {
        result := String::with_capacity(self.len + other.len + 1)
        String::push_str(&result, self)
        String::push_str(&result, other)
        result
    }

    # Repeat string n times
    repeat :: (self: *String, n: u64) -> String => {
        if n == 0 || self.len == 0 {
            ret String::new()
        }
        
        result := String::with_capacity(self.len * n + 1)
        for i in 0:n {
            String::push_str(&result, self)
        }
        result
    }

    # Get substring
    substring :: (self: *String, start: u64, end: u64) -> String => {
        if start >= self.len {
            ret String::new()
        }
        if end >= self.len {
            end = self.len
        }
        if start >= end {
            ret String::new()
        }
        
        len := end - start
        result := String::with_capacity(len + 1)
        
        memcpy(result.data, ptr_offset(self.data, start), len)
        result.len = len
        ptr_offset(result.data, len)[0] = 0
        
        result
    }

    # Slice (alias for substring)
    slice :: (self: *String, start: u64, end: u64) -> String => {
        String::substring(self, start, end)
    }

    # Split at index
    split_at :: (self: *String, index: u64) -> (String, String) => {
        if index >= self.len {
            ret (String::substring(self, 0, self.len), String::new())
        }
        
        left := String::substring(self, 0, index)
        right := String::substring(self, index, self.len)
        (left, right)
    }

    # Convert to i64
    to_i64 :: (self: *String) -> i64 => {
        if self.len == 0 {
            ret 0
        }
        atoi(self.data) as i64
    }

    # Convert to f64
    to_f64 :: (self: *String) -> f64 => {
        if self.len == 0 {
            ret 0.0
        }
        atof(self.data)
    }

    # Create string from i64
    from_i64 :: (value: i64) -> String => {
        buffer := malloc(32) as *u8
        snprintf(buffer, 32, "%ld" as *u8, value)
        
        result := String::from_cstr(buffer)
        free(buffer)
        result
    }

    # Create string from f64
    from_f64 :: (value: f64) -> String => {
        buffer := malloc(64) as *u8
        snprintf(buffer, 64, "%f" as *u8, value)
        
        result := String::from_cstr(buffer)
        free(buffer)
        result
    }

    # Iterate over characters with callback
    each_char :: (self: *String, callback: (u8) -> none) -> none => {
        for i in 0:self.len {
            ch := ptr_offset(self.data, i)[0]
            callback(ch)
        }
    }

    # Clone/copy string
    clone :: (self: *String) -> String => {
        String::substring(self, 0, self.len)
    }

    # Destroy string and free memory
    destroy :: (self: *String) -> none => {
        if self.data ~= (0 as *u8) {
            free(self.data)
            self.data = 0 as *u8
        }
        self.len = 0
        self.capacity = 0
    }

    # Replace first occurrence
    replace_first :: (self: *String, old: *String, new: *String) -> String => {
        index := String::find(self, old)
        if index < 0 {
            ret String::clone(self)
        }
        
        result := String::with_capacity(self.len - old.len + new.len + 1)
        
        left := String::substring(self, 0, index as u64)
        right := String::substring(self, (index as u64) + old.len, self.len)
        String::push_str(&result, &left)
        String::push_str(&result, new)
        String::push_str(&result, &right)
        
        result
    }

    # Count occurrences of character
    count_char :: (self: *String, ch: u8) -> u64 => {
        count := 0
        for i in 0:self.len {
            if ptr_offset(self.data, i)[0] == ch {
                count = count + 1
            }
        }
        count
    }

    # Reverse string
    reverse :: (self: *String) -> String => {
        if self.len <= 1 {
            ret String::clone(self)
        }
        
        result := String::with_capacity(self.len + 1)
        i := 0
        loop {
            if i < self.len {
                idx := self.len - 1 - i
                String::push_char(&result, ptr_offset(self.data, idx)[0])
                i = i + 1
            } else {
                break
            }
        }
        result
    }
}
