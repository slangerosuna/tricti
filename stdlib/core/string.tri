# String type for TriCTI stdlib
# A production-ready string implementation with comprehensive API

use std::prelude

# Core String struct
String :: struct
    data: *raw u8,
    len: u64,
    capacity: u64

# Extern C standard library functions
extern malloc :: (size: u64) -> *raw u8
extern free :: (ptr: *raw u8) -> none
extern memcpy :: (dest: *raw u8, src: *raw u8, n: u64) -> *raw u8
extern memmove :: (dest: *raw u8, src: *raw u8, n: u64) -> *raw u8
extern memset :: (s: *raw u8, c: i32, n: u64) -> *raw u8
extern strlen :: (s: *raw u8) -> u64
extern strcmp :: (s1: *raw u8, s2: *raw u8) -> i32
extern strncmp :: (s1: *raw u8, s2: *raw u8, n: u64) -> i32
extern strcpy :: (dest: *raw u8, src: *raw u8) -> *raw u8
extern strncpy :: (dest: *raw u8, src: *raw u8, n: u64) -> *raw u8
extern strstr :: (haystack: *raw u8, needle: *raw u8) -> *raw u8
extern strchr :: (s: *raw u8, c: i32) -> *raw u8
extern strcat :: (dest: *raw u8, src: *raw u8) -> *raw u8
extern atoi :: (s: *raw u8) -> i32
extern atof :: (s: *raw u8) -> f64
extern sprintf :: (str: *raw u8, format: *raw u8, ...) -> i32
extern snprintf :: (str: *raw u8, size: u64, format: *raw u8, ...) -> i32
extern toupper :: (c: i32) -> i32
extern tolower :: (c: i32) -> i32
extern isspace :: (c: i32) -> i32

# Helper to convert pointer offset
ptr_offset :: unsafe (base: *raw u8, offset: u64) -> *raw u8 => unsafe { (base as u64 + offset) as *raw u8 }

# String implementation with associated functions
impl String:
    # Constructor: Create empty string
    new :: () -> String => do
        data := malloc(1)
        data[0] = 0
        ret String {
            data: data,
            len: 0,
            capacity: 1
        }

    # Constructor: Create string from C string
    from_cstr :: (cstr: *raw u8) -> String => do
        if cstr == (0 as *raw u8):
            ret String::new()

        len := strlen(cstr)
        if len == 0:
            ret String::new()

        capacity := len + 1
        data := malloc(capacity)
        strcpy(data, cstr)

        ret String {
            data: data,
            len: len,
            capacity: capacity
        }

    # Constructor: Create string from raw bytes buffer
    from_bytes :: (ptr: *raw u8, len: u64) -> String => do
        if ptr == (0 as *raw u8) or len == 0:
            ret String::new()

        capacity := len + 1
        data := malloc(capacity)
        memcpy(data, ptr, len)
        ptr_offset(data, len)[0] = 0

        ret String {
            data: data,
            len: len,
            capacity: capacity
        }

    # Constructor: Create string with pre-allocated capacity
    with_capacity :: (cap: u64) -> String => do
        if cap == 0:
            ret String::new()

        data := malloc(cap)
        memset(data, 0, cap)

        ret String {
            data: data,
            len: 0,
            capacity: cap
        }

    # Get length
    len :: (&self) -> u64 => self.len

    # Check if empty
    is_empty :: (&self) -> bool => self.len == 0

    # Get capacity
    capacity :: (&self) -> u64 => self.capacity

    # Reserve additional capacity
    reserve :: (&mut self, additional: u64) -> none => do
        needed := self.len + additional + 1
        if needed <= self.capacity:
            ret none

        new_cap := needed * 2
        new_data := malloc(new_cap)

        if self.data ~= (0 as *u8):
            memcpy(new_data, self.data, self.len)
            free(self.data)

        new_data[self.len] = 0
        self.data = new_data
        self.capacity = new_cap

    # Shrink capacity to fit current length
    shrink_to_fit :: (&mut self) -> none => do
        if self.len == 0:
            if self.data ~= (0 as *raw u8):
                free(self.data)
            self.data = malloc(1)
            self.data[0] = 0
            self.capacity = 1
            ret none

        if self.capacity <= self.len + 1:
            ret none

        new_cap := self.len + 1
        new_data := malloc(new_cap)
        memcpy(new_data, self.data, self.len)
        new_data[self.len] = 0
        free(self.data)

        self.data = new_data
        self.capacity = new_cap

    # Access character at index
    char_at :: (&self, index: u64) -> u8 => do
        if index >= self.len:
            panic("String index out of bounds")
        ret ptr_offset(self.data, index)[0]

    # Get bytes as C string
    as_cstr :: (&self) -> *raw u8 => do
        if self.data == (0 as *raw u8):
            ret "" as *raw u8
        ret self.data

    # Get raw bytes pointer
    bytes :: (&self) -> *raw u8 => { self.data }

    # Alias for raw pointer access
    as_ptr :: (&self) -> *raw u8 => { self.data }

impl String:
    # Push string
    push_str :: (&mut self, other: &String) -> none => do
        if other.len == 0:
            ret none

        new_len := self.len + other.len
        if new_len + 1 >= self.capacity:
            String::reserve(self, other.len)

        memmove(ptr_offset(self.data, self.len), other.data, other.len)
        self.len = new_len
        ptr_offset(self.data, self.len)[0] = 0

    # Push C string
    push_cstr :: (*self, cstr: *u8) -> none => do
        if cstr == (0 as *u8):
            ret none

        cstr_in_self := cstr >= self.data and cstr < ptr_offset(self.data, self.len)
        offset := 0
        if cstr_in_self:
            offset = (cstr as u64) - (self.data as u64)

        len := strlen(cstr)
        if len == 0:
            ret none

        String::reserve(self, self.len + len)

        src := cstr
        if cstr_in_self:
            src = ptr_offset(self.data, offset)

        memmove(ptr_offset(self.data, self.len), src, len)
        self.len = self.len + len
        ptr_offset(self.data, self.len)[0] = 0

    # Push single character
    push_char :: (*self, ch: u8) -> none => do
        if self.len + 1 >= self.capacity:
            String::reserve(self, 1)

        ptr_offset(self.data, self.len)[0] = ch
        self.len = self.len + 1
        ptr_offset(self.data, self.len)[0] = 0

    # Pop last character
    pop :: (*self) -> u8 => do
        if self.len == 0:
            panic("Cannot pop from empty string")

        self.len = self.len - 1
        ch := ptr_offset(self.data, self.len)[0]
        ptr_offset(self.data, self.len)[0] = 0
        ret ch

    # Clear string
    clear :: (*self) -> none => do
        if self.data ~= (0 as *u8):
            memset(self.data, 0, self.capacity)
        self.len = 0

    # Truncate to length
    truncate :: (*self, new_len: u64) -> none => do
        if new_len >= self.len:
            ret none

        self.len = new_len
        if self.data ~= (0 as *u8):
            ptr_offset(self.data, self.len)[0] = 0

    # Check if contains substring
    contains :: (*self, needle: *String) -> bool => do
        if needle.len == 0:
            ret true
        if self.len == 0 or needle.len > self.len:
            ret false

        result := strstr(self.data, needle.data)
        ret result ~= (0 as *u8)

    # Check if starts with
    starts_with :: (*self, prefix: *String) -> bool => do
        if prefix.len > self.len:
            ret false
        if prefix.len == 0:
            ret true

        ret strncmp(self.data, prefix.data, prefix.len) == 0

    # Check if ends with
    ends_with :: (*self, suffix: *String) -> bool => do
        if suffix.len > self.len:
            ret false
        if suffix.len == 0:
            ret true

        offset := self.len - suffix.len
        ret strncmp(ptr_offset(self.data, offset), suffix.data, suffix.len) == 0

    # Find first occurrence of substring
    find :: (*self, needle: *String) -> i64 => do
        if needle.len == 0:
            ret 0
        if self.len == 0 or needle.len > self.len:
            ret -1

        result := strstr(self.data, needle.data)
        if result == (0 as *u8):
            ret -1

        ret (result as u64 - self.data as u64) as i64

    # Index of (alias for find)
    index_of :: (*self, needle: *String) -> i64 => String::find(self, needle)

    # Equals comparison
    equals :: (*self, other: *String) -> bool => do
        if self.len ~= other.len:
            ret false
        if self.len == 0:
            ret true

        ret strcmp(self.data, other.data) == 0

    # Compare (returns -1, 0, or 1)
    compare :: (*self, other: *String) -> i32 => do
        result := strcmp(self.data, other.data)
        if result >= 0:
            if result >= 1:
                ret 1
            ret 0
        ret -1

    # Case-insensitive equality
    eq_ignore_case :: (*self, other: *String) -> bool => do
        if self.len ~= other.len:
            ret false
        if self.len == 0:
            ret true

        for i in 0..self.len:
            c1 := tolower(ptr_offset(self.data, i)[0] as i32)
            c2 := tolower(ptr_offset(other.data, i)[0] as i32)
            if c1 ~= c2:
                ret false
        ret true

    # Convert to uppercase
    to_uppercase :: (*self) -> String => do
        result := String::with_capacity(self.len + 1)

        for i in 0..self.len:
            ch := ptr_offset(self.data, i)[0] as i32
            upper := toupper(ch) as u8
            String::push_char(&result, upper)

        ret result

    # Convert to lowercase
    to_lowercase :: (*self) -> String => do
        result := String::with_capacity(self.len + 1)

        for i in 0..self.len:
            ch := ptr_offset(self.data, i)[0] as i32
            lower := tolower(ch) as u8
            String::push_char(&result, lower)

        ret result

    # Trim whitespace from both ends
    trim :: (*self) -> String => do
        if self.len == 0:
            ret String::new()

        start := self.len
        for i in 0..self.len:
            ch := ptr_offset(self.data, i)[0] as i32
            if isspace(ch) == 0:
                start = i
                break

        if start == self.len:
            ret String::new()

        end := self.len
        for offset in 0..self.len:
            idx := self.len - 1 - offset
            if idx < start:
                break
            ch := ptr_offset(self.data, idx)[0] as i32
            if isspace(ch) == 0:
                end = idx + 1
                break
            if idx == 0:
                end = 0
                break

        if start >= end:
            ret String::new()

        ret String::substring(self, start, end)

    # Trim whitespace from start
    trim_start :: (*self) -> String => do
        if self.len == 0:
            ret String::new()

        start := self.len
        for i in 0..self.len:
            ch := ptr_offset(self.data, i)[0] as i32
            if isspace(ch) == 0:
                start = i
                break

        if start == self.len:
            ret String::new()

        ret String::substring(self, start, self.len)

    # Trim whitespace from end
    trim_end :: (*self) -> String => do
        if self.len == 0:
            ret String::new()

        end := self.len
        for offset in 0..self.len:
            idx := self.len - 1 - offset
            ch := ptr_offset(self.data, idx)[0] as i32
            if isspace(ch) == 0:
                end = idx + 1
                break
            if idx == 0:
                end = 0
                break

        ret String::substring(self, 0, end)

    # Concatenate strings
    concat :: (*self, other: *String) -> String => do
        result := String::with_capacity(self.len + other.len + 1)
        String::push_str(&result, self)
        String::push_str(&result, other)
        ret result

    # Repeat string n times
    repeat :: (*self, n: u64) -> String => do
        if n == 0 or self.len == 0:
            ret String::new()

        result := String::with_capacity(self.len * n + 1)
        for _ in 0..n:
            String::push_str(&result, self)
        ret result

    # Get substring
    substring :: (*self, start: u64, end: u64) -> String => do
        if start >= self.len:
            ret String::new()
        if end >= self.len:
            end = self.len
        if start >= end:
            ret String::new()

        len := end - start
        result := String::with_capacity(len + 1)

        memcpy(result.data, ptr_offset(self.data, start), len)
        result.len = len
        ptr_offset(result.data, len)[0] = 0

        ret result

    # Slice (alias for substring)
    slice :: (*self, start: u64, end: u64) -> String => String::substring(self, start, end)

    # Split at index
    split_at :: (*self, index: u64) -> (String, String) => do
        if index >= self.len:
            ret (String::substring(self, 0, self.len), String::new())

        left := String::substring(self, 0, index)
        right := String::substring(self, index, self.len)
        ret (left, right)

    # Convert to i64
    to_i64 :: (*self) -> i64 => do
        if self.len == 0:
            ret 0
        ret atoi(self.data) as i64

    # Convert to f64
    to_f64 :: (*self) -> f64 => do
        if self.len == 0:
            ret 0.0
        ret atof(self.data)

    # Create string from i64
    from_i64 :: (value: i64) -> String => do
        buffer := malloc(32) as *u8
        snprintf(buffer, 32, "%ld" as *u8, value)

        result := String::from_cstr(buffer)
        free(buffer)
        ret result

    # Create string from u64 (without i64 cast to avoid overflow)
    from_u64 :: (value: u64) -> String => do
        buffer := malloc(32) as *u8
        snprintf(buffer, 32, "%llu" as *u8, value)

        result := String::from_cstr(buffer)
        free(buffer)
        ret result

    # Create string from f64
    from_f64 :: (value: f64) -> String => do
        buffer := malloc(64) as *u8
        snprintf(buffer, 64, "%f" as *u8, value)

        result := String::from_cstr(buffer)
        free(buffer)
        ret result

    # Iterate over characters with callback
    each_char :: (*self, callback: (u8) -> none) -> none => do
        for i in 0..self.len:
            ch := ptr_offset(self.data, i)[0]
            callback(ch)

    # Clone/copy string
    clone :: (*self) -> String => String::substring(self, 0, self.len)

    # Destroy string and free memory
    destroy :: (*self) -> none => do
        if self.data ~= (0 as *u8):
            free(self.data)
            self.data = 0 as *u8
        self.len = 0
        self.capacity = 0

    # Replace first occurrence
    replace_first :: (*self, old: *String, new: *String) -> String => do
        index := String::find(self, old)
        if index < 0:
            ret String::clone(self)

        result := String::with_capacity(self.len - old.len + new.len + 1)

        left := String::substring(self, 0, index as u64)
        right := String::substring(self, (index as u64) + old.len, self.len)
        String::push_str(&result, &left)
        String::push_str(&result, new)
        String::push_str(&result, &right)

        ret result

    # Count occurrences of character
    count_char :: (*self, ch: u8) -> u64 => do
        count := 0
        for i in 0..self.len:
            if ptr_offset(self.data, i)[0] == ch:
                count = count + 1
        ret count

    # Reverse string
    reverse :: (*self) -> String => do
        if self.len <= 1:
            ret String::clone(self)

        result := String::with_capacity(self.len + 1)
        for i in 0..self.len:
            idx := self.len - 1 - i
            String::push_char(&result, ptr_offset(self.data, idx)[0])
        ret result

    # Parse string to i64
    parse_i64 :: (*self) -> ?i64 => do
        if self.len == 0:
            ret none

        trimmed := String::trim(self)
        if trimmed.len == 0:
            ret none

        start_idx := 0
        is_negative := false

        first_char := ptr_offset(trimmed.data, 0)[0]
        if first_char == 45:
            is_negative = true
            start_idx = 1
        elif first_char == 43:
            start_idx = 1

        if start_idx >= trimmed.len:
            ret none

        result := 0 as i64
        for i in start_idx..trimmed.len:
            ch := ptr_offset(trimmed.data, i)[0]
            if ch < 48 or ch > 57:
                ret none
            digit := (ch - 48) as i64

            if is_negative:
                if result < -922337203685477580:
                    ret none
                if result == -922337203685477580 and digit > 8:
                    ret none
                result = result * 10 - digit
            else:
                if result > 922337203685477580:
                    ret none
                if result == 922337203685477580 and digit > 7:
                    ret none
                result = result * 10 + digit

        ret some result

    # Parse string to u64
    parse_u64 :: (*self) -> ?u64 => do
        if self.len == 0:
            ret none

        trimmed := String::trim(self)
        if trimmed.len == 0:
            ret none

        start_idx := 0
        first_char := ptr_offset(trimmed.data, 0)[0]
        if first_char == 43:
            start_idx = 1
        if first_char == 45:
            ret none

        if start_idx >= trimmed.len:
            ret none

    result := 0 as u64
        for i in start_idx..trimmed.len:
            ch := ptr_offset(trimmed.data, i)[0]
            if ch < 48 or ch > 57:
                ret none
            digit := (ch - 48) as u64

            if result > 1844674407370955161:
                ret none
            if result == 1844674407370955161 and digit > 5:
                ret none
            result = result * 10 + digit

        ret some result

    # Parse string to f64
    parse_f64 :: (*self) -> ?f64 => do
        if self.len == 0:
            ret none

        trimmed := String::trim(self)
        if trimmed.len == 0:
            ret none

        has_digit := false
        has_dot := false
        start_idx := 0

        first_char := ptr_offset(trimmed.data, 0)[0]
        if first_char == 45 or first_char == 43:
            start_idx = 1

        for i in start_idx..trimmed.len:
            ch := ptr_offset(trimmed.data, i)[0]
            if ch >= 48 and ch <= 57:
                has_digit = true
            elif ch == 46:
                if has_dot:
                    ret none
                has_dot = true
            elif ch == 101 or ch == 69:
                break
            else:
                ret none

        if not has_digit:
            ret none

        result := atof(trimmed.data)
        ret some result

    # Parse string to bool
    parse_bool :: (*self) -> ?bool => do
        trimmed := String::trim(self)

        true_str := String::from_cstr("true" as *u8)
        false_str := String::from_cstr("false" as *u8)

        if String::equals(&trimmed, &true_str):
            ret some true
        if String::equals(&trimmed, &false_str):
            ret some false
        ret none
