# Signal infrastructure for TriCTI
# Implements typed channels with topology and buffering semantics

use prelude
use core::errors

# =============================================================================
# SIGNAL TYPES AND TOPOLOGY
# =============================================================================

SignalTopology :: enum
    # Multiple producers, single consumer
    MPSC,
    # Single producer, multiple consumers  
    SPMC,
    # Multiple producers, multiple consumers
    MPMC,
    # Single producer, single consumer (optimized)
    SPSC,

BufferingStrategy :: enum
    # First-in-first-out queue with capacity
    FIFO :: struct
        capacity: u64,
    # Overwrites whatever is there when full
    Overwrite,
    # Fail send when full
    FailOnFull :: struct
        capacity: u64,
    # Unbounded (use with caution)
    Unbounded,
    # Ordered by priority (only works when sending types that implement Ord)
    Priority :: struct
        ascending: bool,
        capacity: u64,

# =============================================================================
# SIGNAL DEFINITION
# =============================================================================

Signal<T> :: struct
    name: String,
    topology: SignalTopology,
    buffering: BufferingStrategy,
    
    # Runtime state
    senders: [SenderId],
    receivers: [ReceiverId],
    buffer: SignalBuffer<T>,
    
    # Statistics
    messages_sent: u64,
    messages_received: u64,
    messages_dropped: u64,

SenderId :: u64
ReceiverId :: u64

# =============================================================================
# SIGNAL BUFFER
# =============================================================================

SignalBuffer<T> :: enum
    FIFO :: struct
        queue: RingBuffer<T>,
        capacity: u64,
    Overwrite :: struct
        queue: RingBuffer<T>,
        capacity: u64,
    Priority :: struct
        heap: BinaryHeap<PriorityMessage<T>>,
        capacity: u64,
    Unbounded :: struct
        queue: [T],

PriorityMessage<T> :: struct
    priority: u64,
    payload: T,
    timestamp: u64,

RingBuffer<T> :: struct
    data: [T],
    read_pos: u64,
    write_pos: u64,
    capacity: u64,
    size: u64,

impl<T> RingBuffer<T>:
    new :: (capacity: u64) -> RingBuffer<T> =>
        RingBuffer<T> {
            data: [T::default(); capacity],
            read_pos: 0,
            write_pos: 0,
            capacity: capacity,
            size: 0,
        }

    push :: (&mut self, item: T) -> !none => do
        if self.size >= self.capacity:
            ret err StdError::Message { message: "Ring buffer full" }
        
        self.data.set(self.write_pos, item)
        self.write_pos = (self.write_pos + 1) % self.capacity
        self.size += 1
        
        ret ok none

    pop :: (&mut self) -> !T => do
        if self.size == 0:
            ret err StdError::Message { message: "Ring buffer empty" }
        
        item := self.data.get(self.read_pos)?
        self.read_pos = (self.read_pos + 1) % self.capacity
        self.size -= 1

        ret ok item?

    is_full :: (&self) -> bool => self.size >= self.capacity
    is_empty :: (&self) -> bool => self.size == 0
    len :: (&self) -> u64 => self.size
    capacity :: (&self) -> u64 => self.capacity

# =============================================================================
# SIGNAL OPERATIONS
# =============================================================================

impl<T> Signal<T>:
    # Create a new signal with specified configuration
    new :: (name: String, topology: SignalTopology, 
            buffering: BufferingStrategy) -> Signal<T> => {
        buffer := match buffering {
            BufferingStrategy::FIFO { capacity } => SignalBuffer::FIFO {
                queue: RingBuffer::new(capacity),
                capacity: capacity,
            },
            BufferingStrategy::Overwrite { capacity } => SignalBuffer::Overwrite {
                queue: RingBuffer::new(capacity),
                capacity: capacity,
            },
            BufferingStrategy::Unbounded => SignalBuffer::Unbounded { queue: [] },
            _ => SignalBuffer::Unbounded { queue: [] },
        }

        Signal<T> {
            name: name,
            topology: topology,
            buffering: buffering,
            senders: [],
            receivers: [],
            buffer: buffer,
            messages_sent: 0,
            messages_received: 0,
            messages_dropped: 0,
        }
    }

    # Register a sender
    register_sender :: (&mut self) -> !SenderId => do
        # Check topology constraints
        match self.topology:
            SignalTopology::SPSC or SignalTopology::SPMC => do
                if self.senders.len() > 0:
                    ret err StdError::InvalidArgument {
                        parameter: "sender",
                        message: "Signal topology allows only one sender",
                    }
            _ => {},
        
        sender_id := self.senders.len()
        self.senders.push(sender_id)

        ret ok sender_id

    # Register a receiver
    register_receiver :: (&mut self) -> !ReceiverId => do
        # Check topology constraints
        match self.topology:
            SignalTopology::SPSC or SignalTopology::MPSC => do
                if self.receivers.len() > 0:
                    ret err StdError::InvalidArgument {
                        parameter: "receiver",
                        message: "Signal topology allows only one receiver",
                    }
            _ => {},
        
        receiver_id := self.receivers.len()
        self.receivers.push(receiver_id)
        ret ok receiver_id

    # Send a message
    send :: (&mut self, sender_id: SenderId, message: T) -> !none => do
        # Verify sender is registered
        if not self.senders.contains(sender_id):
            ret err StdError::InvalidArgument {
                parameter: "sender_id",
                message: "Sender not registered",
            }
        
        # Handle based on buffering strategy
        send_result := match &mut self.buffer:
            SignalBuffer::FIFO { queue, .. } =>
                queue.push(message)
            SignalBuffer::Overwrite { queue, .. } => do
                if queue.is_full():
                    match queue.pop():
                        ok _ => {},
                        err _ => {},

                    self.messages_dropped += 1

                queue.push(message)
            SignalBuffer::Unbounded { queue } => do
                queue.push(message)
                ok none
            _ => ok none,
        match send_result:
            ok _ => do
                self.messages_sent += 1
                ret ok none
            err err_ => ret err err_

    # Receive a message (blocking)
    receive :: (&mut self, receiver_id: ReceiverId) -> !T => do
        # Verify receiver is registered
        if not self.receivers.contains(receiver_id):
            ret err StdError::InvalidArgument {
                parameter: "receiver_id",
                message: "Receiver not registered",
            }
        
        # Get message from buffer
        receive_result := match &mut self.buffer:
            SignalBuffer::FIFO { queue, .. } => queue.pop(),
            SignalBuffer::Overwrite { queue, .. } => queue.pop(),
            SignalBuffer::Unbounded { queue } =>
                if queue.is_empty():
                    err StdError::Message { message: "No messages available" }
                else: ok queue.remove(0)?
            _ => err StdError::Message { message: "Receive not supported" },
        match receive_result:
            ok value => do
                self.messages_received += 1
                ret ok value
            err error => ret err error

    # Try receive (non-blocking)
    try_receive :: (&mut self, receiver_id: ReceiverId) -> ?T =>
        match self.receive(receiver_id):
            ok value => some value,
            err _ => none,

    # Get signal statistics
    stats :: (&self) -> SignalStats =>
        SignalStats {
            messages_sent: self.messages_sent,
            messages_received: self.messages_received,
            messages_dropped: self.messages_dropped,
            buffer_size: self.buffer_size(),
            sender_count: self.senders.len(),
            receiver_count: self.receivers.len(),
        }

    buffer_size :: (&self) -> u64 =>
        match &self.buffer:
            SignalBuffer::FIFO { queue, .. } => queue.len(),
            SignalBuffer::Overwrite { queue, .. } => queue.len(),
            SignalBuffer::Unbounded { queue } => queue.len(),
            _ => 0,

SignalStats :: struct
    messages_sent: u64,
    messages_received: u64,
    messages_dropped: u64,
    buffer_size: u64,
    sender_count: u64,
    receiver_count: u64,
