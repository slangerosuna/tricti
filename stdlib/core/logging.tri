# Placeholder logging hooks for stdlib modules.
# Until the host exposes structured logging, these functions forward to println for visibility.

use prelude

LogLevel :: enum
    Trace,
    Debug,
    Info,
    Warn,
    Error,

log_message :: (level: LogLevel, message: String) => do
    label := match level:
        LogLevel::Trace => "[trace]",
        LogLevel::Debug => "[debug]",
        LogLevel::Info => "[info]",
        LogLevel::Warn => "[warn]",
        LogLevel::Error => "[error]",

    println(label)
    println(message)

log_info :: (message: String) => log_message(LogLevel::Info, message)
log_error :: (message: String) => log_message(LogLevel::Error, message)
