# Platform-specific functions for TriCTI
# Provides low-level primitives and system interfaces

use std::prelude
use std::core::errors

# Global counter for timestamps (since we don't have real time yet)
global_timestamp_counter: u64 := 0

# Get current timestamp (monotonically increasing counter for now)
current_timestamp :: () -> u64 => do
    global_timestamp_counter += 1
    global_timestamp_counter

# Reset timestamp counter (for testing)
reset_timestamp :: () => do
    global_timestamp_counter = 0

# Memory allocation (extern functions provided by runtime)
extern alloc :: (size: u64) -> *raw none
extern dealloc :: (ptr: *raw none) -> none

# Platform capabilities
platform_has_feature :: (feature: String) -> bool => match feature:
    "timestamp" => true,
    "alloc" => true,
    _ => false,
