# PostgreSQL-backed table implementation for TriCTI
# Replaces custom MVCC with PostgreSQL MVCC
# Maintains static analyzability for DAG compilation

use prelude
use core::errors
use core::result
use core::postgresql

# =============================================================================
# SCHEMA DEFINITION
# =============================================================================

PgTableSchema :: {
    name: string,
    columns: Vec<PgColumnDef>,
    primary_key: Vec<string>,
    constraints: Vec<PgConstraintDef>,
}

PgColumnDef :: {
    name: string,
    data_type: PgDataType,
    nullable: bool,
    default_value: ?string,
}

PgDataType :: enum {
    Integer,
    BigInt,
    Real,
    DoublePrecision,
    Text,
    Varchar { max_length: u64 },
    Boolean,
    Timestamp,
    Bytea,
}

PgConstraintDef :: {
    name: string,
    constraint_type: PgConstraintType,
}

PgConstraintType :: enum {
    PrimaryKey { columns: Vec<string> },
    ForeignKey { columns: Vec<string>, ref_table: string, ref_columns: Vec<string> },
    Unique { columns: Vec<string> },
    Check { expression: string },
}

impl PgTableSchema {
    # Generate CREATE TABLE DDL
    to_sql :: (&self) -> string => {
        sql := "CREATE TABLE " + self.name + " (\n"
        
        # Add columns
        for (i, col) in self.columns.enumerate() {
            if i > 0 {
                sql = sql + ",\n"
            }
            sql = sql + "  " + col.name + " " + col.data_type.to_sql()
            
            if ~col.nullable {
                sql = sql + " NOT NULL"
            }
            
            match col.default_value {
                some default => { sql = sql + " DEFAULT " + default },
                none => {},
            }
        }
        
        # Add primary key
        if self.primary_key.len() > 0 {
            sql = sql + ",\n  PRIMARY KEY ("
            for (i, col) in self.primary_key.enumerate() {
                if i > 0 { sql = sql + ", " }
                sql = sql + col
            }
            sql = sql + ")"
        }
        
        # Add constraints
        for constraint in self.constraints {
            sql = sql + ",\n  " + constraint.to_sql()
        }
        
        sql = sql + "\n)"
        sql
    }
}

impl PgDataType {
    to_sql :: (&self) -> string => {
        match self {
            PgDataType::Integer => "INTEGER",
            PgDataType::BigInt => "BIGINT",
            PgDataType::Real => "REAL",
            PgDataType::DoublePrecision => "DOUBLE PRECISION",
            PgDataType::Text => "TEXT",
            PgDataType::Varchar { max_length } => "VARCHAR(" + max_length.to_string() + ")",
            PgDataType::Boolean => "BOOLEAN",
            PgDataType::Timestamp => "TIMESTAMP",
            PgDataType::Bytea => "BYTEA",
        }
    }
}

impl PgConstraintDef {
    to_sql :: (&self) -> string => {
        constraint_sql := "CONSTRAINT " + self.name + " "
        
        match self.constraint_type {
            PgConstraintType::PrimaryKey { columns } => {
                constraint_sql + "PRIMARY KEY (" + join_strings(columns, ", ") + ")"
            },
            PgConstraintType::ForeignKey { columns, ref_table, ref_columns } => {
                constraint_sql + "FOREIGN KEY (" + join_strings(columns, ", ") + 
                ") REFERENCES " + ref_table + "(" + join_strings(ref_columns, ", ") + ")"
            },
            PgConstraintType::Unique { columns } => {
                constraint_sql + "UNIQUE (" + join_strings(columns, ", ") + ")"
            },
            PgConstraintType::Check { expression } => {
                constraint_sql + "CHECK (" + expression + ")"
            },
        }
    }
}

join_strings :: (strings: Vec<string>, separator: string) -> string => {
    result := ""
    for (i, s) in strings.enumerate() {
        if i > 0 { result = result + separator }
        result = result + s
    }
    result
}

# =============================================================================
# TABLE OPERATIONS (Rule 2: Guaranteed Access)
# =============================================================================

PgTable :: {
    conn: &PgConnection,
    schema: PgTableSchema,
}

impl PgTable {
    # Create table from schema
    create :: (conn: &PgConnection, schema: PgTableSchema) -> StdResult<PgTable> => {
        sql := schema.to_sql()
        conn.execute(sql)?
        
        std_ok(PgTable {
            conn: conn,
            schema: schema,
        })
    }

    # Drop table
    drop :: (&self) -> StdResult<none> => {
        sql := "DROP TABLE " + self.schema.name
        self.conn.execute(sql)?
        std_ok(none)
    }

    # Insert row (Rule 7: Set-at-a-time operations)
    insert :: (&self, values: Vec<PgValue>) -> StdResult<u64> => {
        if values.len() != self.schema.columns.len() {
            ret std_err(StdError::Message {
                message: "Column count mismatch",
            })
        }
        
        sql := "INSERT INTO " + self.schema.name + " VALUES ("
        
        for (i, _) in values.enumerate() {
            if i > 0 { sql = sql + ", " }
            sql = sql + "$" + (i + 1).to_string()
        }
        
        sql = sql + ")"
        
        stmt := self.conn.prepare("insert_" + self.schema.name, sql)?
        result := stmt.execute(values)?
        
        std_ok(result.num_rows)
    }

    # Select rows - UNSAFE: Only use with trusted input or use select_where instead
    # WARNING: This method is vulnerable to SQL injection if where_clause contains untrusted input
    select :: (&self, where_clause: ?string) -> StdResult<PgResult> => {
        sql := "SELECT * FROM " + self.schema.name
        
        match where_clause {
            some clause => { sql = sql + " WHERE " + clause },
            none => {},
        }
        
        self.conn.execute(sql)
    }

    # Safe select with parameterized where clause
    select_where :: (&self, column: string, value: PgValue) -> StdResult<PgResult> => {
        sql := "SELECT * FROM " + self.schema.name + " WHERE " + column + " = $1"
        
        stmt := self.conn.prepare("select_where_" + self.schema.name + "_" + column, sql)?
        stmt.execute([value])
    }

    # Safe select with multiple conditions (AND)
    select_where_multi :: (&self, conditions: Vec<(string, PgValue)>) -> StdResult<PgResult> => {
        if conditions.len() == 0 {
            ret self.select(none)
        }
        
        sql := "SELECT * FROM " + self.schema.name + " WHERE "
        
        for (i, condition) in conditions.enumerate() {
            if i > 0 { sql = sql + " AND " }
            sql = sql + condition.0 + " = $" + (i + 1).to_string()
        }
        
        values := Vec::new()
        for condition in conditions {
            values.push(condition.1)
        }
        
        stmt := self.conn.prepare("select_multi_" + self.schema.name, sql)?
        stmt.execute(values)
    }

    # Update rows - UNSAFE: Only use with trusted input or use update_where instead
    # WARNING: This method is vulnerable to SQL injection if clauses contain untrusted input
    update :: (&self, set_clause: string, where_clause: ?string) -> StdResult<u64> => {
        sql := "UPDATE " + self.schema.name + " SET " + set_clause
        
        match where_clause {
            some clause => { sql = sql + " WHERE " + clause },
            none => {},
        }
        
        result := self.conn.execute(sql)?
        std_ok(result.num_rows)
    }

    # Safe update with parameterized values
    update_where :: (&self, set_column: string, set_value: PgValue, where_column: string, where_value: PgValue) -> StdResult<u64> => {
        sql := "UPDATE " + self.schema.name + " SET " + set_column + " = $1 WHERE " + where_column + " = $2"
        
        stmt := self.conn.prepare("update_where_" + self.schema.name, sql)?
        result := stmt.execute([set_value, where_value])?
        std_ok(result.num_rows)
    }

    # Delete rows - UNSAFE: Only use with trusted input or use delete_where instead
    # WARNING: This method is vulnerable to SQL injection if where_clause contains untrusted input
    delete :: (&self, where_clause: ?string) -> StdResult<u64> => {
        sql := "DELETE FROM " + self.schema.name
        
        match where_clause {
            some clause => { sql = sql + " WHERE " + clause },
            none => {},
        }
        
        result := self.conn.execute(sql)?
        std_ok(result.num_rows)
    }

    # Safe delete with parameterized where clause
    delete_where :: (&self, column: string, value: PgValue) -> StdResult<u64> => {
        sql := "DELETE FROM " + self.schema.name + " WHERE " + column + " = $1"
        
        stmt := self.conn.prepare("delete_where_" + self.schema.name + "_" + column, sql)?
        result := stmt.execute([value])?
        std_ok(result.num_rows)
    }

    # Guaranteed access (Rule 2): Get by primary key
    get_by_pk :: (&self, pk_values: Vec<PgValue>) -> StdResult<PgResult> => {
        if pk_values.len() != self.schema.primary_key.len() {
            ret std_err(StdError::Message {
                message: "Primary key value count mismatch",
            })
        }
        
        where_clause := ""
        for (i, col) in self.schema.primary_key.enumerate() {
            if i > 0 { where_clause = where_clause + " AND " }
            where_clause = where_clause + col + " = $" + (i + 1).to_string()
        }
        
        sql := "SELECT * FROM " + self.schema.name + " WHERE " + where_clause
        
        stmt := self.conn.prepare("get_by_pk_" + self.schema.name, sql)?
        stmt.execute(pk_values)
    }
}

# =============================================================================
# VIEW SUPPORT (Rule 6: View Updating)
# =============================================================================

PgView :: {
    conn: &PgConnection,
    name: string,
    definition: string,
    is_updatable: bool,
}

impl PgView {
    create :: (conn: &PgConnection, name: string, definition: string) -> StdResult<PgView> => {
        sql := "CREATE VIEW " + name + " AS " + definition
        conn.execute(sql)?
        
        # Check if view is updatable
        updatable := check_view_updatable(conn, name)?
        
        std_ok(PgView {
            conn: conn,
            name: name,
            definition: definition,
            is_updatable: updatable,
        })
    }

    insert :: (&self, values: Vec<PgValue>) -> StdResult<u64> => {
        if ~self.is_updatable {
            ret std_err(StdError::Message {
                message: "View is not updatable",
            })
        }
        
        # TODO: Build INSERT statement for view
        std_err(StdError::Unsupported {
            feature: "View INSERT not yet implemented",
        })
    }

    drop :: (&self) -> StdResult<none> => {
        sql := "DROP VIEW " + self.name
        self.conn.execute(sql)?
        std_ok(none)
    }
}

check_view_updatable :: (conn: &PgConnection, view_name: string) -> StdResult<bool> => {
    sql := "SELECT is_updatable FROM information_schema.views WHERE table_name = $1"
    
    stmt := conn.prepare("check_view_updatable", sql)?
    result := stmt.execute([PgValue::Text { value: view_name }])?
    
    if result.num_rows == 0 {
        ret std_ok(false)
    }
    
    is_updatable_str := result.get_value(0, 0)?.to_string()?
    std_ok(is_updatable_str == "YES")
}

# =============================================================================
# STATIC QUERY PLAN (for DAG compilation)
# =============================================================================

# Extract query plan for static analysis
PgQueryPlan :: {
    node_type: string,
    relation_name: ?string,
    operation: PgOperation,
    estimated_rows: u64,
    estimated_cost: f64,
    children: Vec<PgQueryPlan>,
}

PgOperation :: enum {
    SeqScan,
    IndexScan { index_name: string },
    Join { join_type: string },
    Aggregate,
    Sort,
    Insert,
    Update,
    Delete,
}

explain_query :: (conn: &PgConnection, sql: string) -> StdResult<PgQueryPlan> => {
    explain_sql := "EXPLAIN (FORMAT JSON) " + sql
    
    result := conn.execute(explain_sql)?
    
    if result.num_rows == 0 {
        ret std_err(StdError::Message {
            message: "No query plan returned",
        })
    }
    
    plan_json := result.get_value(0, 0)?.to_string()?
    
    # Parse JSON plan
    parse_query_plan(plan_json)
}

parse_query_plan :: (plan_json: string) -> StdResult<PgQueryPlan> => {
    # Parse PostgreSQL EXPLAIN (FORMAT JSON) output
    # JSON structure: [{"Plan": {...}}]
    
    # Use extern function to parse JSON and extract plan
    plan_ptr := pg_json_parse_plan(plan_json)?
    
    # Extract node type
    node_type := pg_plan_get_node_type(plan_ptr)?
    
    # Extract relation name (may be null for non-scan nodes)
    relation_name := pg_plan_get_relation_name(plan_ptr)
    
    # Extract operation type and create PgOperation
    operation := parse_operation_type(node_type, plan_ptr)?
    
    # Extract estimated rows and cost
    estimated_rows := pg_plan_get_estimated_rows(plan_ptr)?
    estimated_cost := pg_plan_get_total_cost(plan_ptr)?
    
    # Parse child plans recursively
    children := Vec::new()
    child_plans := pg_plan_get_children(plan_ptr)?
    for child_ptr in child_plans {
        child_json := pg_plan_to_json(child_ptr)?
        child_plan := parse_query_plan(child_json)?
        children.push(child_plan)
    }
    
    std_ok(PgQueryPlan {
        node_type: node_type,
        relation_name: relation_name,
        operation: operation,
        estimated_rows: estimated_rows,
        estimated_cost: estimated_cost,
        children: children,
    })
}

parse_operation_type :: (node_type: string, plan_ptr: *none) -> StdResult<PgOperation> => {
    if node_type == "Seq Scan" {
        std_ok(PgOperation::SeqScan)
    } else if node_type == "Index Scan" || node_type == "Index Only Scan" {
        index_name := pg_plan_get_index_name(plan_ptr)?
        std_ok(PgOperation::IndexScan { index_name: index_name })
    } else if node_type == "Nested Loop" || node_type == "Hash Join" || node_type == "Merge Join" {
        std_ok(PgOperation::Join { join_type: node_type })
    } else if node_type == "Aggregate" || node_type == "HashAggregate" || node_type == "GroupAggregate" {
        std_ok(PgOperation::Aggregate)
    } else if node_type == "Sort" {
        std_ok(PgOperation::Sort)
    } else if node_type == "ModifyTable" {
        # Check operation type (INSERT/UPDATE/DELETE)
        op_type := pg_plan_get_modify_operation(plan_ptr)?
        if op_type == "INSERT" {
            std_ok(PgOperation::Insert)
        } else if op_type == "UPDATE" {
            std_ok(PgOperation::Update)
        } else {
            std_ok(PgOperation::Delete)
        }
    } else {
        # Default to SeqScan for unknown types
        std_ok(PgOperation::SeqScan)
    }
}

# =============================================================================
# COMPILE-TIME DEPENDENCY ANALYSIS
# =============================================================================

# Analyze query at compile time for static DAG
CompileTimeAnalysis :: {
    tables_read: Vec<string>,
    tables_written: Vec<string>,
    indexes_used: Vec<string>,
    can_run_parallel: bool,
    isolation_required: IsolationLevel,
}

analyze_at_compile_time :: (sql: string) -> StdResult<CompileTimeAnalysis> => {
    # Use PostgreSQL parser to extract static dependencies
    deps := analyze_query(sql)?
    
    # Determine required isolation level based on access patterns
    isolation := if deps.writes.len() > 0 {
        IsolationLevel::ReadCommitted
    } else {
        IsolationLevel::ReadUncommitted
    }
    
    # Check if query can run in parallel
    can_parallel := deps.is_deterministic && deps.writes.len() == 0
    
    analysis := CompileTimeAnalysis {
        tables_read: extract_table_names(deps.reads),
        tables_written: extract_table_names(deps.writes),
        indexes_used: Vec::new(),
        can_run_parallel: can_parallel,
        isolation_required: isolation,
    }
    
    std_ok(analysis)
}

extract_table_names :: (refs: Vec<TableRef>) -> Vec<string> => {
    names := Vec::new()
    for ref in refs {
        names.push(ref.table)
    }
    names
}
