# Core error definitions for the TriCTI standard library foundations
# These types are intended to be shared across stdlib modules and eventually exported through the prelude.

use prelude

StdError :: enum {
    Message: String,
    Panic: String,
    InvalidArgument: String,
    Unsupported: String,
}

std_error_message :: (err: StdError) -> String => {
    match err {
        StdError::Message(msg) => { msg }
        StdError::Panic(msg) => { msg }
        StdError::InvalidArgument(msg) => { msg }
        StdError::Unsupported(msg) => { msg }
    }
}
