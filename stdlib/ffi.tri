# FFI (Foreign Function Interface) Module
# Provides C/C++ interoperability for TriCTI

use core
mod marshal

# C-compatible types
CInt :: type = i32
CUInt :: type = u32
CLong :: type = i64
CULong :: type = u64
CSize :: type = u64
CChar :: type = u8
CVoid :: type = none

# Dynamic library handle
DynLib :: {
    handle: *raw u8,
    path: String,
    is_open: bool,
}

impl DynLib {
    # Load shared library (.so on Linux, .dll on Windows, .dylib on macOS)
    open :: (path: String) -> ?DynLib => {
        c_path := string_to_cstr(path)
        handle := ffi_dlopen(c_path)
        free_cstr(c_path)
        
        if handle == (unsafe { 0 as *raw u8 }) {
            ret none
        }
        ret some DynLib {
            handle: handle,
            path: path,
            is_open: true,
        }
    }
    
    # Get function symbol from library
    get_symbol :: (&self, name: String) -> ?*raw u8 => {
        if !self.is_open {
            ret none
        }
        c_name := string_to_cstr(name)
        symbol := ffi_dlsym(self.handle, c_name)
        free_cstr(c_name)

        if symbol == (unsafe { 0 as *raw u8 }) {
            ret none
        }
        ret some symbol
    }
    
    # Close library
    close :: (&mut self) -> bool => {
        if !self.is_open {
            ret true
        }
        result := ffi_dlclose(self.handle)
        self.is_open = false
        self.handle = unsafe { 0 as *raw u8 }
        ret result == 0
    }
    
    # Get last error message
    error :: () -> String => {
        err_ptr := ffi_dlerror()
        if err_ptr == (unsafe { 0 as *raw u8 }) {
            ret String::from("No error")
        }
        ret cstr_to_string(err_ptr)
    }
}

impl Drop for DynLib {
    drop :: (&mut self) => {
        self.close()
    }
}

# FFI helper functions - implemented in Rust runtime
extern ffi_dlopen :: (path: *raw u8) -> *raw u8
extern ffi_dlsym :: (handle: *raw u8, symbol: *raw u8) -> *raw u8
extern ffi_dlclose :: (handle: *raw u8) -> i32
extern ffi_dlerror :: () -> *raw u8

# Memory allocation for FFI (C malloc/free)
extern ffi_malloc :: (size: u64) -> *raw u8
extern ffi_free :: (ptr: *raw u8) -> none
extern ffi_memcpy :: (dest: *raw u8, src: *raw u8, n: u64) -> *raw u8
extern ffi_memset :: (ptr: *raw u8, value: i32, n: u64) -> *raw u8
