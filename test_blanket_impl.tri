use core::traits
use core::string
use core::result

main :: () => {
    println("Testing blanket trait implementations...")
    
    # Test 1: From/Into with u8 -> u64
    x: u8 = 42
    y: u64 = u64::from(x)
    assert(y == 42)
    println("✓ Test 1: u8 -> u64 via From::from")
    
    # Test 2: TryFrom with u64 -> u8 (success case)
    a: u64 = 100
    result := u8::try_from(a)
    match result {
        StdResult::Ok { value } => { 
            assert(value == 100)
            println("✓ Test 2: u64 -> u8 TryFrom success case")
        }
        StdResult::Err { message } => { 
            assert(false)
        }
    }
    
    # Test 3: TryFrom with u64 -> u8 (failure case)
    b: u64 = 500
    result2 := u8::try_from(b)
    match result2 {
        StdResult::Ok { value } => { 
            assert(false)
        }
        StdResult::Err { message } => { 
            assert(true)
            println("✓ Test 3: u64 -> u8 TryFrom failure case (overflow)")
        }
    }
    
    # Test 4: String parsing
    s := String::from_cstr("12345" as *u8)
    parse_result := i64::try_from(s)
    match parse_result {
        StdResult::Ok { value } => { 
            assert(value == 12345)
            println("✓ Test 4: String -> i64 parsing")
        }
        StdResult::Err { message } => { 
            assert(false)
        }
    }
    
    println("All blanket impl tests passed!")
}
