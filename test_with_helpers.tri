# Test with comparison helper functions
use prelude

# Helper comparison functions
u64_greater_or_equal :: (a: u64, b: u64) -> bool => {
    # This is implemented at a lower level, we hope it works
    # For now, assume this will be provided by the runtime
    a >= b
}

u64_not_equal :: (a: u64, b: u64) -> bool => {
    a ~= b
}

u64_equal :: (a: u64, b: u64) -> bool => {
    a == b
}

main :: () => {
    println("Testing helper functions...")
    
    x := 5
    y := 5
    z := 10
    
    # Test equality using helper
    eq_result := u64_equal(x, y)
    if eq_result {
        println("PASS: Equality helper works")
    }
    
    # Test inequality using helper
    neq_result := u64_not_equal(x, z)
    if neq_result {
        println("PASS: Inequality helper works")
    }
    
    println("Test complete")
}
